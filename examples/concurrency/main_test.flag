{:namespace "concurrency-test"}

;; Tests run in the entry module (same-module), so they see async :refer bindings
;; from main.flag's imports after CompileProgramWithTests appends these forms.

(deftest go-returns-nil-immediately
  (testing "go returns nil without waiting for the body"
    (is (= nil (go (sleep 2000))))))

(deftest go-runs-body-asynchronously
  (testing "go body executes on another goroutine"
    (let [^{:volatile true} done false]
      (go (do (sleep 10) (update! done true)))
      (is (= false done) "go body update should not have run yet")
      (sleep 50)
      (is (= true done) "go body update should have set done"))))

(deftest go-body-can-compute
  (testing "go body can call fib and store the result"
    (let [^{:volatile true} result 0]
      (go (update! result (fib 10)))
      (sleep 100)
      (is (= 55 result)))))

(deftest future-returns-callable
  (testing "future result is obtained by calling the returned function"
    (let [f (future (+ 20 22))]
      (is (= 42 (f)))
      (is (= 42 (f)) "second call returns cached result"))))

(deftest future-blocks-until-ready
  (testing "calling the future waits for a slow body"
    (let [f (future (do (sleep 30) 99))]
      (is (= 99 (f))))))

(deftest future-runs-asynchronously
  (testing "future starts work without blocking the creator"
    (let [^{:volatile true} done false
          f (future (do (sleep 30) (update! done true) 7))]
      (is (= false done) "body should not have finished yet")
      (is (= false (f :ready?)) "future should report not ready before completion")
      (is (= 7 (f)) "call blocks until result is ready")
      (is (= true (f :ready?)) "future should report ready after completion")
      (is (= true done)))))

(deftest future-can-pipe-result
  (testing "future can return a channel when piped"
    (let [ch (future :piped? true (do (sleep 30) 99))]
      (is (= 99 (channel-receive ch))))))

(deftest channel-send-receive
  (testing "unbuffered channel round-trip via go"
    (let [ch (make-channel)]
      (go (channel-send ch 42))
      (is (= 42 (channel-receive ch))))))

(deftest channel-buffered
  (testing "buffered channel send does not need a waiting receiver"
    (let [ch (make-channel 1)]
      (channel-send ch "ok")
      (is (= "ok" (channel-receive ch))))))

(deftest atom-basics
  (testing "atom defaults to nil"
    (is (= nil (deref (atom)))))
  (testing "deref reset! swap!"
    (let [a (atom 1)]
      (is (= 1 (deref a)))
      (is (= 9 (reset! a 9)))
      (is (= 9 (deref a)))
      (is (= 10 (swap! a + 1)))
      (is (= 10 (deref a))))))

(deftest atom-swap-concurrent
  (testing "swap! is atomic across goroutines"
    (let [a (atom 0)
          n 20
          done (make-channel n)]
      (loop [i 0]
        (when (< i n)
          (go (do
                (swap! a + 1)
                (channel-send done true)))
          (recur (+ i 1))))
      (loop [i 0]
        (when (< i n)
          (channel-receive done)
          (recur (+ i 1))))
      (is (= n (deref a))))))

(deftest atom-type-and-errors
  (testing "type-of atom"
    (is (= :atom (type-of (atom 0)))))
  (testing "deref expects an atom"
    (expect-exception (deref 1) "atom")))

(deftest channel-send-stops-after-close
  (testing "channel-send returns false after the channel is terminated"
    (let [ch (make-channel)]
      (channel-close ch)
      (is (= false (channel-send ch 42))))))

(deftest close-channel-form
  (testing "close-channel terminates"
    (let [ch (make-channel)]
      (is (= nil (close-channel ch)))
      (is (= false (channel-send ch 1)))))
  (testing "close dispatches to close-channel"
    (let [ch (make-channel)]
      (is (= nil (close ch)))
      (is (= false (channel-send ch 1)))))
  (testing "close-channel rejects non-channels"
    (expect-exception (close-channel 1) "channel")))

(deftest with-channel-closes
  (testing "with-channel closes the channel after the body"
    (let [ch (with-channel [c (make-channel)]
               c)]
      (is (= false (channel-send ch 1)))))
  (testing "body can use the channel before close"
    (is (= 7 (with-channel [c (make-channel 1)]
               (do
                 (channel-send c 7)
                 (channel-receive c))))))
  (testing "multiple bindings close LIFO"
    (let [outer (make-channel 1)
          inner (make-channel 1)]
      (with-channel [a outer b inner]
        (channel-send a 1)
        (channel-send b 2))
      (is (= false (channel-send inner 3)))
      (is (= false (channel-send outer 4))))))

(deftest channel-with-future
  (testing "producer future and receive in main"
    (let [ch (make-channel)
          _ (future (channel-send ch (fib 10)))]
      (is (= 55 (channel-receive ch))))))

(deftest channel-some-closes-input-on-match
  (testing "channel-some? terminates its input when it finds a match"
    (let [ch (make-channel 1)]
      (channel-send ch 4)
      (is (= 4 (channel-some? (fn [v] (= v 4)) ch)))
      (is (= false (channel-send ch 5))))))

(deftest channel-every-closes-input-on-failure
  (testing "channel-every? terminates its input when it short-circuits"
    (let [ch (make-channel 3)]
      (channel-send ch 1)
      (channel-send ch 2)
      (channel-send ch 3)
      (is (= false (channel-every? (fn [v] (< v 3)) ch)))
      (is (= false (channel-send ch 4))))))

(deftest select-processes-ready-channels
  (testing "select calls handlers for ready channels only and returns count"
    (let [a (make-channel 1)
          b (make-channel 1)
          empty (make-channel 1)
          ^{:volatile true} seen []]
      (channel-send a 1)
      (channel-send b 2)
      (let [n (select a (fn [v] (update! seen (conj seen v)))
                      empty (fn [v] (update! seen (conj seen v)))
                      b (fn [v] (update! seen (conj seen v))))]
        (is (= 2 n))
        (is (= [1 2] seen))))))

(deftest select-returns-zero-when-none-ready
  (testing "select does not block on empty channels"
    (let [ch (make-channel 1)
          n (select ch (fn [v] v))]
      (is (= 0 n)))))
