{:namespace "compiler-tokenizer-expand-macros-test"}

(deftest expand-macros-canned-fixtures
  (testing "identity and substitution"
    (is (= (expected-fixture "identity-symbol") (expand-fixture "identity-symbol")))
    (is (= (expected-fixture "identity-int") (expand-fixture "identity-int")))
    (is (= (expected-fixture "identity-docstring") (expand-fixture "identity-docstring")))
    (is (= (expected-fixture "constant-ignores-arg") (expand-fixture "constant-ignores-arg")))
    (is (= (expected-fixture "zero-arity") (expand-fixture "zero-arity")))
    (is (= (expected-fixture "pair-vector") (expand-fixture "pair-vector")))
    (is (= (expected-fixture "unused-param") (expand-fixture "unused-param")))
    (is (= (expected-fixture "non-param-symbols") (expand-fixture "non-param-symbols")))
    (is (= (expected-fixture "param-shadows-head") (expand-fixture "param-shadows-head"))))
  (testing "definitions are not emitted"
    (is (= (expected-fixture "only-defmacro") (expand-fixture "only-defmacro")))
    (is (= (expected-fixture "two-defmacros-only") (expand-fixture "two-defmacros-only")))
    (is (= (expected-fixture "empty") (expand-fixture "empty")))
    (is (= 0 (count (expand-source-to-array (slurp-text "examples/compiler_tokenizer/macros/only-defmacro.in")))))
    (is (= 0 (count (expand-source-to-array "")))))
  (testing "nested and ordered expansion"
    (is (= (expected-fixture "nested-macro-in-template") (expand-fixture "nested-macro-in-template")))
    (is (= (expected-fixture "nested-same-macro") (expand-fixture "nested-same-macro")))
    (is (= (expected-fixture "define-order-templates") (expand-fixture "define-order-templates")))
    (is (= (expected-fixture "call-before-define") (expand-fixture "call-before-define")))
    (is (= (expected-fixture "later-def-does-not-rewrite") (expand-fixture "later-def-does-not-rewrite")))
    (is (= (expected-fixture "redefinition") (expand-fixture "redefinition"))))
  (testing "rest splicing"
    (is (= (expected-fixture "rest-vector") (expand-fixture "rest-vector")))
    (is (= (expected-fixture "rest-list") (expand-fixture "rest-list")))
    (is (= (expected-fixture "head-tail-rest") (expand-fixture "head-tail-rest")))
    (is (= (expected-fixture "head-tail-empty-rest") (expand-fixture "head-tail-empty-rest")))
    (is (= (expected-fixture "rest-spliced-twice") (expand-fixture "rest-spliced-twice")))
    (is (= (expected-fixture "rest-docstring") (expand-fixture "rest-docstring")))
    (is (= (expected-fixture "when-style-rest") (expand-fixture "when-style-rest")))
    (is (= (expected-fixture "rest-then-inner-macro") (expand-fixture "rest-then-inner-macro")))
    (is (= (expected-fixture "rest-not-spliced-set") (expand-fixture "rest-not-spliced-set")))
    (is (= (expected-fixture "rest-not-spliced-map") (expand-fixture "rest-not-spliced-map"))))
  (testing "collection walks"
    (is (= (expected-fixture "walk-vector-map") (expand-fixture "walk-vector-map")))
    (is (= (expected-fixture "walk-nested-map") (expand-fixture "walk-nested-map")))
    (is (= (expected-fixture "walk-set") (expand-fixture "walk-set")))
    (is (= (expected-fixture "walk-pipe-vector") (expand-fixture "walk-pipe-vector")))
    (is (= (expected-fixture "nested-non-macro-list") (expand-fixture "nested-non-macro-list")))
    (is (= (expected-fixture "list-args-expanded") (expand-fixture "list-args-expanded")))
    (is (= (expected-fixture "empty-collections") (expand-fixture "empty-collections")))
    (is (= (expected-fixture "quoted-list-not-expanded") (expand-fixture "quoted-list-not-expanded")))
    (is (= (expected-fixture "quoted-call-not-expanded") (expand-fixture "quoted-call-not-expanded"))))
  (testing "non-macro forms"
    (is (= (expected-fixture "unknown-call") (expand-fixture "unknown-call")))
    (is (= (expected-fixture "macro-name-not-head") (expand-fixture "macro-name-not-head")))
    (is (= (expected-fixture "literal-args") (expand-fixture "literal-args")))
    (is (= (expected-fixture "bare-top-level") (expand-fixture "bare-top-level")))
    (is (= (expected-fixture "quoted-symbol") (expand-fixture "quoted-symbol")))
    (is (= (expected-fixture "defn-not-defmacro") (expand-fixture "defn-not-defmacro")))
    (is (= (expected-fixture "identity-vector-arg") (expand-fixture "identity-vector-arg")))
    (is (= (expected-fixture "identity-map-arg") (expand-fixture "identity-map-arg")))
    (is (= (expected-fixture "identity-set-arg") (expand-fixture "identity-set-arg")))
    (is (= (expected-fixture "identity-pipe-arg") (expand-fixture "identity-pipe-arg")))
    (is (= (expected-fixture "identity-list-arg") (expand-fixture "identity-list-arg"))))
  (testing "generated macros"
    (is (= (expected-fixture "generated-identity") (expand-fixture "generated-identity")))
    (is (= (expected-fixture "generated-docstring") (expand-fixture "generated-docstring")))
    (is (= (expected-fixture "generated-rest") (expand-fixture "generated-rest")))
    (is (= (expected-fixture "two-independent") (expand-fixture "two-independent"))))
  (testing "templates and nesting"
    (is (= (expected-fixture "identity-form-arg") (expand-fixture "identity-form-arg")))
    (is (= (expected-fixture "deep-vector") (expand-fixture "deep-vector")))
    (is (= (expected-fixture "deep-map") (expand-fixture "deep-map")))
    (is (= (expected-fixture "same-macro-twice") (expand-fixture "same-macro-twice")))
    (is (= (expected-fixture "produce-map") (expand-fixture "produce-map")))
    (is (= (expected-fixture "produce-set") (expand-fixture "produce-set")))
    (is (= (expected-fixture "produce-list") (expand-fixture "produce-list"))))
  (testing "multi-arity"
    (is (= (expected-fixture "multi-arity-fixed") (expand-fixture "multi-arity-fixed")))
    (is (= (expected-fixture "multi-arity-docstring") (expand-fixture "multi-arity-docstring")))
    (is (= (expected-fixture "multi-arity-do-wrap") (expand-fixture "multi-arity-do-wrap")))
    (is (= (expected-fixture "multi-arity-rest") (expand-fixture "multi-arity-rest"))))
  (testing "macro-case"
    (is (= (expected-fixture "cond-empty-else") (expand-fixture "cond-empty-else")))
    (is (= (expected-fixture "cond-recursive") (expand-fixture "cond-recursive")))
    (is (= (expected-fixture "thread-first-identity") (expand-fixture "thread-first-identity")))
    (is (= (expected-fixture "thread-first-symbol") (expand-fixture "thread-first-symbol")))
    (is (= (expected-fixture "thread-first-forms") (expand-fixture "thread-first-forms")))
    (is (= (expected-fixture "macro-case-underscore") (expand-fixture "macro-case-underscore")))
    (is (= (expected-fixture "macro-case-keyword") (expand-fixture "macro-case-keyword")))
    (is (= (expected-fixture "macro-case-vector-clauses") (expand-fixture "macro-case-vector-clauses"))))
  (testing "hash-fn, meta, defrecord, thread-last"
    (is (= (expected-fixture "hash-fn-body") (expand-fixture "hash-fn-body")))
    (is (= (expected-fixture "meta-walk") (expand-fixture "meta-walk")))
    (is (= (expected-fixture "macro-defrecord") (expand-fixture "macro-defrecord")))
    (is (= (expected-fixture "thread-last") (expand-fixture "thread-last")))
    (is (= (expected-fixture "thread-last-mapcat-rest") (expand-fixture "thread-last-mapcat-rest")))))
