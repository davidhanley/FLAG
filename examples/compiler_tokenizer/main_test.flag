    (is (= :bool (:expr-kind out)))
    (is (= "flagrt.Eq(flagrt.NewBool(a), b)"
           (ir/render-ir (:expr out))))))

(deftest lower-if-two-arg-boxes-bool-then
  (let [out (lower/compile-form-to-ir
