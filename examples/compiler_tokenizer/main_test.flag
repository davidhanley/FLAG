           (ir/render-ir (:expr out))))))

(deftest lower-nil-empty-count-throw-loop
  (is (= "flagrt.IsNil(x)"
         (ir/render-ir (lower/nil-pred-to-ir (ir/ir-ident "x")))))
  (is (= "flagrt.IsEmpty(xs)"
         (ir/render-ir (lower/empty-pred-to-ir (ir/ir-ident "xs")))))
  (is (= "flagrt.NewLong(int64(flagrt.Count(xs)))"
         (ir/render-ir (lower/count-to-ir (ir/ir-ident "xs")))))
  (let [out (lower/compile-form-to-ir
              {:kind :list
               :elements [{:kind :symbol :name "nil?"}
                          {:kind :symbol :name "nil"}]}
              {})]
    (is (= :bool (:expr-kind out)))
    (is (= "flagrt.IsNil(flagrt.NilValue())"
           (ir/render-ir (:expr out)))))
  (let [out (lower/compile-form-to-ir
              {:kind :list
               :elements [{:kind :symbol :name "empty?"}
                          {:kind :string :value "x"}]}
              {})]
    (is (= "flagrt.IsEmpty(flagrt.NewString(\"x\"))"
           (ir/render-ir (:expr out)))))
  (let [out (lower/compile-form-to-ir
              {:kind :list
               :elements [{:kind :symbol :name "count"}
                          {:kind :vector
                           :elements [{:kind :int :value 1}
                                      {:kind :int :value 2}]}]}
              {})]
    (is (= "flagrt.NewLong(int64(flagrt.Count(flagrt.NewArray(flagrt.NewLong(1), flagrt.NewLong(2)))))"
           (ir/render-ir (:expr out)))))
  (let [out (lower/compile-form-to-ir
              {:kind :list
               :elements [{:kind :symbol :name "throw"}
                          {:kind :string :value "boom"}]}
              {})]
    (is (= "func() flagrt.Value {\n\tflagrt.Throw(flagrt.NewString(\"boom\"))\n\treturn flagrt.NilValue()\n}()"
           (ir/render-ir (:expr out)))))
  (let [out (lower/compile-form-to-ir
              {:kind :list
               :elements [{:kind :symbol :name "loop"}
                          {:kind :vector :elements []}
                          {:kind :int :value 1}]}
              {})]
    (is (= :call (:kind (:expr out))))
    (is (= :func-lit (:kind (:fun (:expr out))))))
  (let [out (lower/compile-form-to-ir
              {:kind :list
               :elements [{:kind :symbol :name "loop"}
                          {:kind :vector
                           :elements [{:kind :symbol :name "n"}
                                      {:kind :int :value 0}]}
                          {:kind :symbol :name "n"}]}
              {})]
    (is (= :call (:kind (:expr out))))
    (is (= :func-lit (:kind (:fun (:expr out)))))))

(deftest lower-str-ex-info-assoc-conj
  (is (= "flagrt.Str()"
         (ir/render-ir (lower/str-to-ir []))))
  (is (= "flagrt.Str(\"a\", x)"
         (ir/render-ir (lower/str-to-ir [(ir/ir-string "a") (ir/ir-ident "x")]))))
  (is (= "flagrt.NewMap(flagrt.NewKeyword(\"message\"), flagrt.NewString(\"boom\"), flagrt.NewKeyword(\"data\"), m)"
         (ir/render-ir (lower/ex-info-to-ir (ir/ir-string "boom") (ir/ir-ident "m") nil))))
  (is (= "flagrt.Assoc(m, k, v)"
         (ir/render-ir (lower/assoc-to-ir [(ir/ir-ident "m") (ir/ir-ident "k") (ir/ir-ident "v")]))))
  (is (= "flagrt.Conj(xs, x)"
         (ir/render-ir (lower/conj-to-ir [(ir/ir-ident "xs") (ir/ir-ident "x")]))))
  (let [out (lower/compile-form-to-ir
              {:kind :list
               :elements [{:kind :symbol :name "str"}
                          {:kind :string :value "a"}
                          {:kind :int :value 1}]}
              {})]
    (is (= "flagrt.Str(\"a\", flagrt.NewLong(1))"
           (ir/render-ir (:expr out))))
    (is (= :string (:expr-kind out))))
  (let [out (lower/compile-form-to-ir
              {:kind :list
               :elements [{:kind :symbol :name "ex-info"}
                          {:kind :string :value "boom"}
                          {:kind :map :entries []}]}
              {})]
    (is (= "flagrt.NewMap(flagrt.NewKeyword(\"message\"), flagrt.NewString(\"boom\"), flagrt.NewKeyword(\"data\"), flagrt.NewMap())"
           (ir/render-ir (:expr out)))))
  (let [out (lower/compile-form-to-ir
              {:kind :list
               :elements [{:kind :symbol :name "assoc"}
                          {:kind :symbol :name "m"}
                          {:kind :keyword :name "k"}
                          {:kind :int :value 1}]}
              {:locals {"m" :value}})]
    (is (= "flagrt.Assoc(m, flagrt.NewKeyword(\"k\"), flagrt.NewLong(1))"
           (ir/render-ir (:expr out)))))
  (let [out (lower/compile-form-to-ir
              {:kind :list
               :elements [{:kind :symbol :name "conj"}
                          {:kind :symbol :name "xs"}
                          {:kind :string :value "x"}]}
              {:locals {"xs" :value}})]
    (is (= "flagrt.Conj(xs, flagrt.NewString(\"x\"))"
           (ir/render-ir (:expr out))))))

(deftest lower-seq-drop-take-cons-get-nth
  (is (= "flagrt.Seq(xs)"
         (ir/render-ir (lower/seq-to-ir (ir/ir-ident "xs")))))
  (is (= "flagrt.Drop(n, xs)"
         (ir/render-ir (lower/drop-to-ir [(ir/ir-ident "n") (ir/ir-ident "xs")]))))
  (is (= "flagrt.Take(n, xs)"
         (ir/render-ir (lower/take-to-ir [(ir/ir-ident "n") (ir/ir-ident "xs")]))))
  (is (= "flagrt.Cons(x, xs)"
         (ir/render-ir (lower/cons-to-ir [(ir/ir-ident "x") (ir/ir-ident "xs")]))))
  (is (= "flagrt.Get(m, k)"
         (ir/render-ir (lower/get-to-ir [(ir/ir-ident "m") (ir/ir-ident "k")]))))
  (is (= "flagrt.Nth(xs, i, d)"
         (ir/render-ir (lower/nth-to-ir [(ir/ir-ident "xs") (ir/ir-ident "i") (ir/ir-ident "d")]))))
  (let [out (lower/compile-form-to-ir
              {:kind :list
               :elements [{:kind :symbol :name "seq"}
                          {:kind :string :value "ab"}]}
              {})]
    (is (= "flagrt.Seq(flagrt.NewString(\"ab\"))"
           (ir/render-ir (:expr out)))))
  (let [out (lower/compile-form-to-ir
              {:kind :list
               :elements [{:kind :symbol :name "drop"}
                          {:kind :int :value 1}
                          {:kind :symbol :name "xs"}]}
              {:locals {"xs" :value}})]
    (is (= "flagrt.Drop(flagrt.NewLong(1), xs)"
           (ir/render-ir (:expr out)))))
  (let [out (lower/compile-form-to-ir
              {:kind :list
               :elements [{:kind :symbol :name "get"}
                          {:kind :symbol :name "m"}
                          {:kind :keyword :name "k"}
                          {:kind :string :value "d"}]}
              {:locals {"m" :value}})]
    (is (= "flagrt.Get(m, flagrt.NewKeyword(\"k\"), flagrt.NewString(\"d\"))"
           (ir/render-ir (:expr out)))))
  (let [out (lower/compile-form-to-ir
              {:kind :list
               :elements [{:kind :symbol :name "nth"}
                          {:kind :symbol :name "xs"}
                          {:kind :int :value 0}]}
              {:locals {"xs" :value}})]
    (is (= "flagrt.Nth(xs, flagrt.NewLong(0))"
           (ir/render-ir (:expr out))))))

(deftest lower-not-empty-through-println
  (is (= "flagrt.NotEmpty(xs)"
         (ir/render-ir (lower/not-empty-to-ir (ir/ir-ident "xs")))))
  (is (= "flagrt.TypeOf(x)"
         (ir/render-ir (lower/type-of-to-ir (ir/ir-ident "x")))))
  (is (= "flagrt.Vec(xs)"
         (ir/render-ir (lower/vec-to-ir (ir/ir-ident "xs")))))
  (is (= "flagrt.MapDissoc(m, k)"
         (ir/render-ir (lower/dissoc-to-ir [(ir/ir-ident "m") (ir/ir-ident "k")]))))
  (is (= "flagrt.Contains(m, k)"
         (ir/render-ir (lower/contains-pred-to-ir [(ir/ir-ident "m") (ir/ir-ident "k")]))))
  (is (= "flagrt.Into(to, from)"
         (ir/render-ir (lower/into-to-ir [(ir/ir-ident "to") (ir/ir-ident "from")]))))
  (is (= "flagrt.Concat(a, b)"
         (ir/render-ir (lower/concat-to-ir [(ir/ir-ident "a") (ir/ir-ident "b")]))))
  (is (= "flagrt.ExMessage(e)"
         (ir/render-ir (lower/ex-message-to-ir (ir/ir-ident "e")))))
  (is (= "flagrt.ExData(e)"
         (ir/render-ir (lower/ex-data-to-ir (ir/ir-ident "e")))))
  (is (= "flagrt.ExCause(e)"
         (ir/render-ir (lower/ex-cause-to-ir (ir/ir-ident "e")))))
  (is (= "flagrt.Println(\"a\", x)"
         (ir/render-ir (lower/println-to-ir [(ir/ir-string "a") (ir/ir-ident "x")]))))
  (let [out (lower/compile-form-to-ir
              {:kind :list
               :elements [{:kind :symbol :name "type-of"}
                          {:kind :string :value "x"}]}
              {})]
    (is (= "flagrt.TypeOf(flagrt.NewString(\"x\"))"
           (ir/render-ir (:expr out)))))
  (let [out (lower/compile-form-to-ir
              {:kind :list
               :elements [{:kind :symbol :name "list"}
                          {:kind :string :value "a"}
                          {:kind :int :value 1}]}
              {})]
    (is (= "flagrt.NewList(flagrt.NewString(\"a\"), flagrt.NewLong(1))"
           (ir/render-ir (:expr out)))))
  (let [out (lower/compile-form-to-ir
              {:kind :list
               :elements [{:kind :symbol :name "hash-map"}
                          {:kind :keyword :name "k"}
                          {:kind :int :value 1}]}
              {})]
    (is (= "flagrt.NewMap(flagrt.NewKeyword(\"k\"), flagrt.NewLong(1))"
           (ir/render-ir (:expr out)))))
  (let [out (lower/compile-form-to-ir
              {:kind :list
               :elements [{:kind :symbol :name "contains?"}
                          {:kind :symbol :name "m"}
                          {:kind :keyword :name "k"}]}
              {:locals {"m" :value}})]
    (is (= :bool (:expr-kind out)))
    (is (= "flagrt.Contains(m, flagrt.NewKeyword(\"k\"))"
           (ir/render-ir (:expr out)))))
  (let [out (lower/compile-form-to-ir
              {:kind :list
               :elements [{:kind :symbol :name "println"}
                          {:kind :string :value "a"}
                          {:kind :int :value 1}]}
              {})]
    (is (= "flagrt.Println(\"a\", flagrt.NewLong(1))"
           (ir/render-ir (:expr out))))
    (is (= :value (:expr-kind out)))))

