(deftest lower-eq-to-ir
  (is (= "flagrt.NewBool(flagrt.Eq(flagrt.NewLong(1), flagrt.NewLong(2)))"
         (ir/render-ir (lower/eq-to-ir [(ir/rt-call "NewLong" [(ir/ir-int 1)])
                                        (ir/rt-call "NewLong" [(ir/ir-int 2)])]))))
  (is (= "flagrt.NewBool(flagrt.Eq(a, b) && flagrt.Eq(b, c))"
         (ir/render-ir (lower/eq-to-ir [(ir/ir-ident "a") (ir/ir-ident "b") (ir/ir-ident "c")]))))
  (is (= "flagrt.NewBool(flagrt.Eq(a, b) && flagrt.Eq(b, c) && flagrt.Eq(c, d))"
         (ir/render-ir (lower/eq-to-ir [(ir/ir-ident "a") (ir/ir-ident "b") (ir/ir-ident "c") (ir/ir-ident "d")]))))
  (let [out (lower/compile-form-to-ir
              {:kind :list
               :elements [{:kind :symbol :name "="}
                          {:kind :int :value 1}
                          {:kind :string :value "x"}]}
              {})]
    (is (= "flagrt.NewBool(flagrt.Eq(flagrt.NewLong(1), flagrt.NewString(\"x\")))"
           (ir/render-ir (:expr out)))))
  (let [out (lower/compile-form-to-ir
              {:kind :list
               :elements [{:kind :symbol :name "="}
                          {:kind :symbol :name "a"}
                          {:kind :symbol :name "b"}
                          {:kind :symbol :name "c"}]}
              {:locals {"a" :value "b" :value "c" :value}})]
    (is (= "flagrt.NewBool(flagrt.Eq(a, b) && flagrt.Eq(b, c))"
           (ir/render-ir (:expr out)))))
  (let [out (lower/compile-form-to-ir
              {:kind :list
               :elements [{:kind :symbol :name "countdown"}
                          {:kind :list
                           :elements [{:kind :symbol :name "-"}
                                      {:kind :symbol :name "n"}
                                      {:kind :int :value 1}]}]}
              {:locals {"n" :value}
               :self-function-name "countdown"
               :self-variadic-name "countdown_variadic"
               :self-arity-name "countdown_variadic"
               :self-function-rest true
               :self-function-arity 1})]
    (is (= "countdown_variadic(flagrt.Sub(n, flagrt.NewLong(1)))"
           (ir/render-ir (:expr out))))))

(deftest lower-nil-empty-count-throw-loop
  (is (= "flagrt.NewBool(flagrt.IsNil(x))"
         (ir/render-ir (lower/nil-pred-to-ir (ir/ir-ident "x")))))
  (is (= "flagrt.NewBool(flagrt.IsEmpty(xs))"
         (ir/render-ir (lower/empty-pred-to-ir (ir/ir-ident "xs")))))
  (is (= "flagrt.NewLong(int64(flagrt.Count(xs)))"
         (ir/render-ir (lower/count-to-ir (ir/ir-ident "xs")))))
  (let [out (lower/compile-form-to-ir
              {:kind :list
               :elements [{:kind :symbol :name "nil?"}
                          {:kind :symbol :name "nil"}]}
              {})]
    (is (= "flagrt.NewBool(flagrt.IsNil(flagrt.NilValue()))"
           (ir/render-ir (:expr out)))))
  (let [out (lower/compile-form-to-ir
              {:kind :list
               :elements [{:kind :symbol :name "empty?"}
                          {:kind :string :value "x"}]}
              {})]
    (is (= "flagrt.NewBool(flagrt.IsEmpty(flagrt.NewString(\"x\")))"
           (ir/render-ir (:expr out)))))
  (let [out (lower/compile-form-to-ir
              {:kind :list
               :elements [{:kind :symbol :name "count"}
                          {:kind :vector
                           :elements [{:kind :int :value 1}
                                      {:kind :int :value 2}]}]}
              {})]
    (is (= "flagrt.NewLong(int64(flagrt.Count(flagrt.NewArray(flagrt.NewLong(1), flagrt.NewLong(2)))))"
           (ir/render-ir (:expr out)))))
  (let [out (lower/compile-form-to-ir
              {:kind :list
               :elements [{:kind :symbol :name "throw"}
                          {:kind :string :value "boom"}]}
              {})]
    (is (= "func() flagrt.Value {\n\tflagrt.Throw(flagrt.NewString(\"boom\"))\n\treturn flagrt.NilValue()\n}()"
           (ir/render-ir (:expr out)))))
  (let [out (lower/compile-form-to-ir
              {:kind :list
               :elements [{:kind :symbol :name "loop"}
                          {:kind :vector :elements []}
                          {:kind :int :value 1}]}
              {})]
    (is (= :call (:kind (:expr out))))
    (is (= :func-lit (:kind (:fun (:expr out))))))
  (let [out (lower/compile-form-to-ir
              {:kind :list
               :elements [{:kind :symbol :name "loop"}
                          {:kind :vector
                           :elements [{:kind :symbol :name "n"}
                                      {:kind :int :value 0}]}
                          {:kind :symbol :name "n"}]}
              {})]
    (is (= :call (:kind (:expr out))))
    (is (= :func-lit (:kind (:fun (:expr out)))))))

