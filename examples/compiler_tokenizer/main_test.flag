{:namespace "compiler-tokenizer-test"}

(deftest tokenize-file-emits-token-maps-with-positions
  (let [tokens (tokenize-file-to-array "examples/compiler_tokenizer/sample.txt")]
    (is (= 10 (count tokens)))

    (let [t0 (nth-token tokens 0)
          t1 (nth-token tokens 1)
          t2 (nth-token tokens 2)
          t3 (nth-token tokens 3)
          t4 (nth-token tokens 4)
          t5 (nth-token tokens 5)
          t6 (nth-token tokens 6)
          t7 (nth-token tokens 7)
          t8 (nth-token tokens 8)
          t9 (nth-token tokens 9)]
      (is (= "(" (:token t0))) (is (= 1 (:line t0))) (is (= 1 (:offset t0)))
      (is (= "+" (:token t1))) (is (= 1 (:line t1))) (is (= 2 (:offset t1)))
      (is (= "x" (:token t2))) (is (= 1 (:line t2))) (is (= 4 (:offset t2)))
      (is (= "10" (:token t3))) (is (= 1 (:line t3))) (is (= 6 (:offset t3)))
      (is (= ")" (:token t4))) (is (= 1 (:line t4))) (is (= 8 (:offset t4)))
      (is (= "foo" (:token t5))) (is (= 2 (:line t5))) (is (= 1 (:offset t5)))
      (is (= "bar" (:token t6))) (is (= 2 (:line t6))) (is (= 5 (:offset t6)))
      (is (= "[" (:token t7))) (is (= 3 (:line t7))) (is (= 1 (:offset t7)))
      (is (= "ab" (:token t8))) (is (= 3 (:line t8))) (is (= 2 (:offset t8)))
      (is (= "]" (:token t9))) (is (= 3 (:line t9))) (is (= 4 (:offset t9))))))

(deftest tokenize-file-returns-empty-for-empty-input
  (let [tokens (tokenize-file-to-array "examples/compiler_tokenizer/empty.txt")]
    (is (= 0 (count tokens)))))

(deftest tokenize-file-keeps-multiline-string-as-one-token
  (let [tokens (tokenize-file-to-array "examples/compiler_tokenizer/multiline_string.txt")]
    (is (= 4 (count tokens)))
    (let [t0 (nth-token tokens 0)
          t1 (nth-token tokens 1)
          t2 (nth-token tokens 2)
          t3 (nth-token tokens 3)]
      (is (= "(" (:token t0))) (is (= 1 (:line t0))) (is (= 1 (:offset t0)))
      (is (= "println" (:token t1))) (is (= 1 (:line t1))) (is (= 2 (:offset t1)))
      (is (= "\"\"\"hello\nworld\"\"\"" (:token t2))) (is (= 1 (:line t2))) (is (= 10 (:offset t2)))
      (is (= ")" (:token t3))) (is (= 2 (:line t3))) (is (= 9 (:offset t3))))))

(deftest tokenize-file-handles-single-line-triple-quoted-string
  (let [tokens (tokenize-file-to-array "examples/compiler_tokenizer/triple_quote_single_line.txt")]
    (is (= 4 (count tokens)))
    (let [t0 (nth-token tokens 0)
          t1 (nth-token tokens 1)
          t2 (nth-token tokens 2)
          t3 (nth-token tokens 3)]
      (is (= "(" (:token t0))) (is (= 1 (:line t0))) (is (= 1 (:offset t0)))
      (is (= "println" (:token t1))) (is (= 1 (:line t1))) (is (= 2 (:offset t1)))
      (is (= "\"\"\"hello\"\"\"" (:token t2))) (is (= 1 (:line t2))) (is (= 10 (:offset t2)))
      (is (= ")" (:token t3))) (is (= 1 (:line t3))) (is (= 21 (:offset t3))))))

(deftest parse-file-emits-one-ast-per-top-level-expression
  (let [exprs (parse-file-to-array "examples/compiler_tokenizer/sample.txt")]
    (is (= 4 (count exprs)))
    (let [e0 (nth-token exprs 0)
          e1 (nth-token exprs 1)
          e2 (nth-token exprs 2)
          e3 (nth-token exprs 3)
          e0c0 (nth-token (:elements e0) 0)
          e0c1 (nth-token (:elements e0) 1)
          e0c2 (nth-token (:elements e0) 2)
          e3c0 (nth-token (:elements e3) 0)]
      (is (= :list (:kind e0))) (is (= 1 (:line e0))) (is (= 1 (:col e0)))
      (is (= 3 (count (:elements e0))))
      (is (= :symbol (:kind e0c0))) (is (= "+" (:name e0c0))) (is (= 1 (:line e0c0))) (is (= 2 (:col e0c0)))
      (is (= :symbol (:kind e0c1))) (is (= "x" (:name e0c1))) (is (= 1 (:line e0c1))) (is (= 4 (:col e0c1)))
      (is (= :int (:kind e0c2))) (is (= 10 (:value e0c2))) (is (= 1 (:line e0c2))) (is (= 6 (:col e0c2)))

      (is (= :symbol (:kind e1))) (is (= "foo" (:name e1))) (is (= 2 (:line e1))) (is (= 1 (:col e1)))
      (is (= :symbol (:kind e2))) (is (= "bar" (:name e2))) (is (= 2 (:line e2))) (is (= 5 (:col e2)))

      (is (= :vector (:kind e3))) (is (= 1 (count (:elements e3)))) (is (= 3 (:line e3))) (is (= 1 (:col e3)))
      (is (= :symbol (:kind e3c0))) (is (= "ab" (:name e3c0))) (is (= 3 (:line e3c0))) (is (= 2 (:col e3c0))))))

(deftest build-ast-from-tokens-handles-empty-top-level-forms
  (let [exprs (build-ast-file-to-array "examples/compiler_tokenizer/ast_empty_forms.txt")
        e0 (nth-token exprs 0)
        e1 (nth-token exprs 1)
        e2 (nth-token exprs 2)]
    (is (= 3 (count exprs)))
    (is (= :list (:kind e0))) (is (= 0 (count (:elements e0)))) (is (= 1 (:line e0))) (is (= 1 (:col e0)))
    (is (= :vector (:kind e1))) (is (= 0 (count (:elements e1)))) (is (= 2 (:line e1))) (is (= 1 (:col e1)))
    (is (= :map (:kind e2))) (is (= 0 (count (:entries e2)))) (is (= 3 (:line e2))) (is (= 1 (:col e2)))))

(deftest build-ast-from-tokens-preserves-nested-shape-and-positions
  (let [exprs (build-ast-file-to-array "examples/compiler_tokenizer/ast_nested_forms.txt")
        root (nth-token exprs 0)
        root0 (nth-child root 0)
        root1 (nth-child root 1)
        root2 (nth-child root 2)
        root3 (nth-child root 3)
        root1c0 (nth-child root1 0)
        root1c1 (nth-child root1 1)
        root1c1c0 (nth-child root1c1 0)
        root1c1c1 (nth-child root1c1 1)
        root2c0 (nth-child root2 0)
        root2c1 (nth-child root2 1)
        root2c2 (nth-child root2 2)
        root2c3 (nth-child root2 3)
        root2c1c0 (nth-child root2c1 0)
        root2c1c1 (nth-child root2c1 1)
        root2c3c0 (nth-child root2c3 0)
        root2c3c1 (nth-child root2c3 1)]
    (is (= 1 (count exprs)))
    (is (= :list (:kind root))) (is (= 1 (:line root))) (is (= 1 (:col root)))
    (is (= 4 (count (:elements root))))
    (is (= :symbol (:kind root0))) (is (= "outer" (:name root0))) (is (= 1 (:line root0))) (is (= 2 (:col root0)))
    (is (= :vector (:kind root1))) (is (= 2 (:line root1))) (is (= 3 (:col root1)))
    (is (= :symbol (:kind root1c0))) (is (= "inner" (:name root1c0))) (is (= 2 (:line root1c0))) (is (= 4 (:col root1c0)))
    (is (= :map (:kind root1c1))) (is (= 2 (:line root1c1))) (is (= 10 (:col root1c1)))
    (is (= "key" (:name root1c1c0))) (is (= 2 (:line root1c1c0))) (is (= 11 (:col root1c1c0)))
    (is (= "value" (:name root1c1c1))) (is (= 2 (:line root1c1c1))) (is (= 16 (:col root1c1c1)))

    (is (= :map (:kind root2))) (is (= 3 (:line root2))) (is (= 3 (:col root2)))
    (is (= "pair" (:name root2c0))) (is (= 3 (:line root2c0))) (is (= 4 (:col root2c0)))
    (is (= :vector (:kind root2c1))) (is (= 3 (:line root2c1))) (is (= 10 (:col root2c1)))
    (is (= "left" (:name root2c1c0))) (is (= 3 (:line root2c1c0))) (is (= 11 (:col root2c1c0)))
    (is (= "right" (:name root2c1c1))) (is (= 3 (:line root2c1c1))) (is (= 16 (:col root2c1c1)))
    (is (= "call" (:name root2c2))) (is (= 4 (:line root2c2))) (is (= 4 (:col root2c2)))
    (is (= :list (:kind root2c3))) (is (= 4 (:line root2c3))) (is (= 10 (:col root2c3)))
    (is (= "f" (:name root2c3c0))) (is (= 4 (:line root2c3c0))) (is (= 11 (:col root2c3c0)))
    (is (= "g" (:name root2c3c1))) (is (= 4 (:line root2c3c1))) (is (= 13 (:col root2c3c1)))

    (is (= :string (:kind root3))) (is (= "text" (:value root3))) (is (= 5 (:line root3))) (is (= 3 (:col root3)))))

(deftest ast-source-round-trips-empty-collections
  (let [source (ast-file-to-source "examples/compiler_tokenizer/ast_empty_forms.txt")]
    (is (= "()\n[]\n{}" source))))

(deftest ast-source-round-trips-nested-collections
  (let [source (ast-file-to-source "examples/compiler_tokenizer/ast_nested_forms.txt")]
    (is (= "(outer [inner {:key value}] {:pair [left right] :call (f g)} \"text\")" source))))

(deftest ast-source-preserves-multiline-triple-quoted-strings
  (let [source (ast-file-to-source "examples/compiler_tokenizer/multiline_string.txt")]
    (is (= "(println \"hello\\nworld\")" source))))

(deftest expand-file-accumulates-defmacros-and-repeatedly-expands-calls
  (let [exprs (expand-file-to-array "examples/compiler_tokenizer/macro_sample.txt")]
    (is (= 2 (count exprs)))
    (let [e0 (nth-token exprs 0)
          e1 (nth-token exprs 1)
          e1c0 (nth-token (:elements e1) 0)
          e1c1 (nth-token (:elements e1) 1)
          e1c2 (nth-token (:elements e1) 2)
          e1c3 (nth-token (:elements e1) 3)]
      (is (= :symbol (:kind e0)))
      (is (= "foo" (:name e0)))

      (is (= :list (:kind e1)))
      (is (= 4 (count (:elements e1))))
      (is (= :symbol (:kind e1c0))) (is (= "list" (:name e1c0)))
      (is (= :symbol (:kind e1c1))) (is (= "a" (:name e1c1)))
      (is (= :symbol (:kind e1c2))) (is (= "b" (:name e1c2)))
      (is (= :symbol (:kind e1c3))) (is (= "c" (:name e1c3))))))

(deftest expand-file-expands-macros-recursively-inside-vectors-and-maps
  (let [exprs (expand-file-to-array "examples/compiler_tokenizer/macro_nested.txt")
        e0 (nth-token exprs 0)
        e0c0 (nth-child e0 0)
        e0c1 (nth-child e0 1)
        e0c1c0 (nth-child e0c1 0)
        e0c1c1 (nth-child e0c1 1)
        e1 (nth-token exprs 1)
        e1c0 (nth-child e1 0)
        e1c1 (nth-child e1 1)
        e1c2 (nth-child e1 2)
        e1c3 (nth-child e1 3)
        e1c4 (nth-child e1 4)
        e1c5 (nth-child e1 5)
        e1c5c0 (nth-child e1c5 0)
        e1c5c1 (nth-child e1c5 1)]
    (is (= 2 (count exprs)))
    (is (= :vector (:kind e0)))
    (is (= :symbol (:kind e0c0))) (is (= "foo" (:name e0c0)))
    (is (= :map (:kind e0c1)))
    (is (= "value" (:name e0c1c0)))
    (is (= "bar" (:name e0c1c1)))

    (is (= :map (:kind e1)))
    (is (= "left" (:name e1c0))) (is (= "baz" (:name e1c1)))
    (is (= "right" (:name e1c2))) (is (= "qux" (:name e1c3)))
    (is (= "items" (:name e1c4)))
    (is (= :vector (:kind e1c5)))
    (is (= "a" (:name e1c5c0)))
    (is (= "b" (:name e1c5c1)))))

(deftest expand-file-registers-macros-generated-by-other-macros
  (let [exprs (expand-file-to-array "examples/compiler_tokenizer/macro_generated.txt")
        e0 (nth-token exprs 0)]
    (is (= 1 (count exprs)))
    (is (= :symbol (:kind e0)))
    (is (= "value" (:name e0)))))

(deftest expand-file-splices-rest-args-for-empty-and-nonempty-calls
  (let [exprs (expand-file-to-array "examples/compiler_tokenizer/macro_rest.txt")
        e0 (nth-token exprs 0)
        e1 (nth-token exprs 1)
        e1c0 (nth-child e1 0)
        e1c1 (nth-child e1 1)
        e1c2 (nth-child e1 2)]
    (is (= 2 (count exprs)))
    (is (= :vector (:kind e0)))
    (is (= 0 (count (:elements e0))))
    (is (= :vector (:kind e1)))
    (is (= 3 (count (:elements e1))))
    (is (= "a" (:name e1c0)))
    (is (= "b" (:name e1c1)))
    (is (= "c" (:name e1c2)))))

(deftest ast-node-source-emits-empty-collections-directly
  (let [exprs (build-ast-file-to-array "examples/compiler_tokenizer/ast_empty_forms.txt")]
    (is (= "()" (ast-node-to-source (nth-token exprs 0))))
    (is (= "[]" (ast-node-to-source (nth-token exprs 1))))
    (is (= "{}" (ast-node-to-source (nth-token exprs 2))))))

(deftest codegen-compiles-square-expression-to-go
  (let [exprs (compile-file-to-go-exprs "examples/compiler_tokenizer/square_expr.txt")]
    (is (= 1 (count exprs)))
    (is (= "(x * x)" (nth-token exprs 0)))))

(deftest build-ast-from-tokens-types-quotes-sets-and-pipes
  (let [exprs (build-ast-source-to-array "(println 'abc :xyz 5/6 10N 1.5 \\M #{1 2} #(* % 3) | 1 2 |)")
        call (nth-token exprs 0)
        quoted (nth-child call 1)
        kw (nth-child call 2)
        ratio (nth-child call 3)
        bigint (nth-child call 4)
        fl (nth-child call 5)
        ch (nth-child call 6)
        set-expr (nth-child call 7)
        hash-fn (nth-child call 8)
        pipe (nth-child call 9)]
    (is (= 1 (count exprs)))
    (is (= :quoted-symbol (:kind quoted))) (is (= "abc" (:name quoted)))
    (is (= :keyword (:kind kw))) (is (= "xyz" (:name kw)))
    (is (= :ratio (:kind ratio))) (is (= 5 (:numerator ratio))) (is (= 6 (:denominator ratio)))
    (is (= :bigint (:kind bigint))) (is (= "10" (:value bigint)))
    (is (= :float (:kind fl))) (is (= "1.5" (:raw fl)))
    (is (= :char (:kind ch))) (is (= "M" (:value ch)))
    (is (= :set (:kind set-expr))) (is (= 2 (count (:elements set-expr))))
    (is (= :hash-fn (:kind hash-fn))) (is (= :list (:kind (:body hash-fn))))
    (is (= :pipe-vector (:kind pipe))) (is (= 2 (count (:elements pipe))))))

(deftest build-ast-from-tokens-skips-comment-forms
  (let [exprs (build-ast-source-to-array "(println 1)\n(comment skipped)\n(println 2)")]
    (is (= 2 (count exprs)))
    (is (= "println" (:name (nth-child (nth-token exprs 0) 0))))
    (is (= "println" (:name (nth-child (nth-token exprs 1) 0))))))

(deftest build-ast-from-tokens-metadata-and-quoted-list
  (let [exprs (build-ast-source-to-array "^long value\n'(1 2 3)")
        meta (nth-token exprs 0)
        quoted (nth-token exprs 1)]
    (is (= 2 (count exprs)))
    (is (= :meta (:kind meta)))
    (is (= "long" (:name (:meta meta))))
    (is (= "value" (:name (:target meta))))
    (is (= :quoted-list (:kind quoted)))
    (is (= 3 (count (:elements quoted))))))

(deftest ir-renders-atoms-and-calls
  (is (= "x" (ir/render-ir (ir/ir-ident "x"))))
  (is (= "\"hi\"" (ir/render-ir (ir/ir-string "hi"))))
  (is (= "\"a\\\"b\"" (ir/render-ir (ir/ir-string "a\"b"))))
  (is (= "42" (ir/render-ir (ir/ir-int 42))))
  (is (= "-7" (ir/render-ir (ir/ir-int -7))))
  (is (= "flagrt.NewLong" (ir/render-ir (ir/ir-selector "flagrt" "NewLong"))))
  (is (= "println" (ir/render-ir (ir/ir-selector "" "println"))))
  (is (= "flagrt.NilValue()" (ir/render-ir (ir/rt-call "NilValue" []))))
  (is (= "flagrt.NewLong(42)" (ir/render-ir (ir/rt-call "NewLong" [(ir/ir-int 42)]))))
  (is (= "flagrt.NewBool(true)" (ir/render-ir (ir/rt-call "NewBool" [(ir/ir-raw "true")]))))
  (is (= "flagrt.NewString(\"hi\")" (ir/render-ir (ir/rt-call "NewString" [(ir/ir-string "hi")]))))
  (is (= "flagrt.NewRatio(5, 6)" (ir/render-ir (ir/rt-call "NewRatio" [(ir/ir-int 5) (ir/ir-int 6)]))))
  (is (= "1e2" (ir/render-ir (ir/ir-raw "1e2"))))
  (is (= "flagrt.NewDouble(1e2)" (ir/render-ir (ir/rt-call "NewDouble" [(ir/ir-raw "1e2")]))))
  (is (= "flagrt.Add(flagrt.Add(a, b), c)"
         (ir/render-ir (ir/ir-call (ir/parse-go-fun "flagrt.Add")
                                  [(ir/rt-call "Add" [(ir/ir-ident "a") (ir/ir-ident "b")])
                                   (ir/ir-ident "c")]))))
  (is (= "flagrt.Call(f, x)" (ir/render-ir (ir/rt-call "Call" [(ir/ir-ident "f") (ir/ir-ident "x")]))))
  (is (= "flagFoo_1(x)" (ir/render-ir (ir/ident-call "flagFoo_1" [(ir/ir-ident "x")]))))
  (is (= "flagrt.NewBool(flagrt.IsEmpty(xs))"
         (ir/render-ir (ir/rt-call "NewBool" [(ir/rt-call "IsEmpty" [(ir/ir-ident "xs")])]))))
  (is (= "flagrt.NewLong(int64(flagrt.Count(xs)))"
         (ir/render-ir (ir/rt-call "NewLong" [(ir/ident-call "int64" [(ir/rt-call "Count" [(ir/ir-ident "xs")])])]))))
  (is (= "strings.HasSuffix(s, \".go\")"
         (ir/render-ir (ir/selector-call "strings" "HasSuffix" [(ir/ir-ident "s") (ir/ir-string ".go")]))))
  (is (= "flagrt.NewArray(flagrt.NewLong(1), flagrt.NewLong(2))"
         (ir/render-ir (ir/rt-call "NewArray" [(ir/rt-call "NewLong" [(ir/ir-int 1)])
                                              (ir/rt-call "NewLong" [(ir/ir-int 2)])]))))
  (is (= "flagrt.NewMap(flagrt.NewKeyword(\"a\"), flagrt.NewLong(1))"
         (ir/render-ir (ir/rt-call "NewMap" [(ir/rt-call "NewKeyword" [(ir/ir-string "a")])
                                            (ir/rt-call "NewLong" [(ir/ir-int 1)])])))))

(deftest ir-renders-index-slice-spread-ops
  (is (= "args[0]" (ir/render-ir (ir/ir-index (ir/ir-ident "args") (ir/ir-int 0)))))
  (is (= "args[2:]" (ir/render-ir (ir/ir-slice (ir/ir-ident "args") (ir/ir-int 2) nil))))
  (is (= "flagrt.NewArray(args[1:]...)"
         (ir/render-ir (ir/rt-call "NewArray" [(ir/ir-spread (ir/ir-slice (ir/ir-ident "args") (ir/ir-int 1) nil))]))))
  (is (= "!(flagrt.IsTruthy(x))"
         (ir/render-ir (ir/ir-unary "!" (ir/rt-call "IsTruthy" [(ir/ir-ident "x")])))))
  (is (= "len(args) != 1"
         (ir/render-ir (ir/ir-binary "!=" (ir/ident-call "len" [(ir/ir-ident "args")]) (ir/ir-int 1))))))

(deftest ir-renders-func-lits-and-statements
  (is (= "func() bool {\n\tif ok {\n\t\treturn true\n\t}\n\treturn false\n}()"
         (ir/render-ir (ir/iife "bool"
                               [(ir/ir-if (ir/ir-ident "ok")
                                          [(ir/ir-return (ir/ir-raw "true"))]
                                          [])
                                (ir/ir-return (ir/ir-raw "false"))]))))
  (is (= "func() flagrt.Value {\n\t_ = a\n\treturn b\n}()"
         (ir/render-ir (ir/value-iife [(ir/ir-expr-stmt (ir/ir-ident "a") true)
                                      (ir/ir-return (ir/ir-ident "b"))]))))
  (is (= "\tvar x flagrt.Value\n\tdefer flagrt.Call(f)\n\tx = y\n\treturn x\n"
         (ir/render-ir-stmts [(ir/ir-var "x" "flagrt.Value" nil)
                             (ir/ir-defer (ir/rt-call "Call" [(ir/ir-ident "f")]))
                             (ir/ir-assign "x" (ir/ir-ident "y"))
                             (ir/ir-return (ir/ir-ident "x"))]
                            "\t")))
  (is (= "func(args ...flagrt.Value) flagrt.Value {\n\tx := args[0]\n\treturn x\n}"
         (ir/render-ir (ir/ir-func-lit "args ...flagrt.Value" "flagrt.Value"
                                      [(ir/ir-define ["x"] (ir/ir-index (ir/ir-ident "args") (ir/ir-int 0)))
                                       (ir/ir-return (ir/ir-ident "x"))]))))
  (is (= "\tif err := open(); err != nil {\n\t\treturn\n\t} else {\n\t\tuse()\n\t}\n"
         (ir/render-ir-stmt (ir/ir-if-init "err := open()"
                                          (ir/ir-ident "err != nil")
                                          [(ir/ir-return nil)]
                                          [(ir/ir-expr-stmt (ir/ident-call "use" []) false)])
                           "\t")))
  (is (= "\tfor {\n\t\tbreak\n\t}\n"
         (ir/render-ir-stmt (ir/ir-for [(ir/ir-raw-stmt "\t\tbreak\n")]) "\t")))
  (is (= "\t{\n\t\tvar x = y\n\t}\n"
         (ir/render-ir-stmt (ir/ir-block [(ir/ir-var "x" "" (ir/ir-ident "y"))]) "\t")))
  (is (= "func foo_arity_1(x flagrt.Value) flagrt.Value {\n\treturn x\n}\n"
         (ir/render-ir-stmt (ir/ir-func-decl "foo_arity_1" "x flagrt.Value" "flagrt.Value"
                                            [(ir/ir-return (ir/ir-ident "x"))]) ""))))

(deftest ir-parse-go-fun
  (let [sel (ir/parse-go-fun "flagrt.Add")
        ident (ir/parse-go-fun "flagFoo_1")
        dotted (ir/parse-go-fun "a.b.c")]
    (is (= :selector (:kind sel)))
    (is (= "flagrt" (:pkg sel)))
    (is (= "Add" (:name sel)))
    (is (= :ident (:kind ident)))
    (is (= "flagFoo_1" (:name ident)))
    (is (= :ident (:kind dotted)))
    (is (= "a.b.c" (:name dotted)))))

(deftest lower-literals-to-ir
  (is (= "\"hi\"" (ir/render-ir (lower/ast-node-to-ir {:kind :string :value "hi"}))))
  (is (= "flagrt.NewString(\"x\")" (ir/render-ir (lower/ast-node-to-ir {:kind :char :value "x"}))))
  (is (= "flagrt.NewLong(42)" (ir/render-ir (lower/ast-node-to-ir {:kind :int :value 42}))))
  (is (= "flagrt.NewLong(-7)" (ir/render-ir (lower/ast-node-to-ir {:kind :int :value -7}))))
  (is (= "flagrt.NewBigIntFromString(\"10\")"
         (ir/render-ir (lower/ast-node-to-ir {:kind :bigint :value "10"}))))
  (is (= "flagrt.NewRatio(5, 6)"
         (ir/render-ir (lower/ast-node-to-ir {:kind :ratio :numerator 5 :denominator 6}))))
  (is (= "flagrt.NewDouble(1.5)"
         (ir/render-ir (lower/ast-node-to-ir {:kind :float :value 1.5 :raw "1.5"}))))
  (is (= "flagrt.NewDouble(1e2)"
         (ir/render-ir (lower/ast-node-to-ir {:kind :float :value 100.0 :raw "1e2"}))))
  (is (= "flagrt.NewKeyword(\"xyz\")"
         (ir/render-ir (lower/ast-node-to-ir {:kind :keyword :name "xyz"}))))
  (is (= "flagrt.NewSymbol(\"abc\")"
         (ir/render-ir (lower/ast-node-to-ir {:kind :quoted-symbol :name "abc"}))))
  (is (= "flagrt.NewBool(true)"
         (ir/render-ir (lower/ast-node-to-ir {:kind :symbol :name "true"}))))
  (is (= "flagrt.NewBool(false)"
         (ir/render-ir (lower/ast-node-to-ir {:kind :symbol :name "false"}))))
  (is (= "flagrt.NilValue()"
         (ir/render-ir (lower/ast-node-to-ir {:kind :symbol :name "nil"})))))

(deftest lower-quoted-ast-to-ir
  (is (= "flagrt.NewList(flagrt.NewLong(1), flagrt.NewKeyword(\"a\"))"
         (ir/render-ir (lower/quoted-ast-to-ir
                         {:kind :quoted-list
                          :elements [{:kind :int :value 1}
                                     {:kind :keyword :name "a"}]}))))
  (is (= "flagrt.NewList()"
         (ir/render-ir (lower/quoted-ast-to-ir {:kind :quoted-list :elements []}))))
  (is (= "flagrt.NewList(flagrt.NewSymbol(\"true\"))"
         (ir/render-ir (lower/quoted-ast-to-ir
                         {:kind :quoted-list
                          :elements [{:kind :symbol :name "true"}]}))))
  (is (= "flagrt.NewArray(flagrt.NewList(flagrt.NewSymbol(\"x\")))"
         (ir/render-ir (lower/quoted-ast-to-ir
                         {:kind :vector
                          :elements [{:kind :quoted-list
                                      :elements [{:kind :symbol :name "x"}]}]}))))
  (is (= "flagrt.NewVector(flagrt.NewLong(1))"
         (ir/render-ir (lower/quoted-ast-to-ir
                         {:kind :pipe-vector
                          :elements [{:kind :int :value 1}]}))))
  (is (= "flagrt.NewSet(flagrt.NewKeyword(\"a\"))"
         (ir/render-ir (lower/quoted-ast-to-ir
                         {:kind :set
                          :elements [{:kind :keyword :name "a"}]}))))
  (is (= "flagrt.NewMap(flagrt.NewKeyword(\"a\"), flagrt.NewLong(1))"
         (ir/render-ir (lower/quoted-ast-to-ir
                         {:kind :map
                          :entries [{:kind :keyword :name "a"}
                                    {:kind :int :value 1}]})))))

(deftest lower-call-ast-to-ir
  (is (= "flagrt.Call(flagrt.NewKeyword(\"a\"), flagrt.NewLong(1))"
         (ir/render-ir (lower/call-ast-to-ir
                         {:kind :list
                          :elements [{:kind :keyword :name "a"}
                                     {:kind :int :value 1}]}))))
  (is (= "flagrt.Call(flagrt.NewKeyword(\"a\"))"
         (ir/render-ir (lower/call-ast-to-ir
                         {:kind :list
                          :elements [{:kind :keyword :name "a"}]}))))
  (is (= "flagrt.Call(f, flagrt.NewLong(1))"
         (ir/render-ir (lower/call-to-ir
                         (ir/ir-ident "f")
                         [(ir/ir-call (ir/ir-selector "flagrt" "NewLong") [(ir/ir-int 1)])]))))
  (is (= "flagrt.Call(flagrt.NewKeyword(\"a\"), flagrt.Call(flagrt.NewKeyword(\"b\"), flagrt.NewLong(1)))"
         (ir/render-ir (lower/call-ast-to-ir
                         {:kind :list
                          :elements [{:kind :keyword :name "a"}
                                     {:kind :list
                                      :elements [{:kind :keyword :name "b"}
                                                 {:kind :int :value 1}]}]}))))
  (is (= "flagrt.Call(flagrt.NewKeyword(\"a\"), flagrt.NewArray(flagrt.NewLong(1)))"
         (ir/render-ir (lower/call-ast-to-ir
                         {:kind :list
                          :elements [{:kind :keyword :name "a"}
                                     {:kind :vector
                                      :elements [{:kind :int :value 1}]}]}))))
  (is (= "flagrt.Call(flagrt.NewKeyword(\"a\"), flagrt.NewList(flagrt.NewLong(1)))"
         (ir/render-ir (lower/call-ast-to-ir
                         {:kind :list
                          :elements [{:kind :keyword :name "a"}
                                     {:kind :quoted-list
                                      :elements [{:kind :int :value 1}]}]}))))
  (is (= "flagrt.Call(flagrt.NewKeyword(\"a\"), flagrt.NewBool(true))"
         (ir/render-ir (lower/call-ast-to-ir
                         {:kind :list
                          :elements [{:kind :keyword :name "a"}
                                     {:kind :symbol :name "true"}]})))))

(deftest lower-eq-to-ir
  (is (= "flagrt.Eq(flagrt.NewLong(1), flagrt.NewLong(2))"
         (ir/render-ir (lower/eq-to-ir [(ir/rt-call "NewLong" [(ir/ir-int 1)])
                                        (ir/rt-call "NewLong" [(ir/ir-int 2)])]))))
  (is (= "flagrt.Eq(a, b) && flagrt.Eq(b, c)"
         (ir/render-ir (lower/eq-to-ir [(ir/ir-ident "a") (ir/ir-ident "b") (ir/ir-ident "c")]))))
  (is (= "flagrt.Eq(a, b) && flagrt.Eq(b, c) && flagrt.Eq(c, d)"
         (ir/render-ir (lower/eq-to-ir [(ir/ir-ident "a") (ir/ir-ident "b") (ir/ir-ident "c") (ir/ir-ident "d")]))))
  (let [out (lower/compile-form-to-ir
              {:kind :list
               :elements [{:kind :symbol :name "="}
                          {:kind :int :value 1}
                          {:kind :string :value "x"}]}
              {})]
    (is (= :bool (:expr-kind out)))
    (is (= "flagrt.Eq(flagrt.NewLong(1), flagrt.NewString(\"x\"))"
           (ir/render-ir (:expr out)))))
  (let [out (lower/compile-form-to-ir
              {:kind :list
               :elements [{:kind :symbol :name "="}
                          {:kind :symbol :name "a"}
                          {:kind :symbol :name "b"}
                          {:kind :symbol :name "c"}]}
              {:locals {"a" :value "b" :value "c" :value}})]
    (is (= "flagrt.Eq(a, b) && flagrt.Eq(b, c)"
           (ir/render-ir (:expr out)))))
  (let [out (lower/compile-form-to-ir
              {:kind :list
               :elements [{:kind :symbol :name "countdown"}
                          {:kind :list
                           :elements [{:kind :symbol :name "-"}
                                      {:kind :symbol :name "n"}
                                      {:kind :int :value 1}]}]}
              {:locals {"n" :value}
               :self-function-name "countdown"
               :self-variadic-name "countdown_variadic"
               :self-arity-name "countdown_variadic"
               :self-function-rest true
               :self-function-arity 1})]
    (is (= "countdown_variadic(flagrt.Sub(n, flagrt.NewLong(1)))"
           (ir/render-ir (:expr out))))))

(deftest lower-if-uses-native-bool
  (let [out (lower/compile-form-to-ir
              {:kind :list
               :elements [{:kind :symbol :name "if"}
                          {:kind :list
                           :elements [{:kind :symbol :name "="}
                                      {:kind :symbol :name "tmp"}
                                      {:kind :symbol :name "nil"}]}
                          {:kind :int :value 1}
                          {:kind :int :value 2}]}
              {:locals {"tmp" :value}})
        src (ir/render-ir-stmts (:stmts out) "")]
    (is (nil? (str/index-of src "IsTruthy")))
    (is (nil? (str/index-of src "NewBool")))
    (is (not (nil? (str/index-of src "if flagrt.Eq(tmp, flagrt.NilValue())"))))))

(deftest lower-known-call-fun
  (is (nil? (lower/known-call-fun "f" 1 {:locals {"f" :value}})))
  (is (= {:kind :ident :name "foo_variadic"}
         (lower/known-call-fun "foo" 1 {:functions {"foo" true}})))
  (is (= {:kind :raw :code "flagrt.GoBind_packages_StringReplace.FunctionObject().Fn"}
         (lower/known-call-fun "str/replace" 3
                               {:go-fns {"str/replace" "GoBind_packages_StringReplace"}})))
  (is (= {:kind :ident :name "countdown_variadic"}
         (lower/known-call-fun "countdown" 1
                               {:self-function-name "countdown"
                                :self-function-rest true
                                :self-variadic-name "countdown_variadic"}))))

(deftest lower-known-calls-are-direct
  (let [fn-out (lower/compile-form-to-ir
                 {:kind :list
                  :elements [{:kind :symbol :name "foo"}
                             {:kind :int :value 1}]}
                 {:functions {"foo" true}})
        bind-out (lower/compile-form-to-ir
                   {:kind :list
                    :elements [{:kind :symbol :name "str/replace"}
                               {:kind :string :value "a"}
                               {:kind :string :value "a"}
                               {:kind :string :value "b"}]}
                   {:go-fns {"str/replace" "GoBind_packages_StringReplace"}})
        local-out (lower/compile-form-to-ir
                    {:kind :list
                     :elements [{:kind :symbol :name "f"}
                                {:kind :int :value 1}]}
                    {:locals {"f" :value}})]
    (is (= "foo_variadic(flagrt.NewLong(1))" (ir/render-ir (:expr fn-out))))
    (is (= "flagrt.GoBind_packages_StringReplace.FunctionObject().Fn(flagrt.NewString(\"a\"), flagrt.NewString(\"a\"), flagrt.NewString(\"b\"))"
           (ir/render-ir (:expr bind-out))))
    (is (= "flagrt.Call(f, flagrt.NewLong(1))" (ir/render-ir (:expr local-out))))))

(deftest lower-true-false-are-native-bool
  (let [t (lower/compile-form-to-ir {:kind :symbol :name "true"} {})
        f (lower/compile-form-to-ir {:kind :symbol :name "false"} {})]
    (is (= :bool (:expr-kind t)))
    (is (= :bool (:expr-kind f)))
    (is (= "true" (ir/render-ir (:expr t))))
    (is (= "false" (ir/render-ir (:expr f))))))

(deftest lower-eq-boxes-bool-args
  (let [out (lower/compile-form-to-ir
              {:kind :list
