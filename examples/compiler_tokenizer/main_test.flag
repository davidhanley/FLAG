                                        {:kind :symbol :name "demo"}]}
        threw (try
                (do (lower/compile-module-body [ns-form] ctx) false)
                (catch Throwable t true))]
    (is threw))
   (is (= "int64" (lower/type-hint-to-go-type "long")))
   (is (= "float64" (lower/type-hint-to-go-type "double")))
   (is (= "string" (lower/type-hint-to-go-type "string")))
   (is (= "bool" (lower/type-hint-to-go-type "bool")))
   (is (nil? (lower/type-hint-to-go-type "error")))
   (is (= "StartLine" (lower/exported-record-field-name "start-line")))
   (is (= "EOF" (lower/exported-record-field-name "eof")))
   (let [ctx {:locals {} :globals {} :functions {} :module {} :go-fns {}
             :self-function-name "" :self-variadic-name "" :self-arity-name ""
             :self-function-rest false :self-function-arity 0
             :self-arity-names {} :loop-binding-names [] :if-temps 0
             :namespace "compiler" :package-mode false :exported-names {}
             :allow-redefine false :allow-top-level true}
        printed (lower/compile-module-body
                  [{:kind :list :elements [{:kind :symbol :name "println"}
                                           {:kind :string :value "Hello"}]}]
                  ctx)
        print-form {:kind :list :elements [{:kind :symbol :name "print"}
                                           {:kind :int :value 42}]}
        printed2 (lower/compile-module-body [print-form] ctx)]
    (is (:needs-fmt printed))
    (is (= :call (:kind (:expr (first (:stmts printed))))))
    (is (= "Println" (:name (:fun (:expr (first (:stmts printed)))))))
    (is (:needs-fmt printed2))
    (is (= "Print" (:name (:fun (:expr (first (:stmts printed2))))))))
   (let [ctx {:locals {} :globals {} :functions {} :module {"square" "compiler__square"} :go-fns {}
             :self-function-name "" :self-variadic-name "" :self-arity-name ""
             :self-function-rest false :self-function-arity 0
             :self-arity-names {} :loop-binding-names [] :if-temps 0
             :namespace "compiler" :package-mode false :exported-names {}
             :allow-redefine false}
        form {:kind :list
              :elements [{:kind :symbol :name "go-interface"}
                         {:kind :symbol :name "square"}
                         {:kind :symbol :name "double"}
                         {:kind :vector :elements [{:kind :symbol :name "double"}]}]}
        out (lower/compile-module-body [form] ctx)
        fn0 (first (:functions out))]
    (is (= "square_go" (:go-name fn0)))
    (is (= "(p1 float64) float64" (:go-signature fn0)))
    (is (not (nil? (str/index-of (:body-source fn0) "flagrt.NewDouble(p1)"))))))

(deftest lower-form-loop-fn-and-map-bool
  (let [out (lower/compile-form-to-ir
             {:kind :list
              :elements [{:kind :symbol :name "loop"}
                         {:kind :vector
                          :elements [{:kind :symbol :name "i"}
                                     {:kind :int :value 0}]}
                         {:kind :list
                          :elements [{:kind :symbol :name "do"}
                                     {:kind :list
                                      :elements [{:kind :symbol :name "fn"}
                                                 {:kind :vector :elements []}
                                                 {:kind :symbol :name "i"}]}
                                     {:kind :list
                                      :elements [{:kind :symbol :name "recur"}
                                                 {:kind :list
                                                  :elements [{:kind :symbol :name "+"}
                                                             {:kind :symbol :name "i"}
                                                             {:kind :int :value 1}]}]}]}]}
             {})]
    (is (not (nil? (str/index-of (ir/render-ir (:expr out)) "flagrt.NewRecur")))))
  (let [threw (try
               (do (lower/compile-form-to-ir
                     {:kind :map
                      :entries [{:kind :keyword :name "a"}
                                {:kind :list
                                 :line 3
                                 :col 16
                                 :elements [{:kind :symbol :name "<"}
                                            {:kind :int :value 1}
                                            {:kind :int :value 2}]}]}
                     {})
                   false)
               (catch Throwable t
                 (ex-message t)))]
    (is (not (nil? (str/index-of threw "map literal entries must evaluate to Value at 3:"))))))

(deftest codegen-emits-ir-binary-for-square
  (let [exprs (lift-file-to-array "examples/compiler_tokenizer/square_expr.txt")
        node (codegen/emit-ir-expr (nth-token exprs 0))]
    (is (= :binary (:kind node)))
    (is (= "*" (:op node)))
    (is (= "x" (:name (:left node))))
    (is (= "x" (:name (:right node))))))

