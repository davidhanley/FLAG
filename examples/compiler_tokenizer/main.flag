{:namespace "compiler-tokenizer"
 :imports [["compiler/tokenizer.lib" :as "tokenizer"]
           ["compiler/build-ast.lib" :as "ast"]
           ["compiler/parser.lib" :as "parser"]
           ["compiler/lift.lib" :as "lift"]
           ["compiler/codegen.lib" :as "codegen"]
           ["compiler/ast-source.lib" :as "ast-source"]
           ["async.lib" :refer [channel-receive]]]}

(defn drain-tokens-into
  [ch acc]
  (let [token (channel-receive ch)]
    (if (nil? token)
      acc
      (drain-tokens-into ch (conj acc token)))))

(defn drain-tokens
  [ch]
  (drain-tokens-into ch []))

(defn tokenize-file-to-array
  [path]
  (drain-tokens (tokenizer/tokenize-file path)))

(defn parse-file-to-array
  [path]
  (drain-tokens (parser/parse-file path)))

(defn build-ast-file-to-array
  [path]
  (drain-tokens (->> (tokenizer/tokenize-file path)
                     (ast/build-ast-from-tokens))))

(defn expand-file-to-array
  [path]
  (drain-tokens (parser/parse-file path)))

(defn lift-file-to-array
  [path]
  (drain-tokens (lift/lift-file path)))

(defn compile-file-to-go-exprs
  [path]
  (drain-tokens (codegen/compile-file path)))

(defn ast-file-to-source
  [path]
  (ast-source/asts->source (build-ast-file-to-array path)))

(defn ast-node-to-source
  [node]
  (ast-source/ast->source node))

(defn nth-token
  [tokens n]
  (first (drop n tokens)))

(defn nth-child
  [node n]
  (nth-token (:children node) n))
