{:namespace "compiler-tokenizer"
 :imports [["compiler/tokenizer.lib" :as "tokenizer"]
           ["compiler/build-ast.lib" :as "ast"]
           ["compiler/parser.lib" :as "parser"]
           ["compiler/expand-macros.lib" :as "expand-macros"]
           ["compiler/lift.lib" :as "lift"]
           ["compiler/codegen.lib" :as "codegen"]
           ["compiler/ast-source.lib" :as "ast-source"]
           ["async.lib" :refer [channel-receive]]]}

(defn drain-tokens-into
  [ch acc]
  (let [token (channel-receive ch)]
    (if (nil? token)
      acc
      (drain-tokens-into ch (conj acc token)))))

(defn drain-tokens
  [ch]
  (drain-tokens-into ch []))

(defn tokenize-file-to-array
  [path]
  (drain-tokens (tokenizer/tokenize-file path)))

(defn parse-file-to-array
  [path]
  (drain-tokens (parser/parse-file path)))

(defn build-ast-file-to-array
  [path]
  (drain-tokens (->> (tokenizer/tokenize-file path)
                     (ast/build-ast-from-tokens))))

(defn build-ast-source-to-array
  [source]
  (drain-tokens (->> (tokenizer/tokenize-source source)
                     (ast/build-ast-from-tokens))))

(defn expand-file-to-array
  [path]
  (drain-tokens (parser/parse-file path)))

(defn expand-source-to-array
  [source]
  (drain-tokens (->> (tokenizer/tokenize-source source)
                     (ast/build-ast-from-tokens)
                     (expand-macros/expand-macros))))

(defn expand-source
  [source]
  (ast-source/asts->source (expand-source-to-array source)))

(defn slurp-text
  [path]
  (loop [lines (file-to-strings path) acc nil]
    (if (empty? lines)
      (if (nil? acc) "" acc)
      (recur (rest lines)
             (let [line (str (first lines))]
               (if (nil? acc) line (str acc "\n" line)))))))

(defn expand-fixture
  [name]
  (expand-source (slurp-text (str "examples/compiler_tokenizer/macros/" name ".in"))))

(defn expected-fixture
  [name]
  (slurp-text (str "examples/compiler_tokenizer/macros/" name ".expected")))

(defn lift-file-to-array
  [path]
  (drain-tokens (lift/lift-file path)))

(defn compile-file-to-go-exprs
  [path]
  (drain-tokens (codegen/compile-file path)))

(defn ast-file-to-source
  [path]
  (ast-source/asts->source (build-ast-file-to-array path)))

(defn ast-node-to-source
  [node]
  (ast-source/ast->source node))

(defn nth-token
  [tokens n]
  (first (drop n tokens)))

(defn node-children
  [node]
  (if (= :map (:kind node))
    (:entries node)
    (:elements node)))

(defn nth-child
  [node n]
  (nth-token (node-children node) n))
