{:namespace "compiler-tokenizer"
 :imports [["compiler/tokenizer.lib" :as "tokenizer"]
           ["compiler/parser.lib" :as "parser"]
           ["compiler/expand-macros.lib" :as "macro-expand"]
           ["async.lib" :refer [channel-receive]]]}

(defn drain-tokens-into
  [ch acc]
  (let [token (channel-receive ch)]
    (if (nil? token)
      acc
      (drain-tokens-into ch (conj acc token)))))

(defn drain-tokens
  [ch]
  (drain-tokens-into ch []))

(defn tokenize-file-to-array
  [path]
  (drain-tokens (tokenizer/tokenize-file path)))

(defn parse-file-to-array
  [path]
  (drain-tokens (parser/parse-file path)))

(defn expand-file-to-array
  [path]
  (drain-tokens (macro-expand/expand-file path)))

(defn nth-token
  [tokens n]
  (first (drop n tokens)))
