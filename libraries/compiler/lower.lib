{:namespace "compiler"
 :exports   [ast-node-to-ir quoted-ast-to-ir call-to-ir call-ast-to-ir
             ctor-to-ir runtime-call-to-ir fold-call-to-ir eq-to-ir
             nil-pred-to-ir empty-pred-to-ir count-to-ir
             str-to-ir ex-info-to-ir assoc-to-ir conj-to-ir
             seq-to-ir drop-to-ir take-to-ir cons-to-ir get-to-ir nth-to-ir
             not-empty-to-ir type-of-to-ir vec-to-ir dissoc-to-ir contains-pred-to-ir
             into-to-ir concat-to-ir
             ex-message-to-ir ex-data-to-ir ex-cause-to-ir println-to-ir
             compare-to-ir numeric-eq-to-ir comparison-to-ir
             symbol-ctor-to-ir name-to-ir keyword-ctor-to-ir format-to-ir
             map-to-ir sort-by-to-ir apply-to-ir pmap-to-ir filter-to-ir
             reduce-to-ir doall-to-ir some-to-ir set-to-ir
             line-seq-to-ir repeat-to-ir rand-int-to-ir
             to-json-to-ir from-json-to-ir
             open-file-to-ir file-to-strings-to-ir file-to-strings-path-to-ir
             go-fn-to-ir go-fn-args-to-ir
             symbol-to-ir eval-ast-to-ir if-to-ir let-to-ir
             do-prelude-stmts do-defer-to-ir loop-to-ir recur-to-ir
             defer-to-ir throw-to-ir future-to-ir
             doto-to-ir update-bang-to-ir catch-handler-to-ir try-to-ir
             doseq-to-ir doseq-body-to-ir mapcat-binding-to-ir
             fn-to-ir ns-to-ir def-to-ir defn-binding-to-ir
             defn-to-ir defn-multi-to-ir
             write-to-ir ends-with-to-ir testing-to-ir is-to-ir
             expect-exception-to-ir ast-form-source hash-fn-placeholder-index
             map-destructure-key-ir
             go-ident bind-params-to-ir compile-form-to-ir compile-forms-to-ir
             form-defer-result forms-have-defer? list-head-name catch-type-name
             parse-catch-clause split-try-args
             sanitize-keyword-ident intern-ir intern-decls intern-form-ir
             render-ir render-ir-stmt render-ir-stmts render-function-def
             render-direct-param-types render-direct-function-type
             render-direct-function-literal render-variadic-function-literal
             render-multi-arity-variadic-literal render-function-literal
             format-go-source abs-path cwd-path path-join path-dir path-ext
             path-abs? path-stat-kind file-exists? dir-exists?
             write-text-file read-text-file mkdir-all go-mod-tidy
             file-first-line find-flag-lang-root
             write-compiled-packages write-program-packages
             library-search-roots resolve-import-path module-import-paths
             load-program prologue-path
             implicit-prologue-spec with-implicit-prologue-import program-prologue-path
             go-package-name validate-exports add-go-import seed-imports
             rename-defmacro
             emit-flagi seed-prologue-package-refs strip-inlined-prologue
             result-refs-package? compile-inline-modules compile-package-modules
             emitted-var-expr emitted-stmt-prelude emitted-stmt-code
             emit-go-file compile-program
             module-go-ident exported-go-ident def-go-ident bind-module-name
             prelude-go-name? can-rebind-module-name?
             type-hint-to-go-type exported-record-field-name
             truncate-hint const-form? str-contains?
             compile-module-body]}

(defn literal-rt-call [name args]
  {:kind :call
   :fun {:kind :selector :pkg "flagrt" :name name}
   :args args})

(defn ast-node-to-ir [node]
  (let [kind (:kind node)]
    (cond
      (= kind :string)
      {:kind :string :value (:value node)}

      (= kind :char)
      (literal-rt-call "NewString" [{:kind :string :value (:value node)}])

      (= kind :int)
      (literal-rt-call "NewLong" [{:kind :int :value (:value node)}])

      (= kind :bigint)
      (literal-rt-call "NewBigIntFromString" [{:kind :string :value (:value node)}])

      (= kind :ratio)
      (literal-rt-call "NewRatio" [{:kind :int :value (:numerator node)}
                                   {:kind :int :value (:denominator node)}])

      (= kind :float)
      (let [raw (:raw node)
            code (if (or (nil? raw) (= "" raw))
                   (format "%g" (:value node))
                   raw)]
        (literal-rt-call "NewDouble" [{:kind :raw :code code}]))

      (= kind :keyword)
      (literal-rt-call "NewKeyword" [{:kind :string :value (:name node)}])

      (= kind :quoted-symbol)
      (literal-rt-call "NewSymbol" [{:kind :string :value (:name node)}])

      (= kind :symbol)
      (let [name (:name node)]
        (cond
          (= name "true") (literal-rt-call "NewBool" [{:kind :raw :code "true"}])
          (= name "false") (literal-rt-call "NewBool" [{:kind :raw :code "false"}])
          (= name "nil") (literal-rt-call "NilValue" [])
          :else (throw (ex-info "unsupported symbol for literal lowering"
                                {:node node}))))

      :else (throw (ex-info "unsupported AST node for literal lowering"
                            {:node node})))))

(defn quoted-ast-to-ir-node [mode node]
  (cond
    (= mode :seq)
    (loop [remaining node out []]
      (if (or (nil? remaining) (empty? remaining))
        out
        (recur (rest remaining)
               (conj out (quoted-ast-to-ir-node :node (first remaining))))))

    (= mode :node)
    (let [kind (:kind node)]
      (cond
        (= kind :int) (ast-node-to-ir node)
        (= kind :bigint) (ast-node-to-ir node)
        (= kind :ratio) (ast-node-to-ir node)
        (= kind :float) (ast-node-to-ir node)
        (= kind :keyword) (ast-node-to-ir node)
        (= kind :quoted-symbol) (ast-node-to-ir node)

        (= kind :symbol)
        (literal-rt-call "NewSymbol" [{:kind :string :value (:name node)}])

        (= kind :quoted-list)
        (literal-rt-call "NewList" (quoted-ast-to-ir-node :seq (:elements node)))

        (= kind :list)
        (literal-rt-call "NewList" (quoted-ast-to-ir-node :seq (:elements node)))

        (= kind :vector)
        (literal-rt-call "NewArray" (quoted-ast-to-ir-node :seq (:elements node)))

        (= kind :pipe-vector)
        (literal-rt-call "NewVector" (quoted-ast-to-ir-node :seq (:elements node)))

        (= kind :map)
        (let [entries (:entries node)
              n (if (nil? entries) 0 (count entries))]
          (if (not (= 0 (% n 2)))
            (throw (ex-info "quoted map literal expects an even number of forms"
                            {:node node}))
            (literal-rt-call "NewMap" (quoted-ast-to-ir-node :seq entries))))

        (= kind :set)
        (literal-rt-call "NewSet" (quoted-ast-to-ir-node :seq (:elements node)))

        :else
        (throw (ex-info "unsupported quoted literal" {:node node}))))

    :else (throw (ex-info "unsupported quoted lowering mode" {:mode mode}))))

(defn quoted-ast-to-ir [node]
  (quoted-ast-to-ir-node :node node))

(def special-form-names
  #{"+" "*" "-" "/" "%" "mod" "quot" "rem" "compare" "==" "=" "<" "<=" ">" ">="
    "max" "min"
    "bit-and" "bit-or" "bit-xor" "bit-not" "bit-shift-left" "bit-shift-right"
    "unsigned-bit-shift-right" "bit-test" "bit-set" "bit-clear" "bit-flip"
    "str" "println" "testing" "ex-info" "ex-message" "ex-data" "ex-cause"
    "throw" "try" "catch" "finally" "is" "expect-exception"
    "if" "do" "doto" "for" "doseq" "let" "loop" "recur" "defer" "update!"
    "symbol" "name" "keyword" "first" "fist" "rest" "next" "last"
    "reverse" "cons" "take" "drop" "not-empty" "seq" "empty?" "nil?" "type-of"
    "count" "double" "into" "format" "hash-map" "list" "array" "map" "concat"
    "sort-by" "apply" "pmap" "filter" "reduce" "doall" "some" "seq?" "set"
    "vec" "conj" "contains?" "line-seq" "repeat" "rand-int" "assoc" "dissoc"
    "to-json" "from-json" "open-file" "file-to-strings" "go-fn" "go-fn-args"
    "fn"})

(defn call-to-ir [callee args]
  (loop [remaining args out [callee]]
    (if (or (nil? remaining) (empty? remaining))
      (literal-rt-call "Call" out)
      (recur (rest remaining) (conj out (first remaining))))))

(defn call-ast-to-ir-node [mode node]
  (cond
    (= mode :seq)
    (loop [remaining node out []]
      (if (or (nil? remaining) (empty? remaining))
        out
        (recur (rest remaining)
               (conj out (call-ast-to-ir-node :eval (first remaining))))))

    (= mode :eval)
    (let [kind (:kind node)]
      (cond
        (= kind :string) (ast-node-to-ir node)
        (= kind :char) (ast-node-to-ir node)
        (= kind :int) (ast-node-to-ir node)
        (= kind :bigint) (ast-node-to-ir node)
        (= kind :ratio) (ast-node-to-ir node)
        (= kind :float) (ast-node-to-ir node)
        (= kind :keyword) (ast-node-to-ir node)
        (= kind :quoted-symbol) (ast-node-to-ir node)

        (= kind :symbol)
        (let [name (:name node)]
          (if (or (= name "true") (= name "false") (= name "nil"))
            (ast-node-to-ir node)
            (throw (ex-info "unresolved symbol for call lowering"
                            {:node node}))))

        (= kind :quoted-list) (quoted-ast-to-ir node)
        (= kind :vector) (quoted-ast-to-ir node)
        (= kind :pipe-vector) (quoted-ast-to-ir node)
        (= kind :map) (quoted-ast-to-ir node)
        (= kind :set) (quoted-ast-to-ir node)

        (= kind :list) (call-ast-to-ir-node :call node)

        :else (throw (ex-info "unsupported AST node for call lowering"
                              {:node node}))))

    (= mode :call)
    (let [elements (:elements node)]
      (if (or (nil? elements) (empty? elements))
        (throw (ex-info "unsupported form" {:node node}))
        (let [head (first elements)]
          (if (and (= :symbol (:kind head))
                   (contains? special-form-names (:name head)))
            (throw (ex-info "special form not handled by call lowering"
                            {:node node}))
            (call-to-ir (call-ast-to-ir-node :eval head)
                        (call-ast-to-ir-node :seq (rest elements)))))))

    :else (throw (ex-info "unsupported call lowering mode" {:mode mode}))))

(defn call-ast-to-ir [node]
  (call-ast-to-ir-node :call node))

(defn ctor-to-ir [name args]
  (literal-rt-call name args))

(defn runtime-call-to-ir [name args]
  (literal-rt-call name args))

(defn fold-call-to-ir [name args]
  (if (or (nil? args) (empty? args) (empty? (rest args)))
    (throw (ex-info "fold expects at least two arguments" {:name name}))
    (loop [acc (first args) remaining (rest args)]
      (if (or (nil? remaining) (empty? remaining))
        acc
        (recur (literal-rt-call name [acc (first remaining)])
               (rest remaining))))))

(defn eq-to-ir [args]
  (if (or (nil? args) (empty? args) (empty? (rest args)))
    (throw (ex-info "= expects at least two arguments" {}))
    (loop [acc (literal-rt-call "Eq" [(first args) (first (rest args))])
           prev (first (rest args))
           remaining (rest (rest args))]
      (if (or (nil? remaining) (empty? remaining))
        acc
        (recur {:kind :binary
                :op "&&"
                :left acc
                :right (literal-rt-call "Eq" [prev (first remaining)])}
               (first remaining)
               (rest remaining))))))

(defn nil-pred-to-ir [arg]
  (literal-rt-call "IsNil" [arg]))

(defn empty-pred-to-ir [arg]
  (literal-rt-call "IsEmpty" [arg]))

(defn count-to-ir [arg]
  (literal-rt-call "NewLong"
                   [{:kind :call
                     :fun {:kind :ident :name "int64"}
                     :args [(literal-rt-call "Count" [arg])]}]))

(defn str-to-ir [args]
  (literal-rt-call "Str" (if (or (nil? args) (empty? args)) [] args)))

(defn keyword-ir [name]
  (literal-rt-call "NewKeyword" [{:kind :string :value name}]))

(defn ex-info-to-ir [msg data cause]
  (let [base [(keyword-ir "message") (literal-rt-call "NewString" [msg])
              (keyword-ir "data") data]]
    (ctor-to-ir "NewMap"
                (if (nil? cause)
                  base
                  (conj (conj base (keyword-ir "cause")) cause)))))

(defn assoc-to-ir [args]
  (literal-rt-call "Assoc" (if (or (nil? args) (empty? args)) [] args)))

(defn conj-to-ir [args]
  (literal-rt-call "Conj" (if (or (nil? args) (empty? args)) [] args)))

(defn seq-to-ir [arg]
  (literal-rt-call "Seq" [arg]))

(defn drop-to-ir [args]
  (literal-rt-call "Drop" args))

(defn take-to-ir [args]
  (literal-rt-call "Take" args))

(defn cons-to-ir [args]
  (literal-rt-call "Cons" args))

(defn get-to-ir [args]
  (literal-rt-call "Get" args))

(defn nth-to-ir [args]
  (literal-rt-call "Nth" args))

(defn not-empty-to-ir [arg]
  (literal-rt-call "NotEmpty" [arg]))

(defn type-of-to-ir [arg]
  (literal-rt-call "TypeOf" [arg]))

(defn vec-to-ir [arg]
  (literal-rt-call "Vec" [arg]))

(defn dissoc-to-ir [args]
  (literal-rt-call "MapDissoc" (if (or (nil? args) (empty? args)) [] args)))

(defn contains-pred-to-ir [args]
  (literal-rt-call "Contains" args))

(defn into-to-ir [args]
  (literal-rt-call "Into" args))

(defn concat-to-ir [args]
  (literal-rt-call "Concat" (if (or (nil? args) (empty? args)) [] args)))

(defn ex-message-to-ir [arg]
  (literal-rt-call "ExMessage" [arg]))

(defn ex-data-to-ir [arg]
  (literal-rt-call "ExData" [arg]))

(defn ex-cause-to-ir [arg]
  (literal-rt-call "ExCause" [arg]))

(defn println-to-ir [args]
  (literal-rt-call "Println" (if (or (nil? args) (empty? args)) [] args)))

(defn compare-to-ir [args]
  (literal-rt-call "Compare" args))

(defn numeric-eq-to-ir [args]
  (literal-rt-call "NumericEq" (if (or (nil? args) (empty? args)) [] args)))

(defn comparison-to-ir [op args]
  (if (or (nil? args) (empty? args) (empty? (rest args)))
    (throw (ex-info (str op " expects at least two arguments") {}))
    (loop [acc (literal-rt-call op [(first args) (first (rest args))])
           prev (first (rest args))
           remaining (rest (rest args))]
      (if (or (nil? remaining) (empty? remaining))
        acc
        (recur {:kind :binary
                :op "&&"
                :left acc
                :right (literal-rt-call op [prev (first remaining)])}
               (first remaining)
               (rest remaining))))))

(defn symbol-ctor-to-ir [arg]
  (literal-rt-call "Symbol" [arg]))

(defn name-to-ir [arg]
  (literal-rt-call "Name" [arg]))

(defn keyword-ctor-to-ir [arg]
  (literal-rt-call "Keyword" [arg]))

(defn format-to-ir [args]
  (literal-rt-call "NewString" [(literal-rt-call "Format" args)]))

(defn map-to-ir [args]
  (literal-rt-call "Map" args))

(defn sort-by-to-ir [args]
  (literal-rt-call "SortBy" args))

(defn apply-to-ir [args]
  (literal-rt-call "Apply" args))

(defn pmap-to-ir [args]
  (literal-rt-call "PMap" args))

(defn filter-to-ir [args]
  (literal-rt-call "Filter" args))

(defn reduce-to-ir [args]
  (literal-rt-call "Reduce" args))

(defn doall-to-ir [arg]
  (literal-rt-call "DoAll" [arg]))

(defn some-to-ir [args]
  (literal-rt-call "Some" args))

(defn set-to-ir [arg]
  (literal-rt-call "Set" [arg]))

(defn line-seq-to-ir [arg]
  (literal-rt-call "LineSeq" [arg]))

(defn repeat-to-ir [args]
  (literal-rt-call "Repeat" args))

(defn rand-int-to-ir [arg]
  (literal-rt-call "RandInt" [arg]))

(defn to-json-to-ir [arg]
  (literal-rt-call "ToJSON" [arg]))

(defn from-json-to-ir [arg]
  (literal-rt-call "FromJSON" [arg]))

(defn open-file-to-ir [arg]
  (literal-rt-call "OpenFile" [arg]))

(defn file-to-strings-to-ir [arg]
  (literal-rt-call "FileToStrings" [arg]))

(defn file-to-strings-path-to-ir [arg]
  (literal-rt-call "FileToStringsPath" [arg]))

(defn go-fn-to-ir [arg]
  (literal-rt-call "GoFunction" [arg]))

(defn go-fn-args-to-ir [arg]
  (literal-rt-call "GoFunctionArgs" [arg]))

(def builtin-function-names
  #{"+" "-" "*" "/" "%" "quot" "rem" "mod" "compare" "==" "=" "<" "<=" ">" ">="
    "max" "min"
    "bit-and" "bit-or" "bit-xor" "bit-not" "bit-shift-left" "bit-shift-right"
    "unsigned-bit-shift-right" "bit-test" "bit-set" "bit-clear" "bit-flip"
    "first" "fist" "rest" "next" "last" "reverse" "cons" "take" "drop" "nth"
    "slow-nth" "map" "concat" "sort-by" "apply" "pmap" "filter" "reduce" "get"
    "keys" "vals" "find" "hash-map" "list" "array" "not-empty" "empty?" "nil?"
    "type-of" "count" "double" "numerator" "denominator" "format" "subs"
    "keyword" "into" "doall" "dorun" "line-seq" "some" "seq" "seq?" "set" "vec"
    "conj" "contains?" "assoc" "dissoc" "open-file" "close-file" "close-channel"
    "file-to-strings" "rand-int" "rand" "rand-nth" "shuffle" "repeat"
    "union" "intersection" "difference" "subset?" "superset?" "disjoint?"
    "rename-keys" "map-invert" "select" "project" "rename"
    "go-fn" "go-fn-args" "re-pattern" "re-matches"
    "ex-message" "ex-data" "ex-cause"})

(def unary-runtime-ops
  {"first" "First" "fist" "First" "rest" "Rest" "next" "Next" "last" "Last"
   "reverse" "Reverse" "seq?" "SeqPredicate" "double" "Double" "bit-not" "BitNot"})

(def fold-runtime-ops
  {"+" "Add" "*" "Mul" "-" "Sub" "/" "Div"})

(def binary-runtime-ops
  {"%" "Mod" "mod" "Mod" "quot" "Quot" "rem" "Rem"
   "bit-shift-left" "BitShiftLeft" "bit-shift-right" "BitShiftRight"
   "unsigned-bit-shift-right" "UnsignedBitShiftRight"
   "bit-test" "BitTest" "bit-set" "BitSet" "bit-clear" "BitClear"
   "bit-flip" "BitFlip"})

(def variadic-runtime-ops
  {"bit-and" "BitAnd" "bit-or" "BitOr" "bit-xor" "BitXor"
   "max" "Max" "min" "Min"})

(defn qualified-name? [name]
  (loop [s name]
    (if (or (nil? s) (= 0 (count s)))
      false
      (if (= "/" (subs s 0 1))
        true
        (recur (subs s 1))))))

(defn ident-ir [ident k]
  (let [ir {:kind :ident :name ident}]
    (if (= k :string)
      {:ir ir :expr-kind :string}
      (if (= k :bool)
        {:ir ir :expr-kind :bool}
        {:ir ir :expr-kind :value}))))

(defn symbol-to-ir [name ident ctx]
  (let [locals (:locals ctx)
        globals (:globals ctx)
        functions (:functions ctx)
        module (:module ctx)
        go-fns (:go-fns ctx)
        self-name (:self-function-name ctx)
        self-var (:self-variadic-name ctx)
        slash? (qualified-name? name)]
    (cond
      (and (not slash?)
           ident
           (not (= "" ident))
           (not (nil? locals))
           (contains? locals ident))
      (ident-ir ident (get locals ident))

      (and (= name self-name)
           self-var
           (not (= "" self-var)))
      {:ir (literal-rt-call "NewFunction" [{:kind :ident :name self-var}])
       :expr-kind :value}

      (and (not (nil? module)) (contains? module name))
      (let [go-ident (get module name)]
        (if (and (not (nil? globals)) (contains? globals go-ident))
          (ident-ir go-ident (get globals go-ident))
          (if (and (not (nil? functions)) (contains? functions go-ident))
            {:ir (literal-rt-call "NewFunction" [{:kind :ident :name go-ident}])
             :expr-kind :value}
            {:ir {:kind :ident :name go-ident} :expr-kind :value})))

      (and ident
           (not (= "" ident))
           (not (nil? globals))
           (contains? globals ident))
      (ident-ir ident (get globals ident))

      (and ident
           (not (= "" ident))
           (not (nil? functions))
           (contains? functions ident))
      {:ir (literal-rt-call "NewFunction" [{:kind :ident :name ident}])
       :expr-kind :value}

      (contains? builtin-function-names name)
      {:ir (literal-rt-call "BuiltinFunction" [{:kind :string :value name}])
       :expr-kind :value}

      (and (not (nil? go-fns)) (contains? go-fns name))
      {:ir {:kind :selector :pkg "flagrt" :name (get go-fns name)}
       :expr-kind :value}

      :else
      (throw (ex-info (str "unknown symbol \"" name "\"") {:name name})))))

(defn eval-ast-to-ir-node [mode node ctx]
  (cond
    (= mode :seq)
    (loop [remaining node out []]
      (if (or (nil? remaining) (empty? remaining))
        out
        (recur (rest remaining)
               (conj out (eval-ast-to-ir-node :eval (first remaining) ctx)))))

    (= mode :eval)
    (let [kind (:kind node)]
      (cond
        (= kind :string) (ast-node-to-ir node)
        (= kind :char) (ast-node-to-ir node)
        (= kind :int) (ast-node-to-ir node)
        (= kind :bigint) (ast-node-to-ir node)
        (= kind :ratio) (ast-node-to-ir node)
        (= kind :float) (ast-node-to-ir node)
        (= kind :keyword) (ast-node-to-ir node)
        (= kind :quoted-symbol) (ast-node-to-ir node)

        (= kind :symbol)
        (let [name (:name node)]
          (if (or (= name "true") (= name "false") (= name "nil"))
            (ast-node-to-ir node)
            (:ir (symbol-to-ir name name ctx))))

        (= kind :quoted-list) (quoted-ast-to-ir node)

        (= kind :vector)
        (ctor-to-ir "NewArray" (eval-ast-to-ir-node :seq (:elements node) ctx))

        (= kind :pipe-vector)
        (ctor-to-ir "NewVector" (eval-ast-to-ir-node :seq (:elements node) ctx))

        (= kind :set)
        (ctor-to-ir "NewSet" (eval-ast-to-ir-node :seq (:elements node) ctx))

        (= kind :map)
        (let [entries (:entries node)
              n (if (nil? entries) 0 (count entries))]
          (if (not (= 0 (% n 2)))
            (throw (ex-info "map literal expects key/value pairs" {:node node}))
            (ctor-to-ir "NewMap" (eval-ast-to-ir-node :seq entries ctx))))

        (= kind :list) (eval-ast-to-ir-node :call node ctx)

        :else (throw (ex-info "unsupported AST node for eval lowering"
                              {:node node}))))

    (= mode :call)
    (let [elements (:elements node)]
      (if (or (nil? elements) (empty? elements))
        (throw (ex-info "unsupported form" {:node node}))
        (let [head (first elements)
              args (rest elements)]
          (if (= :symbol (:kind head))
            (let [op (:name head)
                  unary (get unary-runtime-ops op)
                  fold (get fold-runtime-ops op)
                  binary (get binary-runtime-ops op)
                  variadic (get variadic-runtime-ops op)]
              (cond
                unary
                (if (not (= 1 (count args)))
                  (throw (ex-info (str op " expects exactly one argument") {:node node}))
                  (runtime-call-to-ir unary (eval-ast-to-ir-node :seq args ctx)))

                fold
                (fold-call-to-ir fold (eval-ast-to-ir-node :seq args ctx))

                binary
                (if (not (= 2 (count args)))
                  (throw (ex-info (str op " expects exactly two arguments") {:node node}))
                  (runtime-call-to-ir binary (eval-ast-to-ir-node :seq args ctx)))

                variadic
                (runtime-call-to-ir variadic (eval-ast-to-ir-node :seq args ctx))

                (contains? special-form-names op)
                (throw (ex-info "special form not handled by eval lowering"
                                {:node node}))

                :else
                (call-to-ir (eval-ast-to-ir-node :eval head ctx)
                            (eval-ast-to-ir-node :seq args ctx))))
            (call-to-ir (eval-ast-to-ir-node :eval head ctx)
                        (eval-ast-to-ir-node :seq args ctx))))))

    :else (throw (ex-info "unsupported eval lowering mode" {:mode mode}))))

(defn eval-ast-to-ir [node ctx]
  (eval-ast-to-ir-node :eval node ctx))

(defn stmt-list [stmts]
  (if (or (nil? stmts) (empty? stmts))
    []
    stmts))

(defn append-stmt [stmts stmt]
  (conj (stmt-list stmts) stmt))

(defn if-to-ir [name type cond then-stmts then-expr else-stmts else-expr]
  [{:kind :var :name name :type type :expr nil}
   {:kind :if
    :init ""
    :cond cond
    :then (append-stmt then-stmts {:kind :assign :name name :expr then-expr})
    :else (append-stmt else-stmts {:kind :assign :name name :expr else-expr})}])

(defn concat-stmts [left right]
  (loop [out (stmt-list left) remaining (stmt-list right)]
    (if (or (nil? remaining) (empty? remaining))
      out
      (recur (conj out (first remaining)) (rest remaining)))))

(defn let-to-ir [name type binding-stmts body-stmts body-expr]
  [{:kind :var :name name :type type :expr nil}
   {:kind :block
    :body (append-stmt (concat-stmts binding-stmts body-stmts)
                       {:kind :assign :name name :expr body-expr})}])

(defn last-item [xs]
  (loop [remaining (stmt-list xs)]
    (let [more (rest remaining)]
      (if (or (nil? more) (empty? more))
        (first remaining)
        (recur more)))))

(defn do-form-stmt [form]
  (let [stmt (:stmt form)]
    (if (nil? stmt)
      {:kind :expr-stmt :expr (:expr form) :discard true}
      stmt)))

(defn do-prelude-stmts [forms]
  (loop [remaining (stmt-list forms) out []]
    (if (or (nil? remaining) (empty? remaining))
      out
      (let [form (first remaining)
            more (rest remaining)
            with-stmts (concat-stmts out (:stmts form))]
        (if (or (nil? more) (empty? more))
          with-stmts
          (recur more (append-stmt with-stmts (do-form-stmt form))))))))

(defn do-iife-body [forms]
  (let [last (last-item forms)
        prelude (do-prelude-stmts forms)]
    (if (:defer? last)
      (append-stmt (append-stmt prelude (do-form-stmt last))
                   {:kind :return :expr (literal-rt-call "NilValue" [])})
      (append-stmt prelude {:kind :return :expr (:expr last)}))))

(defn do-defer-to-ir [type forms]
  {:kind :call
   :fun {:kind :func-lit :params "" :result type :body (do-iife-body forms)}
   :args []})

(defn loop-binding-stmts [bindings]
  (loop [remaining (stmt-list bindings) out []]
    (if (or (nil? remaining) (empty? remaining))
      out
      (let [b (first remaining)
            with-var (append-stmt out {:kind :var :name (:name b) :type "" :expr (:init b)})
            with-unused (if (:unused b)
                          (append-stmt with-var {:kind :expr-stmt
                                                 :expr {:kind :ident :name (:name b)}
                                                 :discard true})
                          with-var)]
        (recur (rest remaining) with-unused)))))

(defn loop-recur-then [names]
  (let [n (count names)
        arity-check {:kind :if
                     :init ""
                     :cond {:kind :binary
                            :op "!="
                            :left {:kind :call
                                   :fun {:kind :ident :name "len"}
                                   :args [{:kind :ident :name "__recurValues"}]}
                            :right {:kind :int :value n}}
                     :then [{:kind :expr-stmt
                             :expr {:kind :call
                                    :fun {:kind :ident :name "panic"}
                                    :args [{:kind :string :value "internal error: recur arity mismatch"}]}
                             :discard false}]
                     :else []}]
    (loop [remaining (stmt-list names) i 0 out [arity-check]]
      (if (or (nil? remaining) (empty? remaining))
        (append-stmt out {:kind :expr-stmt
                          :expr {:kind :ident :name "continue"}
                          :discard false})
        (recur (rest remaining)
               (inc i)
               (conj out {:kind :assign
                          :name (first remaining)
                          :expr {:kind :index
                                 :x {:kind :ident :name "__recurValues"}
                                 :index {:kind :int :value i}}}))))))

(defn loop-iter-body [binding-names body-stmts body-expr]
  (concat-stmts
    body-stmts
    [{:kind :define :names ["__loopResult"] :expr body-expr}
     {:kind :if
      :init "__recurValues, __isRecur := flagrt.UnwrapRecur(__loopResult)"
      :cond {:kind :ident :name "__isRecur"}
      :then (loop-recur-then binding-names)
      :else []}
     {:kind :return :expr {:kind :ident :name "__loopResult"}}]))

(defn loop-to-ir [init-stmts bindings body-stmts body-expr]
  (let [names (loop [remaining (stmt-list bindings) out []]
                (if (or (nil? remaining) (empty? remaining))
                  out
                  (recur (rest remaining) (conj out (:name (first remaining))))))]
    {:kind :call
     :fun {:kind :func-lit
           :params ""
           :result "flagrt.Value"
           :body (concat-stmts
                   init-stmts
                   (concat-stmts
                     (loop-binding-stmts bindings)
                     [{:kind :for :body (loop-iter-body names body-stmts body-expr)}]))}
     :args []}))

(defn recur-to-ir [values]
  (literal-rt-call "NewRecur" (stmt-list values)))

(defn defer-to-ir [thunk]
  {:kind :defer :expr (literal-rt-call "Call" [thunk])})

(defn throw-to-ir [stmts value]
  {:kind :call
   :fun {:kind :func-lit
         :params ""
         :result "flagrt.Value"
         :body (append-stmt
                 (append-stmt stmts {:kind :expr-stmt
                                     :expr (literal-rt-call "Throw" [value])
                                     :discard false})
                 {:kind :return :expr (literal-rt-call "NilValue" [])})}
   :args []})

(defn future-to-ir [body-stmts body-expr]
  (literal-rt-call "NewFuture"
                   [{:kind :func-lit
                     :params ""
                     :result "flagrt.Value"
                     :body (append-stmt body-stmts {:kind :return :expr body-expr})}]))

(defn value-iife-ir [body]
  {:kind :call
   :fun {:kind :func-lit :params "" :result "flagrt.Value" :body body}
   :args []})

(defn ident-call-ir [name args]
  {:kind :call :fun {:kind :ident :name name} :args args})

(defn self-call-target [name nargs ctx]
  (if (or (nil? name) (= "" name) (not (= name (:self-function-name ctx))))
    nil
    (let [arity-names (:self-arity-names ctx)]
      (if (and (not (nil? arity-names)) (contains? arity-names nargs))
        (get arity-names nargs)
        (if (or (:self-function-rest ctx) (= nargs (:self-function-arity ctx)))
          (if (:self-function-rest ctx)
            (:self-variadic-name ctx)
            (:self-arity-name ctx))
          nil)))))

(defn doto-to-ir [target-stmts target-expr steps]
  (value-iife-ir
    (concat-stmts
      target-stmts
      (append-stmt
        (loop [remaining (stmt-list steps)
               out [{:kind :define :names ["__doto"] :expr target-expr}]]
          (if (or (nil? remaining) (empty? remaining))
            out
            (let [step (first remaining)
                  with-stmts (concat-stmts out (:stmts step))]
              (recur (rest remaining)
                     (append-stmt with-stmts
                                  {:kind :expr-stmt
                                   :expr (literal-rt-call "Call"
                                                          [(:expr step)
                                                           {:kind :ident :name "__doto"}])
                                   :discard true})))))
        {:kind :return :expr {:kind :ident :name "__doto"}}))))

(defn update-bang-to-ir [name stmts value]
  (value-iife-ir
    (append-stmt
      (append-stmt stmts {:kind :assign :name name :expr value})
      {:kind :return :expr {:kind :ident :name name}})))

(defn catch-handler-to-ir [name body-stmts body-expr]
  (let [bind (if (= name "_")
               [{:kind :expr-stmt
                 :expr {:kind :ident :name "__flag_thrown"}
                 :discard true}]
               [{:kind :var :name name :type "" :expr {:kind :ident :name "__flag_thrown"}}
                {:kind :expr-stmt :expr {:kind :ident :name name} :discard true}])]
    (value-iife-ir
      (append-stmt (concat-stmts bind body-stmts)
                   {:kind :return :expr body-expr}))))

(defn try-finally-stmt [finally]
  {:kind :defer
   :expr {:kind :call
          :fun {:kind :func-lit
                :params ""
                :result ""
                :body (append-stmt (:stmts finally)
                                   {:kind :expr-stmt :expr (:expr finally) :discard true})}
          :args []}})

(defn try-recover-body [catches]
  (loop [remaining (stmt-list catches)
         out [{:kind :define :names ["r"] :expr (ident-call-ir "recover" [])}
              {:kind :if
               :init ""
               :cond {:kind :binary
                      :op "=="
                      :left {:kind :ident :name "r"}
                      :right {:kind :ident :name "nil"}}
               :then [{:kind :return :expr nil}]
               :else []}
              {:kind :define
               :names ["__flag_thrown"]
               :expr (literal-rt-call "PanicValue" [{:kind :ident :name "r"}])}]]
    (if (or (nil? remaining) (empty? remaining))
      (append-stmt out {:kind :expr-stmt
                        :expr (ident-call-ir "panic" [{:kind :ident :name "r"}])
                        :discard false})
      (let [c (first remaining)
            then (append-stmt
                   (append-stmt (:stmts c)
                                {:kind :assign :name "__flag_try_result" :expr (:handler c)})
                   {:kind :return :expr nil})]
        (recur (rest remaining)
               (append-stmt out {:kind :if
                                 :init ""
                                 :cond (literal-rt-call "CatchMatches"
                                                        [{:kind :string :value (:class c)}
                                                         {:kind :ident :name "__flag_thrown"}])
                                 :then then
                                 :else []}))))))

(defn try-to-ir [body-stmts body-expr catches finally]
  (let [has-catch (not (or (nil? catches) (empty? (stmt-list catches))))]
    (let [start (if has-catch
                  [{:kind :var :name "__flag_try_result" :type "flagrt.Value" :expr nil}]
                  [])]
      (let [start (if (nil? finally)
                    start
                    (append-stmt start (try-finally-stmt finally)))]
        (if (not has-catch)
          (value-iife-ir
            (append-stmt (concat-stmts start body-stmts)
                         {:kind :return :expr body-expr}))
          (let [inner (append-stmt
                        (concat-stmts
                          [{:kind :defer
                            :expr {:kind :call
                                   :fun {:kind :func-lit
                                         :params ""
                                         :result ""
                                         :body (try-recover-body catches)}
                                   :args []}}]
                          body-stmts)
                        {:kind :assign :name "__flag_try_result" :expr body-expr})]
            (value-iife-ir
              (append-stmt
                (append-stmt start
                             {:kind :expr-stmt
                              :expr {:kind :call
                                     :fun {:kind :func-lit :params "" :result "" :body inner}
                                     :args []}
                              :discard false})
                {:kind :return :expr {:kind :ident :name "__flag_try_result"}}))))))))

(defn doseq-to-ir [loop-expr]
  (value-iife-ir
    [{:kind :expr-stmt :expr (literal-rt-call "DoAll" [loop-expr]) :discard true}
     {:kind :return :expr (literal-rt-call "NilValue" [])}]))

(defn doseq-body-to-ir [body-stmts body-expr]
  (value-iife-ir
    (append-stmt
      (append-stmt body-stmts {:kind :expr-stmt :expr body-expr :discard true})
      {:kind :return :expr (literal-rt-call "NewArray" [])})))

(defn mapcat-binding-to-ir [ident unused panic-msg rest-expr rest-stmts coll]
  (let [args0 {:kind :index :x {:kind :ident :name "args"} :index {:kind :int :value 0}}
        arity {:kind :if
               :init ""
               :cond {:kind :binary
                      :op "!="
                      :left (ident-call-ir "len" [{:kind :ident :name "args"}])
                      :right {:kind :int :value 1}}
               :then [{:kind :expr-stmt
                       :expr (ident-call-ir "panic" [{:kind :string :value panic-msg}])
                       :discard false}]
               :else []}
        bind (if (= ident "_")
               [{:kind :expr-stmt :expr args0 :discard true}]
               (if unused
                 [{:kind :define :names [ident] :expr args0}
                  {:kind :expr-stmt :expr {:kind :ident :name ident} :discard true}]
                 [{:kind :define :names [ident] :expr args0}]))
        fn {:kind :func-lit
            :params "args ...flagrt.Value"
            :result "flagrt.Value"
            :body (append-stmt
                    (concat-stmts (concat-stmts [arity] bind) rest-stmts)
                    {:kind :return :expr rest-expr})}]
    (value-iife-ir
      [{:kind :return
        :expr (literal-rt-call "MapCat"
                               [(literal-rt-call "NewFunction" [fn])
                                coll])}])))

(defn fn-arity-check [name n has-rest]
  (let [op (if has-rest "<" "!=")
        msg (if has-rest
              (str name " expects at least " n " arguments")
              (str name " expects exactly " n " arguments"))]
    {:kind :if
     :init ""
     :cond {:kind :binary
            :op op
            :left (ident-call-ir "len" [{:kind :ident :name "args"}])
            :right {:kind :int :value n}}
     :then [{:kind :expr-stmt
             :expr (ident-call-ir "panic" [{:kind :string :value msg}])
             :discard false}]
     :else []}))

(defn fn-param-stmts [params]
  (loop [remaining (stmt-list params) i 0 out []]
    (if (or (nil? remaining) (empty? remaining))
      out
      (let [p (first remaining)
            arg {:kind :index :x {:kind :ident :name "args"} :index {:kind :int :value i}}
            stmt (if (= p "_")
                   {:kind :expr-stmt :expr arg :discard true}
                   {:kind :define :names [p] :expr arg})]
        (recur (rest remaining) (inc i) (conj out stmt))))))

(defn fn-to-ir [name params has-rest init-stmts body-stmts body-expr]
  (literal-rt-call
    "NewFunction"
    [{:kind :func-lit
      :params "args ...flagrt.Value"
      :result "flagrt.Value"
      :body (append-stmt
              (concat-stmts
                (concat-stmts
                  (concat-stmts [(fn-arity-check name (count (stmt-list params)) has-rest)]
                                (fn-param-stmts params))
                  init-stmts)
                body-stmts)
              {:kind :return :expr body-expr})}]))

(defn ns-to-ir [namespace]
  {:kind :raw-stmt :code (str "// Source namespace: " namespace "\n")})

(defn def-to-ir [name expr]
  {:kind :var :name name :type "" :expr expr})

(defn defn-binding-to-ir [name variadic-name]
  (def-to-ir name (literal-rt-call "NewFunction" [{:kind :ident :name variadic-name}])))

(defn defn-param-list [params]
  (loop [remaining (stmt-list params) out "" first? true]
    (if (or (nil? remaining) (empty? remaining))
      out
      (let [p (first remaining)
            piece (str p " flagrt.Value")]
        (if first?
          (recur (rest remaining) piece false)
          (recur (rest remaining) (str out ", " piece) false))))))

(defn defn-body [init-stmts body-stmts body-expr]
  (append-stmt (concat-stmts init-stmts body-stmts)
               {:kind :return :expr body-expr}))

(defn defn-func-decl [name params result body]
  {:kind :func-decl :name name :params params :result result :body body})

(defn defn-arity-to-ir [name params init-stmts body-stmts body-expr]
  (defn-func-decl name
                  (defn-param-list params)
                  "flagrt.Value"
                  (defn-body init-stmts body-stmts body-expr)))

(defn defn-call-args [n]
  (loop [i 0 out []]
    (if (= i n)
      out
      (recur (inc i)
             (conj out {:kind :index
                        :x {:kind :ident :name "args"}
                        :index {:kind :int :value i}})))))

(defn defn-variadic-to-ir [name arity-name panic-name n]
  (defn-func-decl name
                  "args ...flagrt.Value"
                  "flagrt.Value"
                  [(fn-arity-check panic-name n false)
                   {:kind :return
                    :expr {:kind :call
                           :fun {:kind :ident :name arity-name}
                           :args (defn-call-args n)}}]))

(defn defn-rest-to-ir [name panic-name params init-stmts body-stmts body-expr]
  (defn-func-decl name
                  "args ...flagrt.Value"
                  "flagrt.Value"
                  (append-stmt
                    (concat-stmts
                      (concat-stmts
                        (concat-stmts [(fn-arity-check panic-name (count (stmt-list params)) true)]
                                      (fn-param-stmts params))
                        init-stmts)
                      body-stmts)
                    {:kind :return :expr body-expr})))

(defn defn-to-ir [arity-name variadic-name panic-name params has-rest init-stmts body-stmts body-expr]
  (if has-rest
    [(defn-rest-to-ir variadic-name panic-name params init-stmts body-stmts body-expr)]
    [(defn-arity-to-ir arity-name params init-stmts body-stmts body-expr)
     (defn-variadic-to-ir variadic-name arity-name panic-name (count (stmt-list params)))]))

(defn defn-multi-dispatch-to-ir [name panic-msg arities]
  (defn-func-decl name
                  "args ...flagrt.Value"
                  "flagrt.Value"
                  (append-stmt
                    (loop [remaining (stmt-list arities) out []]
                      (if (or (nil? remaining) (empty? remaining))
                        out
                        (let [a (first remaining)
                              n (:n a)
                              aname (:name a)]
                          (recur (rest remaining)
                                 (conj out {:kind :if
                                            :init ""
                                            :cond {:kind :binary
                                                   :op "=="
                                                   :left (ident-call-ir "len" [{:kind :ident :name "args"}])
                                                   :right {:kind :int :value n}}
                                            :then [{:kind :return
                                                    :expr {:kind :call
                                                           :fun {:kind :ident :name aname}
                                                           :args (defn-call-args n)}}]
                                            :else []})))))
                    {:kind :expr-stmt
                     :expr (ident-call-ir "panic" [{:kind :string :value panic-msg}])
                     :discard false})))

(defn defn-multi-to-ir [variadic-name panic-msg arities]
  (concat-stmts
    (loop [remaining (stmt-list arities) out []]
      (if (or (nil? remaining) (empty? remaining))
        out
        (let [a (first remaining)]
          (recur (rest remaining)
                 (conj out (defn-arity-to-ir (:name a)
                                             (:params a)
                                             (:init-stmts a)
                                             (:body-stmts a)
                                             (:body-expr a)))))))
    [(defn-multi-dispatch-to-ir variadic-name panic-msg arities)]))

(def go-ident-letters "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ")
(def go-ident-digits "0123456789")
(def go-keywords
  #{"break" "case" "chan" "const" "continue" "default" "defer" "else"
    "fallthrough" "for" "func" "go" "goto" "if" "import" "interface"
    "map" "package" "range" "return" "select" "struct" "switch" "type" "var"})

(defn str-has-char? [s ch]
  (loop [remaining s]
    (if (or (nil? remaining) (= 0 (count remaining)))
      false
      (if (= ch (subs remaining 0 1))
        true
        (recur (subs remaining 1))))))

(defn ident-letter? [ch]
  (str-has-char? go-ident-letters ch))

(defn ident-digit? [ch]
  (str-has-char? go-ident-digits ch))

(defn go-ident-char [ch first?]
  (cond
    (= ch "-") "_"
    (and first? (or (= ch "_") (ident-letter? ch))) ch
    (and (not first?) (= ch "?")) "_q"
    (and (not first?) (= ch "!")) "_bang"
    (and (not first?) (= ch ">")) "_gt"
    (and (not first?) (= ch "<")) "_lt"
    (and (not first?) (or (= ch "_") (ident-letter? ch) (ident-digit? ch))) ch
    :else nil))

(defn go-ident [name]
  (if (or (nil? name) (= "" name))
    (throw (ex-info "empty symbol" {:name name}))
    (loop [i 0 n (count name) out ""]
      (if (= i n)
        (let [ident (if (= out "main") "flag_main" out)]
          (if (contains? go-keywords ident)
            (str ident "_")
            ident))
        (let [ch (subs name i (inc i))
              piece (go-ident-char ch (= i 0))]
          (if (nil? piece)
            (throw (ex-info (str "unsupported symbol \"" name "\"") {:name name}))
            (recur (inc i) n (str out piece))))))))

(defn go-ident-or-empty [name]
  (if (or (nil? name) (= "" name))
    ""
    (loop [i 0 n (count name) out ""]
      (if (= i n)
        (let [ident (if (= out "main") "flag_main" out)]
          (if (contains? go-keywords ident)
            (str ident "_")
            ident))
        (let [ch (subs name i (inc i))
              piece (go-ident-char ch (= i 0))]
          (if (nil? piece)
            ""
            (recur (inc i) n (str out piece))))))))

(defn map-put [m k v]
  (assoc m k v))

(defn as-value [x]
  x)

(defn ident-replace-char [s from to]
  (loop [remaining (str s) out ""]
    (if (or (nil? remaining) (= 0 (count remaining)))
      out
      (let [ch (subs remaining 0 1)]
        (if (= ch from)
          (recur (subs remaining 1) (str out to))
          (recur (subs remaining 1) (str out ch)))))))

(defn upcase-first-ident [s]
  (if (or (nil? s) (= 0 (count s)))
    s
    (let [ch (subs s 0 1)
          tail (subs s 1)
          lowers (subs go-ident-letters 0 26)
          uppers (subs go-ident-letters 26)]
      (loop [i 0]
        (if (= i 26)
          s
          (if (= ch (subs lowers i (inc i)))
            (str (subs uppers i (inc i)) tail)
            (recur (inc i))))))))

(defn module-go-ident [namespace local-name]
  (let [local (go-ident local-name)]
    (if (or (nil? namespace) (= "" namespace))
      local
      (str (go-ident (ident-replace-char namespace "." "_")) "__" local))))

(defn exported-go-ident [name]
  (upcase-first-ident (go-ident name)))

(defn def-go-ident [ctx name]
  (if (:package-mode ctx)
    (if (get (:exported-names ctx) name)
      (exported-go-ident name)
      (go-ident name))
    (module-go-ident (:namespace ctx) name)))

(defn local-def-replaces-import? [ctx prev go-name]
  (and (:package-mode ctx)
       (str-has-char? prev ".")
       (not (str-has-char? go-name "."))))

(defn prelude-go-name? [go-name]
  (let [s (str go-name)
        n (count s)]
    (or (and (>= n 10) (= "prologue__" (subs s 0 10)))
        (and (>= n 9) (= "prologue." (subs s 0 9))))))

(defn can-rebind-module-name? [ctx prev go-name]
  (or (local-def-replaces-import? ctx prev go-name)
      (prelude-go-name? prev)))

(defn bind-module-name [ctx flag-name go-name]
  (let [mod (if (nil? (:module ctx)) {} (:module ctx))
        prev (get mod flag-name)]
    (if (and prev (not (= prev go-name)))
      (if (can-rebind-module-name? ctx prev go-name)
        (bind-module-name (assoc ctx :module (map-put mod flag-name go-name)) flag-name go-name)
        (throw (ex-info (str "symbol \"" flag-name "\" already bound to " prev) {})))
      (let [mod1 (map-put mod flag-name go-name)
            ns (:namespace ctx)]
        (if (or (nil? ns) (= "" ns) (str-has-char? flag-name "/"))
          (assoc ctx :module mod1)
          (let [qualified (str ns "/" flag-name)
                qprev (get mod1 qualified)]
            (if (and qprev (not (= qprev go-name)))
              (if (can-rebind-module-name? ctx qprev go-name)
                (assoc ctx :module (map-put mod1 qualified go-name))
                (throw (ex-info (str "symbol \"" qualified "\" already bound to " qprev) {})))
              (assoc ctx :module (map-put mod1 qualified go-name)))))))))

(defn insert-sorted-int [xs n]
  (loop [remaining xs out []]
    (if (or (nil? remaining) (empty? remaining))
      (conj out n)
      (if (< n (first remaining))
        (loop [more remaining acc (conj out n)]
          (if (or (nil? more) (empty? more))
            acc
            (recur (rest more) (conj acc (first more)))))
        (recur (rest remaining) (conj out (first remaining)))))))

(defn sort-ints [xs]
  (loop [remaining xs out []]
    (if (or (nil? remaining) (empty? remaining))
      out
      (recur (rest remaining) (insert-sorted-int out (first remaining))))))

(defn join-arity-counts [counts]
  (loop [remaining counts out ""]
    (if (or (nil? remaining) (empty? remaining))
      out
      (let [more (rest remaining)
            n (first remaining)]
        (if (or (nil? more) (empty? more))
          (if (= out "")
            (str n)
            (str out ", or " n))
          (recur more (if (= out "") (str n) (str out ", " n))))))))

(defn multi-arity-expects-msg [name counts]
  (let [sorted (sort-ints counts)
        n (count sorted)]
    (cond
      (= n 0) (str name " expects arguments")
      (= n 1) (str name " expects exactly " (first sorted) " arguments")
      (= n 2) (str name " expects " (first sorted) " or " (first (rest sorted)) " arguments")
      :else (str name " expects " (join-arity-counts sorted) " arguments"))))

(defn parse-volatile [pattern]
  (if (not (= :meta (:kind pattern)))
    {:volatile? false :target pattern}
    (let [m (:meta pattern)
          target (:target pattern)]
      (if (not (= :map (:kind m)))
        {:volatile? false :target target}
        (let [entries (:entries m)]
          (if (not (= 0 (% (count entries) 2)))
            (throw (ex-info "metadata map expects key/value pairs" {:node m}))
            (loop [remaining entries volatile? false]
              (if (or (nil? remaining) (empty? remaining))
                {:volatile? volatile? :target target}
                (let [k (first remaining)
                      v (first (rest remaining))]
                  (if (and (= :keyword (:kind k)) (= "volatile" (:name k)))
                    (if (and (= :symbol (:kind v)) (= "true" (:name v)))
                      (recur (rest (rest remaining)) true)
                      (if (and (= :symbol (:kind v)) (= "false" (:name v)))
                        (recur (rest (rest remaining)) false)
                        (throw (ex-info "metadata :volatile must be true or false" {:node v}))))
                    (recur (rest (rest remaining)) volatile?)))))))))))

(defn unwrap-ast [node]
  (if (= :meta (:kind node))
    (unwrap-ast (:target node))
    node))

(defn ast-seq [node]
  (if (nil? node)
    []
    (let [els (:elements node)]
      (if (nil? els)
        node
        els))))

(defn unused-binding? [name]
  (and (not (nil? name))
       (not (= 0 (count name)))
       (= "_" (subs name 0 1))))

(defn append-unused [stmts flag-name go-name]
  (if (and (unused-binding? flag-name) (not (= go-name "_")))
    (conj stmts {:kind :expr-stmt :expr {:kind :ident :name go-name} :discard true})
    stmts))

(defn fresh-temp [state prefix]
  (let [n (:temp state)]
    {:name (str prefix n)
     :state (assoc state :temp (inc n))}))

(defn declare-param [state flag-name go-name]
  (if (= go-name "_")
    state
    (if (contains? (:declared state) go-name)
      (throw (ex-info (str "duplicate parameter \"" flag-name "\"") {:name flag-name}))
      (assoc (assoc state
                    :declared (assoc (:declared state) go-name true))
             :locals (assoc (:locals state) go-name :value)))))

(defn declare-binding [state flag-name go-name kind]
  (if (= go-name "_")
    state
    (if (contains? (:declared state) go-name)
      (throw (ex-info (str "duplicate binding \"" flag-name "\"") {:name flag-name}))
      (assoc (assoc state
                    :declared (assoc (:declared state) go-name true))
             :locals (assoc (:locals state) go-name kind)))))

(defn rest-source-ir [n ctor]
  (literal-rt-call ctor
                   [{:kind :spread
                     :expr {:kind :slice
                            :x {:kind :ident :name "args"}
                            :low {:kind :int :value n}
                            :high nil}}]))

(defn bind-symbol-param [state flag-name]
  (let [go-name (go-ident flag-name)
        with-decl (declare-param state flag-name go-name)]
    (assoc (assoc with-decl :params (conj (:params with-decl) go-name))
           :init-stmts (append-unused (:init-stmts with-decl) flag-name go-name))))

(defn bind-symbol-to [state flag-name source kind]
  (let [go-name (go-ident flag-name)
        with-decl (declare-binding state flag-name go-name kind)
        with-var (conj (:init-stmts with-decl)
                       {:kind :var :name go-name :type "" :expr source})]
    (assoc with-decl :init-stmts (append-unused with-var flag-name go-name))))

(defn unhandled-param [node]
  (throw (ex-info "not handled by FLAG param lowering" {:node node})))

(defn map-entries [node]
  (let [entries (:entries node)]
    (if (nil? entries) [] entries)))

(defn map-destructure-key-ir [node]
  (let [form (unwrap-ast node)
        kind (:kind form)]
    (cond
      (= kind :keyword) (literal-rt-call "NewKeyword" [{:kind :string :value (:name form)}])
      (= kind :symbol) (literal-rt-call "NewSymbol" [{:kind :string :value (:name form)}])
      (= kind :quoted-symbol) (literal-rt-call "NewSymbol" [{:kind :string :value (:name form)}])
      (= kind :int) (literal-rt-call "NewLong" [{:kind :int :value (:value form)}])
      (= kind :bigint) (literal-rt-call "NewBigIntFromString" [{:kind :string :value (:value form)}])
      (= kind :float)
      (literal-rt-call "NewDouble" [{:kind :raw
                                     :code (if (or (nil? (:raw form)) (= "" (:raw form)))
                                             (str (:value form))
                                             (:raw form))}])
      (= kind :string) (literal-rt-call "NewString" [{:kind :string :value (:value form)}])
      (= kind :char) (literal-rt-call "NewString" [{:kind :string :value (:value form)}])
      :else (unhandled-param node))))

(defn literal-default-ir [node]
  (let [form (unwrap-ast node)
        kind (:kind form)]
    (cond
      (or (= kind :string) (= kind :char) (= kind :int) (= kind :bigint)
          (= kind :ratio) (= kind :float) (= kind :keyword) (= kind :quoted-symbol))
      (ast-node-to-ir form)
      (= kind :symbol)
      (if (or (= (:name form) "true") (= (:name form) "false") (= (:name form) "nil"))
        (ast-node-to-ir form)
        (unhandled-param node))
      :else (unhandled-param node))))

(defn collect-or-defaults [defaults node]
  (let [form (unwrap-ast node)]
    (if (not (= :map (:kind form)))
      (throw (ex-info "map destructuring :or expects a map" {:node node}))
      (let [entries (map-entries form)]
        (if (not (= 0 (% (count entries) 2)))
          (throw (ex-info "map destructuring :or expects key/value pairs" {:node node}))
          (loop [remaining entries out defaults]
            (if (or (nil? remaining) (empty? remaining))
              out
              (let [key-node (unwrap-ast (first remaining))
                    kind (:kind key-node)]
                (if (not (or (= kind :symbol) (= kind :keyword)))
                  (throw (ex-info "map destructuring :or keys must be symbols or keywords" {:node key-node}))
                  (if (= "" (:name key-node))
                    (throw (ex-info "map destructuring :or key cannot be empty" {:node key-node}))
                    (recur (rest (rest remaining))
                           (conj out {:name (:name key-node)
                                      :node (first (rest remaining))}))))))))))))

(defn or-default-node [defaults name]
  (loop [remaining defaults found nil]
    (if (or (nil? remaining) (empty? remaining))
      found
      (let [item (first remaining)]
        (if (= name (:name item))
          (recur (rest remaining) (:node item))
          (recur (rest remaining) found))))))

(defn has-or-default? [defaults name]
  (loop [remaining defaults]
    (if (or (nil? remaining) (empty? remaining))
      false
      (if (= name (:name (first remaining)))
        true
        (recur (rest remaining))))))

(defn sequential-binding? [kind]
  (or (= kind :vector) (= kind :list) (= kind :set)))

(defn compile-or-default-in-state [state name node]
  (let [cf (:compile-form state)
        form-ctx (assoc (or (:form-ctx state) {}) :locals (:locals state))]
    (if (nil? cf)
      {:stmts [] :expr (literal-default-ir node) :expr-kind :value :defer? false :ctx form-ctx}
      (let [compiled (cf node form-ctx)]
        (if (not (= :value (:expr-kind compiled)))
          (throw (ex-info (str "map destructuring default for \"" name "\" must evaluate to Value") {}))
          compiled)))))

(defn apply-or-default [state source key-ir name node]
  (let [compiled (compile-or-default-in-state state name node)
        stmts (loop [out (stmt-list (:init-stmts state)) remaining (stmt-list (:stmts compiled))]
                (if (or (nil? remaining) (empty? remaining))
                  out
                  (recur (conj out (first remaining)) (rest remaining))))
        st (-> state
               (assoc :init-stmts stmts)
               (assoc :form-ctx (:ctx compiled))
               (assoc :locals (or (:locals (:ctx compiled)) (:locals state))))]
    {:state st
     :expr (literal-rt-call "Get" [source key-ir (:expr compiled)])}))

(defn append-bindings [left right]
  (loop [remaining right out left]
    (if (or (nil? remaining) (empty? remaining))
      out
      (recur (rest remaining) (conj out (first remaining))))))

(defn expand-destructure-special [name vec-node]
  (let [form (unwrap-ast vec-node)]
    (if (not (= :vector (:kind form)))
      (throw (ex-info (str "map destructuring :" name " expects a vector") {:node vec-node}))
      (loop [remaining (ast-seq form) out []]
        (if (or (nil? remaining) (empty? remaining))
          out
          (let [item (first remaining)
                node (unwrap-ast item)]
            (cond
              (= name "keys")
              (if (or (not (= :symbol (:kind node))) (= "" (:name node)))
                (throw (ex-info "map destructuring :keys entries must be symbols" {:node item}))
                (recur (rest remaining)
                       (conj out {:key (literal-rt-call "NewKeyword" [{:kind :string :value (:name node)}])
                                  :binding item})))
              (= name "syms")
              (if (or (not (= :symbol (:kind node))) (= "" (:name node)))
                (throw (ex-info "map destructuring :syms entries must be symbols" {:node item}))
                (recur (rest remaining)
                       (conj out {:key (literal-rt-call "NewSymbol" [{:kind :string :value (:name node)}])
                                  :binding item})))
              (= name "strs")
              (if (not (= :string (:kind node)))
                (throw (ex-info "map destructuring :strs entries must be strings" {:node item}))
                (recur (rest remaining)
                       (conj out {:key (literal-rt-call "NewString" [{:kind :string :value (:value node)}])
                                  :binding {:kind :symbol :name (go-ident (:value node))}})))
              :else (throw (ex-info (str "unsupported map destructuring key :" name) {})))))))))

(defn bind-pattern-node [mode state pattern source]
  (cond
    (= mode :pattern)
    (let [node (unwrap-ast pattern)
          kind (:kind node)]
      (cond
        (= kind :symbol)
        (if (= "&" (:name node))
          (throw (ex-info "unexpected & in binding" {:node node}))
          (if (= "" (:name node))
            (throw (ex-info "binding symbol cannot be empty" {:node node}))
            (bind-symbol-to state (:name node) source :value)))

        (sequential-binding? kind)
        (bind-pattern-node :vector state node source)

        (= kind :map)
        (bind-pattern-node :map state node source)

        :else (unhandled-param node)))

    (= mode :vector)
  (loop [remaining (ast-seq pattern)
         positionals []
         rest-pat nil
         as-pat nil
         seen-rest false]
    (if (or (nil? remaining) (empty? remaining))
      (let [with-as (if (nil? as-pat)
                      state
                      (bind-pattern-node :pattern state as-pat source))]
        (loop [remaining positionals
               current source
               st with-as]
          (if (or (nil? remaining) (empty? remaining))
            (if (nil? rest-pat)
              st
              (bind-pattern-node :pattern st rest-pat current))
            (let [t (fresh-temp st "__dseq")
                  next-name (:name t)
                  st1 (:state t)
                  st2 (assoc st1 :init-stmts
                             (conj (:init-stmts st1)
                                   {:kind :var
                                    :name next-name
                                    :type ""
                                    :expr (literal-rt-call "SeqFirst" [current])}))
                  st3 (bind-pattern-node :pattern st2 (first remaining) {:kind :ident :name next-name})]
              (recur (rest remaining)
                     (literal-rt-call "SeqRest" [current])
                     st3)))))
      (let [item (first remaining)
            node (unwrap-ast item)]
        (cond
          (and (= :keyword (:kind node)) (= "as" (:name node)))
          (if (or (nil? (rest remaining)) (empty? (rest remaining)))
            (throw (ex-info "vector destructuring :as expects a binding form" {:node pattern}))
            (if (not (nil? as-pat))
              (throw (ex-info "vector destructuring supports only one :as" {:node pattern}))
              (recur (rest (rest remaining)) positionals rest-pat (first (rest remaining)) seen-rest)))

          (and (= :symbol (:kind node)) (= "&" (:name node)))
          (if seen-rest
            (throw (ex-info "vector destructuring supports only one & binding" {:node pattern}))
            (if (or (nil? (rest remaining)) (empty? (rest remaining)))
              (throw (ex-info "vector destructuring & expects a binding form" {:node pattern}))
              (recur (rest (rest remaining)) positionals (first (rest remaining)) as-pat true)))

          seen-rest
          (throw (ex-info "vector destructuring only allows :as after & binding" {:node pattern}))

          :else
          (recur (rest remaining) (conj positionals item) rest-pat as-pat seen-rest)))))

    (= mode :map)
    (let [entries (map-entries pattern)]
      (if (not (= 0 (% (count entries) 2)))
        (throw (ex-info "map destructuring expects key/value pairs" {:node pattern}))
        (loop [remaining entries
               bindings []
               as-pat nil
               defaults []]
          (if (or (nil? remaining) (empty? remaining))
            (let [with-as (if (nil? as-pat)
                            state
                            (bind-pattern-node :pattern state as-pat source))]
              (loop [remaining bindings st with-as]
                (if (or (nil? remaining) (empty? remaining))
                  st
                  (let [b (first remaining)
                        binding (:binding b)
                        binding-node (unwrap-ast binding)]
                    (if (and (= :symbol (:kind binding-node))
                             (has-or-default? defaults (:name binding-node)))
                      (let [out (apply-or-default st source (:key b) (:name binding-node)
                                                  (or-default-node defaults (:name binding-node)))]
                        (recur (rest remaining)
                               (bind-pattern-node :pattern (:state out) binding (:expr out))))
                      (recur (rest remaining)
                             (bind-pattern-node :pattern st binding
                                                (literal-rt-call "Get" [source (:key b)]))))))))
            (let [key (first remaining)
                  value (first (rest remaining))
                  key-node (unwrap-ast key)]
              (if (and (= :keyword (:kind key-node))
                       (or (= "as" (:name key-node))
                           (= "or" (:name key-node))
                           (= "keys" (:name key-node))
                           (= "syms" (:name key-node))
                           (= "strs" (:name key-node))))
                (cond
                  (= "as" (:name key-node))
                  (recur (rest (rest remaining)) bindings value defaults)

                  (= "or" (:name key-node))
                  (recur (rest (rest remaining)) bindings as-pat (collect-or-defaults defaults value))

                  :else
                  (recur (rest (rest remaining))
                         (append-bindings bindings (expand-destructure-special (:name key-node) value))
                         as-pat
                         defaults))
                (recur (rest (rest remaining))
                       (conj bindings {:key (map-destructure-key-ir key) :binding value})
                       as-pat
                       defaults)))))))

    :else (throw (ex-info "unsupported bind-pattern mode" {:mode mode}))))

(defn bind-pattern [state pattern source]
  (bind-pattern-node :pattern state pattern source))

(defn bind-params-to-ir
  ([params-ast label locals]
   (bind-params-to-ir params-ast label locals {} nil))
  ([params-ast label locals ctx compile-form]
  (loop [remaining (ast-seq params-ast)
         idx 0
         state {:params []
                :init-stmts []
                :locals (if (or (nil? locals) (empty? locals)) {} locals)
                :declared {}
                :temp 0
                :has-rest false
                :form-ctx ctx
                :compile-form compile-form}]
    (if (or (nil? remaining) (empty? remaining))
      {:params (:params state)
       :init-stmts (:init-stmts state)
       :locals (:locals state)
       :has-rest (:has-rest state)
       :ctx (:form-ctx state)}
      (let [node (unwrap-ast (first remaining))]
        (if (and (= :symbol (:kind node)) (= "&" (:name node)))
          (if (:has-rest state)
            (throw (ex-info (str label " parameters support only one & binding") {:label label}))
            (if (or (nil? (rest remaining)) (empty? (rest remaining)))
              (throw (ex-info (str label " & expects a binding form") {:label label}))
              (let [rest-pat (first (rest remaining))
                    rest-node (unwrap-ast rest-pat)
                    t (fresh-temp state "__rest")
                    rest-name (:name t)
                    st1 (:state t)
                    ctor (if (= :map (:kind rest-node))
                           "NewMap"
                           "NewArray")
                    source (rest-source-ir (count (:params st1)) ctor)
                    st2 (assoc st1 :has-rest true)
                    st3 (assoc st2 :locals (assoc (:locals st2) rest-name :value))
                    st4 (assoc st3 :init-stmts
                               (conj (conj (:init-stmts st3)
                                           {:kind :var :name rest-name :type "" :expr source})
                                     {:kind :expr-stmt
                                      :expr {:kind :ident :name rest-name}
                                      :discard true}))
                    st5 (bind-pattern st4 rest-pat {:kind :ident :name rest-name})]
                {:params (:params st5)
                 :init-stmts (:init-stmts st5)
                 :locals (:locals st5)
                 :has-rest true
                 :ctx (:form-ctx st5)})))
          (if (and (= :symbol (:kind node)) (not (= "" (:name node))))
            (recur (rest remaining) (inc idx) (bind-symbol-param state (:name node)))
            (if (or (sequential-binding? (:kind node)) (= :map (:kind node)))
              (let [param-name (str "__arg" idx)
                    st1 (assoc state :params (conj (:params state) param-name))
                    st2 (bind-pattern st1 node {:kind :ident :name param-name})]
                (recur (rest remaining) (inc idx) st2))
              (unhandled-param node)))))))))

(defn form-result [stmts expr kind ctx]
  {:stmts (stmt-list stmts)
   :expr expr
   :expr-kind kind
   :defer? false
   :ctx ctx})

(defn next-form-temp [ctx prefix]
  (let [cur (if (nil? (:if-temps ctx)) 0 (:if-temps ctx))
        n (inc cur)]
    {:name (str prefix "_" n)
     :ctx (assoc ctx :if-temps n)}))

(defn coerce-form-value [part]
  (let [k (:expr-kind part)]
    (cond
      (= k :string)
      (form-result (:stmts part)
                   (literal-rt-call "NewString" [(:expr part)])
                   :value
                   (:ctx part))
      (= k :bool)
      (form-result (:stmts part)
                   (literal-rt-call "NewBool" [(:expr part)])
                   :value
                   (:ctx part))
      (= k :defer)
      (throw (ex-info "cannot coerce a defer form to Value (defer is a statement)" {}))
      :else part)))

(defn form-value-ir [part]
  (:expr (coerce-form-value part)))

(defn eq-arg-ir [part]
  (let [k (:expr-kind part)]
    (cond
      (= k :value) (:expr part)
      (= k :string) (literal-rt-call "NewString" [(:expr part)])
      (= k :bool) (literal-rt-call "NewBool" [(:expr part)])
      :else (throw (ex-info "= arguments must evaluate to Value" {})))))

(defn value-arg-ir [part label]
  (let [k (:expr-kind part)]
    (cond
      (= k :value) (:expr part)
      (= k :string) (literal-rt-call "NewString" [(:expr part)])
      (= k :bool) (literal-rt-call "NewBool" [(:expr part)])
      :else (throw (ex-info (str label " expects an argument that evaluates to Value") {})))))

(defn wrap-value-arg-ir [part wrap? msg]
  (let [k (:expr-kind part)]
    (cond
      (= k :value) (:expr part)
      (= k :bool) (literal-rt-call "NewBool" [(:expr part)])
      (and wrap? (= k :string)) (literal-rt-call "NewString" [(:expr part)])
      :else (throw (ex-info (str msg) {})))))

(defn string-or-value-ir [part label]
  (let [k (:expr-kind part)]
    (if (or (= k :string) (= k :value))
      (:expr part)
      (throw (ex-info (str label " expects a string, symbol, or keyword argument") {})))))

(def remaining-runtime-ops
  #{"compare" "==" "<" "<=" ">" ">=" "symbol" "name" "keyword" "format"
    "map" "sort-by" "apply" "pmap" "filter" "reduce" "doall" "some" "set"
    "line-seq" "repeat" "rand-int" "to-json" "from-json"
    "open-file" "file-to-strings" "go-fn" "go-fn-args"})

(defn truthy-form-ir [part]
  (let [k (:expr-kind part)]
    (cond
      (= k :bool) (:expr part)
      (= k :value) (literal-rt-call "IsTruthy" [(:expr part)])
      (= k :string) {:kind :raw :code "true"}
      :else (throw (ex-info "unsupported if test expression" {:part part})))))

(defn go-type-for-kind [k]
  (cond
    (= k :string) "string"
    (= k :bool) "bool"
    :else "flagrt.Value"))

(defn form-defer-result [stmts stmt ctx]
  {:stmts (stmt-list stmts)
   :expr (literal-rt-call "NilValue" [])
   :expr-kind :defer
   :defer? true
   :stmt stmt
   :ctx ctx})

(defn forms-have-defer? [forms]
  (loop [remaining (stmt-list forms)]
    (if (or (nil? remaining) (empty? remaining))
      false
      (if (:defer? (first remaining))
        true
        (recur (rest remaining))))))

(defn list-head-name [node]
  (let [form (unwrap-ast node)]
    (if (not (= :list (:kind form)))
      nil
      (let [head (first (:elements form))]
        (if (and (not (nil? head)) (= :symbol (:kind head)))
          (:name head)
          nil)))))

(defn catch-type-name [node]
  (let [form (unwrap-ast node)
        kind (:kind form)]
    (cond
      (= kind :symbol)
      (let [n (:name form)]
        (if (or (= n "ExceptionInfo") (= n "Exception") (= n "Throwable"))
          n
          (throw (ex-info (str "unknown catch type " n " (expected ExceptionInfo, Exception, Throwable, or :default)") {}))))
      (= kind :keyword)
      (if (= (:name form) "default")
        ":default"
        (throw (ex-info (str "unknown catch type :" (:name form) " (expected :default)") {})))
      :else (throw (ex-info "catch type must be Exception, ExceptionInfo, Throwable, or :default" {})))))

(defn parse-catch-clause [node]
  (let [form (unwrap-ast node)
        elems (stmt-list (:elements form))]
    (if (or (nil? elems) (empty? (rest elems)) (empty? (rest (rest elems))))
      (throw (ex-info "catch expects type, name, and optional body" {:node node}))
      (let [class (catch-type-name (first (rest elems)))
            name-node (unwrap-ast (first (rest (rest elems))))]
        (if (or (not (= :symbol (:kind name-node))) (= "" (:name name-node)))
          (throw (ex-info "catch binding name must be a symbol" {:node name-node}))
          {:class class :name name-node :body (rest (rest (rest elems)))})))))

(defn split-try-body [args]
  (loop [remaining (stmt-list args) body []]
    (if (or (nil? remaining) (empty? remaining))
      {:remaining remaining :body body}
      (let [name (list-head-name (first remaining))]
        (if (or (= name "catch") (= name "finally"))
          {:remaining remaining :body body}
          (recur (rest remaining) (conj body (first remaining))))))))

(defn split-try-catches [args]
  (loop [remaining (stmt-list args) catches []]
    (if (or (nil? remaining) (empty? remaining))
      {:remaining remaining :catches catches}
      (let [name (list-head-name (first remaining))]
        (if (= name "catch")
          (recur (rest remaining) (conj catches (first remaining)))
          {:remaining remaining :catches catches})))))

(defn split-try-args [args]
  (let [body-part (split-try-body args)
        catch-part (split-try-catches (:remaining body-part))
        remaining (:remaining catch-part)]
    (if (or (nil? remaining) (empty? remaining))
      {:body (:body body-part) :catches (:catches catch-part) :finally nil}
      (let [name (list-head-name (first remaining))]
        (if (not (= name "finally"))
          (throw (ex-info "catch and finally clauses must come last in try" {}))
          (if (or (nil? (rest remaining)) (empty? (rest remaining)))
            {:body (:body body-part)
             :catches (:catches catch-part)
             :finally (rest (:elements (unwrap-ast (first remaining))))}
            (throw (ex-info "catch and finally clauses must come last in try" {}))))))))

(defn stringish-ir [part label]
  (let [k (:expr-kind part)]
    (cond
      (= k :string) (:expr part)
      (= k :value) (literal-rt-call "Str" [(:expr part)])
      :else (throw (ex-info (str label) {})))))

(defn write-to-ir [file content]
  (literal-rt-call "Write" [file content]))

(defn ends-with-to-ir [left right]
  {:kind :call
   :fun {:kind :selector :pkg "strings" :name "HasSuffix"}
   :args [left right]})

(defn testing-to-ir [body-stmts body-expr]
  (value-iife-ir
    (append-stmt
      (append-stmt body-stmts {:kind :expr-stmt :expr body-expr :discard true})
      {:kind :return :expr (literal-rt-call "NilValue" [])})))

(defn is-to-ir [test-stmts condition message]
  (value-iife-ir
    (append-stmt
      (append-stmt test-stmts
                   {:kind :if
                    :init ""
                    :cond {:kind :unary :op "!" :x condition}
                    :then [{:kind :expr-stmt
                            :expr (ident-call-ir "panic" [{:kind :string :value message}])
                            :discard false}]
                    :else []})
      {:kind :return :expr (literal-rt-call "NilValue" [])})))

(defn expect-exception-to-ir [body-stmts body-expr no-panic expected prefix]
  (let [base [{:kind :define :names ["r"] :expr (ident-call-ir "recover" [])}
              {:kind :if
               :init ""
               :cond {:kind :binary
                      :op "=="
                      :left {:kind :ident :name "r"}
                      :right {:kind :ident :name "nil"}}
               :then [{:kind :expr-stmt
                       :expr (ident-call-ir "panic" [{:kind :string :value no-panic}])
                       :discard false}]
               :else []}]
        recover-body (if (or (nil? expected) (= "" expected))
                       base
                       (append-stmt
                         (append-stmt base
                                      {:kind :define
                                       :names ["msg"]
                                       :expr {:kind :call
                                              :fun {:kind :selector :pkg "fmt" :name "Sprint"}
                                              :args [{:kind :ident :name "r"}]}})
                         {:kind :if
                          :init ""
                          :cond {:kind :unary
                                 :op "!"
                                 :x {:kind :call
                                     :fun {:kind :selector :pkg "strings" :name "Contains"}
                                     :args [{:kind :ident :name "msg"}
                                            {:kind :string :value expected}]}}
                          :then [{:kind :expr-stmt
                                  :expr (ident-call-ir "panic"
                                                       [{:kind :raw
                                                         :code (str (format "%q" (str prefix "expected exception matching " (format "%q" expected) ", got "))
                                                                    " + msg")}])
                                  :discard false}]
                          :else []}))]
    (value-iife-ir
      (append-stmt
        (concat-stmts
          [{:kind :defer
            :expr {:kind :call
                   :fun {:kind :func-lit :params "" :result "" :body recover-body}
                   :args []}}]
          (append-stmt body-stmts {:kind :expr-stmt :expr body-expr :discard true}))
        {:kind :return :expr (literal-rt-call "NilValue" [])}))))

(defn ast-form-source-node [mode node]
  (cond
    (= mode :join)
    (loop [remaining node out ""]
      (if (or (nil? remaining) (empty? remaining))
        out
        (let [piece (ast-form-source-node :form (first remaining))]
          (recur (rest remaining)
                 (if (= out "") piece (str out " " piece))))))

    :else
    (let [form (unwrap-ast node)
          kind (:kind form)]
      (cond
        (= kind :string) (format "%q" (:value form))
        (= kind :char) (str "\\" (:value form))
        (= kind :int) (str (:value form))
        (= kind :bigint) (str (:value form) "N")
        (= kind :float) (if (or (nil? (:raw form)) (= "" (:raw form))) (str (:value form)) (:raw form))
        (= kind :ratio) (str (:numerator form) "/" (:denominator form))
        (= kind :keyword) (str ":" (:name form))
        (= kind :symbol) (:name form)
        (= kind :quoted-symbol) (str "'" (:name form))
        (= kind :list) (str "(" (ast-form-source-node :join (:elements form)) ")")
        (= kind :vector) (str "[" (ast-form-source-node :join (:elements form)) "]")
        (= kind :pipe-vector) (str "|[" (ast-form-source-node :join (:elements form)) "]")
        (= kind :set) (str "#{" (ast-form-source-node :join (:elements form)) "}")
        (= kind :map) (str "{" (ast-form-source-node :join (:entries form)) "}")
        (= kind :hash-fn) (str "#(" (ast-form-source-node :join (:elements (:body form))) ")")
        :else (str kind)))))

(defn ast-form-source [node]
  (ast-form-source-node :form node))

(defn form-pos-prefix [form]
  (let [line (:line form)
        col (:col form)]
    (if (and (not (nil? line)) (> line 0))
      (str "at " line ":" (if (nil? col) 0 col) ": ")
      "")))

(defn form-at-suffix [form]
  (let [line (:line form)
        col (:col form)]
    (if (and (not (nil? line)) (> line 0))
      (str " at " line ":" (if (nil? col) 0 col))
      "")))

(defn restore-outer-scope [inner outer]
  (assoc inner
         :locals (:locals outer)
         :loop-binding-names (:loop-binding-names outer)))

(defn sanitize-keyword-ident [name]
  (loop [remaining (str name) out ""]
    (if (or (nil? remaining) (= 0 (count remaining)))
      out
      (let [ch (subs remaining 0 1)]
        (if (or (= ch "_")
                (str-has-char? go-ident-letters ch)
                (str-has-char? go-ident-digits ch))
          (recur (subs remaining 1) (str out ch))
          (recur (subs remaining 1) (str out "_")))))))

(defn truncate-hint [s]
  (let [text (str s)]
    (if (> (count text) 24)
      (subs text 0 24)
      text)))

(defn str-contains? [s needle]
  (let [text (str s)
        want (str needle)
        n (count want)]
    (if (or (nil? text) (= 0 n) (> n (count text)))
      false
      (loop [i 0]
        (if (> (+ i n) (count text))
          false
          (if (= want (subs text i (+ i n)))
            true
            (recur (inc i))))))))

(defn annotate-form-error [form t]
  (let [msg (ex-message t)]
    (if (or (nil? msg) (str-contains? msg " at "))
      t
      (ex-info (str msg (form-at-suffix form)) {}))))

(defn const-form? [node]
  (let [form (unwrap-ast node)
        kind (:kind form)]
    (cond
      (or (= kind :string) (= kind :char) (= kind :int) (= kind :float)
          (= kind :ratio) (= kind :bigint) (= kind :keyword)
          (= kind :quoted-symbol) (= kind :quoted-list))
      true
      (= kind :symbol)
      (or (= (:name form) "true") (= (:name form) "false") (= (:name form) "nil"))
      (or (= kind :vector) (= kind :pipe-vector) (= kind :set))
      (loop [remaining (stmt-list (:elements form))]
        (if (or (nil? remaining) (empty? remaining))
          true
          (if (const-form? (first remaining))
            (recur (rest remaining))
            false)))
      (= kind :map)
      (loop [remaining (stmt-list (:entries form))]
        (if (or (nil? remaining) (empty? remaining))
          true
          (if (const-form? (first remaining))
            (recur (rest remaining))
            false)))
      (= kind :meta) (const-form? (:target form))
      :else false)))

(defn intern-fresh-name [used base]
  (if (get used base)
    (loop [i 1]
      (let [v (str base "_" i)]
        (if (get used v)
          (recur (inc i))
          v)))
    base))

(defn intern-ir [constants hint code]
  (if (nil? constants)
    {:name code :constants nil}
    (let [by-code (or (:by-code constants) {})
          existing (get by-code code)]
      (if existing
        {:name existing :constants constants}
        (let [name (intern-fresh-name (or (:used constants) {}) (str "flag" hint))]
          {:name name
           :constants {:by-code (assoc by-code code name)
                       :used (assoc (or (:used constants) {}) name true)
                       :order (conj (or (:order constants) []) {:name name :code code})}})))))

(defn intern-decls [constants]
  (if (nil? constants)
    []
    (or (:order constants) [])))

(defn blank-str? [s]
  (or (nil? s) (= "" s)))

(defn join-ir-names [names]
  (loop [remaining (stmt-list names) out ""]
    (if (or (nil? remaining) (empty? remaining))
      out
      (let [piece (str (first remaining))]
        (recur (rest remaining)
               (if (= out "")
                 piece
                 (str out ", " piece)))))))

(defn render-ir-node [mode node indent]
  (cond
    (= mode :stmts)
    (loop [remaining (stmt-list node) out ""]
      (if (or (nil? remaining) (empty? remaining))
        out
        (recur (rest remaining)
               (str out (render-ir-node :stmt (first remaining) indent)))))

    (= mode :expr)
    (let [kind (:kind node)]
      (cond
        (= kind :ident) (:name node)
        (= kind :string) (format "%q" (:value node))
        (= kind :int) (str (:value node))
        (= kind :selector)
        (if (blank-str? (:pkg node))
          (:name node)
          (str (:pkg node) "." (:name node)))
        (= kind :call)
        (loop [remaining (stmt-list (:args node)) out "" first? true]
          (if (or (nil? remaining) (empty? remaining))
            (str (render-ir-node :expr (:fun node) "") "(" out ")")
            (let [arg (first remaining)
                  piece (if (= :spread (:kind arg))
                          (str (render-ir-node :expr (:expr arg) "") "...")
                          (render-ir-node :expr arg ""))]
              (if first?
                (recur (rest remaining) piece false)
                (recur (rest remaining) (str out ", " piece) false)))))
        (= kind :index)
        (str (render-ir-node :expr (:x node) "") "[" (render-ir-node :expr (:index node) "") "]")
        (= kind :slice)
        (let [low (if (nil? (:low node)) "" (render-ir-node :expr (:low node) ""))
              high (if (nil? (:high node)) "" (render-ir-node :expr (:high node) ""))]
          (str (render-ir-node :expr (:x node) "") "[" low ":" high "]"))
        (= kind :unary)
        (if (= "!" (:op node))
          (str "!(" (render-ir-node :expr (:x node) "") ")")
          (str (:op node) (render-ir-node :expr (:x node) "")))
        (= kind :binary)
        (str (render-ir-node :expr (:left node) "") " " (:op node) " " (render-ir-node :expr (:right node) ""))
        (= kind :func-lit)
        (let [result (:result node)
              head (if (blank-str? result)
                     (str "func(" (:params node) ")")
                     (str "func(" (:params node) ") " result))]
          (str head " {\n" (render-ir-node :stmts (:body node) "\t") "}"))
        (= kind :raw) (:code node)
        :else (throw (ex-info "unsupported IR expression" {:node node}))))

    (= mode :stmt)
    (let [kind (:kind node)]
      (cond
        (= kind :raw-stmt) (:code node)
        (= kind :expr-stmt)
        (if (:discard node)
          (str indent "_ = " (render-ir-node :expr (:expr node) "") "\n")
          (str indent (render-ir-node :expr (:expr node) "") "\n"))
        (= kind :return)
        (if (nil? (:expr node))
          (str indent "return\n")
          (str indent "return " (render-ir-node :expr (:expr node) "") "\n"))
        (= kind :defer)
        (str indent "defer " (render-ir-node :expr (:expr node) "") "\n")
        (= kind :go)
        (str indent "go " (render-ir-node :expr (:expr node) "") "\n")
        (= kind :var)
        (let [name (:name node)
              type (:type node)
              expr (:expr node)]
          (cond
            (and (not (blank-str? type)) (nil? expr))
            (str indent "var " name " " type "\n")
            (not (blank-str? type))
            (str indent "var " name " " type " = " (render-ir-node :expr expr "") "\n")
            :else
            (str indent "var " name " = " (render-ir-node :expr expr "") "\n")))
        (= kind :assign)
        (str indent (:name node) " = " (render-ir-node :expr (:expr node) "") "\n")
        (= kind :define)
        (str indent (join-ir-names (:names node)) " := " (render-ir-node :expr (:expr node) "") "\n")
        (= kind :if)
        (let [init (:init node)
              head (if (blank-str? init)
                     (str indent "if " (render-ir-node :expr (:cond node) "") " {\n")
                     (str indent "if " init "; " (render-ir-node :expr (:cond node) "") " {\n"))
              then-block (render-ir-node :stmts (:then node) (str indent "\t"))
              else-part (if (or (nil? (:else node)) (empty? (:else node)))
                          ""
                          (str indent "} else {\n"
                               (render-ir-node :stmts (:else node) (str indent "\t"))))]
          (str head then-block else-part indent "}\n"))
        (= kind :for)
        (str indent "for {\n"
             (render-ir-node :stmts (:body node) (str indent "\t"))
             indent "}\n")
        (= kind :block)
        (str indent "{\n"
             (render-ir-node :stmts (:body node) (str indent "\t"))
             indent "}\n")
        (= kind :func-decl)
        (let [result (:result node)
              head (if (blank-str? result)
                     (str indent "func " (:name node) "(" (:params node) ")")
                     (str indent "func " (:name node) "(" (:params node) ") " result))]
          (str head " {\n"
               (render-ir-node :stmts (:body node) (str indent "\t"))
               indent "}\n"))
        :else (throw (ex-info "unsupported IR statement" {:node node}))))

    :else (throw (ex-info "unsupported IR render mode" {:mode mode}))))

(defn render-ir [node]
  (render-ir-node :expr node ""))

(defn render-ir-stmt [node indent]
  (render-ir-node :stmt node indent))

(defn render-ir-stmts [stmts indent]
  (render-ir-node :stmts stmts indent))

(defn intern-form-ir [ctx hint ir]
  (if (nil? (:constants ctx))
    {:ir ir :ctx ctx}
    (let [code (render-ir ir)
          out (intern-ir (:constants ctx) hint code)]
      {:ir (if (= (:name out) code) ir {:kind :ident :name (:name out)})
       :ctx (assoc ctx :constants (:constants out))})))

(defn intern-new-string-ir [ctx expr]
  (let [hint (if (= :string (:kind expr))
               (str "Str_" (sanitize-keyword-ident (truncate-hint (str (:value expr)))))
               "Str_")]
    (intern-form-ir ctx hint (literal-rt-call "NewString" [expr]))))

(defn intern-string-part [part]
  (if (not (and (= :string (:expr-kind part))
                (= :string (:kind (:expr part)))))
    part
    (let [out (intern-new-string-ir (:ctx part) (:expr part))]
      (form-result (:stmts part) (:ir out) :value (:ctx out)))))

(defn intern-const-ctor [ctx hint ir const?]
  (if const?
    (intern-form-ir ctx hint ir)
    {:ir ir :ctx ctx}))

(defn intern-literal-form [form ctx]
  (let [kind (:kind form)
        ir (ast-node-to-ir form)]
    (cond
      (= kind :char) (intern-form-ir ctx "Char" ir)
      (= kind :bigint) (intern-form-ir ctx (str "Big_" (sanitize-keyword-ident (:value form))) ir)
      (= kind :ratio) (intern-form-ir ctx (str "Ratio_" (:numerator form) "_" (:denominator form)) ir)
      (= kind :keyword) (intern-form-ir ctx (str "Kw_" (sanitize-keyword-ident (:name form))) ir)
      (= kind :quoted-symbol) (intern-form-ir ctx (str "Sym_" (sanitize-keyword-ident (:name form))) ir)
      :else {:ir ir :ctx ctx})))

(defn digit-value [ch]
  (loop [digits go-ident-digits i 0]
    (if (or (nil? digits) (= 0 (count digits)))
      nil
      (if (= ch (subs digits 0 1))
        i
        (recur (subs digits 1) (inc i))))))

(defn positive-int-from-digits [s]
  (loop [i 0 n 0]
    (if (= i (count s))
      (if (= n 0) nil n)
      (let [d (digit-value (subs s i (inc i)))]
        (if (nil? d)
          nil
          (recur (inc i) (+ (* n 10) d)))))))

(defn hash-fn-placeholder-index [name]
  (if (= name "%")
    1
    (if (and (not (nil? name)) (> (count name) 1) (= "%" (subs name 0 1)))
      (positive-int-from-digits (subs name 1))
      nil)))

(defn hash-fn-node [mode node max]
  (cond
    (= mode :max-items)
    (loop [remaining (stmt-list node) m max]
      (if (or (nil? remaining) (empty? remaining))
        m
        (recur (rest remaining) (hash-fn-node :max (first remaining) m))))

    (= mode :replace-items)
    (loop [remaining (stmt-list node) out []]
      (if (or (nil? remaining) (empty? remaining))
        out
        (recur (rest remaining) (conj out (hash-fn-node :replace (first remaining) max)))))

    :else
    (if (nil? node)
      (if (= mode :max) max node)
      (let [kind (:kind node)]
        (cond
          (= kind :symbol)
          (let [idx (hash-fn-placeholder-index (:name node))]
            (if (nil? idx)
              (if (= mode :max) max node)
              (if (= mode :max)
                (if (> idx max) idx max)
                {:kind :symbol
                 :name (str "__p" idx)
                 :line (:line node)
                 :col (:col node)})))

          (= kind :list)
          (if (= mode :max)
            (hash-fn-node :max-items (:elements node) max)
            (assoc node :elements (hash-fn-node :replace-items (:elements node) max)))

          (= kind :vector)
          (if (= mode :max)
            (hash-fn-node :max-items (:elements node) max)
            (assoc node :elements (hash-fn-node :replace-items (:elements node) max)))

          (= kind :pipe-vector)
          (if (= mode :max)
            (hash-fn-node :max-items (:elements node) max)
            (assoc node :elements (hash-fn-node :replace-items (:elements node) max)))

          (= kind :set)
          (if (= mode :max)
            (hash-fn-node :max-items (:elements node) max)
            (assoc node :elements (hash-fn-node :replace-items (:elements node) max)))

          (= kind :map)
          (if (= mode :max)
            (hash-fn-node :max-items (:entries node) max)
            (assoc node :entries (hash-fn-node :replace-items (:entries node) max)))

          (= kind :hash-fn)
          (if (= mode :max) max node)

          (= kind :meta)
          (if (= mode :max)
            (hash-fn-node :max (:target node) (hash-fn-node :max (:meta node) max))
            (assoc (assoc node :meta (hash-fn-node :replace (:meta node) max))
                   :target (hash-fn-node :replace (:target node) max)))

          :else (if (= mode :max) max node))))))

(defn hash-fn-param-vector [n]
  (loop [i 1 out []]
    (if (> i n)
      {:kind :vector :elements out}
      (recur (inc i) (conj out {:kind :symbol :name (str "__p" i)})))))

(def control-forms
  #{"defer" "doto" "try" "doseq" "for" "testing" "is" "expect-exception"
    "catch" "finally"})

(defn compile-form-node [mode node ctx]
  (cond
    (= mode :seq)
    (loop [remaining node ctx ctx stmts [] irs []]
      (if (or (nil? remaining) (empty? remaining))
        {:stmts stmts :irs irs :ctx ctx}
        (let [part (coerce-form-value (intern-string-part (compile-form-node :form (first remaining) ctx)))]
          (recur (rest remaining)
                 (:ctx part)
                 (concat-stmts stmts (:stmts part))
                 (conj irs (:expr part))))))

    (= mode :ctor-seq)
    (let [items (first node)
          label (first (rest node))]
      (loop [remaining (stmt-list items) ctx ctx stmts [] irs []]
        (if (or (nil? remaining) (empty? remaining))
          {:stmts stmts :irs irs :ctx ctx}
          (let [item (first remaining)
                part (compile-form-node :form item ctx)
                k (:expr-kind part)]
            (cond
              (= k :value)
              (recur (rest remaining)
                     (:ctx part)
                     (concat-stmts stmts (:stmts part))
                     (conj irs (:expr part)))
              (= k :string)
              (let [wrapped (intern-string-part part)
                    ir (if (= :value (:expr-kind wrapped))
                         (:expr wrapped)
                         (literal-rt-call "NewString" [(:expr wrapped)]))]
                (recur (rest remaining)
                       (:ctx wrapped)
                       (concat-stmts stmts (:stmts wrapped))
                       (conj irs ir)))
              (= k :bool)
              (recur (rest remaining)
                     (:ctx part)
                     (concat-stmts stmts (:stmts part))
                     (conj irs (literal-rt-call "NewBool" [(:expr part)])))
              :else
              (throw (ex-info (str label (form-at-suffix item)) {})))))))

    (= mode :if)
    (let [args node
          n (count (stmt-list args))]
      (if (and (not (= n 2)) (not (= n 3)))
        (throw (ex-info "if expects test, true branch, and optional false branch" {:args args}))
        (let [cond-part (compile-form-node :form (first args) ctx)
              then0 (compile-form-node :form (first (rest args)) (:ctx cond-part))
              else0 (if (= n 3)
                      (compile-form-node :form (first (rest (rest args))) (:ctx then0))
                      (form-result [] (literal-rt-call "NilValue" []) :value (:ctx then0)))
              then1 (if (and (= n 3) (not (= (:expr-kind then0) (:expr-kind else0))))
                      (coerce-form-value then0)
                      then0)
              else1 (if (and (= n 3) (not (= (:expr-kind then1) (:expr-kind else0))))
                      (coerce-form-value else0)
                      else0)
              then2 (if (= n 2)
                      (coerce-form-value then1)
                      then1)
              tmp (next-form-temp (:ctx else1) "if_result")
              if-stmts (if-to-ir (:name tmp)
                                 (go-type-for-kind (:expr-kind then2))
                                 (truthy-form-ir cond-part)
                                 (:stmts then2)
                                 (:expr then2)
                                 (:stmts else1)
                                 (:expr else1))]
          (form-result (concat-stmts (:stmts cond-part) if-stmts)
                       {:kind :ident :name (:name tmp)}
                       (:expr-kind then2)
                       (:ctx tmp)))))

    (= mode :let)
    (let [args node
          outer-ctx ctx]
  (if (or (nil? args) (empty? args))
    (throw (ex-info "let expects a binding vector" {}))
    (let [bindings-node (unwrap-ast (first args))
          body (rest args)]
      (if (not (= :vector (:kind bindings-node)))
        (throw (ex-info "let expects a binding vector" {:node bindings-node}))
        (let [entries (ast-seq bindings-node)]
          (if (not (= 0 (% (count entries) 2)))
            (throw (ex-info "let binding vector expects name/value pairs" {}))
            (loop [remaining entries
                   ctx ctx
                   bind-stmts []
                   declared {}
                   bind-temp 0]
              (if (or (nil? remaining) (empty? remaining))
                (let [compiled (compile-form-node :forms body ctx)
                      tmp (next-form-temp (:ctx compiled) "let_result")
                      let-stmts (let-to-ir (:name tmp)
                                           (go-type-for-kind (:expr-kind compiled))
                                           bind-stmts
                                           (:stmts compiled)
                                           (:expr compiled))]
                  (form-result let-stmts
                               {:kind :ident :name (:name tmp)}
                               (:expr-kind compiled)
                               (restore-outer-scope (:ctx tmp) outer-ctx)))
                (let [parsed (parse-volatile (first remaining))
                      pat (:target parsed)
                      val-node (first (rest remaining))]
                  (if (not (= :symbol (:kind pat)))
                    (if (:volatile? parsed)
                      (throw (ex-info "volatile let binding currently supports symbol bindings only" {:node pat}))
                      (if (or (sequential-binding? (:kind pat)) (= :map (:kind pat)))
                        (let [part (coerce-form-value (compile-form-node :form val-node ctx))]
                          (if (not (= :value (:expr-kind part)))
                            (throw (ex-info "let binding value must evaluate to Value" {}))
                            (let [source-name (str "__bind" bind-temp)
                                  st0 {:params []
                                       :init-stmts (concat-stmts bind-stmts (:stmts part))
                                       :locals (if (nil? (:locals (:ctx part))) {} (:locals (:ctx part)))
                                       :declared declared
                                       :temp (inc bind-temp)
                                       :has-rest false
                                       :form-ctx (:ctx part)
                                       :compile-form (fn [n c] (compile-form-node :form n c))}
                                  st1 (assoc st0 :init-stmts
                                             (conj (:init-stmts st0)
                                                   {:kind :var :name source-name :type "" :expr (:expr part)}))
                                  st2 (bind-pattern st1 pat {:kind :ident :name source-name})]
                              (recur (rest (rest remaining))
                                     (assoc (or (:form-ctx st2) (:ctx part)) :locals (:locals st2))
                                     (:init-stmts st2)
                                     (:declared st2)
                                     (:temp st2)))))
                        (throw (ex-info "not handled by FLAG form lowering" {:node pat}))))
                    (if (= "" (:name pat))
                      (throw (ex-info "binding symbol cannot be empty" {:node pat}))
                      (let [raw (compile-form-node :form val-node ctx)
                            part (if (:volatile? parsed)
                                   (coerce-form-value raw)
                                   raw)
                            go-name (go-ident (:name pat))]
                        (if (contains? declared go-name)
                          (throw (ex-info (str "duplicate binding \"" (:name pat) "\"") {:name (:name pat)}))
                          (if (:volatile? parsed)
                            (if (not (= :value (:expr-kind part)))
                              (throw (ex-info "volatile let binding value must evaluate to Value" {}))
                              (let [source-name (str "__bind" bind-temp)
                                    next-ctx (assoc (:ctx part) :locals
                                                    (if (= go-name "_")
                                                      (:locals (:ctx part))
                                                      (assoc (:locals (:ctx part)) go-name :mutable-value)))
                                    stmts0 (concat-stmts bind-stmts (:stmts part))
                                    stmts1 (conj stmts0 {:kind :var :name source-name :type "" :expr (:expr part)})
                                    stmts2 (conj stmts1 {:kind :var :name go-name :type "" :expr {:kind :ident :name source-name}})
                                    stmts3 (append-unused stmts2 (:name pat) go-name)]
                                (recur (rest (rest remaining))
                                       next-ctx
                                       stmts3
                                       (if (= go-name "_") declared (assoc declared go-name true))
                                       (inc bind-temp))))
                            (let [next-ctx (assoc (:ctx part) :locals
                                                  (if (= go-name "_")
                                                    (:locals (:ctx part))
                                                    (assoc (:locals (:ctx part)) go-name (:expr-kind part))))
                                  stmts0 (concat-stmts bind-stmts (:stmts part))
                                  stmts1 (conj stmts0 {:kind :var
                                                       :name go-name
                                                       :type ""
                                                       :expr (:expr part)})
                                  stmts2 (append-unused stmts1 (:name pat) go-name)]
                              (recur (rest (rest remaining))
                                     next-ctx
                                     stmts2
                                     (if (= go-name "_")
                                       declared
                                       (assoc declared go-name true))
                                     bind-temp))))))))))))))))

    (= mode :fn)
    (let [args node]
      (if (not (= 2 (count (stmt-list args))))
        (throw (ex-info "fn expects parameter vector and body expression" {}))
        (let [params (first args)
              body (first (rest args))]
          (if (not (= :vector (:kind params)))
            (throw (ex-info "fn expects a parameter vector" {:node params}))
            (let [bound (bind-params-to-ir params "fn" (:locals ctx) ctx (fn [n c] (compile-form-node :form n c)))
                  inner (-> (if (nil? (:ctx bound)) ctx (:ctx bound))
                            (assoc :locals (:locals bound))
                            (assoc :loop-binding-names []))
                  compiled0 (compile-form-node :form body inner)
                  compiled (if (:defer? compiled0)
                             (form-result [] (do-defer-to-ir "flagrt.Value" [compiled0]) :value (:ctx compiled0))
                             (coerce-form-value compiled0))
                  ir (fn-to-ir "fn"
                               (:params bound)
                               (:has-rest bound)
                               (:init-stmts bound)
                               (:stmts compiled)
                               (:expr compiled))]
              (form-result [] ir :value (restore-outer-scope (:ctx compiled) ctx)))))))

    (= mode :update)
    (let [args node]
      (if (not (= 2 (count (stmt-list args))))
        (throw (ex-info "update! expects a mutable symbol and replacement value" {}))
        (let [target (unwrap-ast (first args))
              val-node (first (rest args))]
          (if (not (= :symbol (:kind target)))
            (throw (ex-info "update! first argument must be a mutable symbol" {:node target}))
            (let [ident (go-ident (:name target))
                 locals (:locals ctx)]
              (if (not (= :mutable-value (get locals ident)))
               (throw (ex-info "update! first argument must be a mutable let binding" {:name ident}))
               (let [part (coerce-form-value (compile-form-node :form val-node ctx))
                     ir (update-bang-to-ir ident (:stmts part) (:expr part))]
                 (form-result [] ir :value (:ctx part)))))))))

    (= mode :nil?)
    (if (not (= 1 (count (stmt-list node))))
      (throw (ex-info "nil? expects exactly one argument" {}))
      (let [part (compile-form-node :form (first node) ctx)]
        (form-result (:stmts part)
                    (nil-pred-to-ir (value-arg-ir part "nil?"))
                    :bool
                    (:ctx part))))

    (= mode :empty?)
    (if (not (= 1 (count (stmt-list node))))
      (throw (ex-info "empty? expects exactly one argument" {}))
      (let [part (compile-form-node :form (first node) ctx)]
        (form-result (:stmts part)
                    (empty-pred-to-ir (value-arg-ir part "empty?"))
                    :bool
                    (:ctx part))))

    (= mode :count)
    (if (not (= 1 (count (stmt-list node))))
      (throw (ex-info "count expects exactly one argument" {}))
      (let [part (compile-form-node :form (first node) ctx)]
        (form-result (:stmts part)
                    (count-to-ir (value-arg-ir part "count"))
                    :value
                    (:ctx part))))

    (= mode :throw)
    (if (not (= 1 (count (stmt-list node))))
      (throw (ex-info "throw expects exactly one argument" {}))
      (let [part (coerce-form-value (compile-form-node :form (first node) ctx))]
        (form-result [] (throw-to-ir (:stmts part) (:expr part)) :value (:ctx part))))

    (= mode :recur)
    (let [names (:loop-binding-names ctx)]
      (if (or (nil? names) (empty? names))
        (throw (ex-info "recur can only be used within loop" {}))
        (if (not (= (count (stmt-list node)) (count names)))
          (throw (ex-info (str "recur expects " (count names) " arguments") {}))
          (let [compiled (compile-form-node :seq node ctx)]
            (form-result (:stmts compiled)
                        (recur-to-ir (:irs compiled))
                        :value
                        (:ctx compiled))))))

    (= mode :loop)
    (let [args node
          outer-ctx ctx]
      (if (or (nil? args) (empty? args))
        (throw (ex-info "loop expects a binding vector" {}))
        (let [bindings-node (unwrap-ast (first args))
              body (rest args)]
          (if (not (= :vector (:kind bindings-node)))
            (throw (ex-info "loop expects a binding vector" {:node bindings-node}))
            (if (or (nil? body) (empty? body))
              (throw (ex-info "loop expects at least one body form" {}))
              (let [entries (ast-seq bindings-node)]
                (if (not (= 0 (% (count entries) 2)))
                 (throw (ex-info "loop binding vector expects name/value pairs" {}))
                 (loop [remaining entries
                        ctx ctx
                        init-stmts []
                        bindings []
                        names []
                        declared {}]
                   (if (or (nil? remaining) (empty? remaining))
                     (let [loop-ctx (assoc ctx :loop-binding-names names)
                           compiled (coerce-form-value (compile-form-node :forms body loop-ctx))]
                       (form-result []
                                    (loop-to-ir init-stmts bindings (:stmts compiled) (:expr compiled))
                                    :value
                                    (assoc (:ctx compiled)
                                           :locals (:locals outer-ctx)
                                           :loop-binding-names (:loop-binding-names outer-ctx))))
                     (let [pat (unwrap-ast (first remaining))
                           val-node (first (rest remaining))]
                       (if (or (not (= :symbol (:kind pat))) (= "" (:name pat)))
                         (throw (ex-info "loop bindings must be symbols" {:node pat}))
                         (let [go-name (go-ident (:name pat))]
                           (if (contains? declared go-name)
                             (throw (ex-info (str "duplicate loop binding \"" (:name pat) "\"") {:name (:name pat)}))
                             (let [locals (if (nil? (:locals ctx)) {} (:locals ctx))
                                   next-locals (if (= go-name "_")
                                                 locals
                                                 (assoc locals go-name :mutable-value))
                                   next-ctx (assoc ctx :locals next-locals)
                                   part (coerce-form-value (compile-form-node :form val-node next-ctx))
                                   unused (and (unused-binding? (:name pat)) (not (= go-name "_")))]
                               (recur (rest (rest remaining))
                                      (:ctx part)
                                      (concat-stmts init-stmts (:stmts part))
                                      (conj bindings {:name go-name :init (:expr part) :unused unused})
                                      (conj names go-name)
                                      (if (= go-name "_") declared (assoc declared go-name true)))))))))))))))))

    (= mode :str)
    (loop [remaining (stmt-list node) ctx ctx stmts [] irs []]
      (if (or (nil? remaining) (empty? remaining))
        (form-result stmts (str-to-ir irs) :string ctx)
        (let [part (compile-form-node :form (first remaining) ctx)
              ir (if (= :bool (:expr-kind part))
                   (literal-rt-call "NewBool" [(:expr part)])
                   (:expr part))]
          (recur (rest remaining)
                 (:ctx part)
                 (concat-stmts stmts (:stmts part))
                 (conj irs ir)))))

    (= mode :ex-info)
    (let [n (count (stmt-list node))]
      (if (and (not (= n 2)) (not (= n 3)))
        (throw (ex-info "ex-info expects message, data, and optional cause" {}))
        (let [msg-part (compile-form-node :form (first node) ctx)]
          (if (not (= :string (:expr-kind msg-part)))
            (throw (ex-info "ex-info message must be a string" {}))
            (let [data-part (coerce-form-value (compile-form-node :form (first (rest node)) (:ctx msg-part)))]
              (if (= n 2)
                (form-result (concat-stmts (:stmts msg-part) (:stmts data-part))
                             (ex-info-to-ir (:expr msg-part) (:expr data-part) nil)
                             :value
                             (:ctx data-part))
                (let [cause-part (coerce-form-value (compile-form-node :form (first (rest (rest node))) (:ctx data-part)))]
                  (form-result (concat-stmts (concat-stmts (:stmts msg-part) (:stmts data-part)) (:stmts cause-part))
                               (ex-info-to-ir (:expr msg-part) (:expr data-part) (:expr cause-part))
                               :value
                               (:ctx cause-part)))))))))

    (= mode :assoc)
    (let [args (stmt-list node)
          n (count args)]
      (if (or (nil? args) (empty? args) (empty? (rest args)) (empty? (rest (rest args))) (= 0 (% n 2)))
        (throw (ex-info "assoc expects collection and key/value pairs" {}))
        (loop [remaining args ctx ctx stmts [] irs []]
          (if (or (nil? remaining) (empty? remaining))
            (form-result stmts (assoc-to-ir irs) :value ctx)
            (let [part (compile-form-node :form (first remaining) ctx)]
              (recur (rest remaining)
                     (:ctx part)
                     (concat-stmts stmts (:stmts part))
                     (conj irs (wrap-value-arg-ir part false "assoc arguments must evaluate to Value"))))))))

    (= mode :conj)
    (if (or (nil? node) (empty? node) (empty? (rest node)))
      (throw (ex-info "conj expects collection and at least one item" {}))
      (loop [remaining (stmt-list node) ctx ctx stmts [] irs []]
        (if (or (nil? remaining) (empty? remaining))
          (form-result stmts (conj-to-ir irs) :value ctx)
          (let [part (compile-form-node :form (first remaining) ctx)]
            (recur (rest remaining)
                   (:ctx part)
                   (concat-stmts stmts (:stmts part))
                   (conj irs (wrap-value-arg-ir part true "conj arguments must evaluate to Value")))))))

    (= mode :seq-op)
    (if (not (= 1 (count (stmt-list node))))
      (throw (ex-info "seq expects exactly one argument" {}))
      (let [part (compile-form-node :form (first node) ctx)]
        (form-result (:stmts part)
                     (seq-to-ir (value-arg-ir part "seq"))
                     :value
                     (:ctx part))))

    (= mode :drop)
    (if (not (= 2 (count (stmt-list node))))
      (throw (ex-info "drop expects count and sequence" {}))
      (loop [remaining (stmt-list node) ctx ctx stmts [] irs []]
        (if (or (nil? remaining) (empty? remaining))
          (form-result stmts (drop-to-ir irs) :value ctx)
          (let [part (compile-form-node :form (first remaining) ctx)]
            (recur (rest remaining)
                   (:ctx part)
                   (concat-stmts stmts (:stmts part))
                   (conj irs (wrap-value-arg-ir part false "drop arguments must evaluate to Value")))))))

    (= mode :take)
    (if (not (= 2 (count (stmt-list node))))
      (throw (ex-info "take expects count and sequence" {}))
      (loop [remaining (stmt-list node) ctx ctx stmts [] irs []]
        (if (or (nil? remaining) (empty? remaining))
          (form-result stmts (take-to-ir irs) :value ctx)
          (let [part (compile-form-node :form (first remaining) ctx)]
            (recur (rest remaining)
                   (:ctx part)
                   (concat-stmts stmts (:stmts part))
                   (conj irs (wrap-value-arg-ir part false "take arguments must evaluate to Value")))))))

    (= mode :cons)
    (if (not (= 2 (count (stmt-list node))))
      (throw (ex-info "cons expects exactly two arguments" {}))
      (loop [remaining (stmt-list node) ctx ctx stmts [] irs []]
        (if (or (nil? remaining) (empty? remaining))
          (form-result stmts (cons-to-ir irs) :value ctx)
          (let [part (compile-form-node :form (first remaining) ctx)]
            (recur (rest remaining)
                   (:ctx part)
                   (concat-stmts stmts (:stmts part))
                   (conj irs (wrap-value-arg-ir part false "cons arguments must evaluate to Value")))))))

    (= mode :get)
    (let [n (count (stmt-list node))]
      (if (and (not (= n 2)) (not (= n 3)))
        (throw (ex-info "get expects collection, key, and optional default" {}))
        (loop [remaining (stmt-list node) ctx ctx stmts [] irs []]
          (if (or (nil? remaining) (empty? remaining))
            (form-result stmts (get-to-ir irs) :value ctx)
            (let [part (compile-form-node :form (first remaining) ctx)]
              (recur (rest remaining)
                     (:ctx part)
                     (concat-stmts stmts (:stmts part))
                     (conj irs (wrap-value-arg-ir part true "get arguments must evaluate to Value"))))))))

    (= mode :nth)
    (let [n (count (stmt-list node))]
      (if (and (not (= n 2)) (not (= n 3)))
        (throw (ex-info "nth expects collection, index, and optional default" {}))
        (loop [remaining (stmt-list node) ctx ctx stmts [] irs []]
          (if (or (nil? remaining) (empty? remaining))
            (form-result stmts (nth-to-ir irs) :value ctx)
            (let [part (compile-form-node :form (first remaining) ctx)]
              (recur (rest remaining)
                     (:ctx part)
                     (concat-stmts stmts (:stmts part))
                     (conj irs (wrap-value-arg-ir part true "nth arguments must evaluate to Value"))))))))

    (= mode :not-empty)
    (if (not (= 1 (count (stmt-list node))))
      (throw (ex-info "not-empty expects exactly one argument" {}))
      (let [part (compile-form-node :form (first node) ctx)]
        (form-result (:stmts part)
                     (not-empty-to-ir (wrap-value-arg-ir part false "not-empty expects an argument that evaluates to Value"))
                     :value
                     (:ctx part))))

    (= mode :type-of)
    (if (not (= 1 (count (stmt-list node))))
      (throw (ex-info "type-of expects exactly one argument" {}))
      (let [part (compile-form-node :form (first node) ctx)]
        (form-result (:stmts part)
                     (type-of-to-ir (value-arg-ir part "type-of"))
                     :value
                     (:ctx part))))

    (= mode :vec)
    (if (not (= 1 (count (stmt-list node))))
      (throw (ex-info "vec expects exactly one argument" {}))
      (let [part (compile-form-node :form (first node) ctx)]
        (form-result (:stmts part)
                     (vec-to-ir (value-arg-ir part "vec"))
                     :value
                     (:ctx part))))

    (= mode :dissoc)
    (if (or (nil? node) (empty? node))
      (throw (ex-info "dissoc expects a collection argument" {}))
      (loop [remaining (stmt-list node) ctx ctx stmts [] irs []]
        (if (or (nil? remaining) (empty? remaining))
          (form-result stmts (dissoc-to-ir irs) :value ctx)
          (let [part (compile-form-node :form (first remaining) ctx)]
            (recur (rest remaining)
                   (:ctx part)
                   (concat-stmts stmts (:stmts part))
                   (conj irs (wrap-value-arg-ir part false "dissoc arguments must evaluate to Value")))))))

    (= mode :contains?)
    (if (not (= 2 (count (stmt-list node))))
      (throw (ex-info "contains? expects collection and key" {}))
      (loop [remaining (stmt-list node) ctx ctx stmts [] irs []]
        (if (or (nil? remaining) (empty? remaining))
          (form-result stmts (contains-pred-to-ir irs) :bool ctx)
          (let [part (compile-form-node :form (first remaining) ctx)]
            (recur (rest remaining)
                   (:ctx part)
                   (concat-stmts stmts (:stmts part))
                   (conj irs (wrap-value-arg-ir part false "contains? arguments must evaluate to Value")))))))

    (= mode :list-ctor)
    (loop [remaining (stmt-list node) ctx ctx stmts [] irs []]
      (if (or (nil? remaining) (empty? remaining))
        (form-result stmts (ctor-to-ir "NewList" irs) :value ctx)
        (let [part (compile-form-node :form (first remaining) ctx)]
          (recur (rest remaining)
                 (:ctx part)
                 (concat-stmts stmts (:stmts part))
                 (conj irs (wrap-value-arg-ir part true "list entries must evaluate to Value"))))))

    (= mode :array-ctor)
    (loop [remaining (stmt-list node) ctx ctx stmts [] irs []]
      (if (or (nil? remaining) (empty? remaining))
        (form-result stmts (ctor-to-ir "NewArray" irs) :value ctx)
        (let [part (compile-form-node :form (first remaining) ctx)]
          (recur (rest remaining)
                 (:ctx part)
                 (concat-stmts stmts (:stmts part))
                 (conj irs (wrap-value-arg-ir part true "array entries must evaluate to Value"))))))

    (= mode :hash-map)
    (let [n (count (stmt-list node))]
      (if (not (= 0 (% n 2)))
        (throw (ex-info "hash-map expects key/value pairs" {}))
        (loop [remaining (stmt-list node) ctx ctx stmts [] irs []]
          (if (or (nil? remaining) (empty? remaining))
            (form-result stmts (ctor-to-ir "NewMap" irs) :value ctx)
            (let [part (compile-form-node :form (first remaining) ctx)]
              (recur (rest remaining)
                     (:ctx part)
                     (concat-stmts stmts (:stmts part))
                     (conj irs (wrap-value-arg-ir part true "hash-map entries must evaluate to Value"))))))))

    (= mode :into)
    (if (not (= 2 (count (stmt-list node))))
      (throw (ex-info "into expects exactly two arguments" {}))
      (let [target (compile-form-node :form (first node) ctx)]
        (if (not (= :value (:expr-kind target)))
          (throw (ex-info "into expects a collection Value as the first argument" {}))
          (let [from (compile-form-node :form (first (rest node)) (:ctx target))]
            (if (not (= :value (:expr-kind from)))
              (throw (ex-info "into expects a collection Value as the second argument" {}))
              (form-result (concat-stmts (:stmts target) (:stmts from))
                           (into-to-ir [(:expr target) (:expr from)])
                           :value
                           (:ctx from)))))))

    (= mode :concat)
    (loop [remaining (stmt-list node) ctx ctx stmts [] irs []]
      (if (or (nil? remaining) (empty? remaining))
        (form-result stmts (concat-to-ir irs) :value ctx)
        (let [part (compile-form-node :form (first remaining) ctx)]
          (recur (rest remaining)
                 (:ctx part)
                 (concat-stmts stmts (:stmts part))
                 (conj irs (wrap-value-arg-ir part true "concat arguments must evaluate to Value"))))))

    (= mode :ex-message)
    (if (not (= 1 (count (stmt-list node))))
      (throw (ex-info "ex-message expects exactly one argument" {}))
      (let [part (compile-form-node :form (first node) ctx)]
        (form-result (:stmts part)
                     (ex-message-to-ir (value-arg-ir part "ex-message"))
                     :value
                     (:ctx part))))

    (= mode :ex-data)
    (if (not (= 1 (count (stmt-list node))))
      (throw (ex-info "ex-data expects exactly one argument" {}))
      (let [part (compile-form-node :form (first node) ctx)]
        (form-result (:stmts part)
                     (ex-data-to-ir (value-arg-ir part "ex-data"))
                     :value
                     (:ctx part))))

    (= mode :ex-cause)
    (if (not (= 1 (count (stmt-list node))))
      (throw (ex-info "ex-cause expects exactly one argument" {}))
      (let [part (compile-form-node :form (first node) ctx)]
        (form-result (:stmts part)
                     (ex-cause-to-ir (value-arg-ir part "ex-cause"))
                     :value
                     (:ctx part))))

    (= mode :println)
    (loop [remaining (stmt-list node) ctx ctx stmts [] irs []]
      (if (or (nil? remaining) (empty? remaining))
        (form-result stmts (println-to-ir irs) :value ctx)
        (let [part (compile-form-node :form (first remaining) ctx)
              ir (if (= :bool (:expr-kind part))
                   (literal-rt-call "NewBool" [(:expr part)])
                   (:expr part))]
          (recur (rest remaining)
                 (:ctx part)
                 (concat-stmts stmts (:stmts part))
                 (conj irs ir)))))

    (= mode :value-args)
    (let [args (first node)
          wrap? (first (rest node))
          msg (first (rest (rest node)))]
      (loop [remaining (stmt-list args) ctx ctx stmts [] irs []]
        (if (or (nil? remaining) (empty? remaining))
          {:stmts stmts :irs irs :ctx ctx}
          (let [part0 (compile-form-node :form (first remaining) ctx)
                part (if wrap? (intern-string-part part0) part0)]
            (recur (rest remaining)
                   (:ctx part)
                   (concat-stmts stmts (:stmts part))
                   (conj irs (wrap-value-arg-ir part wrap? msg)))))))

    (= mode :runtime-op)
    (let [op (first node)
          args (first (rest node))]
      (cond
    (= op "compare")
    (if (not (= 2 (count (stmt-list args))))
      (throw (ex-info "compare expects exactly two arguments" {}))
      (let [compiled (compile-form-node :value-args [args true "compare arguments must evaluate to Value"] ctx)]
        (form-result (:stmts compiled) (compare-to-ir (:irs compiled)) :value (:ctx compiled))))

    (= op "==")
    (let [compiled (compile-form-node :value-args [args false "== arguments must evaluate to Value"] ctx)]
      (form-result (:stmts compiled) (numeric-eq-to-ir (:irs compiled)) :bool (:ctx compiled)))

    (or (= op "<") (= op "<=") (= op ">") (= op ">="))
    (if (or (nil? args) (empty? args) (empty? (rest args)))
      (throw (ex-info (str op " expects at least two arguments") {}))
      (let [rt (get {"<" "Lt" "<=" "Le" ">" "Gt" ">=" "Ge"} op)
            compiled (compile-form-node :value-args [args true (str op " expects numeric or string Value arguments")] ctx)]
        (form-result (:stmts compiled)
                     (comparison-to-ir rt (:irs compiled))
                     :bool
                     (:ctx compiled))))

    (= op "symbol")
    (if (not (= 1 (count (stmt-list args))))
      (throw (ex-info "symbol expects exactly one argument" {}))
      (let [part (compile-form-node :form (first args) ctx)]
        (form-result (:stmts part) (symbol-ctor-to-ir (string-or-value-ir part "symbol")) :value (:ctx part))))

    (= op "name")
    (if (not (= 1 (count (stmt-list args))))
      (throw (ex-info "name expects exactly one argument" {}))
      (let [part (compile-form-node :form (first args) ctx)]
        (form-result (:stmts part) (name-to-ir (string-or-value-ir part "name")) :string (:ctx part))))

    (= op "keyword")
    (if (not (= 1 (count (stmt-list args))))
      (throw (ex-info "keyword expects exactly one argument" {}))
      (let [part (compile-form-node :form (first args) ctx)]
        (form-result (:stmts part) (keyword-ctor-to-ir (string-or-value-ir part "keyword")) :value (:ctx part))))

    (= op "format")
    (if (or (nil? args) (empty? args))
      (throw (ex-info "format expects a format string and optional values" {}))
      (let [fmt-part (compile-form-node :form (first args) ctx)]
        (if (not (= :string (:expr-kind fmt-part)))
          (throw (ex-info "format expects a string format argument" {}))
          (let [compiled (compile-form-node :value-args [(rest args) true "function argument must evaluate to Value"] ctx)]
            (form-result (concat-stmts (:stmts fmt-part) (:stmts compiled))
                         (format-to-ir (concat [(:expr fmt-part)] (:irs compiled)))
                         :value
                         (:ctx compiled))))))

    (= op "map")
    (if (or (nil? args) (empty? args) (empty? (rest args)))
      (throw (ex-info "map expects function and at least one sequence" {}))
      (let [compiled (compile-form-node :value-args [args false "map arguments must evaluate to Value"] ctx)]
        (form-result (:stmts compiled) (map-to-ir (:irs compiled)) :value (:ctx compiled))))

    (= op "sort-by")
    (let [n (count (stmt-list args))]
      (if (and (not (= n 2)) (not (= n 3)))
        (throw (ex-info "sort-by expects key function, optional comparator, and collection" {}))
        (let [compiled (compile-form-node :value-args [args false "sort-by arguments must evaluate to Value"] ctx)]
          (form-result (:stmts compiled) (sort-by-to-ir (:irs compiled)) :value (:ctx compiled)))))

    (= op "apply")
    (if (or (nil? args) (empty? args) (empty? (rest args)))
      (throw (ex-info "apply expects function and at least one argument sequence" {}))
      (let [compiled (compile-form-node :value-args [args false "apply arguments must evaluate to Value"] ctx)]
        (form-result (:stmts compiled) (apply-to-ir (:irs compiled)) :value (:ctx compiled))))

    (= op "pmap")
    (if (or (nil? args) (empty? args) (empty? (rest args)))
      (throw (ex-info "pmap expects function and at least one sequence" {}))
      (let [compiled (compile-form-node :value-args [args false "pmap arguments must evaluate to Value"] ctx)]
        (form-result (:stmts compiled) (pmap-to-ir (:irs compiled)) :value (:ctx compiled))))

    (= op "filter")
    (if (not (= 2 (count (stmt-list args))))
      (throw (ex-info "filter expects function and one sequence" {}))
      (let [compiled (compile-form-node :value-args [args false "filter arguments must evaluate to Value"] ctx)]
        (form-result (:stmts compiled) (filter-to-ir (:irs compiled)) :value (:ctx compiled))))

    (= op "reduce")
    (let [n (count (stmt-list args))]
      (if (and (not (= n 2)) (not (= n 3)))
        (throw (ex-info "reduce expects function and collection, or function, initial value, and collection" {}))
        (let [compiled (compile-form-node :value-args [args false "reduce arguments must evaluate to Value"] ctx)]
          (form-result (:stmts compiled) (reduce-to-ir (:irs compiled)) :value (:ctx compiled)))))

    (= op "doall")
    (if (not (= 1 (count (stmt-list args))))
      (throw (ex-info "doall expects exactly one argument" {}))
      (let [part (compile-form-node :form (first args) ctx)]
        (form-result (:stmts part)
                     (doall-to-ir (wrap-value-arg-ir part false "doall expects an argument that evaluates to Value"))
                     :value
                     (:ctx part))))

    (= op "some")
    (if (not (= 2 (count (stmt-list args))))
      (throw (ex-info "some expects predicate and collection" {}))
      (let [compiled (compile-form-node :value-args [args false "some arguments must evaluate to Value"] ctx)]
        (form-result (:stmts compiled) (some-to-ir (:irs compiled)) :value (:ctx compiled))))

    (= op "set")
    (if (not (= 1 (count (stmt-list args))))
      (throw (ex-info "set expects exactly one argument" {}))
      (let [part (compile-form-node :form (first args) ctx)]
        (form-result (:stmts part)
                     (set-to-ir (wrap-value-arg-ir part false "set expects an argument that evaluates to Value"))
                     :value
                     (:ctx part))))

    (= op "line-seq")
    (if (not (= 1 (count (stmt-list args))))
      (throw (ex-info "line-seq expects exactly one argument" {}))
      (let [part (compile-form-node :form (first args) ctx)]
        (form-result (:stmts part)
                     (line-seq-to-ir (wrap-value-arg-ir part false "line-seq expects an argument that evaluates to Value"))
                     :value
                     (:ctx part))))

    (= op "repeat")
    (let [n (count (stmt-list args))]
      (if (and (not (= n 1)) (not (= n 2)))
        (throw (ex-info "repeat expects one or two arguments" {}))
        (let [compiled (compile-form-node :value-args [args true "repeat arguments must evaluate to Value"] ctx)]
          (form-result (:stmts compiled) (repeat-to-ir (:irs compiled)) :value (:ctx compiled)))))

    (= op "rand-int")
    (if (not (= 1 (count (stmt-list args))))
      (throw (ex-info "rand-int expects exactly one argument" {}))
      (let [part (compile-form-node :form (first args) ctx)]
        (form-result (:stmts part)
                     (rand-int-to-ir (wrap-value-arg-ir part false "rand-int expects an argument that evaluates to Value"))
                     :value
                     (:ctx part))))

    (= op "to-json")
    (if (not (= 1 (count (stmt-list args))))
      (throw (ex-info "to-json expects exactly one argument" {}))
      (let [part (compile-form-node :form (first args) ctx)]
        (form-result (:stmts part)
                     (to-json-to-ir (wrap-value-arg-ir part false "to-json expects an argument that evaluates to Value"))
                     :string
                     (:ctx part))))

    (= op "from-json")
    (if (not (= 1 (count (stmt-list args))))
      (throw (ex-info "from-json expects exactly one argument" {}))
      (let [part (compile-form-node :form (first args) ctx)]
        (if (not (= :string (:expr-kind part)))
          (throw (ex-info "from-json expects a string argument" {}))
          (form-result (:stmts part) (from-json-to-ir (:expr part)) :value (:ctx part)))))

    (= op "open-file")
    (if (not (= 1 (count (stmt-list args))))
      (throw (ex-info "open-file expects exactly one argument" {}))
      (let [part (compile-form-node :form (first args) ctx)
            k (:expr-kind part)
            arg (cond
                  (= k :string) (:expr part)
                  (= k :value) (name-to-ir (:expr part))
                  :else (throw (ex-info "open-file expects a string, symbol, or keyword argument" {})))]
        (form-result (:stmts part) (open-file-to-ir arg) :value (:ctx part))))

    (= op "file-to-strings")
    (if (not (= 1 (count (stmt-list args))))
      (throw (ex-info "file-to-strings expects exactly one argument" {}))
      (let [part (compile-form-node :form (first args) ctx)
            k (:expr-kind part)]
        (cond
          (= k :string)
          (form-result (:stmts part) (file-to-strings-path-to-ir (:expr part)) :value (:ctx part))
          (= k :value)
          (form-result (:stmts part) (file-to-strings-to-ir (:expr part)) :value (:ctx part))
          :else (throw (ex-info "file-to-strings expects a string, symbol, or keyword argument" {})))))

    (= op "go-fn")
    (if (not (= 1 (count (stmt-list args))))
      (throw (ex-info "go-fn expects exactly one argument" {}))
      (let [part (compile-form-node :form (first args) ctx)
            k (:expr-kind part)
            arg (cond
                  (= k :string) (:expr part)
                  (= k :value) (name-to-ir (:expr part))
                  :else (throw (ex-info "go-fn expects a string, symbol, or keyword argument" {})))]
        (form-result (:stmts part) (go-fn-to-ir arg) :value (:ctx part))))

    (= op "go-fn-args")
    (if (not (= 1 (count (stmt-list args))))
      (throw (ex-info "go-fn-args expects exactly one argument" {}))
      (let [part (compile-form-node :form (first args) ctx)
            k (:expr-kind part)
            arg (cond
                  (= k :string) (:expr part)
                  (= k :value) (name-to-ir (:expr part))
                  :else (throw (ex-info "go-fn-args expects a string, symbol, or keyword argument" {})))]
        (form-result (:stmts part) (go-fn-args-to-ir arg) :value (:ctx part))))

    :else (throw (ex-info "unsupported remaining runtime op" {:op op}))))

    (= mode :dot)
    (let [name (first node)
          args (first (rest node))]
      (cond
        (= name ".write")
        (if (not (= 2 (count (stmt-list args))))
          (throw (ex-info ".write expects file and content" {}))
          (let [file-part (compile-form-node :form (first args) ctx)]
            (if (not (= :value (:expr-kind file-part)))
              (throw (ex-info ".write expects a file Value" {}))
              (let [content-part (compile-form-node :form (first (rest args)) (:ctx file-part))]
                (form-result (concat-stmts (:stmts file-part) (:stmts content-part))
                             (write-to-ir (:expr file-part)
                                          (stringish-ir content-part ".write content must be string-like"))
                             :value
                             (:ctx content-part))))))

        (= name ".endsWith")
        (if (not (= 2 (count (stmt-list args))))
          (throw (ex-info ".endsWith expects string and suffix" {}))
          (let [left (compile-form-node :form (first args) ctx)
                right (compile-form-node :form (first (rest args)) (:ctx left))]
            (form-result (concat-stmts (:stmts left) (:stmts right))
                         (ends-with-to-ir (stringish-ir left ".endsWith expects a string-like value")
                                          (stringish-ir right ".endsWith expects a string-like value"))
                         :bool
                         (:ctx right))))

        :else (throw (ex-info (str "unsupported symbol \"" name "\"") {:name name}))))

    (= mode :call)
    (let [elements (:elements node)]
      (if (or (nil? elements) (empty? elements))
        (throw (ex-info "unsupported form" {:node node}))
        (let [head (first elements)
              args (rest elements)]
          (if (and (= :symbol (:kind head))
                  (not (= 0 (count (:name head))))
                  (= "." (subs (:name head) 0 1)))
            (compile-form-node :dot [(:name head) args] ctx)
          (if (= :symbol (:kind head))
            (let [op (:name head)
                  unary (get unary-runtime-ops op)
                  fold (get fold-runtime-ops op)
                  binary (get binary-runtime-ops op)
                  variadic (get variadic-runtime-ops op)]
              (cond
                (= op "if") (compile-form-node :if args ctx)
                (= op "do") (compile-form-node :forms args ctx)
                (= op "let") (compile-form-node :let args ctx)
                (= op "fn") (compile-form-node :fn args ctx)
                (= op "update!") (compile-form-node :update args ctx)
                (= op "nil?") (compile-form-node :nil? args ctx)
                (= op "empty?") (compile-form-node :empty? args ctx)
                (= op "count") (compile-form-node :count args ctx)
                (= op "throw") (compile-form-node :throw args ctx)
                (= op "loop") (compile-form-node :loop args ctx)
                (= op "recur") (compile-form-node :recur args ctx)
                (= op "str") (compile-form-node :str args ctx)
                (= op "ex-info") (compile-form-node :ex-info args ctx)
                (= op "assoc") (compile-form-node :assoc args ctx)
                (= op "conj") (compile-form-node :conj args ctx)
                (= op "seq") (compile-form-node :seq-op args ctx)
                (= op "drop") (compile-form-node :drop args ctx)
                (= op "take") (compile-form-node :take args ctx)
                (= op "cons") (compile-form-node :cons args ctx)
                (= op "get") (compile-form-node :get args ctx)
                (= op "nth") (compile-form-node :nth args ctx)
                (= op "not-empty") (compile-form-node :not-empty args ctx)
                (= op "type-of") (compile-form-node :type-of args ctx)
                (= op "vec") (compile-form-node :vec args ctx)
                (= op "dissoc") (compile-form-node :dissoc args ctx)
                (= op "contains?") (compile-form-node :contains? args ctx)
                (= op "list") (compile-form-node :list-ctor args ctx)
                (= op "array") (compile-form-node :array-ctor args ctx)
                (= op "hash-map") (compile-form-node :hash-map args ctx)
                (= op "into") (compile-form-node :into args ctx)
                (= op "concat") (compile-form-node :concat args ctx)
                (= op "ex-message") (compile-form-node :ex-message args ctx)
                (= op "ex-data") (compile-form-node :ex-data args ctx)
                (= op "ex-cause") (compile-form-node :ex-cause args ctx)
                (= op "println") (compile-form-node :println args ctx)
                (contains? control-forms op) (compile-form-node :control [op args node] ctx)
                (contains? remaining-runtime-ops op) (compile-form-node :runtime-op [op args] ctx)
                (= op "=")
                (if (or (nil? args) (empty? args) (empty? (rest args)))
                  (throw (ex-info "= expects at least two arguments" {}))
                  (loop [remaining args ctx ctx stmts [] irs []]
                    (if (or (nil? remaining) (empty? remaining))
                      (form-result stmts (eq-to-ir irs) :bool ctx)
                      (let [part (compile-form-node :form (first remaining) ctx)]
                        (recur (rest remaining)
                               (:ctx part)
                               (concat-stmts stmts (:stmts part))
                               (conj irs (eq-arg-ir part)))))))

                unary
                (if (not (= 1 (count args)))
                  (throw (ex-info (str op " expects exactly one argument") {:node node}))
                  (let [compiled (compile-form-node :seq args ctx)]
                    (form-result (:stmts compiled)
                                 (runtime-call-to-ir unary (:irs compiled))
                                 :value
                                 (:ctx compiled))))

                fold
                (let [compiled (compile-form-node :seq args ctx)]
                  (form-result (:stmts compiled)
                               (fold-call-to-ir fold (:irs compiled))
                               :value
                               (:ctx compiled)))

                binary
                (if (not (= 2 (count args)))
                  (throw (ex-info (str op " expects exactly two arguments") {:node node}))
                  (let [compiled (compile-form-node :seq args ctx)]
                    (form-result (:stmts compiled)
                                 (runtime-call-to-ir binary (:irs compiled))
                                 :value
                                 (:ctx compiled))))

                variadic
                (let [compiled (compile-form-node :seq args ctx)]
                  (form-result (:stmts compiled)
                               (runtime-call-to-ir variadic (:irs compiled))
                               :value
                               (:ctx compiled)))

                (contains? special-form-names op)
                (throw (ex-info "not handled by FLAG form lowering" {:node node}))

                :else
                (let [self-target (self-call-target op (count (stmt-list args)) ctx)]
                  (if (and self-target (not (= "" self-target)))
                    (let [compiled (compile-form-node :seq args ctx)]
                      (form-result (:stmts compiled)
                                   (ident-call-ir self-target (:irs compiled))
                                   :value
                                   (:ctx compiled)))
                    (let [callee (compile-form-node :form head ctx)
                          compiled (compile-form-node :seq args (:ctx callee))]
                      (form-result (concat-stmts (:stmts callee) (:stmts compiled))
                                   (call-to-ir (form-value-ir callee) (:irs compiled))
                                   :value
                                   (:ctx compiled)))))))
            (let [callee (compile-form-node :form head ctx)
                  compiled (compile-form-node :seq args (:ctx callee))]
              (form-result (concat-stmts (:stmts callee) (:stmts compiled))
                           (call-to-ir (form-value-ir callee) (:irs compiled))
                           :value
                           (:ctx compiled))))))))

    (= mode :form)
    (let [form (unwrap-ast node)
          kind (:kind form)]
      (try
      (cond
        (= kind :string) (form-result [] (ast-node-to-ir form) :string ctx)
        (= kind :char)
        (let [interned (intern-literal-form form ctx)]
          (form-result [] (:ir interned) :value (:ctx interned)))
        (= kind :int) (form-result [] (ast-node-to-ir form) :value ctx)
        (= kind :bigint)
        (let [interned (intern-literal-form form ctx)]
          (form-result [] (:ir interned) :value (:ctx interned)))
        (= kind :ratio)
        (let [interned (intern-literal-form form ctx)]
          (form-result [] (:ir interned) :value (:ctx interned)))
        (= kind :float) (form-result [] (ast-node-to-ir form) :value ctx)
        (= kind :keyword)
        (let [interned (intern-literal-form form ctx)]
          (form-result [] (:ir interned) :value (:ctx interned)))
        (= kind :quoted-symbol)
        (let [interned (intern-literal-form form ctx)]
          (form-result [] (:ir interned) :value (:ctx interned)))

        (= kind :symbol)
        (let [name (:name form)]
          (cond
            (= name "true") (form-result [] {:kind :raw :code "true"} :bool ctx)
            (= name "false") (form-result [] {:kind :raw :code "false"} :bool ctx)
            (= name "nil") (form-result [] (ast-node-to-ir form) :value ctx)
            :else
            (let [ident (go-ident-or-empty name)
                  resolved (symbol-to-ir name ident ctx)]
              (form-result [] (:ir resolved) (:expr-kind resolved) ctx))))

        (= kind :quoted-list)
        (let [interned (intern-form-ir ctx "List" (quoted-ast-to-ir form))]
          (form-result [] (:ir interned) :value (:ctx interned)))

        (= kind :vector)
        (let [compiled (compile-form-node :ctor-seq [(:elements form) "vector literal entries must evaluate to Value"] ctx)
              interned (intern-const-ctor (:ctx compiled) "Vec" (ctor-to-ir "NewArray" (:irs compiled)) (const-form? form))]
          (form-result (:stmts compiled) (:ir interned) :value (:ctx interned)))

        (= kind :pipe-vector)
        (let [compiled (compile-form-node :ctor-seq [(:elements form) "vector literal entries must evaluate to Value"] ctx)
              interned (intern-const-ctor (:ctx compiled) "PipeVec" (ctor-to-ir "NewVector" (:irs compiled)) (const-form? form))]
          (form-result (:stmts compiled) (:ir interned) :value (:ctx interned)))

        (= kind :set)
        (let [compiled (compile-form-node :ctor-seq [(:elements form) "set literal entries must evaluate to Value"] ctx)
              interned (intern-const-ctor (:ctx compiled) "Set" (ctor-to-ir "NewSet" (:irs compiled)) (const-form? form))]
          (form-result (:stmts compiled) (:ir interned) :value (:ctx interned)))

        (= kind :map)
        (let [entries (:entries form)
              n (if (nil? entries) 0 (count entries))]
          (if (not (= 0 (% n 2)))
            (throw (ex-info "map literal expects key/value pairs" {:node form}))
            (let [compiled (compile-form-node :ctor-seq [entries "map literal entries must evaluate to Value"] ctx)
                  interned (intern-const-ctor (:ctx compiled) "Map" (ctor-to-ir "NewMap" (:irs compiled)) (const-form? form))]
              (form-result (:stmts compiled) (:ir interned) :value (:ctx interned)))))

        (= kind :list) (compile-form-node :call form ctx)

        (= kind :hash-fn)
        (let [body (:body form)
              n (hash-fn-node :max body 0)
              params (hash-fn-param-vector n)
              rewritten (hash-fn-node :replace body 0)
              bound (bind-params-to-ir params "#()" (:locals ctx) ctx (fn [n c] (compile-form-node :form n c)))
              inner (-> (if (nil? (:ctx bound)) ctx (:ctx bound))
                        (assoc :locals (:locals bound))
                        (assoc :loop-binding-names []))
              compiled0 (compile-form-node :form rewritten inner)
              compiled (if (:defer? compiled0)
                         (form-result [] (do-defer-to-ir "flagrt.Value" [compiled0]) :value (:ctx compiled0))
                         (coerce-form-value compiled0))
              ir (fn-to-ir "#()"
                           (:params bound)
                           (:has-rest bound)
                           (:init-stmts bound)
                           (:stmts compiled)
                           (:expr compiled))]
          (form-result [] ir :value (restore-outer-scope (:ctx compiled) ctx)))

        :else (throw (ex-info "not handled by FLAG form lowering" {:node form})))
      (catch Throwable t
        (throw (annotate-form-error form t)))))

    (= mode :forms)
    (if (or (nil? node) (empty? node))
      (form-result [] (literal-rt-call "NilValue" []) :value ctx)
      (loop [remaining (stmt-list node) ctx ctx compiled []]
        (let [part (compile-form-node :form (first remaining) ctx)
              more (rest remaining)
              next-compiled (conj compiled part)]
          (if (or (nil? more) (empty? more))
            (if (forms-have-defer? next-compiled)
              (let [result-kind (if (:defer? part) :value (:expr-kind part))]
                (form-result []
                             (do-defer-to-ir (go-type-for-kind result-kind) next-compiled)
                             result-kind
                             (:ctx part)))
              (form-result (do-prelude-stmts next-compiled)
                           (:expr part)
                           (:expr-kind part)
                           (:ctx part)))
            (recur more (:ctx part) next-compiled)))))

    (= mode :control)
    (let [op (first node)
          args (first (rest node))
          form (first (rest (rest node)))]
      (cond
        (= op "catch")
        (throw (ex-info "catch used outside try" {}))

        (= op "finally")
        (throw (ex-info "finally used outside try" {}))

        (= op "defer")
        (if (not (= 1 (count (stmt-list args))))
          (throw (ex-info "defer expects a zero-argument function" {}))
          (let [part (coerce-form-value (compile-form-node :form (first args) ctx))]
            (form-defer-result (:stmts part) (defer-to-ir (:expr part)) (:ctx part))))

        (= op "doto")
        (if (or (nil? args) (empty? args))
          (throw (ex-info "doto expects a target and at least one form" {}))
          (let [target (coerce-form-value (compile-form-node :form (first args) ctx))]
            (loop [remaining (rest args) ctx (:ctx target) steps []]
              (if (or (nil? remaining) (empty? remaining))
                (form-result [] (doto-to-ir (:stmts target) (:expr target) steps) :value ctx)
                (let [step (coerce-form-value (compile-form-node :form (first remaining) ctx))]
                  (recur (rest remaining)
                         (:ctx step)
                         (conj steps {:stmts (:stmts step) :expr (:expr step)})))))))

        (= op "try") (compile-form-node :try args ctx)

        (= op "doseq")
        (if (or (nil? args) (empty? args) (empty? (rest args)))
          (throw (ex-info "doseq expects a binding vector and body" {}))
          (let [bindings-node (unwrap-ast (first args))]
            (if (not (= :vector (:kind bindings-node)))
              (throw (ex-info "doseq expects a binding vector" {:node bindings-node}))
              (let [entries (ast-seq bindings-node)]
                (if (not (= 0 (% (count entries) 2)))
                  (throw (ex-info "doseq binding vector expects name/value pairs" {}))
                  (let [loop-part (compile-form-node :seq-bindings ["doseq" entries (rest args)] ctx)]
                    (form-result (:stmts loop-part)
                                 (doseq-to-ir (:expr loop-part))
                                 :value
                                 (:ctx loop-part))))))))

        (= op "for")
        (if (or (nil? args) (empty? args) (empty? (rest args)))
          (throw (ex-info "for expects a binding vector and body" {}))
          (let [bindings-node (unwrap-ast (first args))]
            (if (not (= :vector (:kind bindings-node)))
              (throw (ex-info "for expects a binding vector" {:node bindings-node}))
              (let [entries (ast-seq bindings-node)]
                (if (not (= 0 (% (count entries) 2)))
                  (throw (ex-info "for binding vector expects name/value pairs" {}))
                  (compile-form-node :seq-bindings ["for" entries (rest args)] ctx))))))

        (= op "testing")
        (if (or (nil? args) (empty? args) (empty? (rest args)))
          (throw (ex-info "testing expects a label and body" {}))
          (let [label (unwrap-ast (first args))]
            (if (not (= :string (:kind label)))
              (throw (ex-info "testing expects a string label" {}))
              (if (= "" (:value label))
                (throw (ex-info "testing label cannot be empty" {}))
                (let [compiled (compile-form-node :forms (rest args) ctx)]
                  (form-result [] (testing-to-ir (:stmts compiled) (:expr compiled)) :value (:ctx compiled)))))))

        (= op "is")
        (let [n (count (stmt-list args))]
          (if (and (not (= n 1)) (not (= n 2)))
            (throw (ex-info "is expects an expression and optional message" {}))
            (let [test-part (compile-form-node :form (first args) ctx)
                  message (if (= n 2)
                            (let [msg (unwrap-ast (first (rest args)))]
                              (if (not (= :string (:kind msg)))
                                (throw (ex-info "is message must be a string" {}))
                                (:value msg)))
                            (ast-form-source (first args)))
                  prefixed (str (form-pos-prefix form) message)]
              (form-result []
                           (is-to-ir (:stmts test-part) (truthy-form-ir test-part) prefixed)
                           :value
                           (:ctx test-part)))))

        (= op "expect-exception")
        (let [n (count (stmt-list args))]
          (if (and (not (= n 1)) (not (= n 2)))
            (throw (ex-info "expect-exception expects an expression and optional message" {}))
            (let [body (compile-form-node :form (first args) ctx)
                  expected (if (= n 2)
                             (let [msg (unwrap-ast (first (rest args)))]
                               (if (not (= :string (:kind msg)))
                                 (throw (ex-info "expect-exception message must be a string" {}))
                                 (:value msg)))
                             "")
                  prefix (form-pos-prefix form)
                  source (ast-form-source (first args))
                  no-panic (str prefix "expected exception from " source)]
              (form-result []
                           (expect-exception-to-ir (:stmts body) (:expr body) no-panic expected prefix)
                           :value
                           (:ctx body)))))

        :else (throw (ex-info "unsupported control form" {:op op}))))

    (= mode :seq-bindings)
    (let [kind (first node)
          bindings (first (rest node))
          body (first (rest (rest node)))]
      (if (or (nil? body) (empty? body))
        (throw (ex-info (str kind " expects at least one body form") {}))
        (if (or (nil? bindings) (empty? bindings))
          (if (= kind "doseq")
            (let [compiled (compile-form-node :forms body ctx)
                  k (:expr-kind compiled)]
              (if (or (= k :value) (= k :string) (= k :bool))
                (form-result [] (doseq-body-to-ir (:stmts compiled) (:expr compiled)) :value (:ctx compiled))
                (throw (ex-info "doseq body must evaluate to Value" {}))))
            (let [compiled (coerce-form-value (compile-form-node :forms body ctx))]
              (form-result (:stmts compiled)
                           (ctor-to-ir "NewArray" [(:expr compiled)])
                           :value
                           (:ctx compiled))))
          (if (or (nil? (rest bindings)) (empty? (rest bindings)))
            (throw (ex-info (str kind " binding vector expects name/value pairs") {}))
            (let [name-node (unwrap-ast (first bindings))
                  coll-node (first (rest bindings))]
              (if (not (= :symbol (:kind name-node)))
                (throw (ex-info (str kind " binding name must be a symbol") {:node name-node}))
                (let [ident (go-ident (:name name-node))
                      coll (compile-form-node :form coll-node ctx)
                      coll-ir (wrap-value-arg-ir coll true (str kind " binding collection must evaluate to Value"))
                      locals (:locals (:ctx coll))
                      next-locals (if (= ident "_")
                                    locals
                                    (assoc (if (nil? locals) {} locals) ident :value))
                      next-ctx (assoc (:ctx coll) :locals next-locals)
                      rest-part (compile-form-node :seq-bindings [kind (rest (rest bindings)) body] next-ctx)
                      unused (and (unused-binding? (:name name-node)) (not (= ident "_")))
                      ir (mapcat-binding-to-ir ident
                                               unused
                                               (str kind " binding expects exactly one value")
                                               (:expr rest-part)
                                               (:stmts rest-part)
                                               coll-ir)]
                  (form-result (:stmts coll) ir :value (:ctx rest-part)))))))))

    (= mode :try)
    (let [parsed (split-try-args node)
          body-forms (:body parsed)
          catch-forms (:catches parsed)
          finally-forms (:finally parsed)
          body (if (or (nil? body-forms) (empty? body-forms))
                 (form-result [] (literal-rt-call "NilValue" []) :value ctx)
                 (coerce-form-value (compile-form-node :forms body-forms ctx)))]
      (if (and (or (nil? catch-forms) (empty? catch-forms)) (nil? finally-forms))
        body
        (loop [remaining (stmt-list catch-forms) ctx (:ctx body) catches []]
          (if (or (nil? remaining) (empty? remaining))
            (let [finally (if (nil? finally-forms)
                            nil
                            (compile-form-node :forms finally-forms ctx))]
              (form-result []
                           (try-to-ir (:stmts body) (:expr body) catches finally)
                           :value
                           (if (nil? finally) ctx (:ctx finally))))
            (let [clause (parse-catch-clause (first remaining))
                  ident (go-ident (:name (:name clause)))
                  locals (:locals ctx)
                  handler-locals (if (= ident "_")
                                   locals
                                   (assoc (if (nil? locals) {} locals) ident :value))
                  handler-ctx (assoc ctx :locals handler-locals)
                  handler-body (if (or (nil? (:body clause)) (empty? (:body clause)))
                                 (form-result [] (literal-rt-call "NilValue" []) :value handler-ctx)
                                 (coerce-form-value (compile-form-node :forms (:body clause) handler-ctx)))
                  handler (catch-handler-to-ir ident (:stmts handler-body) (:expr handler-body))]
              (recur (rest remaining)
                     (:ctx handler-body)
                     (conj catches {:class (:class clause) :stmts [] :handler handler})))))))

    :else (throw (ex-info "unsupported compile-form mode" {:mode mode}))))

(defn compile-form-to-ir [node ctx]
  (compile-form-node :form node ctx))

(defn compile-forms-to-ir [forms ctx]
  (compile-form-node :forms forms ctx))

(defn emit-doc-comment [doc]
  (if (or (nil? doc) (= "" doc))
    ""
    (loop [remaining doc out "" current ""]
      (if (or (nil? remaining) (= 0 (count remaining)))
        (if (= "" current)
          (str out "//\n")
          (str out "// " current "\n"))
        (let [ch (subs remaining 0 1)]
          (if (= ch "\n")
            (recur (subs remaining 1)
                   (if (= "" current)
                     (str out "//\n")
                     (str out "// " current "\n"))
                   "")
            (recur (subs remaining 1) out (str current ch))))))))

(defn emit-extra-imports [imports]
  (loop [remaining (stmt-list imports) out ""]
    (if (or (nil? remaining) (empty? remaining))
      out
      (let [imp (first remaining)]
        (recur (rest remaining)
               (str out "\t" (:name imp) " " (format "%q" (:path imp)) "\n"))))))

(defn ends-with-newline? [s]
  (if (or (nil? s) (= 0 (count s)))
    false
    (= "\n" (subs s (- (count s) 1)))))

(defn emit-type-decls [decls]
  (loop [remaining (stmt-list decls) out ""]
    (if (or (nil? remaining) (empty? remaining))
      out
      (let [decl (str (first remaining))
            with-nl (if (ends-with-newline? decl) decl (str decl "\n"))]
        (recur (rest remaining) (str out with-nl "\n"))))))

(defn emit-functions [fns]
  (loop [remaining (stmt-list fns) out ""]
    (if (or (nil? remaining) (empty? remaining))
      out
      (let [item (first remaining)]
        (recur (rest remaining)
               (str out (emit-doc-comment (:doc item)) (:source item) "\n"))))))

(defn emitted-var-expr [expr]
  (if (nil? expr)
    ""
    (if (:kind expr)
      (render-ir expr)
      (str expr))))

(defn emit-vars [vars]
  (loop [remaining (stmt-list vars) out ""]
    (if (or (nil? remaining) (empty? remaining))
      out
      (let [item (first remaining)]
        (recur (rest remaining)
               (str out
                    (emit-doc-comment (:doc item))
                    "var " (:go-name item) " = " (emitted-var-expr (:expr item)) "\n"))))))

(defn find-named-function [fns want]
  (loop [remaining (stmt-list fns)]
    (if (or (nil? remaining) (empty? remaining))
      nil
      (if (= want (:flag-name (first remaining)))
        (first remaining)
        (recur (rest remaining))))))

(defn find-entry-function [fns]
  (let [flag-main (find-named-function fns "flag_main")]
    (if flag-main
      flag-main
      (loop [remaining (stmt-list fns)]
        (if (or (nil? remaining) (empty? remaining))
          nil
          (let [item (first remaining)]
            (if (or (= "main" (:flag-name item))
                    (= "flag_main" (:go-name item))
                    (= "main" (:go-name item)))
              item
              (recur (rest remaining)))))))))

(defn emit-imports [needs-fmt include-main tests entry extra]
  (str "import (\n"
       (if needs-fmt "\t\"fmt\"\n" "")
       (if include-main
         (str "\t\"strings\"\n"
              (if (or (not (or (nil? tests) (empty? tests))) entry)
                "\t\"os\"\n"
                ""))
         "")
       (emit-extra-imports extra)
       "\tflagrt \"flag-lang/runtime\"\n"
       ")\n\n"))

(defn emit-test-runner []
  (str "type flagTestCase struct {\n"
       "\tname string\n"
       "\tline int\n"
       "\tbody string\n"
       "\tfn func() flagrt.Value\n"
       "}\n\n"
       "func runFlagTestCase(tc flagTestCase) (passed bool) {\n"
       "\tdefer func() {\n"
       "\t\tif r := recover(); r != nil {\n"
       "\t\t\tfmt.Printf(\"FAIL %s (line %d)\\n%s\\n%s\\n\", tc.name, tc.line, tc.body, r)\n"
       "\t\t\treturn\n"
       "\t\t}\n"
       "\t\tpassed = true\n"
       "\t\tfmt.Printf(\"PASS %s\\n\", tc.name)\n"
       "\t}()\n"
       "\ttc.fn()\n"
       "\treturn passed\n"
       "}\n\n"))

(defn emit-test-cases [tests]
  (loop [remaining (stmt-list tests) out "\ttests := []flagTestCase{\n"]
    (if (or (nil? remaining) (empty? remaining))
      (str out "\t}\n")
      (let [tc (first remaining)]
        (recur (rest remaining)
               (str out
                    "\t\t{name: " (format "%q" (:label tc))
                    ", line: " (:line tc)
                    ", body: " (format "%q" (:body-source tc))
                    ", fn: " (:go-name tc) "},\n"))))))

(defn emitted-stmt-prelude [stmt]
  (if (not (nil? (:prelude-stmts stmt)))
    (render-ir-stmts (:prelude-stmts stmt) "\t")
    (let [prelude (or (:prelude stmt) "")]
      (if (or (nil? prelude) (= "" prelude))
        ""
        (if (ends-with-newline? prelude) prelude (str prelude "\n"))))))

(defn emitted-stmt-code [stmt]
  (if (not (nil? (:defer-stmt stmt)))
    (render-ir-stmt (:defer-stmt stmt) "")
    (if (:kind (:expr stmt))
      (render-ir (:expr stmt))
      (or (:code stmt) ""))))

(defn emit-main-stmts [stmts]
  (loop [remaining (stmt-list stmts) out ""]
    (if (or (nil? remaining) (empty? remaining))
      out
      (let [stmt (first remaining)
            prelude-out (emitted-stmt-prelude stmt)
            code (emitted-stmt-code stmt)
            line (if (= 0 (:kind stmt))
                   (str "\t" code "\n")
                   (str "\t_ = " code "\n"))]
        (recur (rest remaining) (str out prelude-out line))))))

(defn emit-entry-call [entry]
  (if (nil? entry)
    ""
    (if (or (:has-rest entry) (< 0 (or (:param-count entry) 0)))
      (str "\targs := make([]flagrt.Value, 0, len(os.Args)-1)\n"
           "\tfor _, arg := range os.Args[1:] {\n"
           "\t\targs = append(args, flagrt.NewString(arg))\n"
           "\t}\n"
           "\t_ = flagrt.Call(" (:go-name entry) ", args...)\n")
      (str "\t_ = flagrt.Call(" (:go-name entry) ")\n"))))

(defn emit-main [result entry]
  (let [tests (:tests result)]
    (str "func main() {\n"
         "\t_ = strings.HasSuffix\n"
         (if (or (nil? tests) (empty? tests))
           (str (emit-main-stmts (:stmts result))
                (emit-entry-call entry))
           (str (emit-test-cases tests)
                "\tpassed := 0\n"
                "\tfailed := 0\n"
                "\tfor _, tc := range tests {\n"
                "\t\tif runFlagTestCase(tc) {\n"
                "\t\t\tpassed++\n"
                "\t\t} else {\n"
                "\t\t\tfailed++\n"
                "\t\t}\n"
                "\t}\n"
                "\tfmt.Printf(\"%d passed, %d failed\\n\", passed, failed)\n"
                "\tif failed > 0 {\n"
                "\t\tos.Exit(1)\n"
                "\t}\n"))
         "}\n")))

(defn emit-go-file [pkg-name result include-main]
  (let [tests (:tests result)
        needs-fmt (if (or (nil? tests) (empty? tests))
                    (if (:needs-fmt result) true false)
                    true)
        entry (if include-main (find-entry-function (:functions result)) nil)
        vars (:vars result)
        ns-code (or (:namespace-code result) "")]
    (str "package " pkg-name "\n\n"
         (emit-imports needs-fmt include-main tests entry (:extra-imports result))
         ns-code
         (emit-type-decls (:type-decls result))
         (emit-functions (:functions result))
         (emit-vars vars)
         (if (or (nil? vars) (empty? vars)) "" "\n")
         (if (and include-main (not (or (nil? tests) (empty? tests))))
           (emit-test-runner)
           "")
         (if include-main
           (emit-main result entry)
           ""))))

(defn compile-program [pkg-name result include-main]
  ((go-fn "compiler/format-go-source") (emit-go-file pkg-name result include-main)))

(defn ast-symbol-name [node]
  (let [n (unwrap-ast node)]
    (if (and (= :symbol (:kind n)) (not (= "" (:name n))))
      (:name n)
      nil)))

(defn ast-elements [node]
  (let [els (:elements (unwrap-ast node))]
    (if (nil? els)
      []
      els)))

(defn flatten-form-expr [part]
  (if (or (nil? (:stmts part)) (empty? (:stmts part)))
    (:expr part)
    (value-iife-ir (append-stmt (:stmts part) {:kind :return :expr (:expr part)}))))

(defn module-list-source [forms]
  (str "(" (ast-form-source-node :join forms) ")"))

(defn compiled-inner-ctx [compiled]
  (if (nil? (:ctx compiled))
    compiled
    (:ctx compiled)))

(defn module-ctx-keep [outer inner]
  (-> outer
      (assoc :if-temps (:if-temps inner))
      (assoc :constants (or (:constants inner) (:constants outer)))))

(defn module-ctx-after-fn [outer compiled flag-name go-name]
  (let [inner (compiled-inner-ctx compiled)]
    (-> (module-ctx-keep outer inner)
        (assoc :functions (map-put (or (:functions outer) {}) go-name true))
        (assoc :globals (map-put (or (:globals outer) {}) go-name :value))
        (bind-module-name flag-name go-name))))

(defn module-ctx-after-def [outer compiled flag-name go-name]
  (let [inner (compiled-inner-ctx compiled)]
    (-> (module-ctx-keep outer inner)
        (assoc :globals (map-put (or (:globals outer) {}) go-name :value))
        (bind-module-name flag-name go-name))))

(defn module-ctx-after-test [outer compiled go-name]
  (let [inner (compiled-inner-ctx compiled)]
    (-> (module-ctx-keep outer inner)
        (assoc :functions (map-put (or (:functions outer) {}) go-name true)))))

(defn defn-var-binding [flag-name go-name variadic]
  {:flag-name flag-name
   :go-name go-name
   :doc ""
   :expr (:expr (defn-binding-to-ir go-name variadic))})

(defn ensure-unique-fn [ctx go-name kind]
  (if (and (get (:functions ctx) go-name) (not (:allow-redefine ctx)))
    (throw (ex-info (str kind " \"" go-name "\" already defined") {}))
    ctx))

(defn compile-single-arity-defn [name go-name doc rest-els ctx]
  (let [params-ast (unwrap-ast (first rest-els))]
    (if (not (= :vector (:kind params-ast)))
      (throw (ex-info "defn expects a parameter vector" {}))
      (let [body-els (rest rest-els)]
        (if (or (nil? body-els) (empty? body-els))
          (throw (ex-info "defn expects name, optional docstring, vector params, and body" {}))
          (let [bound (bind-params-to-ir params-ast "defn" (:locals ctx) ctx compile-form-to-ir)
                params (:params bound)
                has-rest (:has-rest bound)
                n (count (stmt-list params))
                variadic (str go-name "_variadic")
                arity-name (if has-rest variadic (str go-name "_arity_" n))
                fn-ctx (-> (if (nil? (:ctx bound)) ctx (:ctx bound))
                           (assoc :locals (:locals bound))
                           (assoc :self-function-name name)
                           (assoc :self-function-arity n)
                           (assoc :self-variadic-name (as-value variadic))
                           (assoc :self-function-rest has-rest)
                           (assoc :self-arity-name (as-value arity-name))
                           (assoc :globals (map-put (or (:globals ctx) {}) go-name :value))
                           (assoc :functions (map-put (or (:functions ctx) {}) go-name true))
                           (bind-module-name name go-name))
                compiled (coerce-form-value (compile-forms-to-ir body-els fn-ctx))
                decls (defn-to-ir arity-name variadic go-name params has-rest
                                  (:init-stmts bound) (:stmts compiled) (:expr compiled))]
            {:op :defn
             :function {:flag-name name
                        :go-name go-name
                        :variadic-name variadic
                        :arity-name arity-name
                        :has-rest has-rest
                        :doc doc
                        :params params
                        :ir-decls decls
                        :body-expr (:expr compiled)
                        :body-stmts (:stmts compiled)
                        :init-stmts (:init-stmts bound)}
             :var (defn-var-binding name go-name variadic)
             :ctx (module-ctx-after-fn ctx compiled name go-name)}))))))

(defn compile-multi-arity-pending [arity-forms go-name ctx]
  (loop [remaining arity-forms seen {} pending [] names {} counts []]
    (if (or (nil? remaining) (empty? remaining))
      {:pending pending :names names :counts counts}
      (let [raw (first remaining)
            list (unwrap-ast raw)]
        (if (or (not (= :list (:kind list))) (< (count (ast-elements list)) 2))
          (throw (ex-info "defn arity expects ([params] body...)" {}))
          (let [params-ast (unwrap-ast (first (ast-elements list)))]
            (if (not (= :vector (:kind params-ast)))
              (throw (ex-info "defn arity expects a parameter vector" {}))
              (let [bound (bind-params-to-ir params-ast "defn" (:locals ctx) ctx compile-form-to-ir)]
                (if (:has-rest bound)
                  (throw (ex-info "multi-arity defn does not yet support & rest" {}))
                  (let [params (:params bound)
                        n (count (stmt-list params))]
                    (if (get seen n)
                      (throw (ex-info (str "duplicate arity with " n " arguments") {}))
                      (let [arity-name (str go-name "_arity_" n)]
                        (recur (rest remaining)
                               (map-put seen n true)
                               (conj pending {:list list
                                              :params params
                                              :init-stmts (:init-stmts bound)
                                              :locals (:locals bound)
                                              :arity-name arity-name
                                              :n n})
                               (map-put names n arity-name)
                               (conj counts n))))))))))))))

(defn compile-multi-arity-defn [name go-name doc arity-forms ctx]
  (if (or (nil? arity-forms) (empty? arity-forms))
    (throw (ex-info "defn expects at least one arity" {}))
    (let [parsed (compile-multi-arity-pending arity-forms go-name ctx)
          variadic (str go-name "_variadic")
          fn-base (-> ctx
                      (assoc :self-function-name name)
                      (assoc :self-variadic-name (as-value variadic))
                      (assoc :self-arity-names (:names parsed))
                      (assoc :self-function-rest false)
                      (assoc :globals (map-put (or (:globals ctx) {}) go-name :value))
                      (assoc :functions (map-put (or (:functions ctx) {}) go-name true))
                      (bind-module-name name go-name))
          compiled (loop [remaining (:pending parsed) cur fn-base arities []]
                     (if (or (nil? remaining) (empty? remaining))
                       {:arities arities :ctx cur}
                       (let [item (first remaining)
                             body-els (rest (ast-elements (:list item)))
                             fn-ctx (-> cur
                                        (assoc :locals (:locals item))
                                        (assoc :self-function-arity (:n item))
                                        (assoc :self-arity-name (as-value (:arity-name item))))
                             body (coerce-form-value (compile-forms-to-ir body-els fn-ctx))]
                         (recur (rest remaining)
                                (:ctx body)
                                (conj arities {:name (:arity-name item)
                                               :params (:params item)
                                               :init-stmts (:init-stmts item)
                                               :body-stmts (:stmts body)
                                               :body-expr (:expr body)
                                               :n (:n item)})))))
          decls (defn-multi-to-ir variadic (multi-arity-expects-msg name (:counts parsed)) (:arities compiled))]
      {:op :defn
       :function {:flag-name name
                  :go-name go-name
                  :variadic-name variadic
                  :arity-name ""
                  :has-rest false
                  :doc doc
                  :params []
                  :ir-decls decls}
       :var (defn-var-binding name go-name variadic)
       :ctx (module-ctx-after-fn ctx (:ctx compiled) name go-name)})))

(defn compile-defn-form [form ctx]
  (let [els (ast-elements form)]
    (if (< (count els) 3)
      (throw (ex-info (str (form-pos-prefix form) "defn expects name, optional docstring, vector params, and body") {}))
      (let [name (ast-symbol-name (first (rest els)))]
        (if (nil? name)
          (throw (ex-info "defn expects a function name" {}))
          (let [go-name (def-go-ident ctx name)
                ctx (ensure-unique-fn ctx go-name "function")
                third (first (rest (rest els)))
                has-doc (and (not (nil? third)) (= :string (:kind (unwrap-ast third))))
                doc (if has-doc (:value (unwrap-ast third)) "")
                rest-els (if has-doc (rest (rest (rest els))) (rest (rest els)))]
            (if (or (nil? rest-els) (empty? rest-els))
              (throw (ex-info (str (form-pos-prefix form) "defn expects name, optional docstring, vector params, and body") {}))
              (let [head (unwrap-ast (first rest-els))]
                (if (= :list (:kind head))
                  (compile-multi-arity-defn name go-name doc rest-els ctx)
                  (if (or (nil? (rest rest-els)) (empty? (rest rest-els)))
                    (throw (ex-info (str (form-pos-prefix form) "defn expects name, optional docstring, vector params, and body") {}))
                    (compile-single-arity-defn name go-name doc rest-els ctx)))))))))))

(defn compile-def-form [form ctx]
  (let [els (ast-elements form)
        n (count els)]
    (if (and (not (= n 3)) (not (= n 4)))
      (throw (ex-info "def expects name, optional docstring, and value" {}))
      (let [name (ast-symbol-name (first (rest els)))]
        (if (nil? name)
          (throw (ex-info "def expects a symbol name" {}))
          (let [has-doc (= n 4)
                doc-node (if has-doc (unwrap-ast (first (rest (rest els)))) nil)]
            (if (and has-doc (not (= :string (:kind doc-node))))
              (throw (ex-info "def docstring must be a string" {}))
              (let [doc (if has-doc (:value doc-node) "")
                    value-node (if has-doc
                                 (first (rest (rest (rest els))))
                                 (first (rest (rest els))))
                    go-name (def-go-ident ctx name)
                    compiled (coerce-form-value (compile-form-to-ir value-node ctx))]
                (if (not (= :value (:expr-kind compiled)))
                  (throw (ex-info "def value must evaluate to Value" {}))
                  (let [next-ctx (module-ctx-after-def ctx compiled name go-name)]
                    {:op :def
                     :var {:flag-name name
                           :go-name go-name
                           :doc doc
                           :expr (flatten-form-expr compiled)}
                     :ctx next-ctx}))))))))))

(defn compile-declare-form [form ctx]
  (let [els (rest (ast-elements form))]
    (if (or (nil? els) (empty? els))
      (throw (ex-info (str "declare expects one or more names" (form-at-suffix form)) {}))
      (loop [remaining els ctx ctx names []]
        (if (or (nil? remaining) (empty? remaining))
          {:op :declare :names names :ctx ctx}
          (let [sym (unwrap-ast (first remaining))
                name (if (and (= :symbol (:kind sym)) (not (= "" (:name sym))))
                       (:name sym)
                       nil)]
            (if (nil? name)
              (throw (ex-info (str "declare expects symbols" (form-at-suffix (first remaining))) {}))
              (let [go-name (def-go-ident ctx name)]
                (recur (rest remaining)
                       (bind-module-name ctx name go-name)
                       (conj names {:flag-name name :go-name go-name}))))))))))

(defn merge-defined-names [defined names]
  (loop [remaining (stmt-list names) out defined]
    (if (or (nil? remaining) (empty? remaining))
      out
      (let [item (first remaining)]
        (recur (rest remaining)
               (map-put out (:flag-name item) (:go-name item)))))))

(defn compile-deftest-form [form ctx]
  (let [els (ast-elements form)]
    (if (< (count els) 3)
      (throw (ex-info "deftest expects a name and body" {}))
      (let [name (ast-symbol-name (first (rest els)))]
        (if (nil? name)
          (throw (ex-info "deftest expects a test name" {}))
          (let [go-name (def-go-ident ctx name)
                ctx (ensure-unique-fn ctx go-name "test")
                body-els (rest (rest els))
                compiled (compile-forms-to-ir body-els ctx)
                body-expr (testing-to-ir (:stmts compiled) (:expr compiled))
                decls (defn-to-ir go-name (str go-name "_variadic") go-name [] false [] [] body-expr)]
            {:op :deftest
             :function {:flag-name name
                        :go-name go-name
                        :variadic-name (str go-name "_variadic")
                        :arity-name go-name
                        :has-rest false
                        :doc ""
                        :params []
                        :ir-decls decls
                        :body-expr body-expr
                        :body-stmts []
                        :init-stmts []}
             :test {:go-name go-name
                    :label name
                    :line (if (nil? (:line form)) 0 (:line form))
                    :body-source (module-list-source body-els)}
             :ctx (module-ctx-after-test ctx compiled go-name)}))))))

(def reserved-go-idents
  #{"any" "append" "bool" "byte" "cap" "close" "complex" "copy" "delete"
    "error" "false" "float32" "float64" "imag" "int" "int8" "int16" "int32" "int64"
    "iota" "len" "make" "max" "min" "new" "nil" "panic" "print" "println"
    "real" "recover" "rune" "string" "true" "uint" "uint8" "uint16" "uint32" "uint64"
    "uintptr"})

(defn reserved-go-ident? [name]
  (or (contains? go-keywords name) (contains? reserved-go-idents name)))

(defn type-hint-to-go-type [hint]
  (cond
    (or (= hint "double") (= hint "float")) "float64"
    (or (= hint "long") (= hint "int")) "int64"
    (= hint "string") "string"
    (or (= hint "boolean") (= hint "bool")) "bool"
    :else nil))

(defn hyphen-ident-parts [name]
  (loop [remaining (str name) cur "" out []]
    (if (or (nil? remaining) (= 0 (count remaining)))
      (if (= cur "") out (conj out cur))
      (let [ch (subs remaining 0 1)]
        (if (= ch "-")
          (recur (subs remaining 1) "" (if (= cur "") out (conj out cur)))
          (recur (subs remaining 1) (str cur ch) out))))))

(defn exported-record-field-name [flag-name]
  (loop [remaining (hyphen-ident-parts flag-name) out ""]
    (if (or (nil? remaining) (empty? remaining))
      out
      (let [part (first remaining)]
        (recur (rest remaining)
               (str out (if (= part "eof") "EOF" (upcase-first-ident part))))))))

(defn record-param-name [flag-name]
  (let [param (go-ident flag-name)]
    (if (reserved-go-ident? param)
      (str param "_")
      param)))

(defn join-strings [items sep]
  (loop [remaining (stmt-list items) out ""]
    (if (or (nil? remaining) (empty? remaining))
      out
      (let [item (str (first remaining))]
        (recur (rest remaining)
               (if (= out "")
                 item
                 (str out sep item)))))))

(defn space-char? [ch]
  (or (= ch " ") (= ch "\t") (= ch "\n") (= ch "\r")))

(defn trim-space [s]
  (loop [text (str s)]
    (if (or (nil? text) (= 0 (count text)))
      ""
      (if (space-char? (subs text 0 1))
        (recur (subs text 1))
        (loop [end (count text)]
          (if (= 0 end)
            ""
            (if (space-char? (subs text (- end 1) end))
              (recur (- end 1))
              (subs text 0 end))))))))

(defn starts-with-str? [s prefix]
  (let [text (str s)
        want (str prefix)
        n (count want)]
    (and (>= (count text) n) (= want (subs text 0 n)))))

(defn format-go-source [src]
  ((go-fn "compiler/format-go-source") src))

(defn abs-path [path]
  ((go-fn "compiler/abs-path") path))

(defn cwd-path []
  ((go-fn "compiler/cwd-path")))

(defn path-join [a b]
  ((go-fn "compiler/path-join") a b))

(defn path-dir [path]
  ((go-fn "compiler/path-dir") path))

(defn path-ext [path]
  ((go-fn "compiler/path-ext") path))

(defn path-abs? [path]
  ((go-fn "compiler/path-abs?") path))

(defn path-stat-kind [path]
  ((go-fn "compiler/path-stat-kind") path))

(defn file-exists? [path]
  (= (path-stat-kind path) "file"))

(defn dir-exists? [path]
  (= (path-stat-kind path) "dir"))

(defn write-text-file [path contents]
  ((go-fn "compiler/write-text-file") path contents))

(defn read-text-file [path]
  ((go-fn "compiler/read-text-file") path))

(defn mkdir-all [path]
  ((go-fn "compiler/mkdir-all") path))

(defn go-mod-tidy [dir]
  ((go-fn "compiler/go-mod-tidy") dir))

(defn module-import-paths [path]
  ((go-fn "compiler/module-import-paths") path))

(defn add-library-root [dir seen roots]
  (let [abs (abs-path dir)]
    (if (contains? seen abs)
      {:seen seen :roots roots}
      {:seen (assoc seen abs true) :roots (conj roots abs)})))

(defn walk-library-root [start seen roots]
  (loop [dir start seen seen roots roots]
    (let [lib (path-join dir "libraries")
          added (if (dir-exists? lib)
                  (add-library-root dir seen roots)
                  {:seen seen :roots roots})
          seen2 (:seen added)
          roots2 (:roots added)
          gom (path-join dir "go.mod")]
      (if (file-exists? gom)
        (add-library-root dir seen2 roots2)
        (let [parent (path-dir dir)]
          (if (= parent dir)
            {:seen seen2 :roots roots2}
            (recur parent seen2 roots2)))))))

(defn library-search-roots [importer-path]
  (let [starts (if (or (nil? importer-path) (= importer-path ""))
                 [(cwd-path)]
                 [(path-dir importer-path) (cwd-path)])]
    (:roots (loop [remaining starts seen {} roots []]
              (if (or (nil? remaining) (empty? remaining))
                {:seen seen :roots roots}
                (let [walked (walk-library-root (first remaining) seen roots)]
                  (recur (rest remaining) (:seen walked) (:roots walked))))))))

(defn import-path-candidates [importer-path import-path]
  (if (path-abs? import-path)
    [import-path]
    (let [dir (path-dir importer-path)
          cwd (cwd-path)
          rel [(path-join dir import-path) (path-join cwd import-path)]]
      (loop [remaining (library-search-roots importer-path) out rel]
        (if (or (nil? remaining) (empty? remaining))
          out
          (recur (rest remaining)
                 (conj out (path-join (path-join (first remaining) "libraries") import-path))))))))

(defn try-source-file [abs tried]
  (if (file-exists? abs)
    {:path abs :tried tried}
    (if (= (path-ext abs) "")
      (loop [exts [".flag" ".lib" ".flaglib"] tried tried]
        (if (or (nil? exts) (empty? exts))
          {:path nil :tried tried}
          (let [with-ext (str abs (first exts))
                tried2 (conj tried with-ext)]
            (if (file-exists? with-ext)
              {:path with-ext :tried tried2}
              (recur (rest exts) tried2)))))
      {:path nil :tried tried})))

(defn resolve-import-path [importer-path import-path]
  (let [trimmed (trim-space import-path)]
    (if (= trimmed "")
      (throw (ex-info "empty import path" {}))
      (loop [cands (import-path-candidates importer-path trimmed) tried []]
        (if (or (nil? cands) (empty? cands))
          (throw (ex-info (str "not found (tried " (join-strings tried ", ") ")") {}))
          (let [abs (abs-path (first cands))
                hit (try-source-file abs (conj tried abs))]
            (if (nil? (:path hit))
              (recur (rest cands) (:tried hit))
              (:path hit))))))))

(defn load-program-modules [path seen stack order]
  (let [abs (abs-path path)]
    (if (contains? seen abs)
      {:seen seen :order order}
      (if (contains? stack abs)
        (throw (ex-info (str "circular import involving " abs) {}))
        (let [stack2 (assoc stack abs true)
              loaded (loop [remaining (or (module-import-paths abs) []) seen seen order order]
                       (if (or (nil? remaining) (empty? remaining))
                         {:seen seen :order order}
                         (let [resolved (resolve-import-path abs (str (first remaining)))
                               nested (load-program-modules resolved seen stack2 order)]
                           (recur (rest remaining) (:seen nested) (:order nested)))))]
          {:seen (assoc (:seen loaded) abs true)
           :order (conj (:order loaded) abs)})))))

(defn prologue-path []
  (let [cands [(path-join (cwd-path) "internal/compiler/prologue.flag")
               (path-join (cwd-path) "prologue.flag")]]
    (loop [remaining cands]
      (if (or (nil? remaining) (empty? remaining))
        ((go-fn "compiler/prologue-path"))
        (if (file-exists? (first remaining))
          (abs-path (first remaining))
          (recur (rest remaining)))))))

(defn load-program [entry-path]
  (let [abs (abs-path entry-path)
        kind (path-stat-kind abs)]
    (cond
      (= kind "missing")
      (throw (ex-info (str "stat " entry-path ": file does not exist") {}))
      (= kind "dir")
      (throw (ex-info (str "LoadProgram expects a file entry, got directory " abs " (pass main.flag or similar)") {}))
      :else
      (let [pro (prologue-path)
            base (if (= abs pro)
                   {:seen {} :order []}
                   (load-program-modules pro {} {} []))
            loaded (load-program-modules abs (:seen base) {} (:order base))]
        {:entry abs :modules (:order loaded)}))))

(defn go-package-name [namespace]
  (go-ident (ident-replace-char (str namespace) "." "_")))

(defn module-export-set [exports]
  (loop [remaining (or exports []) out {}]
    (if (or (nil? remaining) (empty? remaining))
      out
      (recur (rest remaining) (assoc out (as-value (str (first remaining))) true)))))

(defn validate-exports [mod defined defined-macros]
  (if (not (:has-header mod))
    nil
    (loop [remaining (or (:exports mod) [])]
      (if (or (nil? remaining) (empty? remaining))
        nil
        (let [name (as-value (str (first remaining)))]
          (if (or (contains? defined name) (contains? defined-macros name))
            (recur (rest remaining))
            (throw (ex-info (str "export \"" name "\" is not defined in module \"" (:namespace mod) "\"") {}))))))))

(defn add-go-import [ctx pkg-name]
  (let [path (str "flagbuild/" pkg-name)
        imports (or (:go-imports ctx) [])]
    (if (some (fn [imp] (= (:path imp) path)) imports)
      ctx
      (assoc ctx :go-imports (conj imports {:name pkg-name :path path})))))

(defn replace-nth [xs i value]
  (loop [remaining xs n 0 out []]
    (if (or (nil? remaining) (empty? remaining))
      out
      (recur (rest remaining) (inc n) (conj out (if (= n i) value (first remaining)))))))

(defn rename-defmacro [form name]
  (let [node (unwrap-ast form)
        els (or (:elements node) [])]
    (if (< (count els) 2)
      form
      (assoc node :elements (replace-nth els 1 {:kind :symbol
                                                :name name
                                                :line (:line node)
                                                :col (:col node)})))))

(defn defmacro-form-name [form]
  (let [els (ast-elements form)
        head (ast-symbol-name (first els))]
    (if (= head "defmacro")
      (ast-symbol-name (first (rest els)))
      nil)))

(defn collect-defmacros [forms]
  (loop [remaining (or forms []) out {}]
    (if (or (nil? remaining) (empty? remaining))
      out
      (let [name (defmacro-form-name (first remaining))]
        (if (nil? name)
          (recur (rest remaining) out)
          (recur (rest remaining) (assoc out name (first remaining))))))))

(defn seed-one-export [ctx prefix pkg-name package-mode? exp defs macros spec-path]
  (let [go-name (get defs exp)]
    (if go-name
      (let [ref (if package-mode? (str pkg-name "." go-name) go-name)]
        (bind-module-name ctx (as-value (str prefix "/" exp)) ref))
      (let [mac (get macros exp)]
        (if mac
          (assoc ctx :macro-forms (conj (or (:macro-forms ctx) []) (rename-defmacro mac (as-value (str prefix "/" exp)))))
          (throw (ex-info (str "import \"" spec-path "\": exported \"" exp "\" has no definition") {})))))))

(defn seed-one-refer [ctx pkg-name package-mode? ref-name exports defs macros spec-path]
  (if (not (contains? exports ref-name))
    (throw (ex-info (str "import \"" spec-path "\": cannot :refer \"" ref-name "\" (not in :exports)") {}))
    (let [go-name (get defs ref-name)]
      (if go-name
        (let [ref (if package-mode? (str pkg-name "." go-name) go-name)
              ns (:namespace ctx)
              mod0 (or (:module ctx) {})
              mod1 (dissoc mod0 ref-name)
              mod2 (if (or (nil? ns) (= "" ns))
                     mod1
                     (dissoc mod1 (as-value (str ns "/" ref-name))))
              ctx1 (assoc ctx :module mod2)]
          (try
            (bind-module-name ctx1 ref-name ref)
            (catch Throwable t
              (throw (ex-info (str "import \"" spec-path "\": :refer \"" ref-name "\": " (ex-message t)) {})))))
        (let [mac (get macros ref-name)]
          (if mac
            (assoc ctx :macro-forms (conj (or (:macro-forms ctx) []) (rename-defmacro mac ref-name)))
            (throw (ex-info (str "import \"" spec-path "\": referred \"" ref-name "\" has no definition") {}))))))))

(defn seed-one-import [ctx importer-path spec by-path module-defs module-macros used-prefixes]
  (let [spec-path (str (:path spec))
        resolved (resolve-import-path importer-path spec-path)
        provider (get by-path resolved)]
    (if (nil? provider)
      (throw (ex-info (str "import \"" spec-path "\": module not loaded") {}))
      (if (not (:has-header provider))
        (throw (ex-info (str "import \"" spec-path "\": target " resolved " has no module header") {}))
        (let [prefix (if (or (nil? (:as spec)) (= "" (:as spec)))
                       (:namespace provider)
                       (as-value (str (:as spec))))
              prev (get used-prefixes prefix)]
          (if (and prev (not (= prev resolved)))
            (throw (ex-info (str "import prefix \"" prefix "\" already used by " prev) {}))
            (let [exports (module-export-set (:exports provider))
                  defs (get module-defs resolved)
                  macros (or (get module-macros resolved) {})]
              (if (nil? defs)
                (throw (ex-info (str "import \"" spec-path "\": provider not compiled yet") {}))
                (let [package-mode? (if (:package-mode ctx) true false)
                      pkg-name (if package-mode? (go-package-name (:namespace provider)) "")
                      ctx1 (if (and package-mode?
                                    (not (:skip-go-import spec))
                                    (some (fn [exp] (get defs (str exp))) (or (:exports provider) [])))
                             (add-go-import ctx pkg-name)
                             ctx)
                      ctx2 (loop [remaining (or (:exports provider) []) ctx ctx1]
                             (if (or (nil? remaining) (empty? remaining))
                               ctx
                               (recur (rest remaining)
                                      (seed-one-export ctx prefix pkg-name package-mode?
                                                       (as-value (str (first remaining))) defs macros spec-path))))
                      refer-names (if (or (= :all (:refer spec)) (= "all" (:refer spec)))
                                    (or (:exports provider) [])
                                    (or (:refer spec) []))
                      ctx3 (loop [remaining refer-names ctx ctx2]
                             (if (or (nil? remaining) (empty? remaining))
                               ctx
                               (recur (rest remaining)
                                      (seed-one-refer ctx pkg-name package-mode?
                                                      (as-value (str (first remaining))) exports defs macros spec-path))))]
                  {:ctx ctx3 :used-prefixes (assoc used-prefixes prefix resolved)})))))))))

(defn seed-imports [ctx mod by-path module-defs module-macros]
  (loop [remaining (or (:imports mod) []) ctx ctx used {}]
    (if (or (nil? remaining) (empty? remaining))
      ctx
      (let [out (seed-one-import ctx (:path mod) (first remaining) by-path module-defs module-macros used)]
        (recur (rest remaining) (:ctx out) (:used-prefixes out))))))

(defn implicit-prologue-spec [prologue-path]
  {:path prologue-path :as "" :refer :all :skip-go-import true})

(defn with-implicit-prologue-import [mod prologue-path]
  (if (or (nil? prologue-path) (= "" prologue-path) (= (:path mod) prologue-path))
    mod
    (assoc mod :imports (into [(implicit-prologue-spec prologue-path)] (or (:imports mod) [])))))

(defn program-prologue-path [modules]
  (let [mod (first modules)]
    (if (and mod (= "prologue" (:namespace mod)))
      (:path mod)
      nil)))

(defn insert-sorted-string [xs s]
  (loop [remaining xs out []]
    (if (or (nil? remaining) (empty? remaining))
      (conj out s)
      (if (< (compare s (str (first remaining))) 0)
        (loop [more remaining acc (conj out s)]
          (if (or (nil? more) (empty? more))
            acc
            (recur (rest more) (conj acc (first more)))))
        (recur (rest remaining) (conj out (first remaining)))))))

(defn sort-strings [xs]
  (loop [remaining xs out []]
    (if (or (nil? remaining) (empty? remaining))
      out
      (recur (rest remaining) (insert-sorted-string out (str (first remaining)))))))

(defn unique-strings [xs]
  (loop [remaining xs seen {} out []]
    (if (or (nil? remaining) (empty? remaining))
      out
      (let [name (as-value (str (first remaining)))]
        (if (or (= name "") (contains? seen name))
          (recur (rest remaining) seen out)
          (recur (rest remaining) (assoc seen name true) (conj out name)))))))

(defn emit-flagi-go-exports [go-exports]
  (if (or (nil? go-exports) (empty? go-exports))
    ""
    (let [keys (sort-strings (keys go-exports))]
      (str "\n :go-exports {"
           (join-strings (loop [remaining keys out []]
                           (if (or (nil? remaining) (empty? remaining))
                             out
                             (let [k (str (first remaining))]
                               (recur (rest remaining)
                                      (conj out (str k " " (format "%q" (get go-exports k))))))))
                         " ")
           "}"))))

(defn emit-flagi [ns exports go-exports macros defined]
  (let [unique (sort-strings (unique-strings exports))
        header (str "{:namespace " (format "%q" ns)
                    (if (empty? unique)
                      ""
                      (str "\n :exports   [" (join-strings unique " ") "]"))
                    (emit-flagi-go-exports go-exports)
                    "}\n")
        macro-names (sort-strings (keys (or macros {})))
        macro-src (loop [remaining macro-names out ""]
                    (if (or (nil? remaining) (empty? remaining))
                      out
                      (recur (rest remaining)
                             (str out "\n" (ast-form-source (get macros (first remaining))) "\n"))))
        decls (loop [remaining unique out []]
                (if (or (nil? remaining) (empty? remaining))
                  out
                  (let [name (str (first remaining))]
                    (if (get macros name)
                      (recur (rest remaining) out)
                      (if (or (get defined name) (not (nil? (get go-exports name))))
                        (recur (rest remaining) (conj out name))
                        (recur (rest remaining) out))))))]
    (str header macro-src
         (if (empty? decls)
           ""
           (str "\n(declare " (join-strings decls " ") ")\n")))))

(defn seed-prologue-package-refs [ctx exports]
  (loop [remaining (keys (or exports {})) ctx ctx]
    (if (or (nil? remaining) (empty? remaining))
      ctx
      (let [name (as-value (str (first remaining)))
            prev (get (or (:module ctx) {}) name)]
        (if (and prev (str-contains? prev "."))
          (recur (rest remaining) ctx)
          (let [ref (as-value (str "prologue." (get exports name)))
                mod1 (assoc (or (:module ctx) {}) name ref)
                ns (:namespace ctx)
                mod2 (if (or (nil? ns) (= ns ""))
                       mod1
                      (assoc mod1 (as-value (str ns "/" name)) ref))]
            (recur (rest remaining) (assoc ctx :module mod2))))))))

(defn strip-inlined-prologue-name [ctx flag-name go-name]
  (let [fns (dissoc (or (:functions ctx) {}) go-name)
        globs (dissoc (or (:globals ctx) {}) go-name)
        mod (or (:module ctx) {})
        prev (get mod flag-name)
        mod1 (if (or (nil? flag-name) (= flag-name "")
                     (and prev (str-contains? prev ".")))
               mod
               (dissoc mod flag-name))
        ns (:namespace ctx)
        qual (if (or (nil? ns) (= ns "") (nil? flag-name) (= flag-name ""))
               ""
               (as-value (str ns "/" flag-name)))
        qprev (if (= qual "") nil (get mod1 qual))
        mod2 (if (or (= qual "") (and qprev (str-contains? qprev ".")))
               mod1
               (dissoc mod1 qual))]
    (-> ctx (assoc :functions fns) (assoc :globals globs) (assoc :module mod2))))

(defn strip-inlined-prologue [ctx names]
  (loop [remaining (or names []) ctx ctx]
    (if (or (nil? remaining) (empty? remaining))
      (-> ctx (assoc :prologue-fns []) (assoc :prologue-vars []))
      (let [item (first remaining)]
        (recur (rest remaining)
               (strip-inlined-prologue-name ctx (:flag-name item) (:go-name item)))))))

(defn result-refs-package? [result prefix]
  (or (some (fn [fn] (str-contains? (or (:source fn) "") prefix))
            (or (:functions result) []))
      (some (fn [v] (str-contains? (emitted-var-expr (:expr v)) prefix)) (or (:vars result) []))
      (some (fn [stmt] (or (str-contains? (emitted-stmt-code stmt) prefix)
                           (str-contains? (emitted-stmt-prelude stmt) prefix)))
            (or (:stmts result) []))
      (some (fn [decl] (str-contains? (str decl) prefix)) (or (:type-decls result) []))))

(defn expand-module-forms [seed forms]
  ((go-fn "compiler/expand-forms") (or seed []) (or forms [])))

(defn apply-go-exports [mod ctx]
  (loop [remaining (keys (or (:go-exports mod) {})) ctx ctx vars [] defined {}]
    (if (or (nil? remaining) (empty? remaining))
      {:ctx ctx :vars vars :defined defined}
      (let [local (as-value (str (first remaining)))
            host (as-value (str (get (:go-exports mod) local)))
            rt ((go-fn "compiler/go-bind-ident") host)
            go-name (as-value (def-go-ident ctx local))]
        (if (get (:globals ctx) go-name)
          (throw (ex-info (str "symbol \"" local "\" already defined") {}))
          (let [ctx1 (bind-module-name ctx local go-name)
                ctx2 (assoc ctx1 :globals (assoc (or (:globals ctx1) {}) go-name :value))]
            (recur (rest remaining)
                   ctx2
                   (conj vars {:flag-name local :go-name go-name :expr (as-value (str "flagrt." rt))})
                   (assoc defined local go-name))))))))

(defn intern-var-defs [constants]
  (loop [remaining (or (:order constants) []) out []]
    (if (or (nil? remaining) (empty? remaining))
      out
      (let [item (first remaining)]
        (recur (rest remaining)
               (conj out {:doc ""
                          :go-name (:name item)
                          :expr (:code item)}))))))

(defn merge-compile-defined [exported compiled]
  (into (or (:defined exported) {}) (or (:defined compiled) {})))

(defn append-compile-acc [acc compiled]
  {:type-decls (into (or (:type-decls acc) []) (or (:type-decls compiled) []))
   :functions (into (or (:functions acc) []) (or (:functions compiled) []))
   :vars (into (or (:vars acc) []) (or (:vars compiled) []))
   :stmts (into (or (:stmts acc) []) (or (:stmts compiled) []))
   :tests (into (or (:tests acc) []) (or (:tests compiled) []))
   :needs-fmt (if (or (:needs-fmt acc) (:needs-fmt compiled)) true false)})

(defn first-token [s]
  (loop [remaining (trim-space s) out ""]
    (if (or (nil? remaining) (= 0 (count remaining)))
      out
      (let [ch (subs remaining 0 1)]
        (if (space-char? ch)
          out
          (recur (subs remaining 1) (str out ch)))))))

(defn var-init-name [line]
  (let [trimmed (trim-space line)]
    (if (starts-with-str? trimmed "var ")
      (first-token (subs trimmed 4))
      "")))

(defn render-local-inits [lines]
  (loop [remaining (stmt-list lines) out ""]
    (if (or (nil? remaining) (empty? remaining))
      out
      (let [line (str (first remaining))
            name (var-init-name line)
            extra (if (= name "")
                    ""
                    (str "\t_ = " name "\n"))]
        (recur (rest remaining) (str out line extra))))))

(defn render-direct-param-list [params]
  (loop [remaining (stmt-list params) parts []]
    (if (or (nil? remaining) (empty? remaining))
      (join-strings parts ", ")
      (recur (rest remaining)
             (conj parts (str (first remaining) " flagrt.Value"))))))

(defn render-call-args [n]
  (loop [i 0 parts []]
    (if (= i n)
      (join-strings parts ", ")
      (recur (inc i) (conj parts (str "args[" i "]"))))))

(defn render-variadic-function-body [fn]
  (let [params (stmt-list (:params fn))
        n (count params)
        arity (:arity-name fn)]
    (str "\tif len(args) != " n " {\n"
         "\t\tpanic(" (format "%q" (str (:go-name fn) " expects exactly " n " arguments")) ")\n"
         "\t}\n"
         (if (= n 0)
           (str "\treturn " arity "()\n")
           (str "\treturn " arity "(" (render-call-args n) ")\n")))))

(defn render-standalone-variadic-body [fn]
  (let [params (stmt-list (:params fn))
        n (count params)
        check (if (:has-rest fn)
                (str "\tif len(args) < " n " {\n"
                     "\t\tpanic(" (format "%q" (str (:go-name fn) " expects at least " n " arguments")) ")\n"
                     "\t}\n")
                (str "\tif len(args) != " n " {\n"
                     "\t\tpanic(" (format "%q" (str (:go-name fn) " expects exactly " n " arguments")) ")\n"
                     "\t}\n"))
        binds (loop [remaining params i 0 out ""]
                (if (or (nil? remaining) (empty? remaining))
                  out
                  (let [param (str (first remaining))
                        line (if (= param "_")
                               (str "\t_ = args[" i "]\n")
                               (str "\t" param " := args[" i "]\n"))]
                    (recur (rest remaining) (inc i) (str out line)))))]
    (str check binds (render-local-inits (:local-inits fn)) (or (:body-prelude fn) "")
         "\treturn " (if (blank-str? (:body fn)) (or (:body-source fn) "") (:body fn)) "\n")))

(defn render-multi-arity-dispatch [fn]
  (let [arities (stmt-list (:arities fn))
        counts (loop [remaining arities out []]
                 (if (or (nil? remaining) (empty? remaining))
                   out
                   (recur (rest remaining)
                          (conj out (count (stmt-list (:params (first remaining))))))))
        cases (loop [remaining arities out "\tswitch len(args) {\n"]
                (if (or (nil? remaining) (empty? remaining))
                  out
                  (let [a (first remaining)
                        n (count (stmt-list (:params a)))
                        call (if (= n 0)
                               (str "\t\treturn " (:arity-name a) "()\n")
                               (str "\t\treturn " (:arity-name a) "(" (render-call-args n) ")\n"))]
                    (recur (rest remaining)
                           (str out "\tcase " n ":\n" call)))))]
    (str cases
         "\tdefault:\n\t\tpanic(" (format "%q" (multi-arity-expects-msg (:flag-name fn) counts)) ")\n"
         "\t}\n")))

(defn render-arity-function [parent arity]
  (str "func " (:arity-name arity) "(" (render-direct-param-list (:params arity)) ") flagrt.Value {\n"
       (render-local-inits (:local-inits arity))
       (or (:body-prelude arity) "")
       "\treturn " (:body arity) "\n}\n\n"))

(defn function-body-source [fn]
  (if (blank-str? (:body fn))
    (or (:body-source fn) "")
    (:body fn)))

(defn render-function-def [fn]
  (cond
    (not (blank-str? (:go-signature fn)))
    (str "func " (:go-name fn) (:go-signature fn) " {\n" (function-body-source fn) "}\n")

    (not (or (nil? (:ir-decls fn)) (empty? (:ir-decls fn))))
    (render-ir-stmts (:ir-decls fn) "")

    (not (or (nil? (:arities fn)) (empty? (:arities fn))))
    (str (loop [remaining (stmt-list (:arities fn)) out ""]
           (if (or (nil? remaining) (empty? remaining))
             out
             (recur (rest remaining)
                    (str out (render-arity-function fn (first remaining))))))
         "func " (:variadic-name fn) "(args ...flagrt.Value) flagrt.Value {\n"
         (render-multi-arity-dispatch fn)
         "}\n")

    (:has-rest fn)
    (str "func " (:variadic-name fn) "(args ...flagrt.Value) flagrt.Value {\n"
         (render-standalone-variadic-body fn)
         "}\n")

    :else
    (str "func " (:arity-name fn) "(" (render-direct-param-list (:params fn)) ") flagrt.Value {\n"
         (render-local-inits (:local-inits fn))
         (or (:body-prelude fn) "")
         "\treturn " (function-body-source fn) "\n}\n\n"
         "func " (:variadic-name fn) "(args ...flagrt.Value) flagrt.Value {\n"
         (render-variadic-function-body fn)
         "}\n")))

(defn render-direct-param-types [params]
  (loop [remaining (stmt-list params) parts []]
    (if (or (nil? remaining) (empty? remaining))
      (join-strings parts ", ")
      (recur (rest remaining) (conj parts "flagrt.Value")))))

(defn render-direct-function-type [fn]
  (str "func(" (render-direct-param-types (:params fn)) ") flagrt.Value"))

(defn render-direct-function-literal [fn]
  (str "func(" (render-direct-param-list (:params fn)) ") flagrt.Value {\n"
       (render-local-inits (:local-inits fn))
       (or (:body-prelude fn) "")
       "\treturn " (:body fn) "\n}"))

(defn render-variadic-function-literal [fn]
  (str "func(args ...flagrt.Value) flagrt.Value {\n"
       (render-variadic-function-body fn)
       "}"))

(defn render-multi-arity-variadic-literal [fn]
  (str "func(args ...flagrt.Value) flagrt.Value {\n"
       (render-multi-arity-dispatch fn)
       "}"))

(defn render-function-literal [fn]
  (str "func(args ...flagrt.Value) flagrt.Value {\n"
       (render-standalone-variadic-body fn)
       "}"))

(defn function-with-source [fn]
  (assoc fn :source (render-function-def fn)))

(defn functions-with-source [fns]
  (loop [remaining (stmt-list fns) out []]
    (if (or (nil? remaining) (empty? remaining))
      out
      (recur (rest remaining) (conj out (function-with-source (first remaining)))))))

(defn box-go-value [var-name go-type]
  (cond
    (= go-type "float64") (str "flagrt.NewDouble(" var-name ")")
    (= go-type "int64") (str "flagrt.NewLong(" var-name ")")
    (= go-type "string") (str "flagrt.NewString(" var-name ")")
    (= go-type "bool") (str "flagrt.NewBoolean(" var-name ")")
    :else var-name))

(defn unbox-go-value [var-name go-type]
  (cond
    (= go-type "float64") (str var-name ".Double()")
    (= go-type "int64") (str var-name ".Long()")
    (= go-type "string") (str var-name ".String()")
    (= go-type "bool") (str var-name ".Bool()")
    :else var-name))

(defn unbox-record-field [expr go-type]
  (cond
    (= go-type "string") (str "flagrt.RequireString(" expr ")")
    (= go-type "int64") (str "flagrt.RequireLong(" expr ")")
    (= go-type "float64") (str "flagrt.RequireDouble(" expr ")")
    (= go-type "bool") (str "flagrt.RequireBool(" expr ")")
    :else expr))

(defn fmt-call-ir [name args]
  {:kind :call
   :fun {:kind :selector :pkg "fmt" :name name}
   :args args})

(defn form-kind-number [k]
  (cond
    (= k :value) 1
    (= k :string) 2
    (= k :bool) 3
    (= k :mutable-value) 4
    :else 0))

(defn require-top-level-form [form ctx]
  (if (:allow-top-level ctx)
    ctx
    (throw (ex-info (str "top-level expressions are only allowed in the entry module" (form-at-suffix form)) {}))))

(defn intern-keyword-code [ctx flag-name]
  (let [out (intern-form-ir ctx
                            (str "Kw_" (sanitize-keyword-ident flag-name))
                            (literal-rt-call "NewKeyword" [{:kind :string :value flag-name}]))]
    {:code (render-ir (:ir out))
     :ctx (:ctx out)}))

(defn parse-record-field [expr]
  (let [hint (if (= :meta (:kind expr))
               (let [m (:meta expr)]
                 (if (= :symbol (:kind m))
                   (:name m)
                   (throw (ex-info "defrecord field type hint must be a symbol" {}))))
               "")
        target (unwrap-ast expr)
        name (if (and (= :symbol (:kind target)) (not (= "" (:name target))))
               (:name target)
               nil)]
    (if (nil? name)
      (throw (ex-info "defrecord fields must be symbols" {}))
      (let [go-type (if (= hint "")
                      "flagrt.Value"
                      (let [mapped (type-hint-to-go-type hint)]
                        (if (nil? mapped)
                          (throw (ex-info (str "unsupported defrecord field type \"" hint "\"") {}))
                          mapped)))]
        {:flag-name name
         :go-name (exported-record-field-name name)
         :go-type go-type
         :param (record-param-name name)}))))

(defn record-type-decl [type-name fields]
  (str "type " type-name " struct {\n"
       (loop [remaining (stmt-list fields) out ""]
         (if (or (nil? remaining) (empty? remaining))
           out
           (let [f (first remaining)]
             (recur (rest remaining)
                    (str out "\t" (:go-name f) " " (:go-type f) " `flag:" (format "%q" (:flag-name f)) "`\n")))))
       "}\n"))

(defn record-ctor-body [type-name fields]
  (str "flagrt.NewRecord(" type-name "{"
       (loop [remaining (stmt-list fields) parts []]
         (if (or (nil? remaining) (empty? remaining))
           (join-strings parts ", ")
           (let [f (first remaining)]
             (recur (rest remaining)
                    (conj parts (str (:go-name f) ": " (unbox-record-field (:param f) (:go-type f))))))))
       "})"))

(defn record-map-ctor-body [type-name fields ctx]
  (loop [remaining (stmt-list fields) ctx ctx parts []]
    (if (or (nil? remaining) (empty? remaining))
      {:code (str "flagrt.NewRecord(" type-name "{" (join-strings parts ", ") "})")
       :ctx ctx}
      (let [f (first remaining)
            interned (intern-keyword-code ctx (:flag-name f))
            get-code (str "flagrt.Get(m, " (:code interned) ")")]
        (recur (rest remaining)
               (:ctx interned)
               (conj parts (str (:go-name f) ": " (unbox-record-field get-code (:go-type f)))))))))

(defn record-ctor-function [flag-name go-name params body]
  (let [n (count (stmt-list params))
        variadic (str go-name "_variadic")
        arity-name (str go-name "_arity_" n)
        decls (defn-to-ir arity-name variadic go-name params false [] [] {:kind :raw :code body})]
    {:flag-name flag-name
     :go-name go-name
     :variadic-name variadic
     :arity-name arity-name
     :has-rest false
     :doc ""
     :params params
     :ir-decls decls
     :body-expr {:kind :raw :code body}
     :body-stmts []
     :init-stmts []}))

(defn compile-go-interface-params [elements]
  (loop [remaining (stmt-list elements) i 1 types [] sigs []]
    (if (or (nil? remaining) (empty? remaining))
      {:types types :sigs sigs}
      (let [node (unwrap-ast (first remaining))
            name (if (= :symbol (:kind node)) (:name node) nil)]
        (if (nil? name)
          (throw (ex-info "parameter type must be a symbol" {}))
          (let [go-type (type-hint-to-go-type name)]
            (if (nil? go-type)
              (throw (ex-info (str "unsupported parameter type: " name) {}))
              (recur (rest remaining)
                     (inc i)
                     (conj types go-type)
                     (conj sigs (str "p" i " " go-type))))))))))

(defn go-interface-body [target-go types return-type]
  (let [n (count (stmt-list types))]
    (loop [remaining (stmt-list types) i 1 out (str "args := make([]flagrt.Value, 0, " n ")\n")]
      (if (or (nil? remaining) (empty? remaining))
        (str out
             "\tresult := flagrt.Call(" target-go ", args...)\n"
             "\treturn " (unbox-go-value "result" return-type) "\n")
        (recur (rest remaining)
               (inc i)
               (str out "\targs = append(args, " (box-go-value (str "p" i) (first remaining)) ")\n"))))))

(defn compile-go-interface-form [form ctx]
  (let [els (ast-elements form)]
    (if (not (= 4 (count els)))
      (throw (ex-info (str "go-interface expects: function-name return-type [param-type ...]" (form-at-suffix form)) {}))
      (let [target (ast-symbol-name (first (rest els)))
            ret-sym (ast-symbol-name (first (rest (rest els))))
            params-ast (unwrap-ast (first (rest (rest (rest els)))))]
        (if (nil? target)
          (throw (ex-info "go-interface expects a function name" {}))
          (if (nil? ret-sym)
            (throw (ex-info "go-interface expects a return type symbol" {}))
            (let [return-type (type-hint-to-go-type ret-sym)]
              (if (nil? return-type)
                (throw (ex-info (str "unsupported return type: " ret-sym) {}))
                (let [target-go (get (:module ctx) target)]
                  (if (nil? target-go)
                    (throw (ex-info (str "function \"" target "\" not defined") {}))
                    (if (not (= :vector (:kind params-ast)))
                      (throw (ex-info "go-interface expects a parameter type vector" {}))
                      (let [parsed (compile-go-interface-params (:elements params-ast))
                            wrapper (str target "_go")]
                        {:op :go-interface
                         :function {:flag-name wrapper
                                    :go-name wrapper
                                    :variadic-name ""
                                    :arity-name ""
                                    :has-rest false
                                    :doc (str "Go interop wrapper for " target)
                                    :params []
                                    :ir-decls []
                                    :go-signature (str "(" (join-strings (:sigs parsed) ", ") ") " return-type)
                                    :body-source (go-interface-body target-go (:types parsed) return-type)}
                         :ctx ctx}))))))))))))

(defn compile-defrecord-fields [elements]
  (loop [remaining (stmt-list elements) fields [] params []]
    (if (or (nil? remaining) (empty? remaining))
      {:fields fields :params params}
      (let [field (parse-record-field (first remaining))]
        (recur (rest remaining)
               (conj fields field)
               (conj params (:param field)))))))

(defn compile-defrecord-form [form ctx]
  (let [els (ast-elements form)]
    (if (not (= 3 (count els)))
      (throw (ex-info (str "defrecord expects a name and field vector" (form-at-suffix form)) {}))
      (let [name (ast-symbol-name (first (rest els)))
            fields-ast (unwrap-ast (first (rest (rest els))))]
        (if (nil? name)
          (throw (ex-info "defrecord name must be a symbol" {}))
          (if (not (= :vector (:kind fields-ast)))
            (throw (ex-info "defrecord fields must be a vector" {}))
            (let [type-name (go-ident name)
                  prev (get (or (:record-types ctx) {}) type-name)]
              (if prev
                (throw (ex-info (str "record \"" name "\" already defined as " prev) {}))
                (let [parsed (compile-defrecord-fields (:elements fields-ast))
                      ctor-flag (str "->" name)
                      map-flag (str "map->" name)
                      ctor-go (def-go-ident ctx ctor-flag)
                      map-go (def-go-ident ctx map-flag)
                      map-body (record-map-ctor-body type-name (:fields parsed) ctx)
                      ctor (record-ctor-function ctor-flag ctor-go (:params parsed) (record-ctor-body type-name (:fields parsed)))
                      map-ctor (record-ctor-function map-flag map-go ["m"] (:code map-body))
                      next-ctx (-> (:ctx map-body)
                                   (assoc :record-types (map-put (or (:record-types ctx) {}) type-name name))
                                   (assoc :functions (map-put (map-put (or (:functions ctx) {}) ctor-go true) map-go true))
                                   (assoc :globals (map-put (map-put (or (:globals ctx) {}) ctor-go :value) map-go :value))
                                   (bind-module-name ctor-flag ctor-go)
                                   (bind-module-name map-flag map-go))]
                  {:op :defrecord
                   :type-decl (record-type-decl type-name (:fields parsed))
                   :functions [ctor map-ctor]
                   :vars [(defn-var-binding ctor-flag ctor-go (:variadic-name ctor))
                          (defn-var-binding map-flag map-go (:variadic-name map-ctor))]
                   :names [{:flag-name ctor-flag :go-name ctor-go}
                           {:flag-name map-flag :go-name map-go}]
                   :ctx next-ctx})))))))))

(defn compile-top-level-println [form ctx]
  (let [ctx (require-top-level-form form ctx)]
    (loop [remaining (rest (ast-elements form)) ctx ctx stmts [] irs []]
      (if (or (nil? remaining) (empty? remaining))
        {:op :stmt
         :stmt {:prelude-stmts stmts
                :expr (fmt-call-ir "Println" [(literal-rt-call "Str" irs)])
                :kind 0}
         :needs-fmt true
         :ctx ctx}
        (let [part (compile-form-to-ir (first remaining) ctx)]
          (recur (rest remaining)
                 (:ctx part)
                 (concat-stmts stmts (:stmts part))
                 (conj irs (:expr part))))))))

(defn compile-top-level-print [form ctx]
  (let [ctx (require-top-level-form form ctx)
        args (rest (ast-elements form))]
    (if (not (= 1 (count (stmt-list args))))
      (throw (ex-info "expected one argument" {}))
      (let [part (compile-form-to-ir (first args) ctx)
            flat (flatten-form-expr part)
            arg (if (= :value (:expr-kind part))
                  (literal-rt-call "ValueToAny" [flat])
                  flat)]
        {:op :stmt
         :stmt {:prelude-stmts []
                :expr (fmt-call-ir "Print" [arg])
                :kind 0}
         :needs-fmt true
         :ctx (:ctx part)}))))

(defn compile-top-level-expr [form ctx]
  (let [ctx (require-top-level-form form ctx)
        part (compile-form-to-ir form ctx)]
    (if (:defer? part)
      {:op :stmt
       :stmt {:prelude-stmts (:stmts part)
              :defer-stmt (:stmt part)}
       :needs-fmt false
       :ctx (:ctx part)}
      {:op :stmt
       :stmt {:prelude-stmts (:stmts part)
              :expr (:expr part)
              :kind (form-kind-number (:expr-kind part))}
       :needs-fmt false
       :ctx (:ctx part)})))

(defn compile-module-form [form ctx]
  (let [head (list-head-name form)]
    (cond
      (nil? head)
      (compile-top-level-expr form ctx)

      (= head "ns")
      (throw (ex-info "ns must be the first form (or use a module header map)" {}))

      (= head "defn-")
      (throw (ex-info "defn- is not supported; list public names in the module :exports instead" {}))

      (= head "defmacro")
      {:op :skip :ctx ctx}

      (= head "do")
      {:op :splice :forms (rest (ast-elements form)) :ctx ctx}

      (= head "defn")
      (compile-defn-form form ctx)

      (= head "def")
      (compile-def-form form ctx)

      (= head "deftest")
      (compile-deftest-form form ctx)

      (= head "declare")
      (compile-declare-form form ctx)

      (= head "go-interface")
      (compile-go-interface-form form ctx)

      (or (= head "defrecord") (= head "defrecord*"))
      (compile-defrecord-form form ctx)

      (= head "println")
      (compile-top-level-println form ctx)

      (= head "print")
      (compile-top-level-print form ctx)

      :else
      (compile-top-level-expr form ctx))))

(defn compile-module-body [forms ctx]
  (loop [remaining forms
         ctx ctx
         functions []
         vars []
         tests []
         stmts []
         defined {}
         needs-fmt false
         type-decls []]
    (if (or (nil? remaining) (empty? remaining))
      {:functions functions
       :vars vars
       :tests tests
       :stmts stmts
       :defined defined
       :ctx ctx
       :needs-fmt needs-fmt
       :type-decls type-decls}
      (let [item (compile-module-form (first remaining) ctx)
            op (:op item)]
        (cond
          (= op :skip)
          (recur (rest remaining) (:ctx item) functions vars tests stmts defined needs-fmt type-decls)

          (= op :splice)
          (recur (concat-stmts (:forms item) (rest remaining)) (:ctx item) functions vars tests stmts defined needs-fmt type-decls)

          (= op :defn)
          (recur (rest remaining)
                 (:ctx item)
                 (conj functions (function-with-source (:function item)))
                 (conj vars (:var item))
                 tests
                 stmts
                 (map-put defined (:flag-name (:function item)) (:go-name (:function item)))
                 needs-fmt
                 type-decls)

          (= op :def)
          (recur (rest remaining)
                 (:ctx item)
                 functions
                 (conj vars (:var item))
                 tests
                 stmts
                 (map-put defined (:flag-name (:var item)) (:go-name (:var item)))
                 needs-fmt
                 type-decls)

          (= op :deftest)
          (recur (rest remaining)
                 (:ctx item)
                 (conj functions (function-with-source (:function item)))
                 vars
                 (conj tests (:test item))
                 stmts
                 defined
                 needs-fmt
                 type-decls)

          (= op :declare)
          (recur (rest remaining)
                 (:ctx item)
                 functions
                 vars
                 tests
                 stmts
                 (merge-defined-names defined (:names item))
                 needs-fmt
                 type-decls)

          (= op :go-interface)
          (recur (rest remaining)
                 (:ctx item)
                 (conj functions (function-with-source (:function item)))
                 vars
                 tests
                 stmts
                 defined
                 needs-fmt
                 type-decls)

          (= op :defrecord)
          (recur (rest remaining)
                 (:ctx item)
                 (concat-stmts functions (functions-with-source (:functions item)))
                 (concat-stmts vars (:vars item))
                 tests
                 stmts
                 (merge-defined-names defined (:names item))
                 needs-fmt
                 (conj type-decls (:type-decl item)))

          (= op :stmt)
          (recur (rest remaining)
                 (:ctx item)
                 functions
                 vars
                 tests
                 (conj stmts (:stmt item))
                 defined
                 (if (or needs-fmt (:needs-fmt item)) true false)
                 type-decls)

          :else
          (throw (ex-info "not handled by FLAG form lowering" {:node (first remaining)})))))))

(defn compile-inline-modules [modules ctx entry-path]
  (let [by-path (loop [remaining modules out {}]
                  (if (or (nil? remaining) (empty? remaining))
                    out
                    (recur (rest remaining)
                           (assoc out (:path (first remaining)) (first remaining)))))
        prologue-path (program-prologue-path modules)]
    (loop [remaining modules
           shared ctx
           module-defs {}
           module-macros {}
           acc {:type-decls [] :functions [] :vars [] :stmts [] :tests [] :needs-fmt false}]
      (if (or (nil? remaining) (empty? remaining))
        (assoc acc
               :ctx shared
               :namespace (or (:namespace (get by-path entry-path))
                              (:legacy-ns (get by-path entry-path))
                              "")
               :defined module-defs
               :vars (into (or (:vars acc) []) (intern-var-defs (:constants shared))))
        (let [mod (with-implicit-prologue-import (first remaining) prologue-path)
              ctx0 (-> shared
                       (assoc :namespace (or (:namespace mod) (:legacy-ns mod) ""))
                       (assoc :module (or (:module shared) {}))
                       (assoc :go-imports []))
              seeded (seed-imports ctx0 mod by-path module-defs module-macros)
              exported (apply-go-exports mod (assoc seeded :allow-top-level (= (:path mod) entry-path)))
              expanded (expand-module-forms (:macro-forms (:ctx exported)) (:forms mod))
              compiled (compile-module-body expanded (:ctx exported))
              compiled-vars (into (or (:vars exported) []) (or (:vars compiled) []))
              compiled1 (-> compiled
                            (assoc :vars compiled-vars)
                            (assoc :defined (merge-compile-defined exported compiled)))
              macros (collect-defmacros (:forms mod))]
          (do
            (if (:has-header mod)
              (validate-exports mod (:defined compiled1) macros)
              nil)
            (recur (rest remaining)
                   (-> (:ctx compiled1)
                       (assoc :module (or (:module shared) {}))
                       (assoc :go-imports []))
                   (assoc module-defs (:path mod) (:defined compiled1))
                   (assoc module-macros (:path mod) macros)
                   (append-compile-acc acc compiled1))))))))

(defn compile-package-modules [modules ctx prologue-exports entry-path prologue-names]
  (let [by-path (loop [remaining modules out {}]
                  (if (or (nil? remaining) (empty? remaining))
                    out
                    (recur (rest remaining)
                           (assoc out (:path (first remaining)) (first remaining)))))
        prologue-path (program-prologue-path modules)]
    (loop [remaining modules used-pkgs {} out []]
      (if (or (nil? remaining) (empty? remaining))
        out
        (let [mod (with-implicit-prologue-import (first remaining) prologue-path)
              is-entry (= (:path mod) entry-path)
              ctx0 (-> ctx
                       (assoc :package-mode true)
                       (assoc :constants {:by-code {} :used {} :order []})
                       (assoc :namespace (or (:namespace mod) (:legacy-ns mod) ""))
                       (assoc :exported-names (module-export-set (:exports mod)))
                       (assoc :module {})
                       (assoc :go-imports []))
              seeded (seed-imports ctx0 mod by-path
                                   (loop [pkgs out defs {}]
                                     (if (or (nil? pkgs) (empty? pkgs))
                                       defs
                                       (recur (rest pkgs)
                                              (assoc defs (:path (first pkgs)) (:defined (first pkgs))))))
                                   (loop [pkgs out macros {}]
                                     (if (or (nil? pkgs) (empty? pkgs))
                                       macros
                                       (recur (rest pkgs)
                                              (assoc macros (:path (first pkgs)) (:macros (first pkgs)))))))
              exported (apply-go-exports mod (assoc seeded :allow-top-level is-entry))
              expanded (expand-module-forms (:macro-forms (:ctx exported)) (:forms mod))
              compiled (compile-module-body expanded (:ctx exported))
              compiled1 (-> compiled
                            (assoc :vars (into (into (or (:vars exported) []) (or (:vars compiled) []))
                                               (intern-var-defs (:constants (:ctx compiled)))))
                            (assoc :defined (merge-compile-defined exported compiled)))
              macros (collect-defmacros (:forms mod))]
          (do
            (if (:has-header mod)
              (validate-exports mod (:defined compiled1) macros)
              nil)
            (let [compiled2 (if (result-refs-package? compiled1 "prologue.")
                            (assoc compiled1 :ctx (add-go-import (:ctx compiled1) "prologue"))
                            compiled1)
                ns (or (:namespace mod) (:legacy-ns mod) "")
                compiled3 (-> compiled2
                              (assoc :namespace ns)
                              (assoc :namespace-code (if (or (nil? ns) (= ns ""))
                                                      ""
                                                      (render-ir-stmt (ns-to-ir ns) "")))
                              (assoc :extra-imports (or (:go-imports (:ctx compiled2)) [])))
                pkg-name (if is-entry "main" (go-package-name ns))
                used (if is-entry
                       used-pkgs
                       (if (get used-pkgs pkg-name)
                         (throw (ex-info (str "duplicate Go package name \"" pkg-name "\" from "
                                              (get used-pkgs pkg-name) " and " (:path mod)) {}))
                         (assoc used-pkgs (as-value pkg-name) (:path mod))))
                src (compile-program pkg-name compiled3 is-entry)
                flagi (if is-entry
                        ""
                        (emit-flagi ns
                                    (or (:exports mod) (into (keys (:defined compiled3)) (keys macros)))
                                    (:go-exports mod)
                                    macros
                                    (:defined compiled3)))]
            (recur (rest remaining)
                   used
                   (conj out {:dir (if is-entry "" pkg-name)
                              :name pkg-name
                              :source src
                              :flagi flagi
                              :main? is-entry
                              :path (:path mod)
                              :defined (:defined compiled3)
                              :macros macros})))))))))

(defn file-first-line [s]
  (let [text (str s)
        n (count text)]
    (loop [i 0]
      (if (>= i n)
        text
        (if (= (subs text i (+ i 1)) "\n")
          (subs text 0 i)
          (recur (inc i)))))))

(defn go-mod-is-flag-lang? [dir]
  (let [p (path-join dir "go.mod")]
    (if (file-exists? p)
      (= (trim-space (file-first-line (read-text-file p))) "module flag-lang")
      false)))

(defn walk-flag-lang-root [start seen]
  (loop [dir start seen seen]
    (if (contains? seen (as-value dir))
      {:path nil :seen seen}
      (let [seen1 (assoc seen (as-value dir) true)]
        (if (go-mod-is-flag-lang? dir)
          {:path dir :seen seen1}
          (let [parent (path-dir dir)]
            (if (= parent dir)
              {:path nil :seen seen1}
              (recur parent seen1))))))))

(defn find-flag-lang-root [start]
  (let [abs (abs-path start)
        dir (if (= (path-stat-kind abs) "dir") abs (path-dir abs))
        first (walk-flag-lang-root dir {})]
    (if (:path first)
      (:path first)
      (let [second (walk-flag-lang-root (cwd-path) (:seen first))]
        (if (:path second)
          (:path second)
          (throw (ex-info "could not find flag-lang module root (go.mod with module flag-lang)" {})))))))

(defn write-one-compiled-package [dir pkg]
  (if (:main? pkg)
    (write-text-file (path-join dir "main.go") (or (:source pkg) ""))
    (let [pdir (path-join dir (:dir pkg))]
      (do
        (mkdir-all pdir)
        (write-text-file (path-join pdir (str (:name pkg) ".go")) (or (:source pkg) ""))
        (if (or (nil? (:flagi pkg)) (= (:flagi pkg) ""))
          nil
          (write-text-file (path-join pdir (str (:name pkg) ".flagi")) (:flagi pkg)))))))

(defn write-compiled-packages [dir pkgs]
  (loop [remaining (or pkgs [])]
    (if (or (nil? remaining) (empty? remaining))
      nil
      (do
        (write-one-compiled-package dir (first remaining))
        (recur (rest remaining))))))

(defn write-program-packages [dir pkgs entry-path]
  (let [root (find-flag-lang-root entry-path)
        go-mod (str "module flagbuild\n\ngo 1.26.4\n\nrequire flag-lang v0.0.0\n\nreplace flag-lang => " root "\n")]
    (do
      (write-text-file (path-join dir "go.mod") go-mod)
      (let [sum-path (path-join root "go.sum")]
        (if (file-exists? sum-path)
          (write-text-file (path-join dir "go.sum") (read-text-file sum-path))
          nil))
      (write-compiled-packages dir pkgs)
      (go-mod-tidy dir)
      nil)))

