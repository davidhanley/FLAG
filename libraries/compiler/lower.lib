{:namespace "compiler"
 :exports   [ast-node-to-ir quoted-ast-to-ir call-to-ir call-ast-to-ir
             ctor-to-ir runtime-call-to-ir fold-call-to-ir eq-to-ir
             nil-pred-to-ir empty-pred-to-ir count-to-ir
             str-to-ir ex-info-to-ir assoc-to-ir conj-to-ir
             seq-to-ir drop-to-ir take-to-ir cons-to-ir get-to-ir nth-to-ir
             not-empty-to-ir type-of-to-ir vec-to-ir dissoc-to-ir contains-pred-to-ir
             into-to-ir concat-to-ir
             ex-message-to-ir ex-data-to-ir ex-cause-to-ir println-to-ir
             compare-to-ir numeric-eq-to-ir comparison-to-ir
             symbol-ctor-to-ir name-to-ir keyword-ctor-to-ir format-to-ir
             map-to-ir sort-by-to-ir apply-to-ir pmap-to-ir filter-to-ir
             reduce-to-ir doall-to-ir some-to-ir set-to-ir
             line-seq-to-ir repeat-to-ir rand-int-to-ir
             to-json-to-ir from-json-to-ir
             open-file-to-ir file-to-strings-to-ir file-to-strings-path-to-ir
             go-fn-to-ir go-fn-args-to-ir
             symbol-to-ir eval-ast-to-ir if-to-ir let-to-ir
             do-prelude-stmts do-defer-to-ir loop-to-ir recur-to-ir
             defer-to-ir throw-to-ir future-to-ir
             doto-to-ir update-bang-to-ir catch-handler-to-ir try-to-ir
             doseq-to-ir doseq-body-to-ir mapcat-binding-to-ir
             fn-to-ir ns-to-ir def-to-ir defn-binding-to-ir
             defn-to-ir defn-multi-to-ir
             write-to-ir ends-with-to-ir testing-to-ir is-to-ir
             expect-exception-to-ir ast-form-source hash-fn-placeholder-index
             map-destructure-key-ir
             go-ident bind-params-to-ir compile-form-to-ir compile-forms-to-ir
             form-defer-result forms-have-defer? list-head-name catch-type-name
             parse-catch-clause split-try-args]}

(defn literal-rt-call [name args]
  {:kind :call
   :fun {:kind :selector :pkg "flagrt" :name name}
   :args args})

(defn ast-node-to-ir [node]
  (let [kind (:kind node)]
    (cond
      (= kind :string)
      {:kind :string :value (:value node)}

      (= kind :char)
      (literal-rt-call "NewString" [{:kind :string :value (:value node)}])

      (= kind :int)
      (literal-rt-call "NewLong" [{:kind :int :value (:value node)}])

      (= kind :bigint)
      (literal-rt-call "NewBigIntFromString" [{:kind :string :value (:value node)}])

      (= kind :ratio)
      (literal-rt-call "NewRatio" [{:kind :int :value (:numerator node)}
                                   {:kind :int :value (:denominator node)}])

      (= kind :float)
      (let [raw (:raw node)
            code (if (or (nil? raw) (= "" raw))
                   (format "%g" (:value node))
                   raw)]
        (literal-rt-call "NewDouble" [{:kind :raw :code code}]))

      (= kind :keyword)
      (literal-rt-call "NewKeyword" [{:kind :string :value (:name node)}])

      (= kind :quoted-symbol)
      (literal-rt-call "NewSymbol" [{:kind :string :value (:name node)}])

      (= kind :symbol)
      (let [name (:name node)]
        (cond
          (= name "true") (literal-rt-call "NewBool" [{:kind :raw :code "true"}])
          (= name "false") (literal-rt-call "NewBool" [{:kind :raw :code "false"}])
          (= name "nil") (literal-rt-call "NilValue" [])
          :else (throw (ex-info "unsupported symbol for literal lowering"
                                {:node node}))))

      :else (throw (ex-info "unsupported AST node for literal lowering"
                            {:node node})))))

(defn quoted-ast-to-ir-node [mode node]
  (cond
    (= mode :seq)
    (loop [remaining node out []]
      (if (or (nil? remaining) (empty? remaining))
        out
        (recur (rest remaining)
               (conj out (quoted-ast-to-ir-node :node (first remaining))))))

    (= mode :node)
    (let [kind (:kind node)]
      (cond
        (= kind :int) (ast-node-to-ir node)
        (= kind :bigint) (ast-node-to-ir node)
        (= kind :ratio) (ast-node-to-ir node)
        (= kind :float) (ast-node-to-ir node)
        (= kind :keyword) (ast-node-to-ir node)
        (= kind :quoted-symbol) (ast-node-to-ir node)

        (= kind :symbol)
        (literal-rt-call "NewSymbol" [{:kind :string :value (:name node)}])

        (= kind :quoted-list)
        (literal-rt-call "NewList" (quoted-ast-to-ir-node :seq (:elements node)))

        (= kind :list)
        (literal-rt-call "NewList" (quoted-ast-to-ir-node :seq (:elements node)))

        (= kind :vector)
        (literal-rt-call "NewArray" (quoted-ast-to-ir-node :seq (:elements node)))

        (= kind :pipe-vector)
        (literal-rt-call "NewVector" (quoted-ast-to-ir-node :seq (:elements node)))

        (= kind :map)
        (let [entries (:entries node)
              n (if (nil? entries) 0 (count entries))]
          (if (not (= 0 (% n 2)))
            (throw (ex-info "quoted map literal expects an even number of forms"
                            {:node node}))
            (literal-rt-call "NewMap" (quoted-ast-to-ir-node :seq entries))))

        (= kind :set)
        (literal-rt-call "NewSet" (quoted-ast-to-ir-node :seq (:elements node)))

        :else
        (throw (ex-info "unsupported quoted literal" {:node node}))))

    :else (throw (ex-info "unsupported quoted lowering mode" {:mode mode}))))

(defn quoted-ast-to-ir [node]
  (quoted-ast-to-ir-node :node node))

(def special-form-names
  #{"+" "*" "-" "/" "%" "mod" "quot" "rem" "compare" "==" "=" "<" "<=" ">" ">="
    "max" "min"
    "bit-and" "bit-or" "bit-xor" "bit-not" "bit-shift-left" "bit-shift-right"
    "unsigned-bit-shift-right" "bit-test" "bit-set" "bit-clear" "bit-flip"
    "str" "println" "testing" "ex-info" "ex-message" "ex-data" "ex-cause"
    "throw" "try" "catch" "finally" "is" "expect-exception"
    "if" "do" "doto" "for" "doseq" "let" "loop" "recur" "defer" "update!"
    "symbol" "name" "keyword" "first" "fist" "rest" "next" "last"
    "reverse" "cons" "take" "drop" "not-empty" "seq" "empty?" "nil?" "type-of"
    "count" "double" "into" "format" "hash-map" "list" "array" "map" "concat"
    "sort-by" "apply" "pmap" "filter" "reduce" "doall" "some" "seq?" "set"
    "vec" "conj" "contains?" "line-seq" "repeat" "rand-int" "assoc" "dissoc"
    "to-json" "from-json" "open-file" "file-to-strings" "go-fn" "go-fn-args"
    "fn"})

(defn call-to-ir [callee args]
  (loop [remaining args out [callee]]
    (if (or (nil? remaining) (empty? remaining))
      (literal-rt-call "Call" out)
      (recur (rest remaining) (conj out (first remaining))))))

(defn call-ast-to-ir-node [mode node]
  (cond
    (= mode :seq)
    (loop [remaining node out []]
      (if (or (nil? remaining) (empty? remaining))
        out
        (recur (rest remaining)
               (conj out (call-ast-to-ir-node :eval (first remaining))))))

    (= mode :eval)
    (let [kind (:kind node)]
      (cond
        (= kind :string) (ast-node-to-ir node)
        (= kind :char) (ast-node-to-ir node)
        (= kind :int) (ast-node-to-ir node)
        (= kind :bigint) (ast-node-to-ir node)
        (= kind :ratio) (ast-node-to-ir node)
        (= kind :float) (ast-node-to-ir node)
        (= kind :keyword) (ast-node-to-ir node)
        (= kind :quoted-symbol) (ast-node-to-ir node)

        (= kind :symbol)
        (let [name (:name node)]
          (if (or (= name "true") (= name "false") (= name "nil"))
            (ast-node-to-ir node)
            (throw (ex-info "unresolved symbol for call lowering"
                            {:node node}))))

        (= kind :quoted-list) (quoted-ast-to-ir node)
        (= kind :vector) (quoted-ast-to-ir node)
        (= kind :pipe-vector) (quoted-ast-to-ir node)
        (= kind :map) (quoted-ast-to-ir node)
        (= kind :set) (quoted-ast-to-ir node)

        (= kind :list) (call-ast-to-ir-node :call node)

        :else (throw (ex-info "unsupported AST node for call lowering"
                              {:node node}))))

    (= mode :call)
    (let [elements (:elements node)]
      (if (or (nil? elements) (empty? elements))
        (throw (ex-info "unsupported form" {:node node}))
        (let [head (first elements)]
          (if (and (= :symbol (:kind head))
                   (contains? special-form-names (:name head)))
            (throw (ex-info "special form not handled by call lowering"
                            {:node node}))
            (call-to-ir (call-ast-to-ir-node :eval head)
                        (call-ast-to-ir-node :seq (rest elements)))))))

    :else (throw (ex-info "unsupported call lowering mode" {:mode mode}))))

(defn call-ast-to-ir [node]
  (call-ast-to-ir-node :call node))

(defn ctor-to-ir [name args]
  (literal-rt-call name args))

(defn runtime-call-to-ir [name args]
  (literal-rt-call name args))

(defn fold-call-to-ir [name args]
  (if (or (nil? args) (empty? args) (empty? (rest args)))
    (throw (ex-info "fold expects at least two arguments" {:name name}))
    (loop [acc (first args) remaining (rest args)]
      (if (or (nil? remaining) (empty? remaining))
        acc
        (recur (literal-rt-call name [acc (first remaining)])
               (rest remaining))))))

(defn eq-to-ir [args]
  (if (or (nil? args) (empty? args) (empty? (rest args)))
    (throw (ex-info "= expects at least two arguments" {}))
    (loop [acc (literal-rt-call "Eq" [(first args) (first (rest args))])
           prev (first (rest args))
           remaining (rest (rest args))]
      (if (or (nil? remaining) (empty? remaining))
        (literal-rt-call "NewBool" [acc])
        (recur {:kind :binary
                :op "&&"
                :left acc
                :right (literal-rt-call "Eq" [prev (first remaining)])}
               (first remaining)
               (rest remaining))))))

(defn nil-pred-to-ir [arg]
  (literal-rt-call "NewBool" [(literal-rt-call "IsNil" [arg])]))

(defn empty-pred-to-ir [arg]
  (literal-rt-call "NewBool" [(literal-rt-call "IsEmpty" [arg])]))

(defn count-to-ir [arg]
  (literal-rt-call "NewLong"
                   [{:kind :call
                     :fun {:kind :ident :name "int64"}
                     :args [(literal-rt-call "Count" [arg])]}]))

(defn str-to-ir [args]
  (literal-rt-call "Str" (if (or (nil? args) (empty? args)) [] args)))

(defn keyword-ir [name]
  (literal-rt-call "NewKeyword" [{:kind :string :value name}]))

(defn ex-info-to-ir [msg data cause]
  (let [base [(keyword-ir "message") (literal-rt-call "NewString" [msg])
              (keyword-ir "data") data]]
    (ctor-to-ir "NewMap"
                (if (nil? cause)
                  base
                  (conj (conj base (keyword-ir "cause")) cause)))))

(defn assoc-to-ir [args]
  (literal-rt-call "Assoc" (if (or (nil? args) (empty? args)) [] args)))

(defn conj-to-ir [args]
  (literal-rt-call "Conj" (if (or (nil? args) (empty? args)) [] args)))

(defn seq-to-ir [arg]
  (literal-rt-call "Seq" [arg]))

(defn drop-to-ir [args]
  (literal-rt-call "Drop" args))

(defn take-to-ir [args]
  (literal-rt-call "Take" args))

(defn cons-to-ir [args]
  (literal-rt-call "Cons" args))

(defn get-to-ir [args]
  (literal-rt-call "Get" args))

(defn nth-to-ir [args]
  (literal-rt-call "Nth" args))

(defn not-empty-to-ir [arg]
  (literal-rt-call "NotEmpty" [arg]))

(defn type-of-to-ir [arg]
  (literal-rt-call "TypeOf" [arg]))

(defn vec-to-ir [arg]
  (literal-rt-call "Vec" [arg]))

(defn dissoc-to-ir [args]
  (literal-rt-call "MapDissoc" (if (or (nil? args) (empty? args)) [] args)))

(defn contains-pred-to-ir [args]
  (literal-rt-call "NewBool" [(literal-rt-call "Contains" args)]))

(defn into-to-ir [args]
  (literal-rt-call "Into" args))

(defn concat-to-ir [args]
  (literal-rt-call "Concat" (if (or (nil? args) (empty? args)) [] args)))

(defn ex-message-to-ir [arg]
  (literal-rt-call "ExMessage" [arg]))

(defn ex-data-to-ir [arg]
  (literal-rt-call "ExData" [arg]))

(defn ex-cause-to-ir [arg]
  (literal-rt-call "ExCause" [arg]))

(defn println-to-ir [args]
  (literal-rt-call "Println" (if (or (nil? args) (empty? args)) [] args)))

(defn compare-to-ir [args]
  (literal-rt-call "Compare" args))

(defn numeric-eq-to-ir [args]
  (literal-rt-call "NewBool" [(literal-rt-call "NumericEq" (if (or (nil? args) (empty? args)) [] args))]))

(defn comparison-to-ir [op args]
  (if (or (nil? args) (empty? args) (empty? (rest args)))
    (throw (ex-info (str op " expects at least two arguments") {}))
    (loop [acc (literal-rt-call op [(first args) (first (rest args))])
           prev (first (rest args))
           remaining (rest (rest args))]
      (if (or (nil? remaining) (empty? remaining))
        acc
        (recur {:kind :binary
                :op "&&"
                :left acc
                :right (literal-rt-call op [prev (first remaining)])}
               (first remaining)
               (rest remaining))))))

(defn symbol-ctor-to-ir [arg]
  (literal-rt-call "Symbol" [arg]))

(defn name-to-ir [arg]
  (literal-rt-call "Name" [arg]))

(defn keyword-ctor-to-ir [arg]
  (literal-rt-call "Keyword" [arg]))

(defn format-to-ir [args]
  (literal-rt-call "NewString" [(literal-rt-call "Format" args)]))

(defn map-to-ir [args]
  (literal-rt-call "Map" args))

(defn sort-by-to-ir [args]
  (literal-rt-call "SortBy" args))

(defn apply-to-ir [args]
  (literal-rt-call "Apply" args))

(defn pmap-to-ir [args]
  (literal-rt-call "PMap" args))

(defn filter-to-ir [args]
  (literal-rt-call "Filter" args))

(defn reduce-to-ir [args]
  (literal-rt-call "Reduce" args))

(defn doall-to-ir [arg]
  (literal-rt-call "DoAll" [arg]))

(defn some-to-ir [args]
  (literal-rt-call "Some" args))

(defn set-to-ir [arg]
  (literal-rt-call "Set" [arg]))

(defn line-seq-to-ir [arg]
  (literal-rt-call "LineSeq" [arg]))

(defn repeat-to-ir [args]
  (literal-rt-call "Repeat" args))

(defn rand-int-to-ir [arg]
  (literal-rt-call "RandInt" [arg]))

(defn to-json-to-ir [arg]
  (literal-rt-call "ToJSON" [arg]))

(defn from-json-to-ir [arg]
  (literal-rt-call "FromJSON" [arg]))

(defn open-file-to-ir [arg]
  (literal-rt-call "OpenFile" [arg]))

(defn file-to-strings-to-ir [arg]
  (literal-rt-call "FileToStrings" [arg]))

(defn file-to-strings-path-to-ir [arg]
  (literal-rt-call "FileToStringsPath" [arg]))

(defn go-fn-to-ir [arg]
  (literal-rt-call "GoFunction" [arg]))

(defn go-fn-args-to-ir [arg]
  (literal-rt-call "GoFunctionArgs" [arg]))

(def builtin-function-names
  #{"+" "-" "*" "/" "%" "quot" "rem" "mod" "compare" "==" "=" "<" "<=" ">" ">="
    "max" "min"
    "bit-and" "bit-or" "bit-xor" "bit-not" "bit-shift-left" "bit-shift-right"
    "unsigned-bit-shift-right" "bit-test" "bit-set" "bit-clear" "bit-flip"
    "first" "fist" "rest" "next" "last" "reverse" "cons" "take" "drop" "nth"
    "slow-nth" "map" "concat" "sort-by" "apply" "pmap" "filter" "reduce" "get"
    "keys" "vals" "find" "hash-map" "list" "array" "not-empty" "empty?" "nil?"
    "type-of" "count" "double" "numerator" "denominator" "format" "subs"
    "keyword" "into" "doall" "dorun" "line-seq" "some" "seq" "seq?" "set" "vec"
    "conj" "contains?" "assoc" "dissoc" "open-file" "close-file" "close-channel"
    "file-to-strings" "rand-int" "rand" "rand-nth" "shuffle" "repeat"
    "union" "intersection" "difference" "subset?" "superset?" "disjoint?"
    "rename-keys" "map-invert" "select" "project" "rename"
    "go-fn" "go-fn-args" "re-pattern" "re-matches"
    "ex-message" "ex-data" "ex-cause"})

(def unary-runtime-ops
  {"first" "First" "fist" "First" "rest" "Rest" "next" "Next" "last" "Last"
   "reverse" "Reverse" "seq?" "SeqPredicate" "double" "Double" "bit-not" "BitNot"})

(def fold-runtime-ops
  {"+" "Add" "*" "Mul" "-" "Sub" "/" "Div"})

(def binary-runtime-ops
  {"%" "Mod" "mod" "Mod" "quot" "Quot" "rem" "Rem"
   "bit-shift-left" "BitShiftLeft" "bit-shift-right" "BitShiftRight"
   "unsigned-bit-shift-right" "UnsignedBitShiftRight"
   "bit-test" "BitTest" "bit-set" "BitSet" "bit-clear" "BitClear"
   "bit-flip" "BitFlip"})

(def variadic-runtime-ops
  {"bit-and" "BitAnd" "bit-or" "BitOr" "bit-xor" "BitXor"
   "max" "Max" "min" "Min"})

(defn qualified-name? [name]
  (loop [s name]
    (if (or (nil? s) (= 0 (count s)))
      false
      (if (= "/" (subs s 0 1))
        true
        (recur (subs s 1))))))

(defn ident-ir [ident k]
  (let [ir {:kind :ident :name ident}]
    (if (= k :string)
      {:ir ir :expr-kind :string}
      (if (= k :bool)
        {:ir ir :expr-kind :bool}
        {:ir ir :expr-kind :value}))))

(defn symbol-to-ir [name ident ctx]
  (let [locals (:locals ctx)
        globals (:globals ctx)
        functions (:functions ctx)
        module (:module ctx)
        go-fns (:go-fns ctx)
        self-name (:self-function-name ctx)
        self-var (:self-variadic-name ctx)
        slash? (qualified-name? name)]
    (cond
      (and (not slash?)
           ident
           (not (= "" ident))
           (not (nil? locals))
           (contains? locals ident))
      (ident-ir ident (get locals ident))

      (and (= name self-name)
           self-var
           (not (= "" self-var)))
      {:ir (literal-rt-call "NewFunction" [{:kind :ident :name self-var}])
       :expr-kind :value}

      (and (not (nil? module)) (contains? module name))
      (let [go-ident (get module name)]
        (if (and (not (nil? globals)) (contains? globals go-ident))
          (ident-ir go-ident (get globals go-ident))
          (if (and (not (nil? functions)) (contains? functions go-ident))
            {:ir (literal-rt-call "NewFunction" [{:kind :ident :name go-ident}])
             :expr-kind :value}
            {:ir {:kind :ident :name go-ident} :expr-kind :value})))

      (and ident
           (not (= "" ident))
           (not (nil? globals))
           (contains? globals ident))
      (ident-ir ident (get globals ident))

      (and ident
           (not (= "" ident))
           (not (nil? functions))
           (contains? functions ident))
      {:ir (literal-rt-call "NewFunction" [{:kind :ident :name ident}])
       :expr-kind :value}

      (contains? builtin-function-names name)
      {:ir (literal-rt-call "BuiltinFunction" [{:kind :string :value name}])
       :expr-kind :value}

      (and (not (nil? go-fns)) (contains? go-fns name))
      {:ir {:kind :selector :pkg "flagrt" :name (get go-fns name)}
       :expr-kind :value}

      :else
      (throw (ex-info (str "unknown symbol \"" name "\"") {:name name})))))

(defn eval-ast-to-ir-node [mode node ctx]
  (cond
    (= mode :seq)
    (loop [remaining node out []]
      (if (or (nil? remaining) (empty? remaining))
        out
        (recur (rest remaining)
               (conj out (eval-ast-to-ir-node :eval (first remaining) ctx)))))

    (= mode :eval)
    (let [kind (:kind node)]
      (cond
        (= kind :string) (ast-node-to-ir node)
        (= kind :char) (ast-node-to-ir node)
        (= kind :int) (ast-node-to-ir node)
        (= kind :bigint) (ast-node-to-ir node)
        (= kind :ratio) (ast-node-to-ir node)
        (= kind :float) (ast-node-to-ir node)
        (= kind :keyword) (ast-node-to-ir node)
        (= kind :quoted-symbol) (ast-node-to-ir node)

        (= kind :symbol)
        (let [name (:name node)]
          (if (or (= name "true") (= name "false") (= name "nil"))
            (ast-node-to-ir node)
            (:ir (symbol-to-ir name name ctx))))

        (= kind :quoted-list) (quoted-ast-to-ir node)

        (= kind :vector)
        (ctor-to-ir "NewArray" (eval-ast-to-ir-node :seq (:elements node) ctx))

        (= kind :pipe-vector)
        (ctor-to-ir "NewVector" (eval-ast-to-ir-node :seq (:elements node) ctx))

        (= kind :set)
        (ctor-to-ir "NewSet" (eval-ast-to-ir-node :seq (:elements node) ctx))

        (= kind :map)
        (let [entries (:entries node)
              n (if (nil? entries) 0 (count entries))]
          (if (not (= 0 (% n 2)))
            (throw (ex-info "map literal expects key/value pairs" {:node node}))
            (ctor-to-ir "NewMap" (eval-ast-to-ir-node :seq entries ctx))))

        (= kind :list) (eval-ast-to-ir-node :call node ctx)

        :else (throw (ex-info "unsupported AST node for eval lowering"
                              {:node node}))))

    (= mode :call)
    (let [elements (:elements node)]
      (if (or (nil? elements) (empty? elements))
        (throw (ex-info "unsupported form" {:node node}))
        (let [head (first elements)
              args (rest elements)]
          (if (= :symbol (:kind head))
            (let [op (:name head)
                  unary (get unary-runtime-ops op)
                  fold (get fold-runtime-ops op)
                  binary (get binary-runtime-ops op)
                  variadic (get variadic-runtime-ops op)]
              (cond
                unary
                (if (not (= 1 (count args)))
                  (throw (ex-info (str op " expects exactly one argument") {:node node}))
                  (runtime-call-to-ir unary (eval-ast-to-ir-node :seq args ctx)))

                fold
                (fold-call-to-ir fold (eval-ast-to-ir-node :seq args ctx))

                binary
                (if (not (= 2 (count args)))
                  (throw (ex-info (str op " expects exactly two arguments") {:node node}))
                  (runtime-call-to-ir binary (eval-ast-to-ir-node :seq args ctx)))

                variadic
                (runtime-call-to-ir variadic (eval-ast-to-ir-node :seq args ctx))

                (contains? special-form-names op)
                (throw (ex-info "special form not handled by eval lowering"
                                {:node node}))

                :else
                (call-to-ir (eval-ast-to-ir-node :eval head ctx)
                            (eval-ast-to-ir-node :seq args ctx))))
            (call-to-ir (eval-ast-to-ir-node :eval head ctx)
                        (eval-ast-to-ir-node :seq args ctx))))))

    :else (throw (ex-info "unsupported eval lowering mode" {:mode mode}))))

(defn eval-ast-to-ir [node ctx]
  (eval-ast-to-ir-node :eval node ctx))

(defn stmt-list [stmts]
  (if (or (nil? stmts) (empty? stmts))
    []
    stmts))

(defn append-stmt [stmts stmt]
  (conj (stmt-list stmts) stmt))

(defn if-to-ir [name type cond then-stmts then-expr else-stmts else-expr]
  [{:kind :var :name name :type type :expr nil}
   {:kind :if
    :init ""
    :cond cond
    :then (append-stmt then-stmts {:kind :assign :name name :expr then-expr})
    :else (append-stmt else-stmts {:kind :assign :name name :expr else-expr})}])

(defn concat-stmts [left right]
  (loop [out (stmt-list left) remaining (stmt-list right)]
    (if (or (nil? remaining) (empty? remaining))
      out
      (recur (conj out (first remaining)) (rest remaining)))))

(defn let-to-ir [name type binding-stmts body-stmts body-expr]
  [{:kind :var :name name :type type :expr nil}
   {:kind :block
    :body (append-stmt (concat-stmts binding-stmts body-stmts)
                       {:kind :assign :name name :expr body-expr})}])

(defn last-item [xs]
  (loop [remaining (stmt-list xs)]
    (let [more (rest remaining)]
      (if (or (nil? more) (empty? more))
        (first remaining)
        (recur more)))))

(defn do-form-stmt [form]
  (let [stmt (:stmt form)]
    (if (nil? stmt)
      {:kind :expr-stmt :expr (:expr form) :discard true}
      stmt)))

(defn do-prelude-stmts [forms]
  (loop [remaining (stmt-list forms) out []]
    (if (or (nil? remaining) (empty? remaining))
      out
      (let [form (first remaining)
            more (rest remaining)
            with-stmts (concat-stmts out (:stmts form))]
        (if (or (nil? more) (empty? more))
          with-stmts
          (recur more (append-stmt with-stmts (do-form-stmt form))))))))

(defn do-iife-body [forms]
  (let [last (last-item forms)
        prelude (do-prelude-stmts forms)]
    (if (:defer? last)
      (append-stmt (append-stmt prelude (do-form-stmt last))
                   {:kind :return :expr (literal-rt-call "NilValue" [])})
      (append-stmt prelude {:kind :return :expr (:expr last)}))))

(defn do-defer-to-ir [type forms]
  {:kind :call
   :fun {:kind :func-lit :params "" :result type :body (do-iife-body forms)}
   :args []})

(defn loop-binding-stmts [bindings]
  (loop [remaining (stmt-list bindings) out []]
    (if (or (nil? remaining) (empty? remaining))
      out
      (let [b (first remaining)
            with-var (append-stmt out {:kind :var :name (:name b) :type "" :expr (:init b)})
            with-unused (if (:unused b)
                          (append-stmt with-var {:kind :expr-stmt
                                                 :expr {:kind :ident :name (:name b)}
                                                 :discard true})
                          with-var)]
        (recur (rest remaining) with-unused)))))

(defn loop-recur-then [names]
  (let [n (count names)
        arity-check {:kind :if
                     :init ""
                     :cond {:kind :binary
                            :op "!="
                            :left {:kind :call
                                   :fun {:kind :ident :name "len"}
                                   :args [{:kind :ident :name "__recurValues"}]}
                            :right {:kind :int :value n}}
                     :then [{:kind :expr-stmt
                             :expr {:kind :call
                                    :fun {:kind :ident :name "panic"}
                                    :args [{:kind :string :value "internal error: recur arity mismatch"}]}
                             :discard false}]
                     :else []}]
    (loop [remaining (stmt-list names) i 0 out [arity-check]]
      (if (or (nil? remaining) (empty? remaining))
        (append-stmt out {:kind :expr-stmt
                          :expr {:kind :ident :name "continue"}
                          :discard false})
        (recur (rest remaining)
               (inc i)
               (conj out {:kind :assign
                          :name (first remaining)
                          :expr {:kind :index
                                 :x {:kind :ident :name "__recurValues"}
                                 :index {:kind :int :value i}}}))))))

(defn loop-iter-body [binding-names body-stmts body-expr]
  (concat-stmts
    body-stmts
    [{:kind :define :names ["__loopResult"] :expr body-expr}
     {:kind :if
      :init "__recurValues, __isRecur := flagrt.UnwrapRecur(__loopResult)"
      :cond {:kind :ident :name "__isRecur"}
      :then (loop-recur-then binding-names)
      :else []}
     {:kind :return :expr {:kind :ident :name "__loopResult"}}]))

(defn loop-to-ir [init-stmts bindings body-stmts body-expr]
  (let [names (loop [remaining (stmt-list bindings) out []]
                (if (or (nil? remaining) (empty? remaining))
                  out
                  (recur (rest remaining) (conj out (:name (first remaining))))))]
    {:kind :call
     :fun {:kind :func-lit
           :params ""
           :result "flagrt.Value"
           :body (concat-stmts
                   init-stmts
                   (concat-stmts
                     (loop-binding-stmts bindings)
                     [{:kind :for :body (loop-iter-body names body-stmts body-expr)}]))}
     :args []}))

(defn recur-to-ir [values]
  (literal-rt-call "NewRecur" (stmt-list values)))

(defn defer-to-ir [thunk]
  {:kind :defer :expr (literal-rt-call "Call" [thunk])})

(defn throw-to-ir [stmts value]
  {:kind :call
   :fun {:kind :func-lit
         :params ""
         :result "flagrt.Value"
         :body (append-stmt
                 (append-stmt stmts {:kind :expr-stmt
                                     :expr (literal-rt-call "Throw" [value])
                                     :discard false})
                 {:kind :return :expr (literal-rt-call "NilValue" [])})}
   :args []})

(defn future-to-ir [body-stmts body-expr]
  (literal-rt-call "NewFuture"
                   [{:kind :func-lit
                     :params ""
                     :result "flagrt.Value"
                     :body (append-stmt body-stmts {:kind :return :expr body-expr})}]))

(defn value-iife-ir [body]
  {:kind :call
   :fun {:kind :func-lit :params "" :result "flagrt.Value" :body body}
   :args []})

(defn ident-call-ir [name args]
  {:kind :call :fun {:kind :ident :name name} :args args})

(defn self-call-target [name nargs ctx]
  (if (or (nil? name) (= "" name) (not (= name (:self-function-name ctx))))
    nil
    (let [arity-names (:self-arity-names ctx)]
      (if (and (not (nil? arity-names)) (contains? arity-names nargs))
        (get arity-names nargs)
        (if (or (:self-function-rest ctx) (= nargs (:self-function-arity ctx)))
          (if (:self-function-rest ctx)
            (:self-variadic-name ctx)
            (:self-arity-name ctx))
          nil)))))

(defn doto-to-ir [target-stmts target-expr steps]
  (value-iife-ir
    (concat-stmts
      target-stmts
      (append-stmt
        (loop [remaining (stmt-list steps)
               out [{:kind :define :names ["__doto"] :expr target-expr}]]
          (if (or (nil? remaining) (empty? remaining))
            out
            (let [step (first remaining)
                  with-stmts (concat-stmts out (:stmts step))]
              (recur (rest remaining)
                     (append-stmt with-stmts
                                  {:kind :expr-stmt
                                   :expr (literal-rt-call "Call"
                                                          [(:expr step)
                                                           {:kind :ident :name "__doto"}])
                                   :discard true})))))
        {:kind :return :expr {:kind :ident :name "__doto"}}))))

(defn update-bang-to-ir [name stmts value]
  (value-iife-ir
    (append-stmt
      (append-stmt stmts {:kind :assign :name name :expr value})
      {:kind :return :expr {:kind :ident :name name}})))

(defn catch-handler-to-ir [name body-stmts body-expr]
  (let [bind (if (= name "_")
               [{:kind :expr-stmt
                 :expr {:kind :ident :name "__flag_thrown"}
                 :discard true}]
               [{:kind :var :name name :type "" :expr {:kind :ident :name "__flag_thrown"}}
                {:kind :expr-stmt :expr {:kind :ident :name name} :discard true}])]
    (value-iife-ir
      (append-stmt (concat-stmts bind body-stmts)
                   {:kind :return :expr body-expr}))))

(defn try-finally-stmt [finally]
  {:kind :defer
   :expr {:kind :call
          :fun {:kind :func-lit
                :params ""
                :result ""
                :body (append-stmt (:stmts finally)
                                   {:kind :expr-stmt :expr (:expr finally) :discard true})}
          :args []}})

(defn try-recover-body [catches]
  (loop [remaining (stmt-list catches)
         out [{:kind :define :names ["r"] :expr (ident-call-ir "recover" [])}
              {:kind :if
               :init ""
               :cond {:kind :binary
                      :op "=="
                      :left {:kind :ident :name "r"}
                      :right {:kind :ident :name "nil"}}
               :then [{:kind :return :expr nil}]
               :else []}
              {:kind :define
               :names ["__flag_thrown"]
               :expr (literal-rt-call "PanicValue" [{:kind :ident :name "r"}])}]]
    (if (or (nil? remaining) (empty? remaining))
      (append-stmt out {:kind :expr-stmt
                        :expr (ident-call-ir "panic" [{:kind :ident :name "r"}])
                        :discard false})
      (let [c (first remaining)
            then (append-stmt
                   (append-stmt (:stmts c)
                                {:kind :assign :name "__flag_try_result" :expr (:handler c)})
                   {:kind :return :expr nil})]
        (recur (rest remaining)
               (append-stmt out {:kind :if
                                 :init ""
                                 :cond (literal-rt-call "CatchMatches"
                                                        [{:kind :string :value (:class c)}
                                                         {:kind :ident :name "__flag_thrown"}])
                                 :then then
                                 :else []}))))))

(defn try-to-ir [body-stmts body-expr catches finally]
  (let [has-catch (not (or (nil? catches) (empty? (stmt-list catches))))]
    (let [start (if has-catch
                  [{:kind :var :name "__flag_try_result" :type "flagrt.Value" :expr nil}]
                  [])]
      (let [start (if (nil? finally)
                    start
                    (append-stmt start (try-finally-stmt finally)))]
        (if (not has-catch)
          (value-iife-ir
            (append-stmt (concat-stmts start body-stmts)
                         {:kind :return :expr body-expr}))
          (let [inner (append-stmt
                        (concat-stmts
                          [{:kind :defer
                            :expr {:kind :call
                                   :fun {:kind :func-lit
                                         :params ""
                                         :result ""
                                         :body (try-recover-body catches)}
                                   :args []}}]
                          body-stmts)
                        {:kind :assign :name "__flag_try_result" :expr body-expr})]
            (value-iife-ir
              (append-stmt
                (append-stmt start
                             {:kind :expr-stmt
                              :expr {:kind :call
                                     :fun {:kind :func-lit :params "" :result "" :body inner}
                                     :args []}
                              :discard false})
                {:kind :return :expr {:kind :ident :name "__flag_try_result"}}))))))))

(defn doseq-to-ir [loop-expr]
  (value-iife-ir
    [{:kind :expr-stmt :expr (literal-rt-call "DoAll" [loop-expr]) :discard true}
     {:kind :return :expr (literal-rt-call "NilValue" [])}]))

(defn doseq-body-to-ir [body-stmts body-expr]
  (value-iife-ir
    (append-stmt
      (append-stmt body-stmts {:kind :expr-stmt :expr body-expr :discard true})
      {:kind :return :expr (literal-rt-call "NewArray" [])})))

(defn mapcat-binding-to-ir [ident unused panic-msg rest-expr rest-stmts coll]
  (let [args0 {:kind :index :x {:kind :ident :name "args"} :index {:kind :int :value 0}}
        arity {:kind :if
               :init ""
               :cond {:kind :binary
                      :op "!="
                      :left (ident-call-ir "len" [{:kind :ident :name "args"}])
                      :right {:kind :int :value 1}}
               :then [{:kind :expr-stmt
                       :expr (ident-call-ir "panic" [{:kind :string :value panic-msg}])
                       :discard false}]
               :else []}
        bind (if (= ident "_")
               [{:kind :expr-stmt :expr args0 :discard true}]
               (if unused
                 [{:kind :define :names [ident] :expr args0}
                  {:kind :expr-stmt :expr {:kind :ident :name ident} :discard true}]
                 [{:kind :define :names [ident] :expr args0}]))
        fn {:kind :func-lit
            :params "args ...flagrt.Value"
            :result "flagrt.Value"
            :body (append-stmt
                    (concat-stmts (concat-stmts [arity] bind) rest-stmts)
                    {:kind :return :expr rest-expr})}]
    (value-iife-ir
      [{:kind :return
        :expr (literal-rt-call "MapCat"
                               [(literal-rt-call "NewFunction" [fn])
                                coll])}])))

(defn fn-arity-check [name n has-rest]
  (let [op (if has-rest "<" "!=")
        msg (if has-rest
              (str name " expects at least " n " arguments")
              (str name " expects exactly " n " arguments"))]
    {:kind :if
     :init ""
     :cond {:kind :binary
            :op op
            :left (ident-call-ir "len" [{:kind :ident :name "args"}])
            :right {:kind :int :value n}}
     :then [{:kind :expr-stmt
             :expr (ident-call-ir "panic" [{:kind :string :value msg}])
             :discard false}]
     :else []}))

(defn fn-param-stmts [params]
  (loop [remaining (stmt-list params) i 0 out []]
    (if (or (nil? remaining) (empty? remaining))
      out
      (let [p (first remaining)
            arg {:kind :index :x {:kind :ident :name "args"} :index {:kind :int :value i}}
            stmt (if (= p "_")
                   {:kind :expr-stmt :expr arg :discard true}
                   {:kind :define :names [p] :expr arg})]
        (recur (rest remaining) (inc i) (conj out stmt))))))

(defn fn-to-ir [name params has-rest init-stmts body-stmts body-expr]
  (literal-rt-call
    "NewFunction"
    [{:kind :func-lit
      :params "args ...flagrt.Value"
      :result "flagrt.Value"
      :body (append-stmt
              (concat-stmts
                (concat-stmts
                  (concat-stmts [(fn-arity-check name (count (stmt-list params)) has-rest)]
                                (fn-param-stmts params))
                  init-stmts)
                body-stmts)
              {:kind :return :expr body-expr})}]))

(defn ns-to-ir [namespace]
  {:kind :raw-stmt :code (str "// Source namespace: " namespace "\n")})

(defn def-to-ir [name expr]
  {:kind :var :name name :type "" :expr expr})

(defn defn-binding-to-ir [name variadic-name]
  (def-to-ir name (literal-rt-call "NewFunction" [{:kind :ident :name variadic-name}])))

(defn defn-param-list [params]
  (loop [remaining (stmt-list params) out "" first? true]
    (if (or (nil? remaining) (empty? remaining))
      out
      (let [p (first remaining)
            piece (str p " flagrt.Value")]
        (if first?
          (recur (rest remaining) piece false)
          (recur (rest remaining) (str out ", " piece) false))))))

(defn defn-body [init-stmts body-stmts body-expr]
  (append-stmt (concat-stmts init-stmts body-stmts)
               {:kind :return :expr body-expr}))

(defn defn-func-decl [name params result body]
  {:kind :func-decl :name name :params params :result result :body body})

(defn defn-arity-to-ir [name params init-stmts body-stmts body-expr]
  (defn-func-decl name
                  (defn-param-list params)
                  "flagrt.Value"
                  (defn-body init-stmts body-stmts body-expr)))

(defn defn-call-args [n]
  (loop [i 0 out []]
    (if (= i n)
      out
      (recur (inc i)
             (conj out {:kind :index
                        :x {:kind :ident :name "args"}
                        :index {:kind :int :value i}})))))

(defn defn-variadic-to-ir [name arity-name panic-name n]
  (defn-func-decl name
                  "args ...flagrt.Value"
                  "flagrt.Value"
                  [(fn-arity-check panic-name n false)
                   {:kind :return
                    :expr {:kind :call
                           :fun {:kind :ident :name arity-name}
                           :args (defn-call-args n)}}]))

(defn defn-rest-to-ir [name panic-name params init-stmts body-stmts body-expr]
  (defn-func-decl name
                  "args ...flagrt.Value"
                  "flagrt.Value"
                  (append-stmt
                    (concat-stmts
                      (concat-stmts
                        (concat-stmts [(fn-arity-check panic-name (count (stmt-list params)) true)]
                                      (fn-param-stmts params))
                        init-stmts)
                      body-stmts)
                    {:kind :return :expr body-expr})))

(defn defn-to-ir [arity-name variadic-name panic-name params has-rest init-stmts body-stmts body-expr]
  (if has-rest
    [(defn-rest-to-ir variadic-name panic-name params init-stmts body-stmts body-expr)]
    [(defn-arity-to-ir arity-name params init-stmts body-stmts body-expr)
     (defn-variadic-to-ir variadic-name arity-name panic-name (count (stmt-list params)))]))

(defn defn-multi-dispatch-to-ir [name panic-msg arities]
  (defn-func-decl name
                  "args ...flagrt.Value"
                  "flagrt.Value"
                  (append-stmt
                    (loop [remaining (stmt-list arities) out []]
                      (if (or (nil? remaining) (empty? remaining))
                        out
                        (let [a (first remaining)
                              n (:n a)
                              aname (:name a)]
                          (recur (rest remaining)
                                 (conj out {:kind :if
                                            :init ""
                                            :cond {:kind :binary
                                                   :op "=="
                                                   :left (ident-call-ir "len" [{:kind :ident :name "args"}])
                                                   :right {:kind :int :value n}}
                                            :then [{:kind :return
                                                    :expr {:kind :call
                                                           :fun {:kind :ident :name aname}
                                                           :args (defn-call-args n)}}]
                                            :else []})))))
                    {:kind :expr-stmt
                     :expr (ident-call-ir "panic" [{:kind :string :value panic-msg}])
                     :discard false})))

(defn defn-multi-to-ir [variadic-name panic-msg arities]
  (concat-stmts
    (loop [remaining (stmt-list arities) out []]
      (if (or (nil? remaining) (empty? remaining))
        out
        (let [a (first remaining)]
          (recur (rest remaining)
                 (conj out (defn-arity-to-ir (:name a)
                                             (:params a)
                                             (:init-stmts a)
                                             (:body-stmts a)
                                             (:body-expr a)))))))
    [(defn-multi-dispatch-to-ir variadic-name panic-msg arities)]))

(def go-ident-letters "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ")
(def go-ident-digits "0123456789")
(def go-keywords
  #{"break" "case" "chan" "const" "continue" "default" "defer" "else"
    "fallthrough" "for" "func" "go" "goto" "if" "import" "interface"
    "map" "package" "range" "return" "select" "struct" "switch" "type" "var"})

(defn str-has-char? [s ch]
  (loop [remaining s]
    (if (or (nil? remaining) (= 0 (count remaining)))
      false
      (if (= ch (subs remaining 0 1))
        true
        (recur (subs remaining 1))))))

(defn ident-letter? [ch]
  (str-has-char? go-ident-letters ch))

(defn ident-digit? [ch]
  (str-has-char? go-ident-digits ch))

(defn go-ident-char [ch first?]
  (cond
    (= ch "-") "_"
    (and first? (or (= ch "_") (ident-letter? ch))) ch
    (and (not first?) (= ch "?")) "_q"
    (and (not first?) (= ch "!")) "_bang"
    (and (not first?) (= ch ">")) "_gt"
    (and (not first?) (= ch "<")) "_lt"
    (and (not first?) (or (= ch "_") (ident-letter? ch) (ident-digit? ch))) ch
    :else nil))

(defn go-ident [name]
  (if (or (nil? name) (= "" name))
    (throw (ex-info "empty symbol" {:name name}))
    (loop [i 0 n (count name) out ""]
      (if (= i n)
        (let [ident (if (= out "main") "flag_main" out)]
          (if (contains? go-keywords ident)
            (str ident "_")
            ident))
        (let [ch (subs name i (inc i))
              piece (go-ident-char ch (= i 0))]
          (if (nil? piece)
            (throw (ex-info (str "unsupported symbol \"" name "\"") {:name name}))
            (recur (inc i) n (str out piece))))))))

(defn go-ident-or-empty [name]
  (if (or (nil? name) (= "" name))
    ""
    (loop [i 0 n (count name) out ""]
      (if (= i n)
        (let [ident (if (= out "main") "flag_main" out)]
          (if (contains? go-keywords ident)
            (str ident "_")
            ident))
        (let [ch (subs name i (inc i))
              piece (go-ident-char ch (= i 0))]
          (if (nil? piece)
            ""
            (recur (inc i) n (str out piece))))))))

(defn parse-volatile [pattern]
  (if (not (= :meta (:kind pattern)))
    {:volatile? false :target pattern}
    (let [m (:meta pattern)
          target (:target pattern)]
      (if (not (= :map (:kind m)))
        {:volatile? false :target target}
        (let [entries (:entries m)]
          (if (not (= 0 (% (count entries) 2)))
            (throw (ex-info "metadata map expects key/value pairs" {:node m}))
            (loop [remaining entries volatile? false]
              (if (or (nil? remaining) (empty? remaining))
                {:volatile? volatile? :target target}
                (let [k (first remaining)
                      v (first (rest remaining))]
                  (if (and (= :keyword (:kind k)) (= "volatile" (:name k)))
                    (if (and (= :symbol (:kind v)) (= "true" (:name v)))
                      (recur (rest (rest remaining)) true)
                      (if (and (= :symbol (:kind v)) (= "false" (:name v)))
                        (recur (rest (rest remaining)) false)
                        (throw (ex-info "metadata :volatile must be true or false" {:node v}))))
                    (recur (rest (rest remaining)) volatile?)))))))))))

(defn unwrap-ast [node]
  (if (= :meta (:kind node))
    (unwrap-ast (:target node))
    node))

(defn ast-seq [node]
  (if (nil? node)
    []
    (let [els (:elements node)]
      (if (nil? els)
        node
        els))))

(defn unused-binding? [name]
  (and (not (nil? name))
       (not (= 0 (count name)))
       (= "_" (subs name 0 1))))

(defn append-unused [stmts flag-name go-name]
  (if (and (unused-binding? flag-name) (not (= go-name "_")))
    (conj stmts {:kind :expr-stmt :expr {:kind :ident :name go-name} :discard true})
    stmts))

(defn fresh-temp [state prefix]
  (let [n (:temp state)]
    {:name (str prefix n)
     :state (assoc state :temp (inc n))}))

(defn declare-param [state flag-name go-name]
  (if (= go-name "_")
    state
    (if (contains? (:declared state) go-name)
      (throw (ex-info (str "duplicate parameter \"" flag-name "\"") {:name flag-name}))
      (assoc (assoc state
                    :declared (assoc (:declared state) go-name true))
             :locals (assoc (:locals state) go-name :value)))))

(defn declare-binding [state flag-name go-name kind]
  (if (= go-name "_")
    state
    (if (contains? (:declared state) go-name)
      (throw (ex-info (str "duplicate binding \"" flag-name "\"") {:name flag-name}))
      (assoc (assoc state
                    :declared (assoc (:declared state) go-name true))
             :locals (assoc (:locals state) go-name kind)))))

(defn rest-source-ir [n ctor]
  (literal-rt-call ctor
                   [{:kind :spread
                     :expr {:kind :slice
                            :x {:kind :ident :name "args"}
                            :low {:kind :int :value n}
                            :high nil}}]))

(defn bind-symbol-param [state flag-name]
  (let [go-name (go-ident flag-name)
        with-decl (declare-param state flag-name go-name)]
    (assoc (assoc with-decl :params (conj (:params with-decl) go-name))
           :init-stmts (append-unused (:init-stmts with-decl) flag-name go-name))))

(defn bind-symbol-to [state flag-name source kind]
  (let [go-name (go-ident flag-name)
        with-decl (declare-binding state flag-name go-name kind)
        with-var (conj (:init-stmts with-decl)
                       {:kind :var :name go-name :type "" :expr source})]
    (assoc with-decl :init-stmts (append-unused with-var flag-name go-name))))

(defn unhandled-param [node]
  (throw (ex-info "not handled by FLAG param lowering" {:node node})))

(defn map-entries [node]
  (let [entries (:entries node)]
    (if (nil? entries) [] entries)))

(defn map-destructure-key-ir [node]
  (let [form (unwrap-ast node)
        kind (:kind form)]
    (cond
      (= kind :keyword) (literal-rt-call "NewKeyword" [{:kind :string :value (:name form)}])
      (= kind :symbol) (literal-rt-call "NewSymbol" [{:kind :string :value (:name form)}])
      (= kind :quoted-symbol) (literal-rt-call "NewSymbol" [{:kind :string :value (:name form)}])
      (= kind :int) (literal-rt-call "NewLong" [{:kind :int :value (:value form)}])
      (= kind :bigint) (literal-rt-call "NewBigIntFromString" [{:kind :string :value (:value form)}])
      (= kind :float)
      (literal-rt-call "NewDouble" [{:kind :raw
                                     :code (if (or (nil? (:raw form)) (= "" (:raw form)))
                                             (str (:value form))
                                             (:raw form))}])
      (= kind :string) (literal-rt-call "NewString" [{:kind :string :value (:value form)}])
      (= kind :char) (literal-rt-call "NewString" [{:kind :string :value (:value form)}])
      :else (unhandled-param node))))

(defn literal-default-ir [node]
  (let [form (unwrap-ast node)
        kind (:kind form)]
    (cond
      (or (= kind :string) (= kind :char) (= kind :int) (= kind :bigint)
          (= kind :ratio) (= kind :float) (= kind :keyword) (= kind :quoted-symbol))
      (ast-node-to-ir form)
      (= kind :symbol)
      (if (or (= (:name form) "true") (= (:name form) "false") (= (:name form) "nil"))
        (ast-node-to-ir form)
        (unhandled-param node))
      :else (unhandled-param node))))

(defn collect-or-defaults [defaults node]
  (let [form (unwrap-ast node)]
    (if (not (= :map (:kind form)))
      (throw (ex-info "map destructuring :or expects a map" {:node node}))
      (let [entries (map-entries form)]
        (if (not (= 0 (% (count entries) 2)))
          (throw (ex-info "map destructuring :or expects key/value pairs" {:node node}))
          (loop [remaining entries out defaults]
            (if (or (nil? remaining) (empty? remaining))
              out
              (let [key-node (unwrap-ast (first remaining))
                    kind (:kind key-node)]
                (if (not (or (= kind :symbol) (= kind :keyword)))
                  (throw (ex-info "map destructuring :or keys must be symbols or keywords" {:node key-node}))
                  (if (= "" (:name key-node))
                    (throw (ex-info "map destructuring :or key cannot be empty" {:node key-node}))
                    (recur (rest (rest remaining))
                           (assoc out (:name key-node) (literal-default-ir (first (rest remaining)))))))))))))))

(defn append-bindings [left right]
  (loop [remaining right out left]
    (if (or (nil? remaining) (empty? remaining))
      out
      (recur (rest remaining) (conj out (first remaining))))))

(defn expand-destructure-special [name vec-node]
  (let [form (unwrap-ast vec-node)]
    (if (not (= :vector (:kind form)))
      (throw (ex-info (str "map destructuring :" name " expects a vector") {:node vec-node}))
      (loop [remaining (ast-seq form) out []]
        (if (or (nil? remaining) (empty? remaining))
          out
          (let [item (first remaining)
                node (unwrap-ast item)]
            (cond
              (= name "keys")
              (if (or (not (= :symbol (:kind node))) (= "" (:name node)))
                (throw (ex-info "map destructuring :keys entries must be symbols" {:node item}))
                (recur (rest remaining)
                       (conj out {:key (literal-rt-call "NewKeyword" [{:kind :string :value (:name node)}])
                                  :binding item})))
              (= name "syms")
              (if (or (not (= :symbol (:kind node))) (= "" (:name node)))
                (throw (ex-info "map destructuring :syms entries must be symbols" {:node item}))
                (recur (rest remaining)
                       (conj out {:key (literal-rt-call "NewSymbol" [{:kind :string :value (:name node)}])
                                  :binding item})))
              (= name "strs")
              (if (not (= :string (:kind node)))
                (throw (ex-info "map destructuring :strs entries must be strings" {:node item}))
                (recur (rest remaining)
                       (conj out {:key (literal-rt-call "NewString" [{:kind :string :value (:value node)}])
                                  :binding {:kind :symbol :name (go-ident (:value node))}})))
              :else (throw (ex-info (str "unsupported map destructuring key :" name) {})))))))))

(defn bind-pattern-node [mode state pattern source]
  (cond
    (= mode :pattern)
    (let [node (unwrap-ast pattern)
          kind (:kind node)]
      (cond
        (= kind :symbol)
        (if (= "&" (:name node))
          (throw (ex-info "unexpected & in binding" {:node node}))
          (if (= "" (:name node))
            (throw (ex-info "binding symbol cannot be empty" {:node node}))
            (bind-symbol-to state (:name node) source :value)))

        (= kind :vector)
        (bind-pattern-node :vector state node source)

        (= kind :map)
        (bind-pattern-node :map state node source)

        :else (unhandled-param node)))

    (= mode :vector)
  (loop [remaining (ast-seq pattern)
         positionals []
         rest-pat nil
         as-pat nil
         seen-rest false]
    (if (or (nil? remaining) (empty? remaining))
      (let [with-as (if (nil? as-pat)
                      state
                      (bind-pattern-node :pattern state as-pat source))]
        (loop [remaining positionals
               current source
               st with-as]
          (if (or (nil? remaining) (empty? remaining))
            (if (nil? rest-pat)
              st
              (bind-pattern-node :pattern st rest-pat current))
            (let [t (fresh-temp st "__dseq")
                  next-name (:name t)
                  st1 (:state t)
                  st2 (assoc st1 :init-stmts
                             (conj (:init-stmts st1)
                                   {:kind :var
                                    :name next-name
                                    :type ""
                                    :expr (literal-rt-call "SeqFirst" [current])}))
                  st3 (bind-pattern-node :pattern st2 (first remaining) {:kind :ident :name next-name})]
              (recur (rest remaining)
                     (literal-rt-call "SeqRest" [current])
                     st3)))))
      (let [item (first remaining)
            node (unwrap-ast item)]
        (cond
          (and (= :keyword (:kind node)) (= "as" (:name node)))
          (if (or (nil? (rest remaining)) (empty? (rest remaining)))
            (throw (ex-info "vector destructuring :as expects a binding form" {:node pattern}))
            (if (not (nil? as-pat))
              (throw (ex-info "vector destructuring supports only one :as" {:node pattern}))
              (recur (rest (rest remaining)) positionals rest-pat (first (rest remaining)) seen-rest)))

          (and (= :symbol (:kind node)) (= "&" (:name node)))
          (if seen-rest
            (throw (ex-info "vector destructuring supports only one & binding" {:node pattern}))
            (if (or (nil? (rest remaining)) (empty? (rest remaining)))
              (throw (ex-info "vector destructuring & expects a binding form" {:node pattern}))
              (recur (rest (rest remaining)) positionals (first (rest remaining)) as-pat true)))

          seen-rest
          (throw (ex-info "vector destructuring only allows :as after & binding" {:node pattern}))

          :else
          (recur (rest remaining) (conj positionals item) rest-pat as-pat seen-rest)))))

    (= mode :map)
    (let [entries (map-entries pattern)]
      (if (not (= 0 (% (count entries) 2)))
        (throw (ex-info "map destructuring expects key/value pairs" {:node pattern}))
        (loop [remaining entries
               bindings []
               as-pat nil
               defaults {}]
          (if (or (nil? remaining) (empty? remaining))
            (let [with-as (if (nil? as-pat)
                            state
                            (bind-pattern-node :pattern state as-pat source))]
              (loop [remaining bindings st with-as]
                (if (or (nil? remaining) (empty? remaining))
                  st
                  (let [b (first remaining)
                        binding (:binding b)
                        binding-node (unwrap-ast binding)
                        value-expr (if (and (= :symbol (:kind binding-node))
                                            (contains? defaults (:name binding-node)))
                                     (literal-rt-call "Get" [source (:key b) (get defaults (:name binding-node))])
                                     (literal-rt-call "Get" [source (:key b)]))]
                    (recur (rest remaining)
                           (bind-pattern-node :pattern st binding value-expr))))))
            (let [key (first remaining)
                  value (first (rest remaining))
                  key-node (unwrap-ast key)]
              (if (and (= :keyword (:kind key-node))
                       (or (= "as" (:name key-node))
                           (= "or" (:name key-node))
                           (= "keys" (:name key-node))
                           (= "syms" (:name key-node))
                           (= "strs" (:name key-node))))
                (cond
                  (= "as" (:name key-node))
                  (recur (rest (rest remaining)) bindings value defaults)

                  (= "or" (:name key-node))
                  (recur (rest (rest remaining)) bindings as-pat (collect-or-defaults defaults value))

                  :else
                  (recur (rest (rest remaining))
                         (append-bindings bindings (expand-destructure-special (:name key-node) value))
                         as-pat
                         defaults))
                (recur (rest (rest remaining))
                       (conj bindings {:key (map-destructure-key-ir key) :binding value})
                       as-pat
                       defaults)))))))

    :else (throw (ex-info "unsupported bind-pattern mode" {:mode mode}))))

(defn bind-pattern [state pattern source]
  (bind-pattern-node :pattern state pattern source))

(defn bind-params-to-ir [params-ast label locals]
  (loop [remaining (ast-seq params-ast)
         idx 0
         state {:params []
                :init-stmts []
                :locals (if (or (nil? locals) (empty? locals)) {} locals)
                :declared {}
                :temp 0
                :has-rest false}]
    (if (or (nil? remaining) (empty? remaining))
      {:params (:params state)
       :init-stmts (:init-stmts state)
       :locals (:locals state)
       :has-rest (:has-rest state)}
      (let [node (unwrap-ast (first remaining))]
        (if (and (= :symbol (:kind node)) (= "&" (:name node)))
          (if (:has-rest state)
            (throw (ex-info (str label " parameters support only one & binding") {:label label}))
            (if (or (nil? (rest remaining)) (empty? (rest remaining)))
              (throw (ex-info (str label " & expects a binding form") {:label label}))
              (let [rest-pat (first (rest remaining))
                    rest-node (unwrap-ast rest-pat)
                    t (fresh-temp state "__rest")
                    rest-name (:name t)
                    st1 (:state t)
                    ctor (if (= :map (:kind rest-node))
                           "NewMap"
                           "NewArray")
                    source (rest-source-ir (count (:params st1)) ctor)
                    st2 (assoc st1 :has-rest true)
                    st3 (assoc st2 :locals (assoc (:locals st2) rest-name :value))
                    st4 (assoc st3 :init-stmts
                               (conj (conj (:init-stmts st3)
                                           {:kind :var :name rest-name :type "" :expr source})
                                     {:kind :expr-stmt
                                      :expr {:kind :ident :name rest-name}
                                      :discard true}))
                    st5 (bind-pattern st4 rest-pat {:kind :ident :name rest-name})]
                {:params (:params st5)
                 :init-stmts (:init-stmts st5)
                 :locals (:locals st5)
                 :has-rest true})))
          (if (and (= :symbol (:kind node)) (not (= "" (:name node))))
            (recur (rest remaining) (inc idx) (bind-symbol-param state (:name node)))
            (if (or (= :vector (:kind node)) (= :map (:kind node)))
              (let [param-name (str "__arg" idx)
                    st1 (assoc state :params (conj (:params state) param-name))
                    st2 (bind-pattern st1 node {:kind :ident :name param-name})]
                (recur (rest remaining) (inc idx) st2))
              (unhandled-param node))))))))

(defn form-result [stmts expr kind ctx]
  {:stmts (stmt-list stmts)
   :expr expr
   :expr-kind kind
   :defer? false
   :ctx ctx})

(defn next-form-temp [ctx prefix]
  (let [cur (if (nil? (:if-temps ctx)) 0 (:if-temps ctx))
        n (inc cur)]
    {:name (str prefix "_" n)
     :ctx (assoc ctx :if-temps n)}))

(defn coerce-form-value [part]
  (let [k (:expr-kind part)]
    (cond
      (= k :string)
      (form-result (:stmts part)
                   (literal-rt-call "NewString" [(:expr part)])
                   :value
                   (:ctx part))
      (= k :bool)
      (form-result (:stmts part)
                   (literal-rt-call "NewBool" [(:expr part)])
                   :value
                   (:ctx part))
      (= k :defer)
      (throw (ex-info "cannot coerce a defer form to Value (defer is a statement)" {}))
      :else part)))

(defn form-value-ir [part]
  (:expr (coerce-form-value part)))

(defn eq-arg-ir [part]
  (let [k (:expr-kind part)]
    (cond
      (= k :value) (:expr part)
      (= k :string) (literal-rt-call "NewString" [(:expr part)])
      :else (throw (ex-info "= arguments must evaluate to Value" {})))))

(defn value-arg-ir [part label]
  (let [k (:expr-kind part)]
    (cond
      (= k :value) (:expr part)
      (= k :string) (literal-rt-call "NewString" [(:expr part)])
      :else (throw (ex-info (str label " expects an argument that evaluates to Value") {})))))

(defn wrap-value-arg-ir [part wrap? msg]
  (let [k (:expr-kind part)]
    (cond
      (= k :value) (:expr part)
      (and wrap? (= k :string)) (literal-rt-call "NewString" [(:expr part)])
      :else (throw (ex-info (str msg) {})))))

(defn string-or-value-ir [part label]
  (let [k (:expr-kind part)]
    (if (or (= k :string) (= k :value))
      (:expr part)
      (throw (ex-info (str label " expects a string, symbol, or keyword argument") {})))))

(def remaining-runtime-ops
  #{"compare" "==" "<" "<=" ">" ">=" "symbol" "name" "keyword" "format"
    "map" "sort-by" "apply" "pmap" "filter" "reduce" "doall" "some" "set"
    "line-seq" "repeat" "rand-int" "to-json" "from-json"
    "open-file" "file-to-strings" "go-fn" "go-fn-args"})

(defn truthy-form-ir [part]
  (let [k (:expr-kind part)]
    (cond
      (= k :bool) (:expr part)
      (= k :value) (literal-rt-call "IsTruthy" [(:expr part)])
      (= k :string) {:kind :raw :code "true"}
      :else (throw (ex-info "unsupported if test expression" {:part part})))))

(defn go-type-for-kind [k]
  (cond
    (= k :string) "string"
    (= k :bool) "bool"
    :else "flagrt.Value"))

(defn form-defer-result [stmts stmt ctx]
  {:stmts (stmt-list stmts)
   :expr (literal-rt-call "NilValue" [])
   :expr-kind :defer
   :defer? true
   :stmt stmt
   :ctx ctx})

(defn forms-have-defer? [forms]
  (loop [remaining (stmt-list forms)]
    (if (or (nil? remaining) (empty? remaining))
      false
      (if (:defer? (first remaining))
        true
        (recur (rest remaining))))))

(defn list-head-name [node]
  (let [form (unwrap-ast node)]
    (if (not (= :list (:kind form)))
      nil
      (let [head (first (:elements form))]
        (if (and (not (nil? head)) (= :symbol (:kind head)))
          (:name head)
          nil)))))

(defn catch-type-name [node]
  (let [form (unwrap-ast node)
        kind (:kind form)]
    (cond
      (= kind :symbol)
      (let [n (:name form)]
        (if (or (= n "ExceptionInfo") (= n "Exception") (= n "Throwable"))
          n
          (throw (ex-info (str "unknown catch type " n " (expected ExceptionInfo, Exception, Throwable, or :default)") {}))))
      (= kind :keyword)
      (if (= (:name form) "default")
        ":default"
        (throw (ex-info (str "unknown catch type :" (:name form) " (expected :default)") {})))
      :else (throw (ex-info "catch type must be Exception, ExceptionInfo, Throwable, or :default" {})))))

(defn parse-catch-clause [node]
  (let [form (unwrap-ast node)
        elems (stmt-list (:elements form))]
    (if (or (nil? elems) (empty? (rest elems)) (empty? (rest (rest elems))))
      (throw (ex-info "catch expects type, name, and optional body" {:node node}))
      (let [class (catch-type-name (first (rest elems)))
            name-node (unwrap-ast (first (rest (rest elems))))]
        (if (or (not (= :symbol (:kind name-node))) (= "" (:name name-node)))
          (throw (ex-info "catch binding name must be a symbol" {:node name-node}))
          {:class class :name name-node :body (rest (rest (rest elems)))})))))

(defn split-try-body [args]
  (loop [remaining (stmt-list args) body []]
    (if (or (nil? remaining) (empty? remaining))
      {:remaining remaining :body body}
      (let [name (list-head-name (first remaining))]
        (if (or (= name "catch") (= name "finally"))
          {:remaining remaining :body body}
          (recur (rest remaining) (conj body (first remaining))))))))

(defn split-try-catches [args]
  (loop [remaining (stmt-list args) catches []]
    (if (or (nil? remaining) (empty? remaining))
      {:remaining remaining :catches catches}
      (let [name (list-head-name (first remaining))]
        (if (= name "catch")
          (recur (rest remaining) (conj catches (first remaining)))
          {:remaining remaining :catches catches})))))

(defn split-try-args [args]
  (let [body-part (split-try-body args)
        catch-part (split-try-catches (:remaining body-part))
        remaining (:remaining catch-part)]
    (if (or (nil? remaining) (empty? remaining))
      {:body (:body body-part) :catches (:catches catch-part) :finally nil}
      (let [name (list-head-name (first remaining))]
        (if (not (= name "finally"))
          (throw (ex-info "catch and finally clauses must come last in try" {}))
          (if (or (nil? (rest remaining)) (empty? (rest remaining)))
            {:body (:body body-part)
             :catches (:catches catch-part)
             :finally (rest (:elements (unwrap-ast (first remaining))))}
            (throw (ex-info "catch and finally clauses must come last in try" {}))))))))

(defn stringish-ir [part label]
  (let [k (:expr-kind part)]
    (cond
      (= k :string) (:expr part)
      (= k :value) (literal-rt-call "Str" [(:expr part)])
      :else (throw (ex-info (str label) {})))))

(defn write-to-ir [file content]
  (literal-rt-call "Write" [file content]))

(defn ends-with-to-ir [left right]
  {:kind :call
   :fun {:kind :selector :pkg "strings" :name "HasSuffix"}
   :args [left right]})

(defn testing-to-ir [body-stmts body-expr]
  (value-iife-ir
    (append-stmt
      (append-stmt body-stmts {:kind :expr-stmt :expr body-expr :discard true})
      {:kind :return :expr (literal-rt-call "NilValue" [])})))

(defn is-to-ir [test-stmts condition message]
  (value-iife-ir
    (append-stmt
      (append-stmt test-stmts
                   {:kind :if
                    :init ""
                    :cond {:kind :unary :op "!" :x condition}
                    :then [{:kind :expr-stmt
                            :expr (ident-call-ir "panic" [{:kind :string :value message}])
                            :discard false}]
                    :else []})
      {:kind :return :expr (literal-rt-call "NilValue" [])})))

(defn expect-exception-to-ir [body-stmts body-expr no-panic expected prefix]
  (let [base [{:kind :define :names ["r"] :expr (ident-call-ir "recover" [])}
              {:kind :if
               :init ""
               :cond {:kind :binary
                      :op "=="
                      :left {:kind :ident :name "r"}
                      :right {:kind :ident :name "nil"}}
               :then [{:kind :expr-stmt
                       :expr (ident-call-ir "panic" [{:kind :string :value no-panic}])
                       :discard false}]
               :else []}]
        recover-body (if (or (nil? expected) (= "" expected))
                       base
                       (append-stmt
                         (append-stmt base
                                      {:kind :define
                                       :names ["msg"]
                                       :expr {:kind :call
                                              :fun {:kind :selector :pkg "fmt" :name "Sprint"}
                                              :args [{:kind :ident :name "r"}]}})
                         {:kind :if
                          :init ""
                          :cond {:kind :unary
                                 :op "!"
                                 :x {:kind :call
                                     :fun {:kind :selector :pkg "strings" :name "Contains"}
                                     :args [{:kind :ident :name "msg"}
                                            {:kind :string :value expected}]}}
                          :then [{:kind :expr-stmt
                                  :expr (ident-call-ir "panic"
                                                       [{:kind :raw
                                                         :code (str (format "%q" (str prefix "expected exception matching " (format "%q" expected) ", got "))
                                                                    " + msg")}])
                                  :discard false}]
                          :else []}))]
    (value-iife-ir
      (append-stmt
        (concat-stmts
          [{:kind :defer
            :expr {:kind :call
                   :fun {:kind :func-lit :params "" :result "" :body recover-body}
                   :args []}}]
          (append-stmt body-stmts {:kind :expr-stmt :expr body-expr :discard true}))
        {:kind :return :expr (literal-rt-call "NilValue" [])}))))

(defn ast-form-source-node [mode node]
  (cond
    (= mode :join)
    (loop [remaining node out ""]
      (if (or (nil? remaining) (empty? remaining))
        out
        (let [piece (ast-form-source-node :form (first remaining))]
          (recur (rest remaining)
                 (if (= out "") piece (str out " " piece))))))

    :else
    (let [form (unwrap-ast node)
          kind (:kind form)]
      (cond
        (= kind :string) (format "%q" (:value form))
        (= kind :char) (str "\\" (:value form))
        (= kind :int) (str (:value form))
        (= kind :bigint) (str (:value form) "N")
        (= kind :float) (if (or (nil? (:raw form)) (= "" (:raw form))) (str (:value form)) (:raw form))
        (= kind :ratio) (str (:numerator form) "/" (:denominator form))
        (= kind :keyword) (str ":" (:name form))
        (= kind :symbol) (:name form)
        (= kind :quoted-symbol) (str "'" (:name form))
        (= kind :list) (str "(" (ast-form-source-node :join (:elements form)) ")")
        (= kind :vector) (str "[" (ast-form-source-node :join (:elements form)) "]")
        (= kind :pipe-vector) (str "|[" (ast-form-source-node :join (:elements form)) "]")
        (= kind :set) (str "#{" (ast-form-source-node :join (:elements form)) "}")
        (= kind :map) (str "{" (ast-form-source-node :join (:entries form)) "}")
        (= kind :hash-fn) (str "#(" (ast-form-source-node :join (:elements (:body form))) ")")
        :else (str kind)))))

(defn ast-form-source [node]
  (ast-form-source-node :form node))

(defn form-pos-prefix [form]
  (let [line (:line form)
        col (:col form)]
    (if (and (not (nil? line)) (> line 0))
      (str "at " line ":" (if (nil? col) 0 col) ": ")
      "")))

(defn digit-value [ch]
  (loop [digits go-ident-digits i 0]
    (if (or (nil? digits) (= 0 (count digits)))
      nil
      (if (= ch (subs digits 0 1))
        i
        (recur (subs digits 1) (inc i))))))

(defn positive-int-from-digits [s]
  (loop [i 0 n 0]
    (if (= i (count s))
      (if (= n 0) nil n)
      (let [d (digit-value (subs s i (inc i)))]
        (if (nil? d)
          nil
          (recur (inc i) (+ (* n 10) d)))))))

(defn hash-fn-placeholder-index [name]
  (if (= name "%")
    1
    (if (and (not (nil? name)) (> (count name) 1) (= "%" (subs name 0 1)))
      (positive-int-from-digits (subs name 1))
      nil)))

(defn hash-fn-node [mode node max]
  (cond
    (= mode :max-items)
    (loop [remaining (stmt-list node) m max]
      (if (or (nil? remaining) (empty? remaining))
        m
        (recur (rest remaining) (hash-fn-node :max (first remaining) m))))

    (= mode :replace-items)
    (loop [remaining (stmt-list node) out []]
      (if (or (nil? remaining) (empty? remaining))
        out
        (recur (rest remaining) (conj out (hash-fn-node :replace (first remaining) max)))))

    :else
    (if (nil? node)
      (if (= mode :max) max node)
      (let [kind (:kind node)]
        (cond
          (= kind :symbol)
          (let [idx (hash-fn-placeholder-index (:name node))]
            (if (nil? idx)
              (if (= mode :max) max node)
              (if (= mode :max)
                (if (> idx max) idx max)
                {:kind :symbol
                 :name (str "__p" idx)
                 :line (:line node)
                 :col (:col node)})))

          (= kind :list)
          (if (= mode :max)
            (hash-fn-node :max-items (:elements node) max)
            (assoc node :elements (hash-fn-node :replace-items (:elements node) max)))

          (= kind :vector)
          (if (= mode :max)
            (hash-fn-node :max-items (:elements node) max)
            (assoc node :elements (hash-fn-node :replace-items (:elements node) max)))

          (= kind :pipe-vector)
          (if (= mode :max)
            (hash-fn-node :max-items (:elements node) max)
            (assoc node :elements (hash-fn-node :replace-items (:elements node) max)))

          (= kind :set)
          (if (= mode :max)
            (hash-fn-node :max-items (:elements node) max)
            (assoc node :elements (hash-fn-node :replace-items (:elements node) max)))

          (= kind :map)
          (if (= mode :max)
            (hash-fn-node :max-items (:entries node) max)
            (assoc node :entries (hash-fn-node :replace-items (:entries node) max)))

          (= kind :hash-fn)
          (if (= mode :max) max node)

          (= kind :meta)
          (if (= mode :max)
            (hash-fn-node :max (:target node) (hash-fn-node :max (:meta node) max))
            (assoc (assoc node :meta (hash-fn-node :replace (:meta node) max))
                   :target (hash-fn-node :replace (:target node) max)))

          :else (if (= mode :max) max node))))))

(defn hash-fn-param-vector [n]
  (loop [i 1 out []]
    (if (> i n)
      {:kind :vector :elements out}
      (recur (inc i) (conj out {:kind :symbol :name (str "__p" i)})))))

(def control-forms
  #{"defer" "doto" "try" "doseq" "for" "testing" "is" "expect-exception"})

(defn compile-form-node [mode node ctx]
  (cond
    (= mode :seq)
    (loop [remaining node ctx ctx stmts [] irs []]
      (if (or (nil? remaining) (empty? remaining))
        {:stmts stmts :irs irs :ctx ctx}
        (let [part (compile-form-node :form (first remaining) ctx)]
          (recur (rest remaining)
                 (:ctx part)
                 (concat-stmts stmts (:stmts part))
                 (conj irs (form-value-ir part))))))

    (= mode :if)
    (let [args node
          n (count (stmt-list args))]
      (if (and (not (= n 2)) (not (= n 3)))
        (throw (ex-info "if expects test, true branch, and optional false branch" {:args args}))
        (let [cond-part (compile-form-node :form (first args) ctx)
              then0 (compile-form-node :form (first (rest args)) (:ctx cond-part))
              else0 (if (= n 3)
                      (compile-form-node :form (first (rest (rest args))) (:ctx then0))
                      (form-result [] (literal-rt-call "NilValue" []) :value (:ctx then0)))
              then1 (if (and (= n 3) (not (= (:expr-kind then0) (:expr-kind else0))))
                      (coerce-form-value then0)
                      then0)
              else1 (if (and (= n 3) (not (= (:expr-kind then1) (:expr-kind else0))))
                      (coerce-form-value else0)
                      else0)
              then2 (if (and (= n 2) (not (= :value (:expr-kind then1))))
                      (throw (ex-info "if without false branch currently requires a Value result" {}))
                      then1)
              tmp (next-form-temp (:ctx else1) "if_result")
              if-stmts (if-to-ir (:name tmp)
                                 (go-type-for-kind (:expr-kind then2))
                                 (truthy-form-ir cond-part)
                                 (:stmts then2)
                                 (:expr then2)
                                 (:stmts else1)
                                 (:expr else1))]
          (form-result (concat-stmts (:stmts cond-part) if-stmts)
                       {:kind :ident :name (:name tmp)}
                       (:expr-kind then2)
                       (:ctx tmp)))))

    (= mode :let)
    (let [args node]
  (if (or (nil? args) (empty? args))
    (throw (ex-info "let expects a binding vector" {}))
    (let [bindings-node (unwrap-ast (first args))
          body (rest args)]
      (if (not (= :vector (:kind bindings-node)))
        (throw (ex-info "let expects a binding vector" {:node bindings-node}))
        (let [entries (ast-seq bindings-node)]
          (if (not (= 0 (% (count entries) 2)))
            (throw (ex-info "let binding vector expects name/value pairs" {}))
            (loop [remaining entries
                   ctx ctx
                   bind-stmts []
                   declared {}
                   bind-temp 0]
              (if (or (nil? remaining) (empty? remaining))
                (let [compiled (compile-form-node :forms body ctx)
                      tmp (next-form-temp (:ctx compiled) "let_result")
                      let-stmts (let-to-ir (:name tmp)
                                           (go-type-for-kind (:expr-kind compiled))
                                           bind-stmts
                                           (:stmts compiled)
                                           (:expr compiled))]
                  (form-result let-stmts
                               {:kind :ident :name (:name tmp)}
                               (:expr-kind compiled)
                               (:ctx tmp)))
                (let [parsed (parse-volatile (first remaining))
                      pat (:target parsed)
                      val-node (first (rest remaining))]
                  (if (not (= :symbol (:kind pat)))
                    (if (:volatile? parsed)
                      (throw (ex-info "volatile let binding currently supports symbol bindings only" {:node pat}))
                      (if (or (= :vector (:kind pat)) (= :map (:kind pat)))
                        (let [part (compile-form-node :form val-node ctx)]
                          (if (not (= :value (:expr-kind part)))
                            (throw (ex-info "let binding value must evaluate to Value" {}))
                            (let [source-name (str "__bind" bind-temp)
                                  st0 {:params []
                                       :init-stmts (concat-stmts bind-stmts (:stmts part))
                                       :locals (if (nil? (:locals (:ctx part))) {} (:locals (:ctx part)))
                                       :declared declared
                                       :temp (inc bind-temp)
                                       :has-rest false}
                                  st1 (assoc st0 :init-stmts
                                             (conj (:init-stmts st0)
                                                   {:kind :var :name source-name :type "" :expr (:expr part)}))
                                  st2 (bind-pattern st1 pat {:kind :ident :name source-name})]
                              (recur (rest (rest remaining))
                                     (assoc (:ctx part) :locals (:locals st2))
                                     (:init-stmts st2)
                                     (:declared st2)
                                     (:temp st2)))))
                        (throw (ex-info "not handled by FLAG form lowering" {:node pat}))))
                    (if (= "" (:name pat))
                      (throw (ex-info "binding symbol cannot be empty" {:node pat}))
                      (let [part (compile-form-node :form val-node ctx)
                            go-name (go-ident (:name pat))]
                        (if (contains? declared go-name)
                          (throw (ex-info (str "duplicate binding \"" (:name pat) "\"") {:name (:name pat)}))
                          (if (:volatile? parsed)
                            (if (not (= :value (:expr-kind part)))
                              (throw (ex-info "volatile let binding value must evaluate to Value" {}))
                              (let [source-name (str "__bind" bind-temp)
                                    next-ctx (assoc (:ctx part) :locals
                                                    (if (= go-name "_")
                                                      (:locals (:ctx part))
                                                      (assoc (:locals (:ctx part)) go-name :mutable-value)))
                                    stmts0 (concat-stmts bind-stmts (:stmts part))
                                    stmts1 (conj stmts0 {:kind :var :name source-name :type "" :expr (:expr part)})
                                    stmts2 (conj stmts1 {:kind :var :name go-name :type "" :expr {:kind :ident :name source-name}})
                                    stmts3 (append-unused stmts2 (:name pat) go-name)]
                                (recur (rest (rest remaining))
                                       next-ctx
                                       stmts3
                                       (if (= go-name "_") declared (assoc declared go-name true))
                                       (inc bind-temp))))
                            (let [next-ctx (assoc (:ctx part) :locals
                                                  (if (= go-name "_")
                                                    (:locals (:ctx part))
                                                    (assoc (:locals (:ctx part)) go-name (:expr-kind part))))
                                  stmts0 (concat-stmts bind-stmts (:stmts part))
                                  stmts1 (conj stmts0 {:kind :var
                                                       :name go-name
                                                       :type ""
                                                       :expr (:expr part)})
                                  stmts2 (append-unused stmts1 (:name pat) go-name)]
                              (recur (rest (rest remaining))
                                     next-ctx
                                     stmts2
                                     (if (= go-name "_")
                                       declared
                                       (assoc declared go-name true))
                                     bind-temp))))))))))))))))

    (= mode :fn)
    (let [args node]
      (if (not (= 2 (count (stmt-list args))))
        (throw (ex-info "fn expects parameter vector and body expression" {}))
        (let [params (first args)
              body (first (rest args))]
          (if (not (= :vector (:kind params)))
            (throw (ex-info "fn expects a parameter vector" {:node params}))
            (let [bound (bind-params-to-ir params "fn" (:locals ctx))
                  inner (assoc ctx :locals (:locals bound) :loop-binding-names [])
                  compiled0 (compile-form-node :form body inner)
                  compiled (if (:defer? compiled0)
                             (form-result [] (do-defer-to-ir "flagrt.Value" [compiled0]) :value (:ctx compiled0))
                             (coerce-form-value compiled0))
                  ir (fn-to-ir "fn"
                               (:params bound)
                               (:has-rest bound)
                               (:init-stmts bound)
                               (:stmts compiled)
                               (:expr compiled))]
              (form-result [] ir :value (:ctx compiled)))))))

    (= mode :update)
    (let [args node]
      (if (not (= 2 (count (stmt-list args))))
        (throw (ex-info "update! expects a mutable symbol and replacement value" {}))
        (let [target (unwrap-ast (first args))
              val-node (first (rest args))]
          (if (not (= :symbol (:kind target)))
            (throw (ex-info "update! first argument must be a mutable symbol" {:node target}))
            (let [ident (go-ident (:name target))
                 locals (:locals ctx)]
              (if (not (= :mutable-value (get locals ident)))
               (throw (ex-info "update! first argument must be a mutable let binding" {:name ident}))
               (let [part (coerce-form-value (compile-form-node :form val-node ctx))
                     ir (update-bang-to-ir ident (:stmts part) (:expr part))]
                 (form-result [] ir :value (:ctx part)))))))))

    (= mode :nil?)
    (if (not (= 1 (count (stmt-list node))))
      (throw (ex-info "nil? expects exactly one argument" {}))
      (let [part (compile-form-node :form (first node) ctx)]
        (form-result (:stmts part)
                    (nil-pred-to-ir (value-arg-ir part "nil?"))
                    :value
                    (:ctx part))))

    (= mode :empty?)
    (if (not (= 1 (count (stmt-list node))))
      (throw (ex-info "empty? expects exactly one argument" {}))
      (let [part (compile-form-node :form (first node) ctx)]
        (form-result (:stmts part)
                    (empty-pred-to-ir (value-arg-ir part "empty?"))
                    :value
                    (:ctx part))))

    (= mode :count)
    (if (not (= 1 (count (stmt-list node))))
      (throw (ex-info "count expects exactly one argument" {}))
      (let [part (compile-form-node :form (first node) ctx)]
        (form-result (:stmts part)
                    (count-to-ir (value-arg-ir part "count"))
                    :value
                    (:ctx part))))

    (= mode :throw)
    (if (not (= 1 (count (stmt-list node))))
      (throw (ex-info "throw expects exactly one argument" {}))
      (let [part (coerce-form-value (compile-form-node :form (first node) ctx))]
        (form-result [] (throw-to-ir (:stmts part) (:expr part)) :value (:ctx part))))

    (= mode :recur)
    (let [names (:loop-binding-names ctx)]
      (if (or (nil? names) (empty? names))
        (throw (ex-info "recur can only be used within loop" {}))
        (if (not (= (count (stmt-list node)) (count names)))
          (throw (ex-info (str "recur expects " (count names) " arguments") {}))
          (let [compiled (compile-form-node :seq node ctx)]
            (form-result (:stmts compiled)
                        (recur-to-ir (:irs compiled))
                        :value
                        (:ctx compiled))))))

    (= mode :loop)
    (let [args node
          outer-ctx ctx]
      (if (or (nil? args) (empty? args))
        (throw (ex-info "loop expects a binding vector" {}))
        (let [bindings-node (unwrap-ast (first args))
              body (rest args)]
          (if (not (= :vector (:kind bindings-node)))
            (throw (ex-info "loop expects a binding vector" {:node bindings-node}))
            (if (or (nil? body) (empty? body))
              (throw (ex-info "loop expects at least one body form" {}))
              (let [entries (ast-seq bindings-node)]
                (if (not (= 0 (% (count entries) 2)))
                 (throw (ex-info "loop binding vector expects name/value pairs" {}))
                 (loop [remaining entries
                        ctx ctx
                        init-stmts []
                        bindings []
                        names []
                        declared {}]
                   (if (or (nil? remaining) (empty? remaining))
                     (let [loop-ctx (assoc ctx :loop-binding-names names)
                           compiled (coerce-form-value (compile-form-node :forms body loop-ctx))]
                       (form-result []
                                    (loop-to-ir init-stmts bindings (:stmts compiled) (:expr compiled))
                                    :value
                                    (assoc (:ctx compiled)
                                           :locals (:locals outer-ctx)
                                           :loop-binding-names (:loop-binding-names outer-ctx))))
                     (let [pat (unwrap-ast (first remaining))
                           val-node (first (rest remaining))]
                       (if (or (not (= :symbol (:kind pat))) (= "" (:name pat)))
                         (throw (ex-info "loop bindings must be symbols" {:node pat}))
                         (let [go-name (go-ident (:name pat))]
                           (if (contains? declared go-name)
                             (throw (ex-info (str "duplicate loop binding \"" (:name pat) "\"") {:name (:name pat)}))
                             (let [locals (if (nil? (:locals ctx)) {} (:locals ctx))
                                   next-locals (if (= go-name "_")
                                                 locals
                                                 (assoc locals go-name :mutable-value))
                                   next-ctx (assoc ctx :locals next-locals)
                                   part (coerce-form-value (compile-form-node :form val-node next-ctx))
                                   unused (and (unused-binding? (:name pat)) (not (= go-name "_")))]
                               (recur (rest (rest remaining))
                                      (:ctx part)
                                      (concat-stmts init-stmts (:stmts part))
                                      (conj bindings {:name go-name :init (:expr part) :unused unused})
                                      (conj names go-name)
                                      (if (= go-name "_") declared (assoc declared go-name true)))))))))))))))))

    (= mode :str)
    (loop [remaining (stmt-list node) ctx ctx stmts [] irs []]
      (if (or (nil? remaining) (empty? remaining))
        (form-result stmts (str-to-ir irs) :string ctx)
        (let [part (compile-form-node :form (first remaining) ctx)]
          (recur (rest remaining)
                 (:ctx part)
                 (concat-stmts stmts (:stmts part))
                 (conj irs (:expr part))))))

    (= mode :ex-info)
    (let [n (count (stmt-list node))]
      (if (and (not (= n 2)) (not (= n 3)))
        (throw (ex-info "ex-info expects message, data, and optional cause" {}))
        (let [msg-part (compile-form-node :form (first node) ctx)]
          (if (not (= :string (:expr-kind msg-part)))
            (throw (ex-info "ex-info message must be a string" {}))
            (let [data-part (coerce-form-value (compile-form-node :form (first (rest node)) (:ctx msg-part)))]
              (if (= n 2)
                (form-result (concat-stmts (:stmts msg-part) (:stmts data-part))
                             (ex-info-to-ir (:expr msg-part) (:expr data-part) nil)
                             :value
                             (:ctx data-part))
                (let [cause-part (coerce-form-value (compile-form-node :form (first (rest (rest node))) (:ctx data-part)))]
                  (form-result (concat-stmts (concat-stmts (:stmts msg-part) (:stmts data-part)) (:stmts cause-part))
                               (ex-info-to-ir (:expr msg-part) (:expr data-part) (:expr cause-part))
                               :value
                               (:ctx cause-part)))))))))

    (= mode :assoc)
    (let [args (stmt-list node)
          n (count args)]
      (if (or (nil? args) (empty? args) (empty? (rest args)) (empty? (rest (rest args))) (= 0 (% n 2)))
        (throw (ex-info "assoc expects collection and key/value pairs" {}))
        (loop [remaining args ctx ctx stmts [] irs []]
          (if (or (nil? remaining) (empty? remaining))
            (form-result stmts (assoc-to-ir irs) :value ctx)
            (let [part (compile-form-node :form (first remaining) ctx)]
              (recur (rest remaining)
                     (:ctx part)
                     (concat-stmts stmts (:stmts part))
                     (conj irs (wrap-value-arg-ir part false "assoc arguments must evaluate to Value"))))))))

    (= mode :conj)
    (if (or (nil? node) (empty? node) (empty? (rest node)))
      (throw (ex-info "conj expects collection and at least one item" {}))
      (loop [remaining (stmt-list node) ctx ctx stmts [] irs []]
        (if (or (nil? remaining) (empty? remaining))
          (form-result stmts (conj-to-ir irs) :value ctx)
          (let [part (compile-form-node :form (first remaining) ctx)]
            (recur (rest remaining)
                   (:ctx part)
                   (concat-stmts stmts (:stmts part))
                   (conj irs (wrap-value-arg-ir part true "conj arguments must evaluate to Value")))))))

    (= mode :seq-op)
    (if (not (= 1 (count (stmt-list node))))
      (throw (ex-info "seq expects exactly one argument" {}))
      (let [part (compile-form-node :form (first node) ctx)]
        (form-result (:stmts part)
                     (seq-to-ir (value-arg-ir part "seq"))
                     :value
                     (:ctx part))))

    (= mode :drop)
    (if (not (= 2 (count (stmt-list node))))
      (throw (ex-info "drop expects count and sequence" {}))
      (loop [remaining (stmt-list node) ctx ctx stmts [] irs []]
        (if (or (nil? remaining) (empty? remaining))
          (form-result stmts (drop-to-ir irs) :value ctx)
          (let [part (compile-form-node :form (first remaining) ctx)]
            (recur (rest remaining)
                   (:ctx part)
                   (concat-stmts stmts (:stmts part))
                   (conj irs (wrap-value-arg-ir part false "drop arguments must evaluate to Value")))))))

    (= mode :take)
    (if (not (= 2 (count (stmt-list node))))
      (throw (ex-info "take expects count and sequence" {}))
      (loop [remaining (stmt-list node) ctx ctx stmts [] irs []]
        (if (or (nil? remaining) (empty? remaining))
          (form-result stmts (take-to-ir irs) :value ctx)
          (let [part (compile-form-node :form (first remaining) ctx)]
            (recur (rest remaining)
                   (:ctx part)
                   (concat-stmts stmts (:stmts part))
                   (conj irs (wrap-value-arg-ir part false "take arguments must evaluate to Value")))))))

    (= mode :cons)
    (if (not (= 2 (count (stmt-list node))))
      (throw (ex-info "cons expects exactly two arguments" {}))
      (loop [remaining (stmt-list node) ctx ctx stmts [] irs []]
        (if (or (nil? remaining) (empty? remaining))
          (form-result stmts (cons-to-ir irs) :value ctx)
          (let [part (compile-form-node :form (first remaining) ctx)]
            (recur (rest remaining)
                   (:ctx part)
                   (concat-stmts stmts (:stmts part))
                   (conj irs (wrap-value-arg-ir part false "cons arguments must evaluate to Value")))))))

    (= mode :get)
    (let [n (count (stmt-list node))]
      (if (and (not (= n 2)) (not (= n 3)))
        (throw (ex-info "get expects collection, key, and optional default" {}))
        (loop [remaining (stmt-list node) ctx ctx stmts [] irs []]
          (if (or (nil? remaining) (empty? remaining))
            (form-result stmts (get-to-ir irs) :value ctx)
            (let [part (compile-form-node :form (first remaining) ctx)]
              (recur (rest remaining)
                     (:ctx part)
                     (concat-stmts stmts (:stmts part))
                     (conj irs (wrap-value-arg-ir part true "get arguments must evaluate to Value"))))))))

    (= mode :nth)
    (let [n (count (stmt-list node))]
      (if (and (not (= n 2)) (not (= n 3)))
        (throw (ex-info "nth expects collection, index, and optional default" {}))
        (loop [remaining (stmt-list node) ctx ctx stmts [] irs []]
          (if (or (nil? remaining) (empty? remaining))
            (form-result stmts (nth-to-ir irs) :value ctx)
            (let [part (compile-form-node :form (first remaining) ctx)]
              (recur (rest remaining)
                     (:ctx part)
                     (concat-stmts stmts (:stmts part))
                     (conj irs (wrap-value-arg-ir part true "nth arguments must evaluate to Value"))))))))

    (= mode :not-empty)
    (if (not (= 1 (count (stmt-list node))))
      (throw (ex-info "not-empty expects exactly one argument" {}))
      (let [part (compile-form-node :form (first node) ctx)]
        (form-result (:stmts part)
                     (not-empty-to-ir (wrap-value-arg-ir part false "not-empty expects an argument that evaluates to Value"))
                     :value
                     (:ctx part))))

    (= mode :type-of)
    (if (not (= 1 (count (stmt-list node))))
      (throw (ex-info "type-of expects exactly one argument" {}))
      (let [part (compile-form-node :form (first node) ctx)]
        (form-result (:stmts part)
                     (type-of-to-ir (value-arg-ir part "type-of"))
                     :value
                     (:ctx part))))

    (= mode :vec)
    (if (not (= 1 (count (stmt-list node))))
      (throw (ex-info "vec expects exactly one argument" {}))
      (let [part (compile-form-node :form (first node) ctx)]
        (form-result (:stmts part)
                     (vec-to-ir (value-arg-ir part "vec"))
                     :value
                     (:ctx part))))

    (= mode :dissoc)
    (if (or (nil? node) (empty? node))
      (throw (ex-info "dissoc expects a collection argument" {}))
      (loop [remaining (stmt-list node) ctx ctx stmts [] irs []]
        (if (or (nil? remaining) (empty? remaining))
          (form-result stmts (dissoc-to-ir irs) :value ctx)
          (let [part (compile-form-node :form (first remaining) ctx)]
            (recur (rest remaining)
                   (:ctx part)
                   (concat-stmts stmts (:stmts part))
                   (conj irs (wrap-value-arg-ir part false "dissoc arguments must evaluate to Value")))))))

    (= mode :contains?)
    (if (not (= 2 (count (stmt-list node))))
      (throw (ex-info "contains? expects collection and key" {}))
      (loop [remaining (stmt-list node) ctx ctx stmts [] irs []]
        (if (or (nil? remaining) (empty? remaining))
          (form-result stmts (contains-pred-to-ir irs) :value ctx)
          (let [part (compile-form-node :form (first remaining) ctx)]
            (recur (rest remaining)
                   (:ctx part)
                   (concat-stmts stmts (:stmts part))
                   (conj irs (wrap-value-arg-ir part false "contains? arguments must evaluate to Value")))))))

    (= mode :list-ctor)
    (loop [remaining (stmt-list node) ctx ctx stmts [] irs []]
      (if (or (nil? remaining) (empty? remaining))
        (form-result stmts (ctor-to-ir "NewList" irs) :value ctx)
        (let [part (compile-form-node :form (first remaining) ctx)]
          (recur (rest remaining)
                 (:ctx part)
                 (concat-stmts stmts (:stmts part))
                 (conj irs (wrap-value-arg-ir part true "list entries must evaluate to Value"))))))

    (= mode :array-ctor)
    (loop [remaining (stmt-list node) ctx ctx stmts [] irs []]
      (if (or (nil? remaining) (empty? remaining))
        (form-result stmts (ctor-to-ir "NewArray" irs) :value ctx)
        (let [part (compile-form-node :form (first remaining) ctx)]
          (recur (rest remaining)
                 (:ctx part)
                 (concat-stmts stmts (:stmts part))
                 (conj irs (wrap-value-arg-ir part true "array entries must evaluate to Value"))))))

    (= mode :hash-map)
    (let [n (count (stmt-list node))]
      (if (not (= 0 (% n 2)))
        (throw (ex-info "hash-map expects key/value pairs" {}))
        (loop [remaining (stmt-list node) ctx ctx stmts [] irs []]
          (if (or (nil? remaining) (empty? remaining))
            (form-result stmts (ctor-to-ir "NewMap" irs) :value ctx)
            (let [part (compile-form-node :form (first remaining) ctx)]
              (recur (rest remaining)
                     (:ctx part)
                     (concat-stmts stmts (:stmts part))
                     (conj irs (wrap-value-arg-ir part true "hash-map entries must evaluate to Value"))))))))

    (= mode :into)
    (if (not (= 2 (count (stmt-list node))))
      (throw (ex-info "into expects exactly two arguments" {}))
      (let [target (compile-form-node :form (first node) ctx)]
        (if (not (= :value (:expr-kind target)))
          (throw (ex-info "into expects a collection Value as the first argument" {}))
          (let [from (compile-form-node :form (first (rest node)) (:ctx target))]
            (if (not (= :value (:expr-kind from)))
              (throw (ex-info "into expects a collection Value as the second argument" {}))
              (form-result (concat-stmts (:stmts target) (:stmts from))
                           (into-to-ir [(:expr target) (:expr from)])
                           :value
                           (:ctx from)))))))

    (= mode :concat)
    (loop [remaining (stmt-list node) ctx ctx stmts [] irs []]
      (if (or (nil? remaining) (empty? remaining))
        (form-result stmts (concat-to-ir irs) :value ctx)
        (let [part (compile-form-node :form (first remaining) ctx)]
          (recur (rest remaining)
                 (:ctx part)
                 (concat-stmts stmts (:stmts part))
                 (conj irs (wrap-value-arg-ir part true "concat arguments must evaluate to Value"))))))

    (= mode :ex-message)
    (if (not (= 1 (count (stmt-list node))))
      (throw (ex-info "ex-message expects exactly one argument" {}))
      (let [part (compile-form-node :form (first node) ctx)]
        (form-result (:stmts part)
                     (ex-message-to-ir (value-arg-ir part "ex-message"))
                     :value
                     (:ctx part))))

    (= mode :ex-data)
    (if (not (= 1 (count (stmt-list node))))
      (throw (ex-info "ex-data expects exactly one argument" {}))
      (let [part (compile-form-node :form (first node) ctx)]
        (form-result (:stmts part)
                     (ex-data-to-ir (value-arg-ir part "ex-data"))
                     :value
                     (:ctx part))))

    (= mode :ex-cause)
    (if (not (= 1 (count (stmt-list node))))
      (throw (ex-info "ex-cause expects exactly one argument" {}))
      (let [part (compile-form-node :form (first node) ctx)]
        (form-result (:stmts part)
                     (ex-cause-to-ir (value-arg-ir part "ex-cause"))
                     :value
                     (:ctx part))))

    (= mode :println)
    (loop [remaining (stmt-list node) ctx ctx stmts [] irs []]
      (if (or (nil? remaining) (empty? remaining))
        (form-result stmts (println-to-ir irs) :value ctx)
        (let [part (compile-form-node :form (first remaining) ctx)]
          (recur (rest remaining)
                 (:ctx part)
                 (concat-stmts stmts (:stmts part))
                 (conj irs (:expr part))))))

    (= mode :value-args)
    (let [args (first node)
          wrap? (first (rest node))
          msg (first (rest (rest node)))]
      (loop [remaining (stmt-list args) ctx ctx stmts [] irs []]
        (if (or (nil? remaining) (empty? remaining))
          {:stmts stmts :irs irs :ctx ctx}
          (let [part (compile-form-node :form (first remaining) ctx)]
            (recur (rest remaining)
                   (:ctx part)
                   (concat-stmts stmts (:stmts part))
                   (conj irs (wrap-value-arg-ir part wrap? msg)))))))

    (= mode :runtime-op)
    (let [op (first node)
          args (first (rest node))]
      (cond
    (= op "compare")
    (if (not (= 2 (count (stmt-list args))))
      (throw (ex-info "compare expects exactly two arguments" {}))
      (let [compiled (compile-form-node :value-args [args true "compare arguments must evaluate to Value"] ctx)]
        (form-result (:stmts compiled) (compare-to-ir (:irs compiled)) :value (:ctx compiled))))

    (= op "==")
    (let [compiled (compile-form-node :value-args [args false "== arguments must evaluate to Value"] ctx)]
      (form-result (:stmts compiled) (numeric-eq-to-ir (:irs compiled)) :value (:ctx compiled)))

    (or (= op "<") (= op "<=") (= op ">") (= op ">="))
    (if (or (nil? args) (empty? args) (empty? (rest args)))
      (throw (ex-info (str op " expects at least two arguments") {}))
      (let [rt (get {"<" "Lt" "<=" "Le" ">" "Gt" ">=" "Ge"} op)
            compiled (compile-form-node :value-args [args true (str op " expects numeric or string Value arguments")] ctx)]
        (form-result (:stmts compiled)
                     (literal-rt-call "NewBool" [(comparison-to-ir rt (:irs compiled))])
                     :value
                     (:ctx compiled))))

    (= op "symbol")
    (if (not (= 1 (count (stmt-list args))))
      (throw (ex-info "symbol expects exactly one argument" {}))
      (let [part (compile-form-node :form (first args) ctx)]
        (form-result (:stmts part) (symbol-ctor-to-ir (string-or-value-ir part "symbol")) :value (:ctx part))))

    (= op "name")
    (if (not (= 1 (count (stmt-list args))))
      (throw (ex-info "name expects exactly one argument" {}))
      (let [part (compile-form-node :form (first args) ctx)]
        (form-result (:stmts part) (name-to-ir (string-or-value-ir part "name")) :string (:ctx part))))

    (= op "keyword")
    (if (not (= 1 (count (stmt-list args))))
      (throw (ex-info "keyword expects exactly one argument" {}))
      (let [part (compile-form-node :form (first args) ctx)]
        (form-result (:stmts part) (keyword-ctor-to-ir (string-or-value-ir part "keyword")) :value (:ctx part))))

    (= op "format")
    (if (or (nil? args) (empty? args))
      (throw (ex-info "format expects a format string and optional values" {}))
      (let [fmt-part (compile-form-node :form (first args) ctx)]
        (if (not (= :string (:expr-kind fmt-part)))
          (throw (ex-info "format expects a string format argument" {}))
          (let [compiled (compile-form-node :value-args [(rest args) true "function argument must evaluate to Value"] ctx)]
            (form-result (concat-stmts (:stmts fmt-part) (:stmts compiled))
                         (format-to-ir (concat [(:expr fmt-part)] (:irs compiled)))
                         :value
                         (:ctx compiled))))))

    (= op "map")
    (if (or (nil? args) (empty? args) (empty? (rest args)))
      (throw (ex-info "map expects function and at least one sequence" {}))
      (let [compiled (compile-form-node :value-args [args false "map arguments must evaluate to Value"] ctx)]
        (form-result (:stmts compiled) (map-to-ir (:irs compiled)) :value (:ctx compiled))))

    (= op "sort-by")
    (let [n (count (stmt-list args))]
      (if (and (not (= n 2)) (not (= n 3)))
        (throw (ex-info "sort-by expects key function, optional comparator, and collection" {}))
        (let [compiled (compile-form-node :value-args [args false "sort-by arguments must evaluate to Value"] ctx)]
          (form-result (:stmts compiled) (sort-by-to-ir (:irs compiled)) :value (:ctx compiled)))))

    (= op "apply")
    (if (or (nil? args) (empty? args) (empty? (rest args)))
      (throw (ex-info "apply expects function and at least one argument sequence" {}))
      (let [compiled (compile-form-node :value-args [args false "apply arguments must evaluate to Value"] ctx)]
        (form-result (:stmts compiled) (apply-to-ir (:irs compiled)) :value (:ctx compiled))))

    (= op "pmap")
    (if (or (nil? args) (empty? args) (empty? (rest args)))
      (throw (ex-info "pmap expects function and at least one sequence" {}))
      (let [compiled (compile-form-node :value-args [args false "pmap arguments must evaluate to Value"] ctx)]
        (form-result (:stmts compiled) (pmap-to-ir (:irs compiled)) :value (:ctx compiled))))

    (= op "filter")
    (if (not (= 2 (count (stmt-list args))))
      (throw (ex-info "filter expects function and one sequence" {}))
      (let [compiled (compile-form-node :value-args [args false "filter arguments must evaluate to Value"] ctx)]
        (form-result (:stmts compiled) (filter-to-ir (:irs compiled)) :value (:ctx compiled))))

    (= op "reduce")
    (let [n (count (stmt-list args))]
      (if (and (not (= n 2)) (not (= n 3)))
        (throw (ex-info "reduce expects function and collection, or function, initial value, and collection" {}))
        (let [compiled (compile-form-node :value-args [args false "reduce arguments must evaluate to Value"] ctx)]
          (form-result (:stmts compiled) (reduce-to-ir (:irs compiled)) :value (:ctx compiled)))))

    (= op "doall")
    (if (not (= 1 (count (stmt-list args))))
      (throw (ex-info "doall expects exactly one argument" {}))
      (let [part (compile-form-node :form (first args) ctx)]
        (form-result (:stmts part)
                     (doall-to-ir (wrap-value-arg-ir part false "doall expects an argument that evaluates to Value"))
                     :value
                     (:ctx part))))

    (= op "some")
    (if (not (= 2 (count (stmt-list args))))
      (throw (ex-info "some expects predicate and collection" {}))
      (let [compiled (compile-form-node :value-args [args false "some arguments must evaluate to Value"] ctx)]
        (form-result (:stmts compiled) (some-to-ir (:irs compiled)) :value (:ctx compiled))))

    (= op "set")
    (if (not (= 1 (count (stmt-list args))))
      (throw (ex-info "set expects exactly one argument" {}))
      (let [part (compile-form-node :form (first args) ctx)]
        (form-result (:stmts part)
                     (set-to-ir (wrap-value-arg-ir part false "set expects an argument that evaluates to Value"))
                     :value
                     (:ctx part))))

    (= op "line-seq")
    (if (not (= 1 (count (stmt-list args))))
      (throw (ex-info "line-seq expects exactly one argument" {}))
      (let [part (compile-form-node :form (first args) ctx)]
        (form-result (:stmts part)
                     (line-seq-to-ir (wrap-value-arg-ir part false "line-seq expects an argument that evaluates to Value"))
                     :value
                     (:ctx part))))

    (= op "repeat")
    (let [n (count (stmt-list args))]
      (if (and (not (= n 1)) (not (= n 2)))
        (throw (ex-info "repeat expects one or two arguments" {}))
        (let [compiled (compile-form-node :value-args [args true "repeat arguments must evaluate to Value"] ctx)]
          (form-result (:stmts compiled) (repeat-to-ir (:irs compiled)) :value (:ctx compiled)))))

    (= op "rand-int")
    (if (not (= 1 (count (stmt-list args))))
      (throw (ex-info "rand-int expects exactly one argument" {}))
      (let [part (compile-form-node :form (first args) ctx)]
        (form-result (:stmts part)
                     (rand-int-to-ir (wrap-value-arg-ir part false "rand-int expects an argument that evaluates to Value"))
                     :value
                     (:ctx part))))

    (= op "to-json")
    (if (not (= 1 (count (stmt-list args))))
      (throw (ex-info "to-json expects exactly one argument" {}))
      (let [part (compile-form-node :form (first args) ctx)]
        (form-result (:stmts part)
                     (to-json-to-ir (wrap-value-arg-ir part false "to-json expects an argument that evaluates to Value"))
                     :string
                     (:ctx part))))

    (= op "from-json")
    (if (not (= 1 (count (stmt-list args))))
      (throw (ex-info "from-json expects exactly one argument" {}))
      (let [part (compile-form-node :form (first args) ctx)]
        (if (not (= :string (:expr-kind part)))
          (throw (ex-info "from-json expects a string argument" {}))
          (form-result (:stmts part) (from-json-to-ir (:expr part)) :value (:ctx part)))))

    (= op "open-file")
    (if (not (= 1 (count (stmt-list args))))
      (throw (ex-info "open-file expects exactly one argument" {}))
      (let [part (compile-form-node :form (first args) ctx)
            k (:expr-kind part)
            arg (cond
                  (= k :string) (:expr part)
                  (= k :value) (name-to-ir (:expr part))
                  :else (throw (ex-info "open-file expects a string, symbol, or keyword argument" {})))]
        (form-result (:stmts part) (open-file-to-ir arg) :value (:ctx part))))

    (= op "file-to-strings")
    (if (not (= 1 (count (stmt-list args))))
      (throw (ex-info "file-to-strings expects exactly one argument" {}))
      (let [part (compile-form-node :form (first args) ctx)
            k (:expr-kind part)]
        (cond
          (= k :string)
          (form-result (:stmts part) (file-to-strings-path-to-ir (:expr part)) :value (:ctx part))
          (= k :value)
          (form-result (:stmts part) (file-to-strings-to-ir (:expr part)) :value (:ctx part))
          :else (throw (ex-info "file-to-strings expects a string, symbol, or keyword argument" {})))))

    (= op "go-fn")
    (if (not (= 1 (count (stmt-list args))))
      (throw (ex-info "go-fn expects exactly one argument" {}))
      (let [part (compile-form-node :form (first args) ctx)
            k (:expr-kind part)
            arg (cond
                  (= k :string) (:expr part)
                  (= k :value) (name-to-ir (:expr part))
                  :else (throw (ex-info "go-fn expects a string, symbol, or keyword argument" {})))]
        (form-result (:stmts part) (go-fn-to-ir arg) :value (:ctx part))))

    (= op "go-fn-args")
    (if (not (= 1 (count (stmt-list args))))
      (throw (ex-info "go-fn-args expects exactly one argument" {}))
      (let [part (compile-form-node :form (first args) ctx)
            k (:expr-kind part)
            arg (cond
                  (= k :string) (:expr part)
                  (= k :value) (name-to-ir (:expr part))
                  :else (throw (ex-info "go-fn-args expects a string, symbol, or keyword argument" {})))]
        (form-result (:stmts part) (go-fn-args-to-ir arg) :value (:ctx part))))

    :else (throw (ex-info "unsupported remaining runtime op" {:op op}))))

    (= mode :dot)
    (let [name (first node)
          args (first (rest node))]
      (cond
        (= name ".write")
        (if (not (= 2 (count (stmt-list args))))
          (throw (ex-info ".write expects file and content" {}))
          (let [file-part (compile-form-node :form (first args) ctx)]
            (if (not (= :value (:expr-kind file-part)))
              (throw (ex-info ".write expects a file Value" {}))
              (let [content-part (compile-form-node :form (first (rest args)) (:ctx file-part))]
                (form-result (concat-stmts (:stmts file-part) (:stmts content-part))
                             (write-to-ir (:expr file-part)
                                          (stringish-ir content-part ".write content must be string-like"))
                             :value
                             (:ctx content-part))))))

        (= name ".endsWith")
        (if (not (= 2 (count (stmt-list args))))
          (throw (ex-info ".endsWith expects string and suffix" {}))
          (let [left (compile-form-node :form (first args) ctx)
                right (compile-form-node :form (first (rest args)) (:ctx left))]
            (form-result (concat-stmts (:stmts left) (:stmts right))
                         (ends-with-to-ir (stringish-ir left ".endsWith expects a string-like value")
                                          (stringish-ir right ".endsWith expects a string-like value"))
                         :bool
                         (:ctx right))))

        :else (throw (ex-info "not handled by FLAG form lowering" {:node node}))))

    (= mode :call)
    (let [elements (:elements node)]
      (if (or (nil? elements) (empty? elements))
        (throw (ex-info "unsupported form" {:node node}))
        (let [head (first elements)
              args (rest elements)]
          (if (and (= :symbol (:kind head))
                  (not (= 0 (count (:name head))))
                  (= "." (subs (:name head) 0 1)))
            (compile-form-node :dot [(:name head) args] ctx)
          (if (= :symbol (:kind head))
            (let [op (:name head)
                  unary (get unary-runtime-ops op)
                  fold (get fold-runtime-ops op)
                  binary (get binary-runtime-ops op)
                  variadic (get variadic-runtime-ops op)]
              (cond
                (= op "if") (compile-form-node :if args ctx)
                (= op "do") (compile-form-node :forms args ctx)
                (= op "let") (compile-form-node :let args ctx)
                (= op "fn") (compile-form-node :fn args ctx)
                (= op "update!") (compile-form-node :update args ctx)
                (= op "nil?") (compile-form-node :nil? args ctx)
                (= op "empty?") (compile-form-node :empty? args ctx)
                (= op "count") (compile-form-node :count args ctx)
                (= op "throw") (compile-form-node :throw args ctx)
                (= op "loop") (compile-form-node :loop args ctx)
                (= op "recur") (compile-form-node :recur args ctx)
                (= op "str") (compile-form-node :str args ctx)
                (= op "ex-info") (compile-form-node :ex-info args ctx)
                (= op "assoc") (compile-form-node :assoc args ctx)
                (= op "conj") (compile-form-node :conj args ctx)
                (= op "seq") (compile-form-node :seq-op args ctx)
                (= op "drop") (compile-form-node :drop args ctx)
                (= op "take") (compile-form-node :take args ctx)
                (= op "cons") (compile-form-node :cons args ctx)
                (= op "get") (compile-form-node :get args ctx)
                (= op "nth") (compile-form-node :nth args ctx)
                (= op "not-empty") (compile-form-node :not-empty args ctx)
                (= op "type-of") (compile-form-node :type-of args ctx)
                (= op "vec") (compile-form-node :vec args ctx)
                (= op "dissoc") (compile-form-node :dissoc args ctx)
                (= op "contains?") (compile-form-node :contains? args ctx)
                (= op "list") (compile-form-node :list-ctor args ctx)
                (= op "array") (compile-form-node :array-ctor args ctx)
                (= op "hash-map") (compile-form-node :hash-map args ctx)
                (= op "into") (compile-form-node :into args ctx)
                (= op "concat") (compile-form-node :concat args ctx)
                (= op "ex-message") (compile-form-node :ex-message args ctx)
                (= op "ex-data") (compile-form-node :ex-data args ctx)
                (= op "ex-cause") (compile-form-node :ex-cause args ctx)
                (= op "println") (compile-form-node :println args ctx)
                (contains? control-forms op) (compile-form-node :control [op args node] ctx)
                (contains? remaining-runtime-ops op) (compile-form-node :runtime-op [op args] ctx)
                (= op "=")
                (if (or (nil? args) (empty? args) (empty? (rest args)))
                  (throw (ex-info "= expects at least two arguments" {}))
                  (loop [remaining args ctx ctx stmts [] irs []]
                    (if (or (nil? remaining) (empty? remaining))
                      (form-result stmts (eq-to-ir irs) :value ctx)
                      (let [part (compile-form-node :form (first remaining) ctx)]
                        (recur (rest remaining)
                               (:ctx part)
                               (concat-stmts stmts (:stmts part))
                               (conj irs (eq-arg-ir part)))))))

                unary
                (if (not (= 1 (count args)))
                  (throw (ex-info (str op " expects exactly one argument") {:node node}))
                  (let [compiled (compile-form-node :seq args ctx)]
                    (form-result (:stmts compiled)
                                 (runtime-call-to-ir unary (:irs compiled))
                                 :value
                                 (:ctx compiled))))

                fold
                (let [compiled (compile-form-node :seq args ctx)]
                  (form-result (:stmts compiled)
                               (fold-call-to-ir fold (:irs compiled))
                               :value
                               (:ctx compiled)))

                binary
                (if (not (= 2 (count args)))
                  (throw (ex-info (str op " expects exactly two arguments") {:node node}))
                  (let [compiled (compile-form-node :seq args ctx)]
                    (form-result (:stmts compiled)
                                 (runtime-call-to-ir binary (:irs compiled))
                                 :value
                                 (:ctx compiled))))

                variadic
                (let [compiled (compile-form-node :seq args ctx)]
                  (form-result (:stmts compiled)
                               (runtime-call-to-ir variadic (:irs compiled))
                               :value
                               (:ctx compiled)))

                (contains? special-form-names op)
                (throw (ex-info "not handled by FLAG form lowering" {:node node}))

                :else
                (let [self-target (self-call-target op (count (stmt-list args)) ctx)]
                  (if (and self-target (not (= "" self-target)))
                    (let [compiled (compile-form-node :seq args ctx)]
                      (form-result (:stmts compiled)
                                   (ident-call-ir self-target (:irs compiled))
                                   :value
                                   (:ctx compiled)))
                    (let [callee (compile-form-node :form head ctx)
                          compiled (compile-form-node :seq args (:ctx callee))]
                      (form-result (concat-stmts (:stmts callee) (:stmts compiled))
                                   (call-to-ir (form-value-ir callee) (:irs compiled))
                                   :value
                                   (:ctx compiled)))))))
            (let [callee (compile-form-node :form head ctx)
                  compiled (compile-form-node :seq args (:ctx callee))]
              (form-result (concat-stmts (:stmts callee) (:stmts compiled))
                           (call-to-ir (form-value-ir callee) (:irs compiled))
                           :value
                           (:ctx compiled))))))))

    (= mode :form)
    (let [form (unwrap-ast node)
          kind (:kind form)]
      (cond
        (= kind :string) (form-result [] (ast-node-to-ir form) :string ctx)
        (= kind :char) (form-result [] (ast-node-to-ir form) :value ctx)
        (= kind :int) (form-result [] (ast-node-to-ir form) :value ctx)
        (= kind :bigint) (form-result [] (ast-node-to-ir form) :value ctx)
        (= kind :ratio) (form-result [] (ast-node-to-ir form) :value ctx)
        (= kind :float) (form-result [] (ast-node-to-ir form) :value ctx)
        (= kind :keyword) (form-result [] (ast-node-to-ir form) :value ctx)
        (= kind :quoted-symbol) (form-result [] (ast-node-to-ir form) :value ctx)

        (= kind :symbol)
        (let [name (:name form)]
          (if (or (= name "true") (= name "false") (= name "nil"))
            (form-result [] (ast-node-to-ir form) :value ctx)
            (let [ident (go-ident-or-empty name)
                  resolved (symbol-to-ir name ident ctx)]
              (form-result [] (:ir resolved) (:expr-kind resolved) ctx))))

        (= kind :quoted-list) (form-result [] (quoted-ast-to-ir form) :value ctx)

        (= kind :vector)
        (let [compiled (compile-form-node :seq (:elements form) ctx)]
          (form-result (:stmts compiled)
                       (ctor-to-ir "NewArray" (:irs compiled))
                       :value
                       (:ctx compiled)))

        (= kind :pipe-vector)
        (let [compiled (compile-form-node :seq (:elements form) ctx)]
          (form-result (:stmts compiled)
                       (ctor-to-ir "NewVector" (:irs compiled))
                       :value
                       (:ctx compiled)))

        (= kind :set)
        (let [compiled (compile-form-node :seq (:elements form) ctx)]
          (form-result (:stmts compiled)
                       (ctor-to-ir "NewSet" (:irs compiled))
                       :value
                       (:ctx compiled)))

        (= kind :map)
        (let [entries (:entries form)
              n (if (nil? entries) 0 (count entries))]
          (if (not (= 0 (% n 2)))
            (throw (ex-info "map literal expects key/value pairs" {:node form}))
            (let [compiled (compile-form-node :seq entries ctx)]
              (form-result (:stmts compiled)
                           (ctor-to-ir "NewMap" (:irs compiled))
                           :value
                           (:ctx compiled)))))

        (= kind :list) (compile-form-node :call form ctx)

        (= kind :hash-fn)
        (let [body (:body form)
              n (hash-fn-node :max body 0)
              params (hash-fn-param-vector n)
              rewritten (hash-fn-node :replace body 0)]
          (compile-form-node :fn [params rewritten] ctx))

        :else (throw (ex-info "not handled by FLAG form lowering" {:node form}))))

    (= mode :forms)
    (if (or (nil? node) (empty? node))
      (form-result [] (literal-rt-call "NilValue" []) :value ctx)
      (loop [remaining (stmt-list node) ctx ctx compiled []]
        (let [part (compile-form-node :form (first remaining) ctx)
              more (rest remaining)
              next-compiled (conj compiled part)]
          (if (or (nil? more) (empty? more))
            (if (forms-have-defer? next-compiled)
              (let [result-kind (if (:defer? part) :value (:expr-kind part))]
                (form-result []
                             (do-defer-to-ir (go-type-for-kind result-kind) next-compiled)
                             result-kind
                             (:ctx part)))
              (form-result (do-prelude-stmts next-compiled)
                           (:expr part)
                           (:expr-kind part)
                           (:ctx part)))
            (recur more (:ctx part) next-compiled)))))

    (= mode :control)
    (let [op (first node)
          args (first (rest node))
          form (first (rest (rest node)))]
      (cond
        (= op "defer")
        (if (not (= 1 (count (stmt-list args))))
          (throw (ex-info "defer expects a zero-argument function" {}))
          (let [part (coerce-form-value (compile-form-node :form (first args) ctx))]
            (form-defer-result (:stmts part) (defer-to-ir (:expr part)) (:ctx part))))

        (= op "doto")
        (if (or (nil? args) (empty? args))
          (throw (ex-info "doto expects a target and at least one form" {}))
          (let [target (coerce-form-value (compile-form-node :form (first args) ctx))]
            (loop [remaining (rest args) ctx (:ctx target) steps []]
              (if (or (nil? remaining) (empty? remaining))
                (form-result [] (doto-to-ir (:stmts target) (:expr target) steps) :value ctx)
                (let [step (coerce-form-value (compile-form-node :form (first remaining) ctx))]
                  (recur (rest remaining)
                         (:ctx step)
                         (conj steps {:stmts (:stmts step) :expr (:expr step)})))))))

        (= op "try") (compile-form-node :try args ctx)

        (= op "doseq")
        (if (or (nil? args) (empty? args) (empty? (rest args)))
          (throw (ex-info "doseq expects a binding vector and body" {}))
          (let [bindings-node (unwrap-ast (first args))]
            (if (not (= :vector (:kind bindings-node)))
              (throw (ex-info "doseq expects a binding vector" {:node bindings-node}))
              (let [entries (ast-seq bindings-node)]
                (if (not (= 0 (% (count entries) 2)))
                  (throw (ex-info "doseq binding vector expects name/value pairs" {}))
                  (let [loop-part (compile-form-node :seq-bindings ["doseq" entries (rest args)] ctx)]
                    (form-result (:stmts loop-part)
                                 (doseq-to-ir (:expr loop-part))
                                 :value
                                 (:ctx loop-part))))))))

        (= op "for")
        (if (or (nil? args) (empty? args) (empty? (rest args)))
          (throw (ex-info "for expects a binding vector and body" {}))
          (let [bindings-node (unwrap-ast (first args))]
            (if (not (= :vector (:kind bindings-node)))
              (throw (ex-info "for expects a binding vector" {:node bindings-node}))
              (let [entries (ast-seq bindings-node)]
                (if (not (= 0 (% (count entries) 2)))
                  (throw (ex-info "for binding vector expects name/value pairs" {}))
                  (compile-form-node :seq-bindings ["for" entries (rest args)] ctx))))))

        (= op "testing")
        (if (or (nil? args) (empty? args) (empty? (rest args)))
          (throw (ex-info "testing expects a label and body" {}))
          (let [label (unwrap-ast (first args))]
            (if (not (= :string (:kind label)))
              (throw (ex-info "testing expects a string label" {}))
              (if (= "" (:value label))
                (throw (ex-info "testing label cannot be empty" {}))
                (let [compiled (compile-form-node :forms (rest args) ctx)]
                  (form-result [] (testing-to-ir (:stmts compiled) (:expr compiled)) :value (:ctx compiled)))))))

        (= op "is")
        (let [n (count (stmt-list args))]
          (if (and (not (= n 1)) (not (= n 2)))
            (throw (ex-info "is expects an expression and optional message" {}))
            (let [test-part (compile-form-node :form (first args) ctx)
                  message (if (= n 2)
                            (let [msg (unwrap-ast (first (rest args)))]
                              (if (not (= :string (:kind msg)))
                                (throw (ex-info "is message must be a string" {}))
                                (:value msg)))
                            (ast-form-source (first args)))
                  prefixed (str (form-pos-prefix form) message)]
              (form-result []
                           (is-to-ir (:stmts test-part) (truthy-form-ir test-part) prefixed)
                           :value
                           (:ctx test-part)))))

        (= op "expect-exception")
        (let [n (count (stmt-list args))]
          (if (and (not (= n 1)) (not (= n 2)))
            (throw (ex-info "expect-exception expects an expression and optional message" {}))
            (let [body (compile-form-node :form (first args) ctx)
                  expected (if (= n 2)
                             (let [msg (unwrap-ast (first (rest args)))]
                               (if (not (= :string (:kind msg)))
                                 (throw (ex-info "expect-exception message must be a string" {}))
                                 (:value msg)))
                             "")
                  prefix (form-pos-prefix form)
                  source (ast-form-source (first args))
                  no-panic (str prefix "expected exception from " source)]
              (form-result []
                           (expect-exception-to-ir (:stmts body) (:expr body) no-panic expected prefix)
                           :value
                           (:ctx body)))))

        :else (throw (ex-info "unsupported control form" {:op op}))))

    (= mode :seq-bindings)
    (let [kind (first node)
          bindings (first (rest node))
          body (first (rest (rest node)))]
      (if (or (nil? body) (empty? body))
        (throw (ex-info (str kind " expects at least one body form") {}))
        (if (or (nil? bindings) (empty? bindings))
          (if (= kind "doseq")
            (let [compiled (compile-form-node :forms body ctx)
                  k (:expr-kind compiled)]
              (if (or (= k :value) (= k :string) (= k :bool))
                (form-result [] (doseq-body-to-ir (:stmts compiled) (:expr compiled)) :value (:ctx compiled))
                (throw (ex-info "doseq body must evaluate to Value" {}))))
            (let [compiled (coerce-form-value (compile-form-node :forms body ctx))]
              (form-result (:stmts compiled)
                           (ctor-to-ir "NewArray" [(:expr compiled)])
                           :value
                           (:ctx compiled))))
          (if (or (nil? (rest bindings)) (empty? (rest bindings)))
            (throw (ex-info (str kind " binding vector expects name/value pairs") {}))
            (let [name-node (unwrap-ast (first bindings))
                  coll-node (first (rest bindings))]
              (if (not (= :symbol (:kind name-node)))
                (throw (ex-info (str kind " binding name must be a symbol") {:node name-node}))
                (let [ident (go-ident (:name name-node))
                      coll (compile-form-node :form coll-node ctx)
                      coll-ir (wrap-value-arg-ir coll true (str kind " binding collection must evaluate to Value"))
                      locals (:locals (:ctx coll))
                      next-locals (if (= ident "_")
                                    locals
                                    (assoc (if (nil? locals) {} locals) ident :value))
                      next-ctx (assoc (:ctx coll) :locals next-locals)
                      rest-part (compile-form-node :seq-bindings [kind (rest (rest bindings)) body] next-ctx)
                      unused (and (unused-binding? (:name name-node)) (not (= ident "_")))
                      ir (mapcat-binding-to-ir ident
                                               unused
                                               (str kind " binding expects exactly one value")
                                               (:expr rest-part)
                                               (:stmts rest-part)
                                               coll-ir)]
                  (form-result (:stmts coll) ir :value (:ctx rest-part)))))))))

    (= mode :try)
    (let [parsed (split-try-args node)
          body-forms (:body parsed)
          catch-forms (:catches parsed)
          finally-forms (:finally parsed)
          body (if (or (nil? body-forms) (empty? body-forms))
                 (form-result [] (literal-rt-call "NilValue" []) :value ctx)
                 (coerce-form-value (compile-form-node :forms body-forms ctx)))]
      (if (and (or (nil? catch-forms) (empty? catch-forms)) (nil? finally-forms))
        body
        (loop [remaining (stmt-list catch-forms) ctx (:ctx body) catches []]
          (if (or (nil? remaining) (empty? remaining))
            (let [finally (if (nil? finally-forms)
                            nil
                            (compile-form-node :forms finally-forms ctx))]
              (form-result []
                           (try-to-ir (:stmts body) (:expr body) catches finally)
                           :value
                           (if (nil? finally) ctx (:ctx finally))))
            (let [clause (parse-catch-clause (first remaining))
                  ident (go-ident (:name (:name clause)))
                  locals (:locals ctx)
                  handler-locals (if (= ident "_")
                                   locals
                                   (assoc (if (nil? locals) {} locals) ident :value))
                  handler-ctx (assoc ctx :locals handler-locals)
                  handler-body (if (or (nil? (:body clause)) (empty? (:body clause)))
                                 (form-result [] (literal-rt-call "NilValue" []) :value handler-ctx)
                                 (coerce-form-value (compile-form-node :forms (:body clause) handler-ctx)))
                  handler (catch-handler-to-ir ident (:stmts handler-body) (:expr handler-body))]
              (recur (rest remaining)
                     (:ctx handler-body)
                     (conj catches {:class (:class clause) :stmts [] :handler handler})))))))

    :else (throw (ex-info "unsupported compile-form mode" {:mode mode}))))

(defn compile-form-to-ir [node ctx]
  (compile-form-node :form node ctx))

(defn compile-forms-to-ir [forms ctx]
  (compile-form-node :forms forms ctx))
