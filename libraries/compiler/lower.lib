{:namespace "compiler"
 :exports   [ast-node-to-ir quoted-ast-to-ir call-to-ir call-ast-to-ir
             ctor-to-ir runtime-call-to-ir fold-call-to-ir eq-to-ir
             symbol-to-ir eval-ast-to-ir if-to-ir let-to-ir
             do-prelude-stmts do-defer-to-ir loop-to-ir recur-to-ir
             defer-to-ir throw-to-ir future-to-ir
             doto-to-ir update-bang-to-ir catch-handler-to-ir try-to-ir
             doseq-to-ir doseq-body-to-ir mapcat-binding-to-ir
             fn-to-ir ns-to-ir def-to-ir defn-binding-to-ir
             defn-to-ir defn-multi-to-ir
             go-ident bind-params-to-ir compile-form-to-ir compile-forms-to-ir]}

(defn literal-rt-call [name args]
  {:kind :call
   :fun {:kind :selector :pkg "flagrt" :name name}
   :args args})

(defn ast-node-to-ir [node]
  (let [kind (:kind node)]
    (cond
      (= kind :string)
      {:kind :string :value (:value node)}

      (= kind :char)
      (literal-rt-call "NewString" [{:kind :string :value (:value node)}])

      (= kind :int)
      (literal-rt-call "NewLong" [{:kind :int :value (:value node)}])

      (= kind :bigint)
      (literal-rt-call "NewBigIntFromString" [{:kind :string :value (:value node)}])

      (= kind :ratio)
      (literal-rt-call "NewRatio" [{:kind :int :value (:numerator node)}
                                   {:kind :int :value (:denominator node)}])

      (= kind :float)
      (let [raw (:raw node)
            code (if (or (nil? raw) (= "" raw))
                   (format "%g" (:value node))
                   raw)]
        (literal-rt-call "NewDouble" [{:kind :raw :code code}]))

      (= kind :keyword)
      (literal-rt-call "NewKeyword" [{:kind :string :value (:name node)}])

      (= kind :quoted-symbol)
      (literal-rt-call "NewSymbol" [{:kind :string :value (:name node)}])

      (= kind :symbol)
      (let [name (:name node)]
        (cond
          (= name "true") (literal-rt-call "NewBool" [{:kind :raw :code "true"}])
          (= name "false") (literal-rt-call "NewBool" [{:kind :raw :code "false"}])
          (= name "nil") (literal-rt-call "NilValue" [])
          :else (throw (ex-info "unsupported symbol for literal lowering"
                                {:node node}))))

      :else (throw (ex-info "unsupported AST node for literal lowering"
                            {:node node})))))

(defn quoted-ast-to-ir-node [mode node]
  (cond
    (= mode :seq)
    (loop [remaining node out []]
      (if (or (nil? remaining) (empty? remaining))
        out
        (recur (rest remaining)
               (conj out (quoted-ast-to-ir-node :node (first remaining))))))

    (= mode :node)
    (let [kind (:kind node)]
      (cond
        (= kind :int) (ast-node-to-ir node)
        (= kind :bigint) (ast-node-to-ir node)
        (= kind :ratio) (ast-node-to-ir node)
        (= kind :float) (ast-node-to-ir node)
        (= kind :keyword) (ast-node-to-ir node)
        (= kind :quoted-symbol) (ast-node-to-ir node)

        (= kind :symbol)
        (literal-rt-call "NewSymbol" [{:kind :string :value (:name node)}])

        (= kind :quoted-list)
        (literal-rt-call "NewList" (quoted-ast-to-ir-node :seq (:elements node)))

        (= kind :list)
        (literal-rt-call "NewList" (quoted-ast-to-ir-node :seq (:elements node)))

        (= kind :vector)
        (literal-rt-call "NewArray" (quoted-ast-to-ir-node :seq (:elements node)))

        (= kind :pipe-vector)
        (literal-rt-call "NewVector" (quoted-ast-to-ir-node :seq (:elements node)))

        (= kind :map)
        (let [entries (:entries node)
              n (if (nil? entries) 0 (count entries))]
          (if (not (= 0 (% n 2)))
            (throw (ex-info "quoted map literal expects an even number of forms"
                            {:node node}))
            (literal-rt-call "NewMap" (quoted-ast-to-ir-node :seq entries))))

        (= kind :set)
        (literal-rt-call "NewSet" (quoted-ast-to-ir-node :seq (:elements node)))

        :else
        (throw (ex-info "unsupported quoted literal" {:node node}))))

    :else (throw (ex-info "unsupported quoted lowering mode" {:mode mode}))))

(defn quoted-ast-to-ir [node]
  (quoted-ast-to-ir-node :node node))

(def special-form-names
  #{"+" "*" "-" "/" "%" "mod" "quot" "rem" "compare" "==" "=" "<" "<=" ">" ">="
    "max" "min"
    "bit-and" "bit-or" "bit-xor" "bit-not" "bit-shift-left" "bit-shift-right"
    "unsigned-bit-shift-right" "bit-test" "bit-set" "bit-clear" "bit-flip"
    "str" "println" "testing" "ex-info" "ex-message" "ex-data" "ex-cause"
    "throw" "try" "catch" "finally" "is" "expect-exception"
    "if" "do" "doto" "for" "doseq" "let" "loop" "recur" "defer" "update!"
    "symbol" "name" "keyword" "first" "fist" "rest" "next" "last"
    "reverse" "cons" "take" "drop" "not-empty" "seq" "empty?" "nil?" "type-of"
    "count" "double" "into" "format" "hash-map" "list" "array" "map" "concat"
    "sort-by" "apply" "pmap" "filter" "reduce" "doall" "some" "seq?" "set"
    "vec" "conj" "contains?" "line-seq" "repeat" "rand-int" "assoc" "dissoc"
    "to-json" "from-json" "open-file" "file-to-strings" "go-fn" "go-fn-args"
    "fn"})

(defn call-to-ir [callee args]
  (loop [remaining args out [callee]]
    (if (or (nil? remaining) (empty? remaining))
      (literal-rt-call "Call" out)
      (recur (rest remaining) (conj out (first remaining))))))

(defn call-ast-to-ir-node [mode node]
  (cond
    (= mode :seq)
    (loop [remaining node out []]
      (if (or (nil? remaining) (empty? remaining))
        out
        (recur (rest remaining)
               (conj out (call-ast-to-ir-node :eval (first remaining))))))

    (= mode :eval)
    (let [kind (:kind node)]
      (cond
        (= kind :string) (ast-node-to-ir node)
        (= kind :char) (ast-node-to-ir node)
        (= kind :int) (ast-node-to-ir node)
        (= kind :bigint) (ast-node-to-ir node)
        (= kind :ratio) (ast-node-to-ir node)
        (= kind :float) (ast-node-to-ir node)
        (= kind :keyword) (ast-node-to-ir node)
        (= kind :quoted-symbol) (ast-node-to-ir node)

        (= kind :symbol)
        (let [name (:name node)]
          (if (or (= name "true") (= name "false") (= name "nil"))
            (ast-node-to-ir node)
            (throw (ex-info "unresolved symbol for call lowering"
                            {:node node}))))

        (= kind :quoted-list) (quoted-ast-to-ir node)
        (= kind :vector) (quoted-ast-to-ir node)
        (= kind :pipe-vector) (quoted-ast-to-ir node)
        (= kind :map) (quoted-ast-to-ir node)
        (= kind :set) (quoted-ast-to-ir node)

        (= kind :list) (call-ast-to-ir-node :call node)

        :else (throw (ex-info "unsupported AST node for call lowering"
                              {:node node}))))

    (= mode :call)
    (let [elements (:elements node)]
      (if (or (nil? elements) (empty? elements))
        (throw (ex-info "unsupported form" {:node node}))
        (let [head (first elements)]
          (if (and (= :symbol (:kind head))
                   (contains? special-form-names (:name head)))
            (throw (ex-info "special form not handled by call lowering"
                            {:node node}))
            (call-to-ir (call-ast-to-ir-node :eval head)
                        (call-ast-to-ir-node :seq (rest elements)))))))

    :else (throw (ex-info "unsupported call lowering mode" {:mode mode}))))

(defn call-ast-to-ir [node]
  (call-ast-to-ir-node :call node))

(defn ctor-to-ir [name args]
  (literal-rt-call name args))

(defn runtime-call-to-ir [name args]
  (literal-rt-call name args))

(defn fold-call-to-ir [name args]
  (if (or (nil? args) (empty? args) (empty? (rest args)))
    (throw (ex-info "fold expects at least two arguments" {:name name}))
    (loop [acc (first args) remaining (rest args)]
      (if (or (nil? remaining) (empty? remaining))
        acc
        (recur (literal-rt-call name [acc (first remaining)])
               (rest remaining))))))

(defn eq-to-ir [args]
  (if (or (nil? args) (empty? args) (empty? (rest args)))
    (throw (ex-info "= expects at least two arguments" {}))
    (loop [acc (literal-rt-call "Eq" [(first args) (first (rest args))])
           prev (first (rest args))
           remaining (rest (rest args))]
      (if (or (nil? remaining) (empty? remaining))
        (literal-rt-call "NewBool" [acc])
        (recur {:kind :binary
                :op "&&"
                :left acc
                :right (literal-rt-call "Eq" [prev (first remaining)])}
               (first remaining)
               (rest remaining))))))

(def builtin-function-names
  #{"+" "-" "*" "/" "%" "quot" "rem" "mod" "compare" "==" "=" "<" "<=" ">" ">="
    "max" "min"
    "bit-and" "bit-or" "bit-xor" "bit-not" "bit-shift-left" "bit-shift-right"
    "unsigned-bit-shift-right" "bit-test" "bit-set" "bit-clear" "bit-flip"
    "first" "fist" "rest" "next" "last" "reverse" "cons" "take" "drop" "nth"
    "slow-nth" "map" "concat" "sort-by" "apply" "pmap" "filter" "reduce" "get"
    "keys" "vals" "find" "hash-map" "list" "array" "not-empty" "empty?" "nil?"
    "type-of" "count" "double" "numerator" "denominator" "format" "subs"
    "keyword" "into" "doall" "dorun" "line-seq" "some" "seq" "seq?" "set" "vec"
    "conj" "contains?" "assoc" "dissoc" "open-file" "close-file" "close-channel"
    "file-to-strings" "rand-int" "rand" "rand-nth" "shuffle" "repeat"
    "union" "intersection" "difference" "subset?" "superset?" "disjoint?"
    "rename-keys" "map-invert" "select" "project" "rename"
    "go-fn" "go-fn-args" "re-pattern" "re-matches"
    "ex-message" "ex-data" "ex-cause"})

(def unary-runtime-ops
  {"first" "First" "fist" "First" "rest" "Rest" "next" "Next" "last" "Last"
   "reverse" "Reverse" "seq?" "SeqPredicate" "double" "Double" "bit-not" "BitNot"})

(def fold-runtime-ops
  {"+" "Add" "*" "Mul" "-" "Sub" "/" "Div"})

(def binary-runtime-ops
  {"%" "Mod" "mod" "Mod" "quot" "Quot" "rem" "Rem"
   "bit-shift-left" "BitShiftLeft" "bit-shift-right" "BitShiftRight"
   "unsigned-bit-shift-right" "UnsignedBitShiftRight"
   "bit-test" "BitTest" "bit-set" "BitSet" "bit-clear" "BitClear"
   "bit-flip" "BitFlip"})

(def variadic-runtime-ops
  {"bit-and" "BitAnd" "bit-or" "BitOr" "bit-xor" "BitXor"
   "max" "Max" "min" "Min"})

(defn qualified-name? [name]
  (loop [s name]
    (if (or (nil? s) (= 0 (count s)))
      false
      (if (= "/" (subs s 0 1))
        true
        (recur (subs s 1))))))

(defn ident-ir [ident k]
  (let [ir {:kind :ident :name ident}]
    (if (= k :string)
      {:ir ir :expr-kind :string}
      (if (= k :bool)
        {:ir ir :expr-kind :bool}
        {:ir ir :expr-kind :value}))))

(defn symbol-to-ir [name ident ctx]
  (let [locals (:locals ctx)
        globals (:globals ctx)
        functions (:functions ctx)
        module (:module ctx)
        go-fns (:go-fns ctx)
        self-name (:self-function-name ctx)
        self-var (:self-variadic-name ctx)
        slash? (qualified-name? name)]
    (cond
      (and (not slash?)
           ident
           (not (= "" ident))
           (not (nil? locals))
           (contains? locals ident))
      (ident-ir ident (get locals ident))

      (and (= name self-name)
           self-var
           (not (= "" self-var)))
      {:ir (literal-rt-call "NewFunction" [{:kind :ident :name self-var}])
       :expr-kind :value}

      (and (not (nil? module)) (contains? module name))
      (let [go-ident (get module name)]
        (if (and (not (nil? globals)) (contains? globals go-ident))
          (ident-ir go-ident (get globals go-ident))
          (if (and (not (nil? functions)) (contains? functions go-ident))
            {:ir (literal-rt-call "NewFunction" [{:kind :ident :name go-ident}])
             :expr-kind :value}
            {:ir {:kind :ident :name go-ident} :expr-kind :value})))

      (and ident
           (not (= "" ident))
           (not (nil? globals))
           (contains? globals ident))
      (ident-ir ident (get globals ident))

      (and ident
           (not (= "" ident))
           (not (nil? functions))
           (contains? functions ident))
      {:ir (literal-rt-call "NewFunction" [{:kind :ident :name ident}])
       :expr-kind :value}

      (contains? builtin-function-names name)
      {:ir (literal-rt-call "BuiltinFunction" [{:kind :string :value name}])
       :expr-kind :value}

      (and (not (nil? go-fns)) (contains? go-fns name))
      {:ir {:kind :selector :pkg "flagrt" :name (get go-fns name)}
       :expr-kind :value}

      :else
      (throw (ex-info (str "unknown symbol \"" name "\"") {:name name})))))

(defn eval-ast-to-ir-node [mode node ctx]
  (cond
    (= mode :seq)
    (loop [remaining node out []]
      (if (or (nil? remaining) (empty? remaining))
        out
        (recur (rest remaining)
               (conj out (eval-ast-to-ir-node :eval (first remaining) ctx)))))

    (= mode :eval)
    (let [kind (:kind node)]
      (cond
        (= kind :string) (ast-node-to-ir node)
        (= kind :char) (ast-node-to-ir node)
        (= kind :int) (ast-node-to-ir node)
        (= kind :bigint) (ast-node-to-ir node)
        (= kind :ratio) (ast-node-to-ir node)
        (= kind :float) (ast-node-to-ir node)
        (= kind :keyword) (ast-node-to-ir node)
        (= kind :quoted-symbol) (ast-node-to-ir node)

        (= kind :symbol)
        (let [name (:name node)]
          (if (or (= name "true") (= name "false") (= name "nil"))
            (ast-node-to-ir node)
            (:ir (symbol-to-ir name name ctx))))

        (= kind :quoted-list) (quoted-ast-to-ir node)

        (= kind :vector)
        (ctor-to-ir "NewArray" (eval-ast-to-ir-node :seq (:elements node) ctx))

        (= kind :pipe-vector)
        (ctor-to-ir "NewVector" (eval-ast-to-ir-node :seq (:elements node) ctx))

        (= kind :set)
        (ctor-to-ir "NewSet" (eval-ast-to-ir-node :seq (:elements node) ctx))

        (= kind :map)
        (let [entries (:entries node)
              n (if (nil? entries) 0 (count entries))]
          (if (not (= 0 (% n 2)))
            (throw (ex-info "map literal expects key/value pairs" {:node node}))
            (ctor-to-ir "NewMap" (eval-ast-to-ir-node :seq entries ctx))))

        (= kind :list) (eval-ast-to-ir-node :call node ctx)

        :else (throw (ex-info "unsupported AST node for eval lowering"
                              {:node node}))))

    (= mode :call)
    (let [elements (:elements node)]
      (if (or (nil? elements) (empty? elements))
        (throw (ex-info "unsupported form" {:node node}))
        (let [head (first elements)
              args (rest elements)]
          (if (= :symbol (:kind head))
            (let [op (:name head)
                  unary (get unary-runtime-ops op)
                  fold (get fold-runtime-ops op)
                  binary (get binary-runtime-ops op)
                  variadic (get variadic-runtime-ops op)]
              (cond
                unary
                (if (not (= 1 (count args)))
                  (throw (ex-info (str op " expects exactly one argument") {:node node}))
                  (runtime-call-to-ir unary (eval-ast-to-ir-node :seq args ctx)))

                fold
                (fold-call-to-ir fold (eval-ast-to-ir-node :seq args ctx))

                binary
                (if (not (= 2 (count args)))
                  (throw (ex-info (str op " expects exactly two arguments") {:node node}))
                  (runtime-call-to-ir binary (eval-ast-to-ir-node :seq args ctx)))

                variadic
                (runtime-call-to-ir variadic (eval-ast-to-ir-node :seq args ctx))

                (contains? special-form-names op)
                (throw (ex-info "special form not handled by eval lowering"
                                {:node node}))

                :else
                (call-to-ir (eval-ast-to-ir-node :eval head ctx)
                            (eval-ast-to-ir-node :seq args ctx))))
            (call-to-ir (eval-ast-to-ir-node :eval head ctx)
                        (eval-ast-to-ir-node :seq args ctx))))))

    :else (throw (ex-info "unsupported eval lowering mode" {:mode mode}))))

(defn eval-ast-to-ir [node ctx]
  (eval-ast-to-ir-node :eval node ctx))

(defn stmt-list [stmts]
  (if (or (nil? stmts) (empty? stmts))
    []
    stmts))

(defn append-stmt [stmts stmt]
  (conj (stmt-list stmts) stmt))

(defn if-to-ir [name type cond then-stmts then-expr else-stmts else-expr]
  [{:kind :var :name name :type type :expr nil}
   {:kind :if
    :init ""
    :cond cond
    :then (append-stmt then-stmts {:kind :assign :name name :expr then-expr})
    :else (append-stmt else-stmts {:kind :assign :name name :expr else-expr})}])

(defn concat-stmts [left right]
  (loop [out (stmt-list left) remaining (stmt-list right)]
    (if (or (nil? remaining) (empty? remaining))
      out
      (recur (conj out (first remaining)) (rest remaining)))))

(defn let-to-ir [name type binding-stmts body-stmts body-expr]
  [{:kind :var :name name :type type :expr nil}
   {:kind :block
    :body (append-stmt (concat-stmts binding-stmts body-stmts)
                       {:kind :assign :name name :expr body-expr})}])

(defn last-item [xs]
  (loop [remaining (stmt-list xs)]
    (let [more (rest remaining)]
      (if (or (nil? more) (empty? more))
        (first remaining)
        (recur more)))))

(defn do-form-stmt [form]
  (let [stmt (:stmt form)]
    (if (nil? stmt)
      {:kind :expr-stmt :expr (:expr form) :discard true}
      stmt)))

(defn do-prelude-stmts [forms]
  (loop [remaining (stmt-list forms) out []]
    (if (or (nil? remaining) (empty? remaining))
      out
      (let [form (first remaining)
            more (rest remaining)
            with-stmts (concat-stmts out (:stmts form))]
        (if (or (nil? more) (empty? more))
          with-stmts
          (recur more (append-stmt with-stmts (do-form-stmt form))))))))

(defn do-iife-body [forms]
  (let [last (last-item forms)
        prelude (do-prelude-stmts forms)]
    (if (:defer? last)
      (append-stmt (append-stmt prelude (do-form-stmt last))
                   {:kind :return :expr (literal-rt-call "NilValue" [])})
      (append-stmt prelude {:kind :return :expr (:expr last)}))))

(defn do-defer-to-ir [type forms]
  {:kind :call
   :fun {:kind :func-lit :params "" :result type :body (do-iife-body forms)}
   :args []})

(defn loop-binding-stmts [bindings]
  (loop [remaining (stmt-list bindings) out []]
    (if (or (nil? remaining) (empty? remaining))
      out
      (let [b (first remaining)
            with-var (append-stmt out {:kind :var :name (:name b) :type "" :expr (:init b)})
            with-unused (if (:unused b)
                          (append-stmt with-var {:kind :expr-stmt
                                                 :expr {:kind :ident :name (:name b)}
                                                 :discard true})
                          with-var)]
        (recur (rest remaining) with-unused)))))

(defn loop-recur-then [names]
  (let [n (count names)
        arity-check {:kind :if
                     :init ""
                     :cond {:kind :binary
                            :op "!="
                            :left {:kind :call
                                   :fun {:kind :ident :name "len"}
                                   :args [{:kind :ident :name "__recurValues"}]}
                            :right {:kind :int :value n}}
                     :then [{:kind :expr-stmt
                             :expr {:kind :call
                                    :fun {:kind :ident :name "panic"}
                                    :args [{:kind :string :value "internal error: recur arity mismatch"}]}
                             :discard false}]
                     :else []}]
    (loop [remaining (stmt-list names) i 0 out [arity-check]]
      (if (or (nil? remaining) (empty? remaining))
        (append-stmt out {:kind :expr-stmt
                          :expr {:kind :ident :name "continue"}
                          :discard false})
        (recur (rest remaining)
               (inc i)
               (conj out {:kind :assign
                          :name (first remaining)
                          :expr {:kind :index
                                 :x {:kind :ident :name "__recurValues"}
                                 :index {:kind :int :value i}}}))))))

(defn loop-iter-body [binding-names body-stmts body-expr]
  (concat-stmts
    body-stmts
    [{:kind :define :names ["__loopResult"] :expr body-expr}
     {:kind :if
      :init "__recurValues, __isRecur := flagrt.UnwrapRecur(__loopResult)"
      :cond {:kind :ident :name "__isRecur"}
      :then (loop-recur-then binding-names)
      :else []}
     {:kind :return :expr {:kind :ident :name "__loopResult"}}]))

(defn loop-to-ir [init-stmts bindings body-stmts body-expr]
  (let [names (loop [remaining (stmt-list bindings) out []]
                (if (or (nil? remaining) (empty? remaining))
                  out
                  (recur (rest remaining) (conj out (:name (first remaining))))))]
    {:kind :call
     :fun {:kind :func-lit
           :params ""
           :result "flagrt.Value"
           :body (concat-stmts
                   init-stmts
                   (concat-stmts
                     (loop-binding-stmts bindings)
                     [{:kind :for :body (loop-iter-body names body-stmts body-expr)}]))}
     :args []}))

(defn recur-to-ir [values]
  (literal-rt-call "NewRecur" (stmt-list values)))

(defn defer-to-ir [thunk]
  {:kind :defer :expr (literal-rt-call "Call" [thunk])})

(defn throw-to-ir [stmts value]
  {:kind :call
   :fun {:kind :func-lit
         :params ""
         :result "flagrt.Value"
         :body (append-stmt
                 (append-stmt stmts {:kind :expr-stmt
                                     :expr (literal-rt-call "Throw" [value])
                                     :discard false})
                 {:kind :return :expr (literal-rt-call "NilValue" [])})}
   :args []})

(defn future-to-ir [body-stmts body-expr]
  (literal-rt-call "NewFuture"
                   [{:kind :func-lit
                     :params ""
                     :result "flagrt.Value"
                     :body (append-stmt body-stmts {:kind :return :expr body-expr})}]))

(defn value-iife-ir [body]
  {:kind :call
   :fun {:kind :func-lit :params "" :result "flagrt.Value" :body body}
   :args []})

(defn ident-call-ir [name args]
  {:kind :call :fun {:kind :ident :name name} :args args})

(defn self-call-target [name nargs ctx]
  (if (or (nil? name) (= "" name) (not (= name (:self-function-name ctx))))
    nil
    (let [arity-names (:self-arity-names ctx)]
      (if (and (not (nil? arity-names)) (contains? arity-names nargs))
        (get arity-names nargs)
        (if (or (:self-function-rest ctx) (= nargs (:self-function-arity ctx)))
          (if (:self-function-rest ctx)
            (:self-variadic-name ctx)
            (:self-arity-name ctx))
          nil)))))

(defn doto-to-ir [target-stmts target-expr steps]
  (value-iife-ir
    (concat-stmts
      target-stmts
      (append-stmt
        (loop [remaining (stmt-list steps)
               out [{:kind :define :names ["__doto"] :expr target-expr}]]
          (if (or (nil? remaining) (empty? remaining))
            out
            (let [step (first remaining)
                  with-stmts (concat-stmts out (:stmts step))]
              (recur (rest remaining)
                     (append-stmt with-stmts
                                  {:kind :expr-stmt
                                   :expr (literal-rt-call "Call"
                                                          [(:expr step)
                                                           {:kind :ident :name "__doto"}])
                                   :discard true})))))
        {:kind :return :expr {:kind :ident :name "__doto"}}))))

(defn update-bang-to-ir [name stmts value]
  (value-iife-ir
    (append-stmt
      (append-stmt stmts {:kind :assign :name name :expr value})
      {:kind :return :expr {:kind :ident :name name}})))

(defn catch-handler-to-ir [name body-stmts body-expr]
  (let [bind (if (= name "_")
               [{:kind :expr-stmt
                 :expr {:kind :ident :name "__flag_thrown"}
                 :discard true}]
               [{:kind :var :name name :type "" :expr {:kind :ident :name "__flag_thrown"}}
                {:kind :expr-stmt :expr {:kind :ident :name name} :discard true}])]
    (value-iife-ir
      (append-stmt (concat-stmts bind body-stmts)
                   {:kind :return :expr body-expr}))))

(defn try-finally-stmt [finally]
  {:kind :defer
   :expr {:kind :call
          :fun {:kind :func-lit
                :params ""
                :result ""
                :body (append-stmt (:stmts finally)
                                   {:kind :expr-stmt :expr (:expr finally) :discard true})}
          :args []}})

(defn try-recover-body [catches]
  (loop [remaining (stmt-list catches)
         out [{:kind :define :names ["r"] :expr (ident-call-ir "recover" [])}
              {:kind :if
               :init ""
               :cond {:kind :binary
                      :op "=="
                      :left {:kind :ident :name "r"}
                      :right {:kind :ident :name "nil"}}
               :then [{:kind :return :expr nil}]
               :else []}
              {:kind :define
               :names ["__flag_thrown"]
               :expr (literal-rt-call "PanicValue" [{:kind :ident :name "r"}])}]]
    (if (or (nil? remaining) (empty? remaining))
      (append-stmt out {:kind :expr-stmt
                        :expr (ident-call-ir "panic" [{:kind :ident :name "r"}])
                        :discard false})
      (let [c (first remaining)
            then (append-stmt
                   (append-stmt (:stmts c)
                                {:kind :assign :name "__flag_try_result" :expr (:handler c)})
                   {:kind :return :expr nil})]
        (recur (rest remaining)
               (append-stmt out {:kind :if
                                 :init ""
                                 :cond (literal-rt-call "CatchMatches"
                                                        [{:kind :string :value (:class c)}
                                                         {:kind :ident :name "__flag_thrown"}])
                                 :then then
                                 :else []}))))))

(defn try-to-ir [body-stmts body-expr catches finally]
  (let [has-catch (not (or (nil? catches) (empty? (stmt-list catches))))]
    (let [start (if has-catch
                  [{:kind :var :name "__flag_try_result" :type "flagrt.Value" :expr nil}]
                  [])]
      (let [start (if (nil? finally)
                    start
                    (append-stmt start (try-finally-stmt finally)))]
        (if (not has-catch)
          (value-iife-ir
            (append-stmt (concat-stmts start body-stmts)
                         {:kind :return :expr body-expr}))
          (let [inner (append-stmt
                        (concat-stmts
                          [{:kind :defer
                            :expr {:kind :call
                                   :fun {:kind :func-lit
                                         :params ""
                                         :result ""
                                         :body (try-recover-body catches)}
                                   :args []}}]
                          body-stmts)
                        {:kind :assign :name "__flag_try_result" :expr body-expr})]
            (value-iife-ir
              (append-stmt
                (append-stmt start
                             {:kind :expr-stmt
                              :expr {:kind :call
                                     :fun {:kind :func-lit :params "" :result "" :body inner}
                                     :args []}
                              :discard false})
                {:kind :return :expr {:kind :ident :name "__flag_try_result"}}))))))))

(defn doseq-to-ir [loop-expr]
  (value-iife-ir
    [{:kind :expr-stmt :expr (literal-rt-call "DoAll" [loop-expr]) :discard true}
     {:kind :return :expr (literal-rt-call "NilValue" [])}]))

(defn doseq-body-to-ir [body-stmts body-expr]
  (value-iife-ir
    (append-stmt
      (append-stmt body-stmts {:kind :expr-stmt :expr body-expr :discard true})
      {:kind :return :expr (literal-rt-call "NewArray" [])})))

(defn mapcat-binding-to-ir [ident unused panic-msg rest-expr rest-stmts coll]
  (let [args0 {:kind :index :x {:kind :ident :name "args"} :index {:kind :int :value 0}}
        arity {:kind :if
               :init ""
               :cond {:kind :binary
                      :op "!="
                      :left (ident-call-ir "len" [{:kind :ident :name "args"}])
                      :right {:kind :int :value 1}}
               :then [{:kind :expr-stmt
                       :expr (ident-call-ir "panic" [{:kind :string :value panic-msg}])
                       :discard false}]
               :else []}
        bind (if (= ident "_")
               [{:kind :expr-stmt :expr args0 :discard true}]
               (if unused
                 [{:kind :define :names [ident] :expr args0}
                  {:kind :expr-stmt :expr {:kind :ident :name ident} :discard true}]
                 [{:kind :define :names [ident] :expr args0}]))
        fn {:kind :func-lit
            :params "args ...flagrt.Value"
            :result "flagrt.Value"
            :body (append-stmt
                    (concat-stmts (concat-stmts [arity] bind) rest-stmts)
                    {:kind :return :expr rest-expr})}]
    (value-iife-ir
      [{:kind :return
        :expr (literal-rt-call "MapCat"
                               [(literal-rt-call "NewFunction" [fn])
                                coll])}])))

(defn fn-arity-check [name n has-rest]
  (let [op (if has-rest "<" "!=")
        msg (if has-rest
              (str name " expects at least " n " arguments")
              (str name " expects exactly " n " arguments"))]
    {:kind :if
     :init ""
     :cond {:kind :binary
            :op op
            :left (ident-call-ir "len" [{:kind :ident :name "args"}])
            :right {:kind :int :value n}}
     :then [{:kind :expr-stmt
             :expr (ident-call-ir "panic" [{:kind :string :value msg}])
             :discard false}]
     :else []}))

(defn fn-param-stmts [params]
  (loop [remaining (stmt-list params) i 0 out []]
    (if (or (nil? remaining) (empty? remaining))
      out
      (let [p (first remaining)
            arg {:kind :index :x {:kind :ident :name "args"} :index {:kind :int :value i}}
            stmt (if (= p "_")
                   {:kind :expr-stmt :expr arg :discard true}
                   {:kind :define :names [p] :expr arg})]
        (recur (rest remaining) (inc i) (conj out stmt))))))

(defn fn-to-ir [name params has-rest init-stmts body-stmts body-expr]
  (literal-rt-call
    "NewFunction"
    [{:kind :func-lit
      :params "args ...flagrt.Value"
      :result "flagrt.Value"
      :body (append-stmt
              (concat-stmts
                (concat-stmts
                  (concat-stmts [(fn-arity-check name (count (stmt-list params)) has-rest)]
                                (fn-param-stmts params))
                  init-stmts)
                body-stmts)
              {:kind :return :expr body-expr})}]))

(defn ns-to-ir [namespace]
  {:kind :raw-stmt :code (str "// Source namespace: " namespace "\n")})

(defn def-to-ir [name expr]
  {:kind :var :name name :type "" :expr expr})

(defn defn-binding-to-ir [name variadic-name]
  (def-to-ir name (literal-rt-call "NewFunction" [{:kind :ident :name variadic-name}])))

(defn defn-param-list [params]
  (loop [remaining (stmt-list params) out "" first? true]
    (if (or (nil? remaining) (empty? remaining))
      out
      (let [p (first remaining)
            piece (str p " flagrt.Value")]
        (if first?
          (recur (rest remaining) piece false)
          (recur (rest remaining) (str out ", " piece) false))))))

(defn defn-body [init-stmts body-stmts body-expr]
  (append-stmt (concat-stmts init-stmts body-stmts)
               {:kind :return :expr body-expr}))

(defn defn-func-decl [name params result body]
  {:kind :func-decl :name name :params params :result result :body body})

(defn defn-arity-to-ir [name params init-stmts body-stmts body-expr]
  (defn-func-decl name
                  (defn-param-list params)
                  "flagrt.Value"
                  (defn-body init-stmts body-stmts body-expr)))

(defn defn-call-args [n]
  (loop [i 0 out []]
    (if (= i n)
      out
      (recur (inc i)
             (conj out {:kind :index
                        :x {:kind :ident :name "args"}
                        :index {:kind :int :value i}})))))

(defn defn-variadic-to-ir [name arity-name panic-name n]
  (defn-func-decl name
                  "args ...flagrt.Value"
                  "flagrt.Value"
                  [(fn-arity-check panic-name n false)
                   {:kind :return
                    :expr {:kind :call
                           :fun {:kind :ident :name arity-name}
                           :args (defn-call-args n)}}]))

(defn defn-rest-to-ir [name panic-name params init-stmts body-stmts body-expr]
  (defn-func-decl name
                  "args ...flagrt.Value"
                  "flagrt.Value"
                  (append-stmt
                    (concat-stmts
                      (concat-stmts
                        (concat-stmts [(fn-arity-check panic-name (count (stmt-list params)) true)]
                                      (fn-param-stmts params))
                        init-stmts)
                      body-stmts)
                    {:kind :return :expr body-expr})))

(defn defn-to-ir [arity-name variadic-name panic-name params has-rest init-stmts body-stmts body-expr]
  (if has-rest
    [(defn-rest-to-ir variadic-name panic-name params init-stmts body-stmts body-expr)]
    [(defn-arity-to-ir arity-name params init-stmts body-stmts body-expr)
     (defn-variadic-to-ir variadic-name arity-name panic-name (count (stmt-list params)))]))

(defn defn-multi-dispatch-to-ir [name panic-msg arities]
  (defn-func-decl name
                  "args ...flagrt.Value"
                  "flagrt.Value"
                  (append-stmt
                    (loop [remaining (stmt-list arities) out []]
                      (if (or (nil? remaining) (empty? remaining))
                        out
                        (let [a (first remaining)
                              n (:n a)
                              aname (:name a)]
                          (recur (rest remaining)
                                 (conj out {:kind :if
                                            :init ""
                                            :cond {:kind :binary
                                                   :op "=="
                                                   :left (ident-call-ir "len" [{:kind :ident :name "args"}])
                                                   :right {:kind :int :value n}}
                                            :then [{:kind :return
                                                    :expr {:kind :call
                                                           :fun {:kind :ident :name aname}
                                                           :args (defn-call-args n)}}]
                                            :else []})))))
                    {:kind :expr-stmt
                     :expr (ident-call-ir "panic" [{:kind :string :value panic-msg}])
                     :discard false})))

(defn defn-multi-to-ir [variadic-name panic-msg arities]
  (concat-stmts
    (loop [remaining (stmt-list arities) out []]
      (if (or (nil? remaining) (empty? remaining))
        out
        (let [a (first remaining)]
          (recur (rest remaining)
                 (conj out (defn-arity-to-ir (:name a)
                                             (:params a)
                                             (:init-stmts a)
                                             (:body-stmts a)
                                             (:body-expr a)))))))
    [(defn-multi-dispatch-to-ir variadic-name panic-msg arities)]))

(def go-ident-letters "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ")
(def go-ident-digits "0123456789")
(def go-keywords
  #{"break" "case" "chan" "const" "continue" "default" "defer" "else"
    "fallthrough" "for" "func" "go" "goto" "if" "import" "interface"
    "map" "package" "range" "return" "select" "struct" "switch" "type" "var"})

(defn str-has-char? [s ch]
  (loop [remaining s]
    (if (or (nil? remaining) (= 0 (count remaining)))
      false
      (if (= ch (subs remaining 0 1))
        true
        (recur (subs remaining 1))))))

(defn ident-letter? [ch]
  (str-has-char? go-ident-letters ch))

(defn ident-digit? [ch]
  (str-has-char? go-ident-digits ch))

(defn go-ident-char [ch first?]
  (cond
    (= ch "-") "_"
    (and first? (or (= ch "_") (ident-letter? ch))) ch
    (and (not first?) (= ch "?")) "_q"
    (and (not first?) (= ch "!")) "_bang"
    (and (not first?) (= ch ">")) "_gt"
    (and (not first?) (= ch "<")) "_lt"
    (and (not first?) (or (= ch "_") (ident-letter? ch) (ident-digit? ch))) ch
    :else nil))

(defn go-ident [name]
  (if (or (nil? name) (= "" name))
    (throw (ex-info "empty symbol" {:name name}))
    (loop [i 0 n (count name) out ""]
      (if (= i n)
        (let [ident (if (= out "main") "flag_main" out)]
          (if (contains? go-keywords ident)
            (str ident "_")
            ident))
        (let [ch (subs name i (inc i))
              piece (go-ident-char ch (= i 0))]
          (if (nil? piece)
            (throw (ex-info (str "unsupported symbol \"" name "\"") {:name name}))
            (recur (inc i) n (str out piece))))))))

(defn go-ident-or-empty [name]
  (if (or (nil? name) (= "" name))
    ""
    (loop [i 0 n (count name) out ""]
      (if (= i n)
        (let [ident (if (= out "main") "flag_main" out)]
          (if (contains? go-keywords ident)
            (str ident "_")
            ident))
        (let [ch (subs name i (inc i))
              piece (go-ident-char ch (= i 0))]
          (if (nil? piece)
            ""
            (recur (inc i) n (str out piece))))))))

(defn parse-volatile [pattern]
  (if (not (= :meta (:kind pattern)))
    {:volatile? false :target pattern}
    (let [m (:meta pattern)
          target (:target pattern)]
      (if (not (= :map (:kind m)))
        {:volatile? false :target target}
        (let [entries (:entries m)]
          (if (not (= 0 (% (count entries) 2)))
            (throw (ex-info "metadata map expects key/value pairs" {:node m}))
            (loop [remaining entries volatile? false]
              (if (or (nil? remaining) (empty? remaining))
                {:volatile? volatile? :target target}
                (let [k (first remaining)
                      v (first (rest remaining))]
                  (if (and (= :keyword (:kind k)) (= "volatile" (:name k)))
                    (if (and (= :symbol (:kind v)) (= "true" (:name v)))
                      (recur (rest (rest remaining)) true)
                      (if (and (= :symbol (:kind v)) (= "false" (:name v)))
                        (recur (rest (rest remaining)) false)
                        (throw (ex-info "metadata :volatile must be true or false" {:node v}))))
                    (recur (rest (rest remaining)) volatile?)))))))))))

(defn unwrap-ast [node]
  (if (= :meta (:kind node))
    (unwrap-ast (:target node))
    node))

(defn ast-seq [node]
  (if (nil? node)
    []
    (let [els (:elements node)]
      (if (nil? els)
        node
        els))))

(defn unused-binding? [name]
  (and (not (nil? name))
       (not (= 0 (count name)))
       (= "_" (subs name 0 1))))

(defn append-unused [stmts flag-name go-name]
  (if (and (unused-binding? flag-name) (not (= go-name "_")))
    (conj stmts {:kind :expr-stmt :expr {:kind :ident :name go-name} :discard true})
    stmts))

(defn fresh-temp [state prefix]
  (let [n (:temp state)]
    {:name (str prefix n)
     :state (assoc state :temp (inc n))}))

(defn declare-param [state flag-name go-name]
  (if (= go-name "_")
    state
    (if (contains? (:declared state) go-name)
      (throw (ex-info (str "duplicate parameter \"" flag-name "\"") {:name flag-name}))
      (assoc (assoc state
                    :declared (assoc (:declared state) go-name true))
             :locals (assoc (:locals state) go-name :value)))))

(defn declare-binding [state flag-name go-name kind]
  (if (= go-name "_")
    state
    (if (contains? (:declared state) go-name)
      (throw (ex-info (str "duplicate binding \"" flag-name "\"") {:name flag-name}))
      (assoc (assoc state
                    :declared (assoc (:declared state) go-name true))
             :locals (assoc (:locals state) go-name kind)))))

(defn rest-source-ir [n ctor]
  (literal-rt-call ctor
                   [{:kind :spread
                     :expr {:kind :slice
                            :x {:kind :ident :name "args"}
                            :low {:kind :int :value n}
                            :high nil}}]))

(defn bind-symbol-param [state flag-name]
  (let [go-name (go-ident flag-name)
        with-decl (declare-param state flag-name go-name)]
    (assoc (assoc with-decl :params (conj (:params with-decl) go-name))
           :init-stmts (append-unused (:init-stmts with-decl) flag-name go-name))))

(defn bind-symbol-to [state flag-name source kind]
  (let [go-name (go-ident flag-name)
        with-decl (declare-binding state flag-name go-name kind)
        with-var (conj (:init-stmts with-decl)
                       {:kind :var :name go-name :type "" :expr source})]
    (assoc with-decl :init-stmts (append-unused with-var flag-name go-name))))

(defn unhandled-param [node]
  (throw (ex-info "not handled by FLAG param lowering" {:node node})))

(defn bind-pattern-node [mode state pattern source]
  (cond
    (= mode :pattern)
    (let [node (unwrap-ast pattern)
          kind (:kind node)]
      (cond
        (= kind :symbol)
        (if (= "&" (:name node))
          (throw (ex-info "unexpected & in binding" {:node node}))
          (if (= "" (:name node))
            (throw (ex-info "binding symbol cannot be empty" {:node node}))
            (bind-symbol-to state (:name node) source :value)))

        (= kind :vector)
        (bind-pattern-node :vector state node source)

        :else (unhandled-param node)))

    (= mode :vector)
  (loop [remaining (ast-seq pattern)
         positionals []
         rest-pat nil
         as-pat nil
         seen-rest false]
    (if (or (nil? remaining) (empty? remaining))
      (let [with-as (if (nil? as-pat)
                      state
                      (bind-pattern-node :pattern state as-pat source))]
        (loop [remaining positionals
               current source
               st with-as]
          (if (or (nil? remaining) (empty? remaining))
            (if (nil? rest-pat)
              st
              (bind-pattern-node :pattern st rest-pat current))
            (let [t (fresh-temp st "__dseq")
                  next-name (:name t)
                  st1 (:state t)
                  st2 (assoc st1 :init-stmts
                             (conj (:init-stmts st1)
                                   {:kind :var
                                    :name next-name
                                    :type ""
                                    :expr (literal-rt-call "SeqFirst" [current])}))
                  st3 (bind-pattern-node :pattern st2 (first remaining) {:kind :ident :name next-name})]
              (recur (rest remaining)
                     (literal-rt-call "SeqRest" [current])
                     st3)))))
      (let [item (first remaining)
            node (unwrap-ast item)]
        (cond
          (and (= :keyword (:kind node)) (= "as" (:name node)))
          (if (or (nil? (rest remaining)) (empty? (rest remaining)))
            (throw (ex-info "vector destructuring :as expects a binding form" {:node pattern}))
            (if (not (nil? as-pat))
              (throw (ex-info "vector destructuring supports only one :as" {:node pattern}))
              (recur (rest (rest remaining)) positionals rest-pat (first (rest remaining)) seen-rest)))

          (and (= :symbol (:kind node)) (= "&" (:name node)))
          (if seen-rest
            (throw (ex-info "vector destructuring supports only one & binding" {:node pattern}))
            (if (or (nil? (rest remaining)) (empty? (rest remaining)))
              (throw (ex-info "vector destructuring & expects a binding form" {:node pattern}))
              (recur (rest (rest remaining)) positionals (first (rest remaining)) as-pat true)))

          seen-rest
          (throw (ex-info "vector destructuring only allows :as after & binding" {:node pattern}))

          :else
          (recur (rest remaining) (conj positionals item) rest-pat as-pat seen-rest)))))

    :else (throw (ex-info "unsupported bind-pattern mode" {:mode mode}))))

(defn bind-pattern [state pattern source]
  (bind-pattern-node :pattern state pattern source))

(defn bind-params-to-ir [params-ast label locals]
  (loop [remaining (ast-seq params-ast)
         idx 0
         state {:params []
                :init-stmts []
                :locals (if (or (nil? locals) (empty? locals)) {} locals)
                :declared {}
                :temp 0
                :has-rest false}]
    (if (or (nil? remaining) (empty? remaining))
      {:params (:params state)
       :init-stmts (:init-stmts state)
       :locals (:locals state)
       :has-rest (:has-rest state)}
      (let [node (unwrap-ast (first remaining))]
        (if (and (= :symbol (:kind node)) (= "&" (:name node)))
          (if (:has-rest state)
            (throw (ex-info (str label " parameters support only one & binding") {:label label}))
            (if (or (nil? (rest remaining)) (empty? (rest remaining)))
              (throw (ex-info (str label " & expects a binding form") {:label label}))
              (let [rest-pat (first (rest remaining))
                    rest-node (unwrap-ast rest-pat)
                    t (fresh-temp state "__rest")
                    rest-name (:name t)
                    st1 (:state t)
                    ctor (if (= :map (:kind rest-node))
                           (unhandled-param rest-node)
                           "NewArray")
                    source (rest-source-ir (count (:params st1)) ctor)
                    st2 (assoc st1 :has-rest true)
                    st3 (assoc st2 :locals (assoc (:locals st2) rest-name :value))
                    st4 (assoc st3 :init-stmts
                               (conj (conj (:init-stmts st3)
                                           {:kind :var :name rest-name :type "" :expr source})
                                     {:kind :expr-stmt
                                      :expr {:kind :ident :name rest-name}
                                      :discard true}))
                    st5 (bind-pattern st4 rest-pat {:kind :ident :name rest-name})]
                {:params (:params st5)
                 :init-stmts (:init-stmts st5)
                 :locals (:locals st5)
                 :has-rest true})))
          (if (and (= :symbol (:kind node)) (not (= "" (:name node))))
            (recur (rest remaining) (inc idx) (bind-symbol-param state (:name node)))
            (if (or (= :vector (:kind node)) (= :map (:kind node)))
              (if (= :map (:kind node))
                (unhandled-param node)
                (let [param-name (str "__arg" idx)
                      st1 (assoc state :params (conj (:params state) param-name))
                      st2 (bind-pattern st1 node {:kind :ident :name param-name})]
                  (recur (rest remaining) (inc idx) st2)))
              (unhandled-param node))))))))

(defn form-result [stmts expr kind ctx]
  {:stmts (stmt-list stmts)
   :expr expr
   :expr-kind kind
   :defer? false
   :ctx ctx})

(defn next-form-temp [ctx prefix]
  (let [cur (if (nil? (:if-temps ctx)) 0 (:if-temps ctx))
        n (inc cur)]
    {:name (str prefix "_" n)
     :ctx (assoc ctx :if-temps n)}))

(defn coerce-form-value [part]
  (let [k (:expr-kind part)]
    (cond
      (= k :string)
      (form-result (:stmts part)
                   (literal-rt-call "NewString" [(:expr part)])
                   :value
                   (:ctx part))
      (= k :bool)
      (form-result (:stmts part)
                   (literal-rt-call "NewBool" [(:expr part)])
                   :value
                   (:ctx part))
      :else part)))

(defn form-value-ir [part]
  (:expr (coerce-form-value part)))

(defn eq-arg-ir [part]
  (let [k (:expr-kind part)]
    (cond
      (= k :value) (:expr part)
      (= k :string) (literal-rt-call "NewString" [(:expr part)])
      :else (throw (ex-info "= arguments must evaluate to Value" {})))))

(defn truthy-form-ir [part]
  (let [k (:expr-kind part)]
    (cond
      (= k :bool) (:expr part)
      (= k :value) (literal-rt-call "IsTruthy" [(:expr part)])
      (= k :string) {:kind :raw :code "true"}
      :else (throw (ex-info "unsupported if test expression" {:part part})))))

(defn go-type-for-kind [k]
  (cond
    (= k :string) "string"
    (= k :bool) "bool"
    :else "flagrt.Value"))

(defn compile-form-node [mode node ctx]
  (cond
    (= mode :seq)
    (loop [remaining node ctx ctx stmts [] irs []]
      (if (or (nil? remaining) (empty? remaining))
        {:stmts stmts :irs irs :ctx ctx}
        (let [part (compile-form-node :form (first remaining) ctx)]
          (recur (rest remaining)
                 (:ctx part)
                 (concat-stmts stmts (:stmts part))
                 (conj irs (form-value-ir part))))))

    (= mode :if)
    (let [args node
          n (count (stmt-list args))]
      (if (and (not (= n 2)) (not (= n 3)))
        (throw (ex-info "if expects test, true branch, and optional false branch" {:args args}))
        (let [cond-part (compile-form-node :form (first args) ctx)
              then0 (compile-form-node :form (first (rest args)) (:ctx cond-part))
              else0 (if (= n 3)
                      (compile-form-node :form (first (rest (rest args))) (:ctx then0))
                      (form-result [] (literal-rt-call "NilValue" []) :value (:ctx then0)))
              then1 (if (and (= n 3) (not (= (:expr-kind then0) (:expr-kind else0))))
                      (coerce-form-value then0)
                      then0)
              else1 (if (and (= n 3) (not (= (:expr-kind then1) (:expr-kind else0))))
                      (coerce-form-value else0)
                      else0)
              then2 (if (and (= n 2) (not (= :value (:expr-kind then1))))
                      (throw (ex-info "if without false branch currently requires a Value result" {}))
                      then1)
              tmp (next-form-temp (:ctx else1) "if_result")
              if-stmts (if-to-ir (:name tmp)
                                 (go-type-for-kind (:expr-kind then2))
                                 (truthy-form-ir cond-part)
                                 (:stmts then2)
                                 (:expr then2)
                                 (:stmts else1)
                                 (:expr else1))]
          (form-result (concat-stmts (:stmts cond-part) if-stmts)
                       {:kind :ident :name (:name tmp)}
                       (:expr-kind then2)
                       (:ctx tmp)))))

    (= mode :let)
    (let [args node]
  (if (or (nil? args) (empty? args))
    (throw (ex-info "let expects a binding vector" {}))
    (let [bindings-node (unwrap-ast (first args))
          body (rest args)]
      (if (not (= :vector (:kind bindings-node)))
        (throw (ex-info "let expects a binding vector" {:node bindings-node}))
        (let [entries (ast-seq bindings-node)]
          (if (not (= 0 (% (count entries) 2)))
            (throw (ex-info "let binding vector expects name/value pairs" {}))
            (loop [remaining entries
                   ctx ctx
                   bind-stmts []
                   declared {}
                   bind-temp 0]
              (if (or (nil? remaining) (empty? remaining))
                (let [compiled (compile-form-node :forms body ctx)
                      tmp (next-form-temp (:ctx compiled) "let_result")
                      let-stmts (let-to-ir (:name tmp)
                                           (go-type-for-kind (:expr-kind compiled))
                                           bind-stmts
                                           (:stmts compiled)
                                           (:expr compiled))]
                  (form-result let-stmts
                               {:kind :ident :name (:name tmp)}
                               (:expr-kind compiled)
                               (:ctx tmp)))
                (let [parsed (parse-volatile (first remaining))
                      pat (:target parsed)
                      val-node (first (rest remaining))]
                  (if (not (= :symbol (:kind pat)))
                    (if (:volatile? parsed)
                      (throw (ex-info "volatile let binding currently supports symbol bindings only" {:node pat}))
                      (throw (ex-info "not handled by FLAG form lowering" {:node pat})))
                    (if (= "" (:name pat))
                      (throw (ex-info "binding symbol cannot be empty" {:node pat}))
                      (let [part (compile-form-node :form val-node ctx)
                            go-name (go-ident (:name pat))]
                        (if (contains? declared go-name)
                          (throw (ex-info (str "duplicate binding \"" (:name pat) "\"") {:name (:name pat)}))
                          (if (:volatile? parsed)
                            (if (not (= :value (:expr-kind part)))
                              (throw (ex-info "volatile let binding value must evaluate to Value" {}))
                              (let [source-name (str "__bind" bind-temp)
                                    next-ctx (assoc (:ctx part) :locals
                                                    (if (= go-name "_")
                                                      (:locals (:ctx part))
                                                      (assoc (:locals (:ctx part)) go-name :mutable-value)))
                                    stmts0 (concat-stmts bind-stmts (:stmts part))
                                    stmts1 (conj stmts0 {:kind :var :name source-name :type "" :expr (:expr part)})
                                    stmts2 (conj stmts1 {:kind :var :name go-name :type "" :expr {:kind :ident :name source-name}})
                                    stmts3 (append-unused stmts2 (:name pat) go-name)]
                                (recur (rest (rest remaining))
                                       next-ctx
                                       stmts3
                                       (if (= go-name "_") declared (assoc declared go-name true))
                                       (inc bind-temp))))
                            (let [next-ctx (assoc (:ctx part) :locals
                                                  (if (= go-name "_")
                                                    (:locals (:ctx part))
                                                    (assoc (:locals (:ctx part)) go-name (:expr-kind part))))
                                  stmts0 (concat-stmts bind-stmts (:stmts part))
                                  stmts1 (conj stmts0 {:kind :var
                                                       :name go-name
                                                       :type ""
                                                       :expr (:expr part)})
                                  stmts2 (append-unused stmts1 (:name pat) go-name)]
                              (recur (rest (rest remaining))
                                     next-ctx
                                     stmts2
                                     (if (= go-name "_")
                                       declared
                                       (assoc declared go-name true))
                                     bind-temp))))))))))))))))

    (= mode :fn)
    (let [args node]
      (if (not (= 2 (count (stmt-list args))))
        (throw (ex-info "fn expects parameter vector and body expression" {}))
        (let [params (first args)
              body (first (rest args))]
          (if (not (= :vector (:kind params)))
            (throw (ex-info "fn expects a parameter vector" {:node params}))
            (let [bound (bind-params-to-ir params "fn" (:locals ctx))
                  inner (assoc ctx :locals (:locals bound))
                  compiled (coerce-form-value (compile-form-node :form body inner))
                  ir (fn-to-ir "fn"
                               (:params bound)
                               (:has-rest bound)
                               (:init-stmts bound)
                               (:stmts compiled)
                               (:expr compiled))]
              (form-result [] ir :value (:ctx compiled)))))))

    (= mode :update)
    (let [args node]
      (if (not (= 2 (count (stmt-list args))))
        (throw (ex-info "update! expects a mutable symbol and replacement value" {}))
        (let [target (unwrap-ast (first args))
              val-node (first (rest args))]
          (if (not (= :symbol (:kind target)))
            (throw (ex-info "update! first argument must be a mutable symbol" {:node target}))
            (let [ident (go-ident (:name target))
                 locals (:locals ctx)]
              (if (not (= :mutable-value (get locals ident)))
               (throw (ex-info "update! first argument must be a mutable let binding" {:name ident}))
               (let [part (coerce-form-value (compile-form-node :form val-node ctx))
                     ir (update-bang-to-ir ident (:stmts part) (:expr part))]
                 (form-result [] ir :value (:ctx part)))))))))

    (= mode :call)
    (let [elements (:elements node)]
      (if (or (nil? elements) (empty? elements))
        (throw (ex-info "unsupported form" {:node node}))
        (let [head (first elements)
              args (rest elements)]
          (if (and (= :symbol (:kind head))
                  (not (= 0 (count (:name head))))
                  (= "." (subs (:name head) 0 1)))
            (throw (ex-info "not handled by FLAG form lowering" {:node node}))
          (if (= :symbol (:kind head))
            (let [op (:name head)
                  unary (get unary-runtime-ops op)
                  fold (get fold-runtime-ops op)
                  binary (get binary-runtime-ops op)
                  variadic (get variadic-runtime-ops op)]
              (cond
                (= op "if") (compile-form-node :if args ctx)
                (= op "do") (compile-form-node :forms args ctx)
                (= op "let") (compile-form-node :let args ctx)
                (= op "fn") (compile-form-node :fn args ctx)
                (= op "update!") (compile-form-node :update args ctx)

                (= op "=")
                (if (or (nil? args) (empty? args) (empty? (rest args)))
                  (throw (ex-info "= expects at least two arguments" {}))
                  (loop [remaining args ctx ctx stmts [] irs []]
                    (if (or (nil? remaining) (empty? remaining))
                      (form-result stmts (eq-to-ir irs) :value ctx)
                      (let [part (compile-form-node :form (first remaining) ctx)]
                        (recur (rest remaining)
                               (:ctx part)
                               (concat-stmts stmts (:stmts part))
                               (conj irs (eq-arg-ir part)))))))

                unary
                (if (not (= 1 (count args)))
                  (throw (ex-info (str op " expects exactly one argument") {:node node}))
                  (let [compiled (compile-form-node :seq args ctx)]
                    (form-result (:stmts compiled)
                                 (runtime-call-to-ir unary (:irs compiled))
                                 :value
                                 (:ctx compiled))))

                fold
                (let [compiled (compile-form-node :seq args ctx)]
                  (form-result (:stmts compiled)
                               (fold-call-to-ir fold (:irs compiled))
                               :value
                               (:ctx compiled)))

                binary
                (if (not (= 2 (count args)))
                  (throw (ex-info (str op " expects exactly two arguments") {:node node}))
                  (let [compiled (compile-form-node :seq args ctx)]
                    (form-result (:stmts compiled)
                                 (runtime-call-to-ir binary (:irs compiled))
                                 :value
                                 (:ctx compiled))))

                variadic
                (let [compiled (compile-form-node :seq args ctx)]
                  (form-result (:stmts compiled)
                               (runtime-call-to-ir variadic (:irs compiled))
                               :value
                               (:ctx compiled)))

                (contains? special-form-names op)
                (throw (ex-info "not handled by FLAG form lowering" {:node node}))

                :else
                (let [self-target (self-call-target op (count (stmt-list args)) ctx)]
                  (if (and self-target (not (= "" self-target)))
                    (let [compiled (compile-form-node :seq args ctx)]
                      (form-result (:stmts compiled)
                                   (ident-call-ir self-target (:irs compiled))
                                   :value
                                   (:ctx compiled)))
                    (let [callee (compile-form-node :form head ctx)
                          compiled (compile-form-node :seq args (:ctx callee))]
                      (form-result (concat-stmts (:stmts callee) (:stmts compiled))
                                   (call-to-ir (form-value-ir callee) (:irs compiled))
                                   :value
                                   (:ctx compiled)))))))
            (let [callee (compile-form-node :form head ctx)
                  compiled (compile-form-node :seq args (:ctx callee))]
              (form-result (concat-stmts (:stmts callee) (:stmts compiled))
                           (call-to-ir (form-value-ir callee) (:irs compiled))
                           :value
                           (:ctx compiled))))))))

    (= mode :form)
    (let [form (unwrap-ast node)
          kind (:kind form)]
      (cond
        (= kind :string) (form-result [] (ast-node-to-ir form) :string ctx)
        (= kind :char) (form-result [] (ast-node-to-ir form) :value ctx)
        (= kind :int) (form-result [] (ast-node-to-ir form) :value ctx)
        (= kind :bigint) (form-result [] (ast-node-to-ir form) :value ctx)
        (= kind :ratio) (form-result [] (ast-node-to-ir form) :value ctx)
        (= kind :float) (form-result [] (ast-node-to-ir form) :value ctx)
        (= kind :keyword) (form-result [] (ast-node-to-ir form) :value ctx)
        (= kind :quoted-symbol) (form-result [] (ast-node-to-ir form) :value ctx)

        (= kind :symbol)
        (let [name (:name form)]
          (if (or (= name "true") (= name "false") (= name "nil"))
            (form-result [] (ast-node-to-ir form) :value ctx)
            (let [ident (go-ident-or-empty name)
                  resolved (symbol-to-ir name ident ctx)]
              (form-result [] (:ir resolved) (:expr-kind resolved) ctx))))

        (= kind :quoted-list) (form-result [] (quoted-ast-to-ir form) :value ctx)

        (= kind :vector)
        (let [compiled (compile-form-node :seq (:elements form) ctx)]
          (form-result (:stmts compiled)
                       (ctor-to-ir "NewArray" (:irs compiled))
                       :value
                       (:ctx compiled)))

        (= kind :pipe-vector)
        (let [compiled (compile-form-node :seq (:elements form) ctx)]
          (form-result (:stmts compiled)
                       (ctor-to-ir "NewVector" (:irs compiled))
                       :value
                       (:ctx compiled)))

        (= kind :set)
        (let [compiled (compile-form-node :seq (:elements form) ctx)]
          (form-result (:stmts compiled)
                       (ctor-to-ir "NewSet" (:irs compiled))
                       :value
                       (:ctx compiled)))

        (= kind :map)
        (let [entries (:entries form)
              n (if (nil? entries) 0 (count entries))]
          (if (not (= 0 (% n 2)))
            (throw (ex-info "map literal expects key/value pairs" {:node form}))
            (let [compiled (compile-form-node :seq entries ctx)]
              (form-result (:stmts compiled)
                           (ctor-to-ir "NewMap" (:irs compiled))
                           :value
                           (:ctx compiled)))))

        (= kind :list) (compile-form-node :call form ctx)

        :else (throw (ex-info "not handled by FLAG form lowering" {:node form}))))

    (= mode :forms)
    (if (or (nil? node) (empty? node))
      (form-result [] (literal-rt-call "NilValue" []) :value ctx)
      (loop [remaining (stmt-list node) ctx ctx compiled []]
        (let [part (compile-form-node :form (first remaining) ctx)
              more (rest remaining)
              next-compiled (conj compiled part)]
          (if (or (nil? more) (empty? more))
            (form-result (do-prelude-stmts next-compiled)
                         (:expr part)
                         (:expr-kind part)
                         (:ctx part))
            (recur more (:ctx part) next-compiled)))))

    :else (throw (ex-info "unsupported compile-form mode" {:mode mode}))))

(defn compile-form-to-ir [node ctx]
  (compile-form-node :form node ctx))

(defn compile-forms-to-ir [forms ctx]
  (compile-form-node :forms forms ctx))
