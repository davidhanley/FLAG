{:namespace "compiler"
 :exports   [tokenize-file tokenize-file-parse-tokens]
 :imports   [["async.lib" :refer [go make-channel channel-send channel-receive channel-close]]
             ["interop.lib" :refer [defrecord]]
             ["stdlib.lib" :refer [second third]]]}

(def whitespace-chars #{" " "\t" "\n" "\r" ","})
(def delimiter-chars #{"(" ")" "[" "]" "{" "}" "^" "'"})

;; Mirrors internal/compiler.ParseTokenKind values.
(def token-eof 0)
(def token-error 1)
(def token-list-open 2)
(def token-list-close 3)
(def token-vector-open 4)
(def token-vector-close 5)
(def token-map-open 6)
(def token-map-close 7)
(def token-metadata 8)
(def token-quote 9)
(def token-dispatch-set-open 10)
(def token-dispatch-fn-open 11)
(def token-string 12)
(def token-atom 13)

(defn whitespace-char? [ch]
  (contains? whitespace-chars ch))

(defn delimiter-char? [ch]
  (contains? delimiter-chars ch))

(defrecord SourceToken [token line offset])
(defrecord TokenState [token start-line start-offset in-string triple escaped])
(defrecord ParseToken [kind lexeme string message line col])

(defn emit-token!
  [out token line offset]
  (if (empty? token)
    nil
    (channel-send out (->SourceToken token line offset))))

(defn make-state [token start-line start-offset in-string triple escaped]
  (->TokenState token start-line start-offset in-string triple escaped))

(def empty-token-state
  (make-state "" 0 0 false false false))

(defn starts-triple-quote?
  [chars]
  (and (= "\"" (first chars))
       (= "\"" (second chars))
       (= "\"" (third chars))))

(defn starts-dispatch-set?
  [chars]
  (and (= "#" (first chars))
       (= "{" (second chars))))

(defn starts-dispatch-fn?
  [chars]
  (and (= "#" (first chars))
       (= "(" (second chars))))

(defn strip-quoted-token
  [token prefix suffix]
  (let [chars (seq token)
        total (count chars)]
    (if (<= total (+ prefix suffix))
      ""
      (loop [remaining (take (- total prefix suffix) (drop prefix chars))
             out ""]
        (if (empty? remaining)
          out
          (recur (rest remaining) (str out (first remaining))))))))

(defn token->string-value
  [token]
  (let [chars (seq token)
        n (count chars)]
    (cond
      (and (>= n 6)
           (starts-triple-quote? chars)
           (= "\"" (first (drop (- n 3) chars)))
           (= "\"" (first (drop (- n 2) chars)))
           (= "\"" (first (drop (- n 1) chars))))
      (strip-quoted-token token 3 3)

      (and (>= n 2)
           (= "\"" (first chars))
           (= "\"" (first (drop (- n 1) chars))))
      (strip-quoted-token token 1 1)

      true
      token)))

(defn source-token->parse-token
  [{:keys [token line offset]}]
  (cond
    (= token "(") (->ParseToken token-list-open "" "" "" line offset)
    (= token ")") (->ParseToken token-list-close "" "" "" line offset)
    (= token "[") (->ParseToken token-vector-open "" "" "" line offset)
    (= token "]") (->ParseToken token-vector-close "" "" "" line offset)
    (= token "{") (->ParseToken token-map-open "" "" "" line offset)
    (= token "}") (->ParseToken token-map-close "" "" "" line offset)
    (= token "^") (->ParseToken token-metadata "" "" "" line offset)
    (= token "'") (->ParseToken token-quote "" "" "" line offset)
    (= token "#{") (->ParseToken token-dispatch-set-open "" "" "" line offset)
    (= token "#(") (->ParseToken token-dispatch-fn-open "" "" "" line offset)
    (= token "#") (->ParseToken token-error "" "" "unexpected end after #" line offset)
    (and (>= (count token) 2)
         (= "\"" (first (seq token)))
         (= "\"" (last (seq token))))
    (->ParseToken token-string "" (token->string-value token) "" line offset)
    true
    (->ParseToken token-atom token "" "" line offset)))

(defn token-end-col
  [source-token]
  (+ (:offset source-token) (count (:token source-token))))

(defn tokenize-line-step!
  [out chars line column state]
  (loop [remaining chars col column current state]
    (if (empty? remaining)
      (if (:in-string current)
        current
        (do
          (emit-token! out (:token current) (:start-line current) (:start-offset current))
          empty-token-state))
      (let [ch (first remaining)]
        (if (:in-string current)
          (if (:triple current)
            (if (starts-triple-quote? remaining)
              (let [token (str (:token current) "\"\"\"")]
                (emit-token! out token (:start-line current) (:start-offset current))
                (recur (drop 3 remaining) (+ col 3) empty-token-state))
              (recur (rest remaining) (inc col)
                     (make-state (str (:token current) ch)
                                 (:start-line current)
                                 (:start-offset current)
                                 true
                                 true
                                 false)))
            (let [token (str (:token current) ch)]
              (cond
                (:escaped current)
                (recur (rest remaining) (inc col)
                       (make-state token
                                   (:start-line current)
                                   (:start-offset current)
                                   true
                                   false
                                   false))

                (= "\\" ch)
                (recur (rest remaining) (inc col)
                       (make-state token
                                   (:start-line current)
                                   (:start-offset current)
                                   true
                                   false
                                   true))

                (= "\"" ch)
                (do
                  (emit-token! out token (:start-line current) (:start-offset current))
                  (recur (rest remaining) (inc col) empty-token-state))

                true
                (recur (rest remaining) (inc col)
                       (make-state token
                                   (:start-line current)
                                   (:start-offset current)
                                   true
                                   false
                                   false)))))
          (cond
            (= ";" ch)
            (do
              (emit-token! out (:token current) (:start-line current) (:start-offset current))
              empty-token-state)

            (whitespace-char? ch)
            (do
              (emit-token! out (:token current) (:start-line current) (:start-offset current))
              (recur (rest remaining) (inc col) empty-token-state))

            (delimiter-char? ch)
            (do
              (emit-token! out (:token current) (:start-line current) (:start-offset current))
              (emit-token! out ch line col)
              (recur (rest remaining) (inc col) empty-token-state))

            (= "\"" ch)
            (if (starts-triple-quote? remaining)
              (do
                (emit-token! out (:token current) (:start-line current) (:start-offset current))
                (recur (drop 3 remaining) (+ col 3)
                       (make-state "\"\"\"" line col true true false)))
              (do
                (emit-token! out (:token current) (:start-line current) (:start-offset current))
                (recur (rest remaining) (inc col)
                       (make-state "\"" line col true false false))))

            (starts-dispatch-set? remaining)
            (do
              (emit-token! out (:token current) (:start-line current) (:start-offset current))
              (emit-token! out "#{" line col)
              (recur (drop 2 remaining) (+ col 2) empty-token-state))

            (starts-dispatch-fn? remaining)
            (do
              (emit-token! out (:token current) (:start-line current) (:start-offset current))
              (emit-token! out "#(" line col)
              (recur (drop 2 remaining) (+ col 2) empty-token-state))

            true
            (if (empty? (:token current))
              (recur (rest remaining) (inc col)
                     (make-state ch line col false false false))
              (recur (rest remaining) (inc col)
                     (make-state (str (:token current) ch)
                                 (:start-line current)
                                 (:start-offset current)
                                 false
                                 false
                                 false)))))))))

(defn tokenize-lines!
  [out lines line-number]
  (loop [remaining lines line line-number state empty-token-state]
    (if (empty? remaining)
      (emit-token! out (:token state) (:start-line state) (:start-offset state))
      (let [next-state (tokenize-line-step! out (seq (str (first remaining))) line 1 state)
            has-more (not (empty? (rest remaining)))
            carry-state (if (and has-more (:in-string next-state))
                          (make-state (str (:token next-state) "\n")
                                      (:start-line next-state)
                                      (:start-offset next-state)
                                      true
                                      (:triple next-state)
                                      (:escaped next-state))
                          next-state)]
        (recur (rest remaining) (+ line 1) carry-state)))))

(defn tokenize-file
  "Read a source file and return a channel of token maps {:token :line :offset}."
  [path]
  (let [out (make-channel 64)]
    (go
      (with-open [rdr (io/reader path)]
        (do
          (tokenize-lines! out (line-seq rdr) 1)
          (channel-close out))))
    out))

(defn tokenize-file-parse-tokens
  "Read a source file and return a channel of ParseToken-shaped maps matching Go ParseToken fields."
  [path]
  (let [out (make-channel 64)
        in (tokenize-file path)]
    (go
      (loop [last-token nil]
        (let [source-token (channel-receive in)]
          (if (nil? source-token)
            (let [eof-line (if (nil? last-token) 1 (:line last-token))
                  eof-col (if (nil? last-token) 1 (token-end-col last-token))]
              (channel-send out (->ParseToken token-eof "" "" "" eof-line eof-col))
              (channel-close out))
            (do
              (channel-send out (source-token->parse-token source-token))
              (recur source-token))))))
    out))
