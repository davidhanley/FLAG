;; Concurrency package: import and :refer what you need.
;;
;;   {:imports [["async.lib" :refer [go future sleep
;;                                    make-channel channel-send channel-receive
;;                                    channel-close select
;;                                    channel-map channel-filter channel-reduce
;;                                    channel-every? channel-some? channel-lines]]]}
;;
;; go / future are macros that expand to go-run / future-run (also exported
;; under async/… for the expansion). sleep, channels, and select are functions.
{:namespace "async"
 :exports   [go future go-run future-run future-piped-run
             sleep make-channel channel-send channel-receive channel-close select
             channel-map channel-filter channel-reduce channel-every? channel-some? channel-lines]
 :go-exports {go-run          "async/go-run"
              future-run      "async/future-run"
              future-piped-run "async/future-piped-run"
              sleep           "async/sleep"
              make-channel    "async/make-channel"
              channel-send    "async/channel-send"
              channel-receive "async/channel-receive"
              channel-close   "async/channel-close"
              select          "async/select"
             channel-map     "async/channel-map"
             channel-filter  "async/channel-filter"
             channel-reduce  "async/channel-reduce"
             channel-every?  "async/channel-every?"
             channel-some?   "async/channel-some?"
             channel-lines   "async/channel-lines"}}

(defmacro go
  "Evaluate body on a new goroutine; return nil immediately."
  [& body]
  (async/go-run (fn [] (do body))))

(defmacro future
  "Evaluate body on a new goroutine; return a 0-arg fn, or a channel when :piped? true."
  [& body]
  (macro-case (do body)
    [[:piped? true & forms]
     (async/future-piped-run (fn [] (do forms)))]
    [[& forms]
     (async/future-run (fn [] (do forms)))]))
