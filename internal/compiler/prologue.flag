(defmacro when [test & body]
  (if test (do body)))

(defmacro when-not [test & body]
  (if test nil (do body)))

(defmacro inc [x]
  (+ x 1))

(defmacro dec [x]
  (- x 1))

(defmacro not= [a b]
  (if (= a b) false true))

(defmacro cond [& clauses]
  (macro-case (do clauses)
    [[] nil]
    [[:else expr] expr]
    [[test expr & rest]
     (if test
       expr
       (cond rest))]))

(defmacro -> [x & forms]
  (macro-case (do forms)
    [[] x]
    [[(f & args) & rest]
     (-> (f x args) rest)]
    [[f & rest]
     (-> (f x) rest)]))

(defmacro ->> [x & forms]
  (macro-case (do forms)
    [[] x]
    [[(f & args) & rest]
     (->> (f args x) rest)]
    [[f & rest]
     (->> (f x) rest)]))

(defmacro some-> [x & forms]
  (macro-case (do forms)
    [[] x]
    [[(f & args) & rest]
     (let [tmp x]
       (if (= tmp nil)
         nil
         (some-> (f tmp args) rest)))]
    [[f & rest]
     (let [tmp x]
       (if (= tmp nil)
         nil
         (some-> (f tmp) rest)))]))

(defmacro some->> [x & forms]
  (macro-case (do forms)
    [[] x]
    [[(f & args) & rest]
     (let [tmp x]
       (if (= tmp nil)
         nil
         (some->> (f args tmp) rest)))]
    [[f & rest]
     (let [tmp x]
       (if (= tmp nil)
         nil
         (some->> (f tmp) rest)))]))

(defmacro cond-> [x & clauses]
  (macro-case (do clauses)
    [[] x]
    [[test (f & args) & rest]
     (let [tmp x]
       (cond-> (if test
                 (f tmp args)
                 tmp)
               rest))]
    [[test f & rest]
     (let [tmp x]
       (cond-> (if test
                 (f tmp)
                 tmp)
               rest))]))

(defmacro when-let [bindings & body]
  (macro-case (do bindings)
    [[name value]
     (let [name value]
       (if name
         (do body)))]))

(defmacro comp [& fns]
  (macro-case (do fns)
    [[] (fn [x] x)]
    [[f] f]
    [[f & rest]
     (let [g (comp rest)]
       (fn [x]
         (f (g x))))]))

(defmacro not [x]
  (if x false true))

(def peek first)
(def pop rest)

(defn identity [x] x)

(defn constantly [x]
  (fn [& rest] (do rest x)))

(defn second [coll]
  (first (rest coll)))

(defn third [coll]
  (slow-nth coll 2))

(defn fourth [coll]
  (slow-nth coll 3))

(defn fifth [coll]
  (slow-nth coll 4))

(defn sixth [coll]
  (slow-nth coll 5))

(defn seventh [coll]
  (slow-nth coll 6))

(defn eighth [coll]
  (slow-nth coll 7))

(defn ninth [coll]
  (slow-nth coll 8))

(defn tenth [coll]
  (slow-nth coll 9))

(defn val [entry]
  (second entry))

(defn some? [x]
  (not (nil? x)))

(defn true? [x]
  (= x true))

(defn false? [x]
  (= x false))

(defn boolean [x]
  (if x true false))

(defn not-empty? [coll]
  (not (empty? coll)))

(defn not-any? [pred coll]
  (not (some pred coll)))

(defn remove [pred coll]
  (filter (fn [x] (not (pred x))) coll))

(defn update [m k f & extra]
  (assoc m k (apply f (get m k) extra)))

(defn get-in [m ks]
  (reduce get m ks))

(defn update-in [m ks f & extra]
  (if (seq ks)
    (let [k (first ks)
          rest-ks (rest ks)
          base (if (nil? m) {} m)]
      (if (seq rest-ks)
        (assoc base k (apply update-in (get base k) rest-ks f extra))
        (assoc base k (apply f (get base k) extra))))
    (apply f m extra)))

(defn assoc-in [m ks v]
  (if (seq ks)
    (let [k (first ks)
          rest-ks (rest ks)
          base (if (nil? m) {} m)]
      (if (seq rest-ks)
        (assoc base k (assoc-in (get base k) rest-ks v))
        (assoc base k v)))
    m))

(defn dissoc-in [m ks]
  (if (nil? m)
    nil
    (if (seq ks)
      (let [k (first ks)
            rest-ks (rest ks)]
        (if (seq rest-ks)
          (let [next (dissoc-in (get m k) rest-ks)]
            (if (or (nil? next) (empty? next))
              (dissoc m k)
              (assoc m k next)))
          (dissoc m k)))
      m)))

(defn juxt [& fns]
  (fn [& xs]
    (vec (map (fn [f] (apply f xs)) fns))))

(defn partial [f & bound]
  (fn [& more]
    (apply f (concat bound more))))

(defn keep [f coll]
  (filter some? (map f coll)))

(defn every? [pred coll]
  (loop [xs coll]
    (if (seq xs)
      (if (pred (first xs))
        (recur (rest xs))
        false)
      true)))

(defn max-key [kfn x & more]
  (reduce (fn [best cand]
            (if (> (kfn cand) (kfn best))
              cand
              best))
          x
          more))

(defn zipmap [ks vs]
  (loop [ks ks vs vs out {}]
    (if (and (seq ks) (seq vs))
      (recur (rest ks) (rest vs) (assoc out (first ks) (first vs)))
      out)))

(defn group-by [f coll]
  (reduce (fn [acc x]
            (let [k (f x)]
              (assoc acc k (conj (or (get acc k) []) x))))
          {}
          coll))

(defn select-keys [m ks]
  (reduce (fn [acc k]
            (if (contains? m k)
              (assoc acc k (get m k))
              acc))
          {}
          ks))

(defn merge [& maps]
  (reduce (fn [out m]
            (if (nil? m)
              out
              (reduce (fn [acc pair]
                        (assoc acc (first pair) (val pair)))
                      (if (nil? out) {} out)
                      m)))
          nil
          maps))

(defn merge-with [f & maps]
  (reduce (fn [out m]
            (if (nil? m)
              out
              (reduce (fn [acc pair]
                        (let [k (first pair)
                              v (val pair)]
                          (if (contains? acc k)
                            (assoc acc k (f (get acc k) v))
                            (assoc acc k v))))
                      (if (nil? out) {} out)
                      m)))
          nil
          maps))

(defn mapcat [f & colls]
  (apply concat (apply map f colls)))

(defn sequential? [x]
  (or (= (type-of x) :list)
      (= (type-of x) :array)
      (= (type-of x) :vector)
      (= (type-of x) :lazy-list)))

(defn distinct [coll]
  (loop [xs coll seen #{} out []]
    (if (empty? xs)
      out
      (let [x (first xs)]
        (if (contains? seen x)
          (recur (rest xs) seen out)
          (recur (rest xs) (conj seen x) (conj out x)))))))

(defn flatten [x]
  (if (sequential? x)
    (vec (mapcat (fn [item]
                   (if (sequential? item)
                     (flatten item)
                     [item]))
                 x))
    []))

(defn interpose [sep coll]
  (if (empty? coll)
    []
    (loop [xs (rest coll) out [(first coll)]]
      (if (empty? xs)
        out
        (recur (rest xs) (conj out sep (first xs)))))))

(defn interleave [& colls]
  (if (empty? colls)
    []
    (loop [cols colls out []]
      (if (every? not-empty? cols)
        (recur (map rest cols)
               (reduce conj out (map first cols)))
        out))))

(defn partition [n & more]
  (if (or (= (count more) 1) (= (count more) 2) (= (count more) 3))
    (let [c (count more)
          step (if (= c 1) n (first more))
          coll (if (= c 1)
                 (first more)
                 (if (= c 2)
                   (second more)
                   (nth more 2)))
          pad (if (= c 3) (second more) nil)
          use-pad (= c 3)]
      (loop [xs coll out []]
        (if (empty? xs)
          out
          (let [part (vec (take n xs))]
            (if (= (count part) n)
              (recur (drop step xs) (conj out part))
              (if use-pad
                (conj out (vec (take n (concat part pad))))
                out))))))
    (throw "partition expects 2, 3, or 4 arguments")))

(defn partition-all [n & more]
  (if (or (= (count more) 1) (= (count more) 2))
    (let [step (if (= (count more) 1) n (first more))
          coll (if (= (count more) 1) (first more) (second more))]
      (loop [xs coll out []]
        (if (empty? xs)
          out
          (recur (drop step xs) (conj out (vec (take n xs)))))))
    (throw "partition-all expects 2 or 3 arguments")))

(defn partition-by [f coll]
  (loop [xs coll out []]
    (if (empty? xs)
      out
      (let [fv (f (first xs))
            run (loop [ys (rest xs) acc [(first xs)]]
                  (if (or (empty? ys) (not= fv (f (first ys))))
                    acc
                    (recur (rest ys) (conj acc (first ys)))))]
        (recur (drop (count run) xs) (conj out run))))))
