(defmacro when [test & body]
  (if test (do body)))

(defmacro when-not [test & body]
  (if test nil (do body)))

(defmacro inc [x]
  (+ x 1))

(defmacro dec [x]
  (- x 1))

(defmacro not= [a b]
  (if (= a b) false true))

(defmacro cond [& clauses]
  (macro-case (do clauses)
    [[] nil]
    [[:else expr] expr]
    [[test expr & rest]
     (if test
       expr
       (cond rest))]))

(defmacro -> [x & forms]
  (macro-case (do forms)
    [[] x]
    [[(f & args) & rest]
     (-> (f x args) rest)]
    [[f & rest]
     (-> (f x) rest)]))

(defmacro ->> [x & forms]
  (macro-case (do forms)
    [[] x]
    [[(f & args) & rest]
     (->> (f args x) rest)]
    [[f & rest]
     (->> (f x) rest)]))

(defmacro some-> [x & forms]
  (macro-case (do forms)
    [[] x]
    [[(f & args) & rest]
     (let [tmp x]
       (if (= tmp nil)
         nil
         (some-> (f tmp args) rest)))]
    [[f & rest]
     (let [tmp x]
       (if (= tmp nil)
         nil
         (some-> (f tmp) rest)))]))

(defmacro some->> [x & forms]
  (macro-case (do forms)
    [[] x]
    [[(f & args) & rest]
     (let [tmp x]
       (if (= tmp nil)
         nil
         (some->> (f args tmp) rest)))]
    [[f & rest]
     (let [tmp x]
       (if (= tmp nil)
         nil
         (some->> (f tmp) rest)))]))

(defmacro cond-> [x & clauses]
  (macro-case (do clauses)
    [[] x]
    [[test (f & args) & rest]
     (let [tmp x]
       (cond-> (if test
                 (f tmp args)
                 tmp)
               rest))]
    [[test f & rest]
     (let [tmp x]
       (cond-> (if test
                 (f tmp)
                 tmp)
               rest))]))

(defmacro when-let [bindings & body]
  (macro-case (do bindings)
    [[name value]
     (let [name value]
       (if name
         (do body)))]))

(defmacro comp [& fns]
  (macro-case (do fns)
    [[] (fn [x] x)]
    [[f] f]
    [[f & rest]
     (let [g (comp rest)]
       (fn [x]
         (f (g x))))]))

(defmacro not [x]
  (if x false true))

(defn identity [x] x)

(defn constantly [x]
  (fn [& rest] (do rest x)))

(defn second [coll]
  (first (rest coll)))

(defn val [entry]
  (second entry))

(defn some? [x]
  (not (nil? x)))

(defn not-empty? [coll]
  (not (empty? coll)))

(defn not-any? [pred coll]
  (not (some pred coll)))

(defn remove [pred coll]
  (filter (fn [x] (not (pred x))) coll))

(defn update [m k f & extra]
  (assoc m k (apply f (get m k) extra)))

(defn get-in [m ks]
  (reduce get m ks))

(defn juxt [& fns]
  (fn [& xs]
    (vec (map (fn [f] (apply f xs)) fns))))

(defn partial [f & bound]
  (fn [& more]
    (apply f (concat bound more))))

(defn keep [f coll]
  (filter some? (map f coll)))

(defn every? [pred coll]
  (loop [xs coll]
    (if (seq xs)
      (if (pred (first xs))
        (recur (rest xs))
        false)
      true)))

(defn max-key [kfn x & more]
  (reduce (fn [best cand]
            (if (> (kfn cand) (kfn best))
              cand
              best))
          x
          more))

(defn zipmap [ks vs]
  (loop [ks ks vs vs out {}]
    (if (and (seq ks) (seq vs))
      (recur (rest ks) (rest vs) (assoc out (first ks) (first vs)))
      out)))

(defn group-by [f coll]
  (reduce (fn [acc x]
            (let [k (f x)]
              (assoc acc k (conj (or (get acc k) []) x))))
          {}
          coll))

(defn select-keys [m ks]
  (reduce (fn [acc k]
            (if (contains? m k)
              (assoc acc k (get m k))
              acc))
          {}
          ks))

(defn merge [& maps]
  (reduce (fn [out m]
            (if (nil? m)
              out
              (reduce (fn [acc pair]
                        (assoc acc (first pair) (val pair)))
                      (if (nil? out) {} out)
                      m)))
          nil
          maps))

(defn mapcat [f & colls]
  (apply concat (apply map f colls)))
